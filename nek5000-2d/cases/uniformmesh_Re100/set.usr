      subroutine s35ad_axisym8_update
      include 'SIZE'
      include 'TOTAL'

      integer s35ng
      parameter(s35ng=48)
      real s35gx(s35ng),s35gw(s35ng)
      real s35xx(s35ng),s35yy(s35ng),s35zz(s35ng)
      real s35uz(s35ng),s35ur(s35ng),s35pp(s35ng)
      real s35rst(ldim,s35ng),s35dist(s35ng)
      integer s35rc(s35ng),s35proc(s35ng),s35el(s35ng)

      real s35pm1(lx1,ly1,lz1,lelt)
      real s35pw1(lx1,ly1,lz1,lelt)
      real s35pw2(lx1,ly1,lz1,lelt)

      integer ih_intp
      common /intp_h/ ih_intp
      logical intp_phys_rdy
      common /phys_intp_rdy/ intp_phys_rdy

      integer npp,nidd,nekcomm,nekgroup,nekreal
      common /nekmpi/ nidd,npp,nekcomm,nekgroup,nekreal

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real s35a,s35rs,s35rho,s35mu,s35nu
      real s35pbar,s35wsum,s35sp,s35su,s35uth
      real s35y,s35dy,s35st,s35x,s35w
      real s35roa,s35aor,s35fn,s35ap,s35bp
      real s35au,s35bu,s35det,s35gn,s35hn
      real s35ps,s35us,s35blend,s35tol
      real s35pi
      integer s35i,s35n,s35ltot,s35nf,s35nfg,s35fu
      logical s35cache
      save s35rc,s35proc,s35el,s35rst,s35dist,s35cache
      data s35cache /.false./

      if (ldim.ne.2) then
         if (nid.eq.0) write(6,*)
     $      'S35AD ERROR: axisym8 requires ldim=2'
         call exitt
      endif

      if (abs(phys_up)+abs(phys_vp)+abs(phys_wp)+
     $    abs(phys_ox)+abs(phys_oy)+abs(phys_oz).gt.1.0e-12) then
         if (nid.eq.0) write(6,*)
     $      'S35AD ERROR: axisym8 full-run path is fixed sphere only'
         call exitt
      endif

      call s35ar_gl_init(s35gx,s35gw)

      s35a=phys_a
c     U14 GL sweep: harmonic degree N=3 is fixed.
c     Harmonic and CV radii both use q/a=1.140.
      s35rs=r_sample_over_a*s35a
      s35rho=max(abs(param(1)),1.0e-30)
      s35mu=abs(param(2))
      s35nu=s35mu/s35rho
      s35pi=4.0*atan(1.0)

      do s35i=1,s35ng
         s35xx(s35i)=phys_zp+s35rs*s35gx(s35i)
         s35yy(s35i)=s35rs*
     $      sqrt(max(0.0,1.0-s35gx(s35i)*s35gx(s35i)))
         s35zz(s35i)=0.0
      enddo

      s35ltot=lx1*ly1*lz1*nelt
      if (lx2.ne.lx1) then
         call mappr(s35pm1,pr,s35pw1,s35pw2)
      else
         call copy(s35pm1,pr,s35ltot)
      endif

      if (.not.intp_phys_rdy) then
         s35tol=5.0e-13
         call fgslib_findpts_setup(ih_intp,nekcomm,npp,ldim,
     $      xm1,ym1,zm1,lx1,ly1,lz1,nelt,
     $      2*lx1,2*ly1,2*lz1,0.01,
     $      s35ltot,s35ltot,256,s35tol)
         intp_phys_rdy=.true.
      endif

      if (.not.s35cache) then
         call fgslib_findpts(ih_intp,s35rc,1,s35proc,1,
     $      s35el,1,s35rst,ldim,s35dist,1,
     $      s35xx,1,s35yy,1,s35zz,1,s35ng)

         s35nf=0
         do s35i=1,s35ng
            if (s35rc(s35i).ge.2) s35nf=s35nf+1
         enddo
         s35nfg=iglsum(s35nf,1)
         if (s35nfg.gt.0) then
            if (nid.eq.0) write(6,'(A,I8)')
     $         'S35AR FATAL GL048 findpts failures=',s35nfg
            call exitt
         endif
         s35cache=.true.
      endif

      call fgslib_findpts_eval(ih_intp,s35uz,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,vx)
      call fgslib_findpts_eval(ih_intp,s35ur,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,vy)
      call fgslib_findpts_eval(ih_intp,s35pp,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35pm1)

      s35pbar=0.0
      s35wsum=0.0
      do s35i=1,s35ng
         s35pbar=s35pbar+s35gw(s35i)*s35pp(s35i)
         s35wsum=s35wsum+s35gw(s35i)
      enddo
      s35pbar=s35pbar/max(s35wsum,1.0e-30)

      s35roa=s35rs/max(s35a,1.0e-30)
      s35aor=s35a/max(s35rs,1.0e-30)

      do s35n=1,3
         s35sp=0.0
         s35su=0.0
         do s35i=1,s35ng
            s35x=s35gx(s35i)
            s35w=s35gw(s35i)
            s35st=sqrt(max(0.0,1.0-s35x*s35x))
            call s35ad_y0(s35n,s35x,s35y,s35dy)
            s35uth=-s35uz(s35i)*s35st+s35ur(s35i)*s35x
            s35sp=s35sp+
     $         2.0*s35pi*s35w*s35y*(s35pp(s35i)-s35pbar)
            s35su=s35su+
     $         2.0*s35pi*s35w*s35dy*s35uth
         enddo

         s35fn=float(s35n)
         s35ap=(1.0-0.5*s35fn*(2.0*s35fn-1.0)
     $      /(s35fn+1.0)*s35aor**(2*s35n+1))*s35roa**s35n
         s35bp=-(s35fn*(2.0*s35fn-1.0)*(2.0*s35fn+1.0)
     $      /(s35fn+1.0))*s35aor**(s35n+1)

         s35gn=2.0*(s35fn+3.0)/(2.0*s35fn+3.0)
         s35hn=s35fn-2.0-s35fn*(2.0*s35fn+1.0)
     $      /(2.0*s35fn+3.0)*s35aor**2
         s35au=0.25*s35fn*
     $      (s35gn+s35hn*s35aor**(2*s35n+1))
     $      *s35roa**(s35n+1)

         s35gn=s35fn+1.0
         s35hn=0.5*((s35fn-2.0)*(2.0*s35fn+1.0)
     $      *s35roa**2-s35fn*(2.0*s35fn-1.0))
         s35bu=s35fn*
     $      (s35gn+s35hn*s35aor**(2*s35n+1))
     $      *s35roa**(s35n-1)

         s35det=s35ap*s35bu-s35au*s35bp
         s35ps=(s35a*s35a/(s35mu*s35nu))*s35sp
         s35us=(s35a/s35nu)*s35su

         if (abs(s35det).le.1.0e-30) then
            if (nid.eq.0) write(6,'(A,I4)')
     $         'S35AD FATAL singular Lamb mode n=',s35n
            call exitt
         endif

         s35pr8(s35n)=
     $      (s35ps*s35bu-s35us*s35bp)/s35det
         s35fr8(s35n)=
     $      (s35ap*s35us-s35au*s35ps)/s35det

         s35blend=beta_coeff
         s35p8(s35n)=(1.0-s35blend)*s35p8(s35n)
     $      +s35blend*s35pr8(s35n)
         s35f8(s35n)=(1.0-s35blend)*s35f8(s35n)
     $      +s35blend*s35fr8(s35n)
      enddo

      if (nid.eq.0 .and.
     $   (istep.eq.1 .or. mod(istep,1000).eq.0)) then
         s35fu=977
         if (istep.eq.1) then
            open(s35fu,file='stage35AD_coeff8.dat',
     $           status='replace')
            write(s35fu,'(A)')
     $       '# step time n Praw Phiraw Pcommit Phicommit'
         else
            open(s35fu,file='stage35AD_coeff8.dat',
     $           status='unknown',position='append')
         endif
         do s35n=1,3
            write(s35fu,'(I10,1x,1p6e22.13)') istep,time,
     $         float(s35n),s35pr8(s35n),s35fr8(s35n),
     $         s35p8(s35n),s35f8(s35n)
         enddo
         close(s35fu)
      endif

      return
      end


      subroutine s35ad_axisym8_vel(s35rx,s35ry,s35rz,
     $ s35rr,s35a,s35nu,s35ux,s35uy,s35uz)
      real s35rx,s35ry,s35rz,s35rr,s35a,s35nu
      real s35ux,s35uy,s35uz
      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real s35ct,s35st,s35rho,s35cp,s35sp
      real s35roa,s35y,s35dy,s35fn
      real s35au1,s35au2,s35au3
      real s35bu1,s35bu2,s35bu3
      real s35pr,s35pt,s35fr,s35ft
      real s35ur,s35ut,s35up
      integer s35n

      s35ux=0.0
      s35uy=0.0
      s35uz=0.0
      if (s35rr.le.1.0e-30) return

      s35ct=s35rz/s35rr
      s35rho=sqrt(s35rx*s35rx+s35ry*s35ry)
      s35st=s35rho/s35rr
      if (s35rho.gt.1.0e-30) then
         s35cp=s35rx/s35rho
         s35sp=s35ry/s35rho
      else
         s35cp=1.0
         s35sp=0.0
      endif
      s35roa=s35rr/max(s35a,1.0e-30)
      s35ur=0.0
      s35ut=0.0

      do s35n=1,3
         s35fn=float(s35n)
         call s35ad_y0(s35n,s35ct,s35y,s35dy)

         s35au1=s35fn*(s35fn+3.0)
     $      /(2.0*(2.0*s35fn+3.0))*s35roa**(s35n+1)
         s35au2=0.25*s35fn*(s35fn-2.0)*s35roa**(-s35n)
         s35au3=-0.25*s35fn*s35fn*(2.0*s35fn+1.0)
     $      /(2.0*s35fn+3.0)*s35roa**(-(s35n+2))

         s35pr=(s35nu/s35a)*
     $      (s35au1/(s35fn+3.0)
     $      +s35au3/(-s35fn))*s35p8(s35n)
         s35pt=(s35nu/s35a)*
     $      (s35au1/(s35fn*(s35fn+1.0))
     $      +s35au3/(s35fn*(s35fn+1.0)))
     $      *s35p8(s35n)

         if (s35n.eq.2) then
            s35pr=s35pr-(s35nu/s35a)*0.25*s35fn
     $         *s35roa**(-s35n)*s35p8(s35n)
         else if (abs(s35au2).gt.1.0e-30) then
            s35pr=s35pr+(s35nu/s35a)*
     $         s35au2/(-s35fn+2.0)*s35p8(s35n)
            s35pt=s35pt+(s35nu/s35a)*
     $         s35au2/(s35fn*(s35fn+1.0))*s35p8(s35n)
         endif

         s35bu1=s35fn*(s35fn+1.0)*s35roa**(s35n-1)
         s35bu2=0.5*s35fn*(s35fn-2.0)*(2.0*s35fn+1.0)
     $      *s35roa**(-s35n)
         s35bu3=-0.5*s35fn*s35fn*(2.0*s35fn-1.0)
     $      *s35roa**(-(s35n+2))

         s35fr=(s35nu/s35a)*
     $      (s35bu1/(s35fn+1.0)
     $      +s35bu3/(-s35fn))*s35f8(s35n)
         s35ft=(s35nu/s35a)*
     $      (s35bu1/(s35fn*(s35fn+1.0))
     $      +s35bu3/(s35fn*(s35fn+1.0)))
     $      *s35f8(s35n)

         if (s35n.eq.2) then
            s35fr=s35fr-(s35nu/s35a)*0.5*s35fn
     $         *(2.0*s35fn+1.0)*s35roa**(-s35n)
     $         *s35f8(s35n)
         else if (abs(s35bu2).gt.1.0e-30) then
            s35fr=s35fr+(s35nu/s35a)*
     $         s35bu2/(-s35fn+2.0)*s35f8(s35n)
            s35ft=s35ft+(s35nu/s35a)*
     $         s35bu2/(s35fn*(s35fn+1.0))*s35f8(s35n)
         endif

         s35ur=s35ur+(s35pr+s35fr)*s35y
         s35ut=s35ut+(s35pt+s35ft)*s35dy
      enddo

      s35up=s35ur*s35st+s35ut*s35ct
      s35ux=s35up*s35cp
      s35uy=s35up*s35sp
      s35uz=s35ur*s35ct-s35ut*s35st
      return
      end

      subroutine s35ad_axisym8_press(s35rx,s35ry,s35rz,
     $ s35rr,s35a,s35ptil)
      include 'SIZE'
      include 'TOTAL'
      real s35rx,s35ry,s35rz,s35rr,s35a,s35ptil
      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real s35rho,s35mu,s35nu,s35roa,s35aor
      real s35ct,s35y,s35dy,s35fn,s35ap,s35bp,s35pl
      integer s35n

      s35ptil=0.0
      if (s35rr.le.1.0e-30) return
      s35rho=max(abs(param(1)),1.0e-30)
      s35mu=abs(param(2))
      s35nu=s35mu/s35rho
      s35roa=s35rr/max(s35a,1.0e-30)
      s35aor=s35a/max(s35rr,1.0e-30)
      s35ct=s35rz/s35rr
      s35pl=0.0

      do s35n=1,3
         s35fn=float(s35n)
         call s35ad_y0(s35n,s35ct,s35y,s35dy)
         s35ap=(1.0-0.5*s35fn*(2.0*s35fn-1.0)
     $      /(s35fn+1.0)*s35aor**(2*s35n+1))*s35roa**s35n
         s35bp=-(s35fn*(2.0*s35fn-1.0)*(2.0*s35fn+1.0)
     $      /(s35fn+1.0))*s35aor**(s35n+1)
         s35pl=s35pl+
     $      (s35ap*s35p8(s35n)+s35bp*s35f8(s35n))*s35y
      enddo
      s35ptil=(s35mu*s35nu/(s35a*s35a))*s35pl
      return
      end

      subroutine s35ad_write_cv_force
      include 'SIZE'
      include 'TOTAL'

      integer s35ng
      parameter(s35ng=128)
      real s35g(s35ng),s35w(s35ng)
      real s35x(s35ng),s35y(s35ng),s35z(s35ng)
      real s35uz(s35ng),s35ur(s35ng),s35p(s35ng)
      real s35uzxq(s35ng),s35uzrq(s35ng)
      real s35urzq(s35ng),s35urrq(s35ng)

      real s35uzx(lx1,ly1,lz1,lelt)
      real s35uzr(lx1,ly1,lz1,lelt)
      real s35urz(lx1,ly1,lz1,lelt)
      real s35urr(lx1,ly1,lz1,lelt)
      real s35dum(lx1,ly1,lz1,lelt)
      common /s35ad_grad/ s35uzx,s35uzr,s35urz,
     $ s35urr,s35dum

      real s35pm(lx1,ly1,lz1,lelt)
      real s35pw1(lx1,ly1,lz1,lelt)
      real s35pw2(lx1,ly1,lz1,lelt)

      real s35rst(ldim,s35ng),s35dist(s35ng)
      integer s35rc(s35ng),s35proc(s35ng),s35el(s35ng)
      integer s35ih,npp,nidd,nekcomm,nekgroup,nekreal
      common /nekmpi/ nidd,npp,nekcomm,nekgroup,nekreal

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a

      real s35q,s35rs,s35rho,s35mu,s35pi,s35tol
      real s35nz,s35nr,s35sz,s35sr,s35tz,s35un,s35cz
      real s35fac,s35fs,s35fc,s35fcv,s35pbar,s35wsum
      real s35den,s35cds,s35cdc,s35cdcv
      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8
      real s35nu,s35n0,s35hl,s35fl,s35cdl,s35cdls
      integer s35i,s35ltot,s35nf,s35nfg,s35fu

      call s35ad_gl128_init(s35g,s35w)
c     CV radius follows the harmonic sampling radius q/a.
      s35q=r_sample_over_a
      s35rs=phys_a*s35q
      s35rho=max(abs(param(1)),1.0e-30)
      s35mu=abs(param(2))
      s35pi=4.0*atan(1.0)

      do s35i=1,s35ng
         s35x(s35i)=phys_zp+s35rs*s35g(s35i)
         s35y(s35i)=s35rs*
     $      sqrt(max(0.0,1.0-s35g(s35i)*s35g(s35i)))
         s35z(s35i)=0.0
      enddo

      call gradm1(s35uzx,s35uzr,s35dum,vx)
      call gradm1(s35urz,s35urr,s35dum,vy)

      s35ltot=lx1*ly1*lz1*nelt
      if (lx2.ne.lx1) then
         call mappr(s35pm,pr,s35pw1,s35pw2)
      else
         call copy(s35pm,pr,s35ltot)
      endif

      s35tol=5.0e-13
      call fgslib_findpts_setup(s35ih,nekcomm,npp,ldim,
     $ xm1,ym1,zm1,lx1,ly1,lz1,nelt,
     $ 2*lx1,2*ly1,2*lz1,0.01,
     $ s35ltot,s35ltot,256,s35tol)

      call fgslib_findpts(s35ih,s35rc,1,s35proc,1,
     $ s35el,1,s35rst,ldim,s35dist,1,
     $ s35x,1,s35y,1,s35z,1,s35ng)

      s35nf=0
      do s35i=1,s35ng
         if (s35rc(s35i).ge.2) s35nf=s35nf+1
      enddo
      s35nfg=iglsum(s35nf,1)
      if (s35nfg.gt.0) then
         if (nid.eq.0) write(6,'(A,I8)')
     $      'S35AL native CV findpts failures=',s35nfg
         call exitt
      endif

      call fgslib_findpts_eval(s35ih,s35uz,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,vx)
      call fgslib_findpts_eval(s35ih,s35ur,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,vy)
      call fgslib_findpts_eval(s35ih,s35p,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35pm)
      call fgslib_findpts_eval(s35ih,s35uzxq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35uzx)
      call fgslib_findpts_eval(s35ih,s35uzrq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35uzr)
      call fgslib_findpts_eval(s35ih,s35urzq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35urz)
      call fgslib_findpts_eval(s35ih,s35urrq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35urr)

      s35pbar=0.0
      s35wsum=0.0
      do s35i=1,s35ng
         s35pbar=s35pbar+s35w(s35i)*s35p(s35i)
         s35wsum=s35wsum+s35w(s35i)
      enddo
      s35pbar=s35pbar/max(s35wsum,1.0e-30)

      s35fs=0.0
      s35fc=0.0
      do s35i=1,s35ng
         s35nz=s35g(s35i)
         s35nr=sqrt(max(0.0,1.0-s35nz*s35nz))
         s35sz=-(s35p(s35i)-s35pbar)
     $      +2.0*s35mu*s35uzxq(s35i)
         s35sr=s35mu*(s35uzrq(s35i)+s35urzq(s35i))
         s35tz=s35sz*s35nz+s35sr*s35nr
         s35un=s35uz(s35i)*s35nz+s35ur(s35i)*s35nr
         s35cz=s35rho*s35uz(s35i)*s35un
         s35fac=2.0*s35pi*s35rs*s35rs*s35w(s35i)
         s35fs=s35fs+s35fac*s35tz
         s35fc=s35fc+s35fac*s35cz
      enddo
      s35fcv=s35fs-s35fc

      s35den=0.5*s35rho*cfg_flow(3)*cfg_flow(3)
     $   *(s35pi*(2.0*phys_a)**2/4.0)
      s35cds=s35fs/max(s35den,1.0e-30)
      s35cdc=s35fc/max(s35den,1.0e-30)
      s35cdcv=s35fcv/max(s35den,1.0e-30)

      if (nid.eq.0) then
         s35fu=978
         if (istep.eq.1) then
            open(s35fu,file='stage35AD_cv_drag.dat',
     $           status='replace')
            write(s35fu,'(A)')
     $       '# common CV-GL128: step time Cd_s Cd_c Cd_CV Fs Fc Fcv'
         else
            open(s35fu,file='stage35AD_cv_drag.dat',
     $           status='unknown',position='append')
         endif
         write(s35fu,'(I10,1x,1p7e22.13)') istep,time,
     $      s35cds,s35cdc,s35cdcv,s35fs,s35fc,s35fcv
         close(s35fu)
      endif

c     Stage35AR force pair.  Lamb force comes directly from the
c     high-N axisymmetric coefficient state, not legacy arrays.
      s35nu=s35mu/s35rho
      s35n0=sqrt(3.0/(4.0*s35pi))
      s35hl=s35p8(1)+6.0*s35f8(1)
      s35fl=s35pi*s35mu*s35nu*s35n0*s35hl
      s35cdls=s35fl/max(s35den,1.0e-30)
      s35cdl=abs(s35cdls)

      if (nid.eq.0) then
         s35fu=976
         if (istep.eq.1) then
            open(s35fu,file='stage35AR_forces.dat',
     $           status='replace')
            write(s35fu,'(A)')
     $ '# step time Cd_CV Cd_Lamb_abs Cd_Lamb_signed H10 '//
     $ 'P10 Phi10 Cd_stress Cd_conv F_CV F_Lamb'
         else
            open(s35fu,file='stage35AR_forces.dat',
     $           status='unknown',position='append')
         endif
         write(s35fu,'(I10,1x,1p11e22.13)') istep,time,
     $      s35cdcv,s35cdl,s35cdls,s35hl,s35p8(1),
     $      s35f8(1),s35cds,s35cdc,s35fcv,s35fl
         close(s35fu)
      endif

      call fgslib_findpts_free(s35ih)
      return
      end


      subroutine s35al_write_cv_force_ref128
      include 'SIZE'
      include 'TOTAL'

      integer s35ng
      parameter(s35ng=128)
      real s35g(s35ng),s35w(s35ng)
      real s35x(s35ng),s35y(s35ng),s35z(s35ng)
      real s35uz(s35ng),s35ur(s35ng),s35p(s35ng)
      real s35uzxq(s35ng),s35uzrq(s35ng)
      real s35urzq(s35ng),s35urrq(s35ng)

      real s35uzx(lx1,ly1,lz1,lelt)
      real s35uzr(lx1,ly1,lz1,lelt)
      real s35urz(lx1,ly1,lz1,lelt)
      real s35urr(lx1,ly1,lz1,lelt)
      real s35dum(lx1,ly1,lz1,lelt)
      common /s35ad_grad/ s35uzx,s35uzr,s35urz,
     $ s35urr,s35dum

      real s35pm(lx1,ly1,lz1,lelt)
      real s35pw1(lx1,ly1,lz1,lelt)
      real s35pw2(lx1,ly1,lz1,lelt)

      real s35rst(ldim,s35ng),s35dist(s35ng)
      integer s35rc(s35ng),s35proc(s35ng),s35el(s35ng)
      integer s35ih,npp,nidd,nekcomm,nekgroup,nekreal
      common /nekmpi/ nidd,npp,nekcomm,nekgroup,nekreal

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a

      real s35q,s35rs,s35rho,s35mu,s35pi,s35tol
      real s35nz,s35nr,s35sz,s35sr,s35tz,s35un,s35cz
      real s35fac,s35fs,s35fc,s35fcv,s35pbar,s35wsum
      real s35den,s35cds,s35cdc,s35cdcv
      integer s35i,s35ltot,s35nf,s35nfg,s35fu

      call s35ad_gl128_init(s35g,s35w)
c     CV radius follows the harmonic sampling radius q/a.
      s35q=r_sample_over_a
      s35rs=phys_a*s35q
      s35rho=max(abs(param(1)),1.0e-30)
      s35mu=abs(param(2))
      s35pi=4.0*atan(1.0)

      do s35i=1,s35ng
         s35x(s35i)=phys_zp+s35rs*s35g(s35i)
         s35y(s35i)=s35rs*
     $      sqrt(max(0.0,1.0-s35g(s35i)*s35g(s35i)))
         s35z(s35i)=0.0
      enddo

      call gradm1(s35uzx,s35uzr,s35dum,vx)
      call gradm1(s35urz,s35urr,s35dum,vy)

      s35ltot=lx1*ly1*lz1*nelt
      if (lx2.ne.lx1) then
         call mappr(s35pm,pr,s35pw1,s35pw2)
      else
         call copy(s35pm,pr,s35ltot)
      endif

      s35tol=5.0e-13
      call fgslib_findpts_setup(s35ih,nekcomm,npp,ldim,
     $ xm1,ym1,zm1,lx1,ly1,lz1,nelt,
     $ 2*lx1,2*ly1,2*lz1,0.01,
     $ s35ltot,s35ltot,256,s35tol)

      call fgslib_findpts(s35ih,s35rc,1,s35proc,1,
     $ s35el,1,s35rst,ldim,s35dist,1,
     $ s35x,1,s35y,1,s35z,1,s35ng)

      s35nf=0
      do s35i=1,s35ng
         if (s35rc(s35i).ge.2) s35nf=s35nf+1
      enddo
      s35nfg=iglsum(s35nf,1)
      if (s35nfg.gt.0) then
         if (nid.eq.0) write(6,'(A,I8)')
     $      'S35AL ref128 CV findpts failures=',s35nfg
         call exitt
      endif

      call fgslib_findpts_eval(s35ih,s35uz,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,vx)
      call fgslib_findpts_eval(s35ih,s35ur,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,vy)
      call fgslib_findpts_eval(s35ih,s35p,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35pm)
      call fgslib_findpts_eval(s35ih,s35uzxq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35uzx)
      call fgslib_findpts_eval(s35ih,s35uzrq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35uzr)
      call fgslib_findpts_eval(s35ih,s35urzq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35urz)
      call fgslib_findpts_eval(s35ih,s35urrq,1,s35rc,1,
     $ s35proc,1,s35el,1,s35rst,ldim,s35ng,s35urr)

      s35pbar=0.0
      s35wsum=0.0
      do s35i=1,s35ng
         s35pbar=s35pbar+s35w(s35i)*s35p(s35i)
         s35wsum=s35wsum+s35w(s35i)
      enddo
      s35pbar=s35pbar/max(s35wsum,1.0e-30)

      s35fs=0.0
      s35fc=0.0
      do s35i=1,s35ng
         s35nz=s35g(s35i)
         s35nr=sqrt(max(0.0,1.0-s35nz*s35nz))
         s35sz=-(s35p(s35i)-s35pbar)
     $      +2.0*s35mu*s35uzxq(s35i)
         s35sr=s35mu*(s35uzrq(s35i)+s35urzq(s35i))
         s35tz=s35sz*s35nz+s35sr*s35nr
         s35un=s35uz(s35i)*s35nz+s35ur(s35i)*s35nr
         s35cz=s35rho*s35uz(s35i)*s35un
         s35fac=2.0*s35pi*s35rs*s35rs*s35w(s35i)
         s35fs=s35fs+s35fac*s35tz
         s35fc=s35fc+s35fac*s35cz
      enddo
      s35fcv=s35fs-s35fc

      s35den=0.5*s35rho*cfg_flow(3)*cfg_flow(3)
     $   *(s35pi*(2.0*phys_a)**2/4.0)
      s35cds=s35fs/max(s35den,1.0e-30)
      s35cdc=s35fc/max(s35den,1.0e-30)
      s35cdcv=s35fcv/max(s35den,1.0e-30)

      if (nid.eq.0) then
         s35fu=979
         if (istep.eq.1) then
            open(s35fu,file='stage35AL_cv_drag_ref128.dat',
     $           status='replace')
            write(s35fu,'(A)')
     $       '# GL128 ref: step time Cd_s Cd_c Cd_CV Fs Fc Fcv'
         else
            open(s35fu,file='stage35AL_cv_drag_ref128.dat',
     $           status='unknown',position='append')
         endif
         write(s35fu,'(I10,1x,1p7e22.13)') istep,time,
     $      s35cds,s35cdc,s35cdcv,s35fs,s35fc,s35fcv
         close(s35fu)
      endif

      call fgslib_findpts_free(s35ih)
      return
      end

      subroutine s35ad_selftest
c     Analytic n=3 sanity test of the axisym high-N evaluator.
c     Called before physalis_update_particle_state on first userchk.
c     Therefore use cfg_radius, which validation_config already set.
      include 'SIZE'
      include 'TOTAL'

      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a

      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real s35rr,s35ct,s35st,s35rx,s35rz
      real s35rho,s35mu,s35nu,s35ux,s35uy,s35uz,s35pt
      real s35err,s35refx,s35refz,s35refp
      real s35atest,s35vscale,s35pscale
      integer s35n

      s35atest=abs(cfg_radius)
      if (s35atest.le.1.0e-30) then
         if (nid.eq.0) write(6,*)
     $      'S35AD FATAL selftest cfg_radius not initialized'
         call exitt
      endif

      s35rho=max(abs(param(1)),1.0e-30)
      s35mu=abs(param(2))
      s35nu=s35mu/s35rho

      do s35n=1,8
         s35p8(s35n)=0.0
         s35f8(s35n)=0.0
         s35pr8(s35n)=0.0
         s35fr8(s35n)=0.0
      enddo

      s35p8(3)=1.234
      s35f8(3)=-0.456
      s35rr=1.03*s35atest
      s35ct=0.37
      s35st=sqrt(1.0-s35ct*s35ct)
      s35rx=s35rr*s35st
      s35rz=s35rr*s35ct

      call s35ad_axisym8_vel(s35rx,0.0,s35rz,s35rr,
     $   s35atest,s35nu,s35ux,s35uy,s35uz)
      call s35ad_axisym8_press(s35rx,0.0,s35rz,s35rr,
     $   s35atest,s35pt)

c     Base references: a=.005, rho=1, mu=1e-4,
c     P30=1.234, Phi30=-0.456.
      s35vscale=(s35nu/1.0e-4)*(0.005/s35atest)
      s35pscale=(s35mu*s35nu/1.0e-8)
     $   *(0.005/s35atest)**2

      s35refx=-1.1012176229944176e-04*s35vscale
      s35refz= 5.2336412795869190e-04*s35vscale
      s35refp=-1.2696295806200715e-03*s35pscale

      s35err=max(abs(s35ux-s35refx),
     $           abs(s35uz-s35refz))
      s35err=max(s35err,abs(s35pt-s35refp))

c     Return to zero.  Restart state is restored later by the sidecar hook.
      do s35n=1,8
         s35p8(s35n)=0.0
         s35f8(s35n)=0.0
         s35pr8(s35n)=0.0
         s35fr8(s35n)=0.0
      enddo

      if (s35err.gt.1.0e-11) then
         if (nid.eq.0) write(6,'(A,1p4e18.9)')
     $      'S35AD FATAL selftest err/u/z/p=',
     $      s35err,s35ux,s35uz,s35pt
         call exitt
      endif

      if (nid.eq.0) write(6,'(A,1p3e14.5)')
     $   'S35AD axisym8 selftest PASS err/a/nu=',
     $   s35err,s35atest,s35nu

      return
      end



c-----------------------------------------------------------------------
c     STAGE35AI exact solver-history restart sidecar.
c     This promotes the already-used inner-replay state to disk so the
c     first true continuation starts from the same Nek temporal state.
      subroutine s35ai_corestate_write
      include 'SIZE'
      include 'TOTAL'
      integer npp,nidd,nekcomm,nekgroup,nekreal
      common /nekmpi/ nidd,npp,nekcomm,nekgroup,nekreal
      integer s35u,s35n1,s35n2
      character*96 s35name
      character*16 s35magic

      s35n1=lx1*ly1*lz1*nelv
      s35n2=lx2*ly2*lz2*nelv
      write(s35name,'(A,I9.9,A,I6.6,A)')
     $ 's35ai_core_step',istep,'_rank',nid,'.bin'
      s35u=980
      open(s35u,file=s35name,status='replace',
     $     form='unformatted')
      s35magic='S35AI_CORE_V1'
      write(s35u) s35magic
      write(s35u) istep,time,npp,nid,nelv
      call s35ai_write_i(s35u,lglel,nelv)
      call s35ai_write_r(s35u,dtlag,10)
      call s35ai_write_r(s35u,vx,s35n1)
      call s35ai_write_r(s35u,vy,s35n1)
      call s35ai_write_r(s35u,vz,s35n1)
      call s35ai_write_r(s35u,pr,s35n2)
      call s35ai_write_r(s35u,vxlag,s35n1*(lorder-1))
      call s35ai_write_r(s35u,vylag,s35n1*(lorder-1))
      call s35ai_write_r(s35u,vzlag,s35n1*(lorder-1))
      call s35ai_write_r(s35u,prlag,s35n2*lorder2)
      call s35ai_write_r(s35u,abx1,s35n1)
      call s35ai_write_r(s35u,aby1,s35n1)
      call s35ai_write_r(s35u,abz1,s35n1)
      call s35ai_write_r(s35u,abx2,s35n1)
      call s35ai_write_r(s35u,aby2,s35n1)
      call s35ai_write_r(s35u,abz2,s35n1)
      call s35ai_write_r(s35u,bm1lag,s35n1*(lorder-1))
      call s35ai_write_r(s35u,v1mask,s35n1)
      call s35ai_write_r(s35u,v2mask,s35n1)
      call s35ai_write_r(s35u,v3mask,s35n1)
      close(s35u)
      return
      end
c-----------------------------------------------------------------------
      subroutine s35ai_corestate_read
      include 'SIZE'
      include 'TOTAL'
      integer npp,nidd,nekcomm,nekgroup,nekreal
      common /nekmpi/ nidd,npp,nekcomm,nekgroup,nekreal
      integer s35u,s35n1,s35n2,s35ios
      integer s35step,s35np,s35nid,s35nelv,s35i
      integer s35bad,s35badg,s35igl(lelt)
      real s35time,s35terr
      character*96 s35name
      character*16 s35magic

      write(s35name,'(A,I6.6,A)')
     $ 's35ai_core_rank',nid,'.bin'
      s35u=981
      open(s35u,file=s35name,status='old',
     $     form='unformatted',iostat=s35ios)
      if (s35ios.ne.0) then
         write(6,*) 'S35AI FATAL cannot open core state ',s35name
         call exitt
      endif
      read(s35u,iostat=s35ios) s35magic
      if (s35ios.ne.0 .or. s35magic.ne.'S35AI_CORE_V1') then
         write(6,*) 'S35AI FATAL bad core-state header ',s35name
         call exitt
      endif
      read(s35u,iostat=s35ios)
     $ s35step,s35time,s35np,s35nid,s35nelv
      if (s35ios.ne.0) then
         write(6,*) 'S35AI FATAL bad core-state metadata'
         call exitt
      endif
      if (s35nelv.gt.lelt .or. s35nelv.lt.1) then
         write(6,*) 'S35AI FATAL bad saved nelv ',s35nelv
         call exitt
      endif
      call s35ai_read_i(s35u,s35igl,s35nelv)

      s35bad=0
      if (s35np.ne.npp) s35bad=1
      if (s35nid.ne.nid) s35bad=1
      if (s35nelv.ne.nelv) s35bad=1
      if (s35bad.eq.0) then
         do s35i=1,nelv
            if (s35igl(s35i).ne.lglel(s35i)) s35bad=1
         enddo
      endif
      s35badg=iglsum(s35bad,1)
      if (s35badg.ne.0) then
         if (nid.eq.0) write(6,*)
     $    'S35AI FATAL MPI/decomposition differs from saved state'
         call exitt
      endif

      s35terr=abs(s35time-time)
      if (s35terr.gt.1.0e-12*max(1.0,abs(time))) then
         if (nid.eq.0) write(6,*)
     $    'S35AI FATAL field/core times differ ',time,s35time
         call exitt
      endif

      s35n1=lx1*ly1*lz1*nelv
      s35n2=lx2*ly2*lz2*nelv
      call s35ai_read_r(s35u,dtlag,10)
      call s35ai_read_r(s35u,vx,s35n1)
      call s35ai_read_r(s35u,vy,s35n1)
      call s35ai_read_r(s35u,vz,s35n1)
      call s35ai_read_r(s35u,pr,s35n2)
      call s35ai_read_r(s35u,vxlag,s35n1*(lorder-1))
      call s35ai_read_r(s35u,vylag,s35n1*(lorder-1))
      call s35ai_read_r(s35u,vzlag,s35n1*(lorder-1))
      call s35ai_read_r(s35u,prlag,s35n2*lorder2)
      call s35ai_read_r(s35u,abx1,s35n1)
      call s35ai_read_r(s35u,aby1,s35n1)
      call s35ai_read_r(s35u,abz1,s35n1)
      call s35ai_read_r(s35u,abx2,s35n1)
      call s35ai_read_r(s35u,aby2,s35n1)
      call s35ai_read_r(s35u,abz2,s35n1)
      call s35ai_read_r(s35u,bm1lag,s35n1*(lorder-1))
      call s35ai_read_r(s35u,v1mask,s35n1)
      call s35ai_read_r(s35u,v2mask,s35n1)
      call s35ai_read_r(s35u,v3mask,s35n1)
      close(s35u)

      if (nid.eq.0) then
         open(982,file='STAGE35AI_CORESTATE_RESTORED',
     $        status='replace',form='formatted')
         write(982,'(A,I10,1pE22.13)')
     $    'source_step_time ',s35step,s35time
         close(982)
         write(6,'(A,I10,1pE18.9)')
     $    'S35AI restored exact solver state step/time=',
     $    s35step,s35time
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine s35ai_write_r(s35u,s35a,s35n)
      integer s35u,s35n,s35i
      real s35a(*)
      write(s35u) (s35a(s35i),s35i=1,s35n)
      return
      end
c-----------------------------------------------------------------------
      subroutine s35ai_read_r(s35u,s35a,s35n)
      integer s35u,s35n,s35i
      real s35a(*)
      read(s35u) (s35a(s35i),s35i=1,s35n)
      return
      end
c-----------------------------------------------------------------------
      subroutine s35ai_write_i(s35u,s35a,s35n)
      integer s35u,s35n,s35i,s35a(*)
      write(s35u) (s35a(s35i),s35i=1,s35n)
      return
      end
c-----------------------------------------------------------------------
      subroutine s35ai_read_i(s35u,s35a,s35n)
      integer s35u,s35n,s35i,s35a(*)
      read(s35u) (s35a(s35i),s35i=1,s35n)
      return
      end
c-----------------------------------------------------------------------

      subroutine s35ad_restart_field_hook
c     Optional full-restart replay.  Presence of STAGE35AD_RESTART_ON
c     enables the three-file Nek full_restart sequence.
      include 'SIZE'
      include 'TOTAL'
      character*80 s35fn(3)
      logical s35ex
      integer s35active
      common /s35ad_restart_i/ s35active

      inquire(file='STAGE35AD_RESTART_ON',exist=s35ex)
      if (.not.s35ex) then
         s35active=0
         return
      endif

      s35active=1
      if (istep.le.2) then
         call blank(s35fn,3*80)
         s35fn(1)='s35ad_rs1.fld'
         s35fn(2)='s35ad_rs2.fld'
         s35fn(3)='s35ad_rs3.fld'
         call full_restart(s35fn,3)
      endif
      return
      end


      subroutine s35ad_restart_state_hook
c     Restore the Physalis state corresponding to the full-restart field
c     replayed at local istep=0,1,2.
      include 'SIZE'
      include 'TOTAL'
      integer s35active,s35slot
      common /s35ad_restart_i/ s35active
      character*80 s35name

      if (s35active.ne.1) return
      if (istep.gt.2) return

      s35slot=istep+1
      if (s35slot.eq.1) s35name='s35ad_state1.dat'
      if (s35slot.eq.2) s35name='s35ad_state2.dat'
      if (s35slot.eq.3) s35name='s35ad_state3.dat'
      call s35ad_state_read(s35name)

c     Stage35AI: after the third full-restart field is loaded, replace
c     reconstructed Nek temporal history with the exact source state.
      if (istep.eq.2) call s35ai_corestate_read

c     For replay steps 1 and 2, the ordinary startup block no longer runs.
c     Rebuild dynamic targets explicitly from the restored state so that
c     the next computed step sees the exact U8/P8 cage state.
      if (istep.gt.0) then
         call physalis_update_particle_state
         call physalis_reconstruct_velocity_cage
         call physalis_reconstruct_pressure_cage
         call stage24_apply_target_mode
         call physalis_update_velocity_cage_residual
      endif

      return
      end


      subroutine s35ad_restart_save_hook
c     Save Nek temporal-history files and matching small Physalis sidecars.
c     The default full-restart interval is 10000 steps.  A short smoke run
c     can override it with a single integer in STAGE35AD_FULLRST_INTERVAL.
      include 'SIZE'
      include 'TOTAL'
      integer s35int,s35mt,s35ios,s35active
      common /s35ad_restart_i/ s35active
      logical s35ex
      character*80 s35name

      if (s35active.eq.1 .and. istep.le.2) return

      s35int=10000
      inquire(file='STAGE35AD_FULLRST_INTERVAL',exist=s35ex)
      if (s35ex) then
         open(991,file='STAGE35AD_FULLRST_INTERVAL',
     $        status='old',form='formatted',iostat=s35ios)
         if (s35ios.eq.0) then
            read(991,*,iostat=s35ios) s35int
            close(991)
         endif
      endif
      if (s35int.lt.3) s35int=3

c     Same three-step save window used by full_restart_save with the
c     default nfld_save=3.
      s35mt=mod(istep+s35int,s35int)
      if (istep.gt.s35int/2 .and. s35mt.lt.3
     $    .and. lastep.ne.1) then
         write(s35name,'(A,I9.9,A)')
     $      's35ad_state_step',istep,'.dat'
         call s35ad_state_write(s35name)
         call s35ai_corestate_write
      endif

      call full_restart_save(s35int)
      return
      end


      subroutine s35ad_state_write(s35name)
      include 'SIZE'
      include 'TOTAL'
      character*(*) s35name
      integer phmax
      parameter(phmax=2*lorder-1)

      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,
     $ v_re_old,v_im_old

      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax)
      real ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      integer ph_initialized,ph_count
      common /physalis_history_i/ ph_initialized,ph_count

      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer phys_pressure_ref_step
      common /physalis_pressure_reference_i/
     $ phys_pressure_ref_step

      if (nid.ne.0) return

      open(992,file=s35name,status='replace',form='formatted')
      write(992,'(A)') 'S35AD_STATE_V1'
      write(992,*) istep,time
      write(992,*) s35p8
      write(992,*) s35f8
      write(992,*) s35pr8
      write(992,*) s35fr8

      write(992,*) p_re
      write(992,*) p_im
      write(992,*) phi_re
      write(992,*) phi_im
      write(992,*) v_re
      write(992,*) v_im
      write(992,*) p_re_old
      write(992,*) p_im_old
      write(992,*) phi_re_old
      write(992,*) phi_im_old
      write(992,*) v_re_old
      write(992,*) v_im_old

      write(992,*) ph_x
      write(992,*) ph_w
      write(992,*) ph_acc
      write(992,*) ph_pr
      write(992,*) ph_pi
      write(992,*) ph_fr
      write(992,*) ph_fi
      write(992,*) ph_vr
      write(992,*) ph_vi
      write(992,*) ph_pref
      write(992,*) ph_initialized,ph_count
      write(992,*) phys_pressure_ref,phys_pressure_ref_step
      close(992)

      return
      end


      subroutine s35ad_state_read(s35name)
      include 'SIZE'
      include 'TOTAL'
      character*(*) s35name
      character*32 s35magic
      integer phmax,s35ios,s35srcstep
      real s35srctime
      parameter(phmax=2*lorder-1)

      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,
     $ v_re_old,v_im_old

      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax)
      real ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      integer ph_initialized,ph_count
      common /physalis_history_i/ ph_initialized,ph_count

      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer phys_pressure_ref_step
      common /physalis_pressure_reference_i/
     $ phys_pressure_ref_step

      open(993,file=s35name,status='old',form='formatted',
     $     iostat=s35ios)
      if (s35ios.ne.0) then
         write(6,*) 'S35AD FATAL cannot open state ',s35name
         call exitt
      endif

      read(993,'(A)',iostat=s35ios) s35magic
      if (s35ios.ne.0 .or.
     $    index(s35magic,'S35AD_STATE_V1').ne.1) then
         write(6,*) 'S35AD FATAL bad state header ',s35name
         call exitt
      endif

      read(993,*) s35srcstep,s35srctime
      read(993,*) s35p8
      read(993,*) s35f8
      read(993,*) s35pr8
      read(993,*) s35fr8

      read(993,*) p_re
      read(993,*) p_im
      read(993,*) phi_re
      read(993,*) phi_im
      read(993,*) v_re
      read(993,*) v_im
      read(993,*) p_re_old
      read(993,*) p_im_old
      read(993,*) phi_re_old
      read(993,*) phi_im_old
      read(993,*) v_re_old
      read(993,*) v_im_old

      read(993,*) ph_x
      read(993,*) ph_w
      read(993,*) ph_acc
      read(993,*) ph_pr
      read(993,*) ph_pi
      read(993,*) ph_fr
      read(993,*) ph_fi
      read(993,*) ph_vr
      read(993,*) ph_vi
      read(993,*) ph_pref
      read(993,*) ph_initialized,ph_count
      read(993,*) phys_pressure_ref,phys_pressure_ref_step
      close(993)

      if (nid.eq.0) write(6,'(A,I10,1pE18.9)')
     $   'S35AD restored Physalis state source step/time=',
     $   s35srcstep,s35srctime

      return
      end


      subroutine s35ad_write_signature
c     Cheap restart-smoke signature: global U and gauge-free P norms plus
c     the committed N=1..8 coefficient vector.
      include 'SIZE'
      include 'TOTAL'

      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real s35su2,s35sp,s35sp2,s35sw,s35w,s35pm
      real s35un,s35pn
      integer s35i,s35j,s35k,s35e,s35fu

      s35su2=0.0
      do s35e=1,nelv
      do s35k=1,lz1
      do s35j=1,ly1
      do s35i=1,lx1
         s35w=bm1(s35i,s35j,s35k,s35e)
         s35su2=s35su2+s35w*
     $      (vx(s35i,s35j,s35k,s35e)**2+
     $       vy(s35i,s35j,s35k,s35e)**2)
      enddo
      enddo
      enddo
      enddo
      s35su2=glsum(s35su2,1)

      s35sp=0.0
      s35sw=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         s35w=bm2(s35i,s35j,s35k,s35e)
         s35sp=s35sp+s35w*pr(s35i,s35j,s35k,s35e)
         s35sw=s35sw+s35w
      enddo
      enddo
      enddo
      enddo
      s35sp=glsum(s35sp,1)
      s35sw=glsum(s35sw,1)
      s35pm=s35sp/max(s35sw,1.0e-30)

      s35sp2=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         s35w=bm2(s35i,s35j,s35k,s35e)
         s35pn=pr(s35i,s35j,s35k,s35e)-s35pm
         s35sp2=s35sp2+s35w*s35pn*s35pn
      enddo
      enddo
      enddo
      enddo
      s35sp2=glsum(s35sp2,1)

      s35un=sqrt(max(s35su2,0.0))
      s35pn=sqrt(max(s35sp2,0.0))

      if (nid.eq.0) then
         s35fu=994
         if (istep.eq.0) then
            open(s35fu,file='stage35AD_signature.dat',
     $           status='replace')
            write(s35fu,'(A)')
     $       '# step time Unorm PmfNorm P1..P8 Phi1..Phi8'
         else
            open(s35fu,file='stage35AD_signature.dat',
     $           status='unknown',position='append')
         endif
         write(s35fu,'(I10,1x,1p19e22.13)') istep,time,
     $      s35un,s35pn,s35p8,s35f8
         close(s35fu)
      endif

      return
      end

c     Layered restart audit.
c       mode 1: immediately after Nek full_restart load
c       mode 2: immediately after Physalis sidecar restore
c       mode 3: after U8/P8 cage reconstruction
c       mode 4: source reference snapshot
c       mode 5: first continued step after replay
      include 'SIZE'
      include 'TOTAL'

      integer s35mode
      integer s35slot,s35fu,s35i,s35j,s35k,s35e
      integer s35ncu,s35ncp
      character*80 s35name
      real s35u2,s35uz2,s35ur2
      real s35psum,s35pwt,s35pm,s35p2,s35px,s35px2
      real s35pp,s35w
      real s35cu2,s35cp2,s35cpm,s35cpw
      real s35hs
      real s35tiny
      parameter(s35tiny=1.0e-300)

      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,
     $ v_re_old,v_im_old

      integer phmax
      parameter(phmax=2*lorder-1)
      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax)
      real ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      integer ph_initialized,ph_count
      common /physalis_history_i/ ph_initialized,ph_count

      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer phys_pressure_ref_step
      common /physalis_pressure_reference_i/
     $ phys_pressure_ref_step

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage

      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved

      integer phys_vmask_valid
      common /physalis_vmask_ctl/ phys_vmask_valid

c     Field signatures.
      s35uz2=0.0
      s35ur2=0.0
      do s35e=1,nelv
      do s35k=1,lz1
      do s35j=1,ly1
      do s35i=1,lx1
         s35w=bm1(s35i,s35j,s35k,s35e)
         s35uz2=s35uz2+s35w*vx(s35i,s35j,s35k,s35e)**2
         s35ur2=s35ur2+s35w*vy(s35i,s35j,s35k,s35e)**2
      enddo
      enddo
      enddo
      enddo
      s35uz2=glsum(s35uz2,1)
      s35ur2=glsum(s35ur2,1)
      s35u2=s35uz2+s35ur2

      s35psum=0.0
      s35pwt=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         s35w=bm2(s35i,s35j,s35k,s35e)
         s35psum=s35psum+s35w*pr(s35i,s35j,s35k,s35e)
         s35pwt=s35pwt+s35w
      enddo
      enddo
      enddo
      enddo
      s35psum=glsum(s35psum,1)
      s35pwt=glsum(s35pwt,1)
      s35pm=s35psum/max(s35pwt,s35tiny)

      s35p2=0.0
      s35px=0.0
      s35px2=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         s35w=bm2(s35i,s35j,s35k,s35e)
         s35pp=pr(s35i,s35j,s35k,s35e)-s35pm
         s35p2=s35p2+s35w*s35pp*s35pp
         s35px=s35px+s35w*xm2(s35i,s35j,s35k,s35e)*s35pp
         s35px2=s35px2+s35w*xm2(s35i,s35j,s35k,s35e)**2
     $      *s35pp
      enddo
      enddo
      enddo
      enddo
      s35p2=glsum(s35p2,1)
      s35px=glsum(s35px,1)
      s35px2=glsum(s35px2,1)

c     Cage signatures.
      s35cu2=0.0
      s35ncu=0
      do s35e=1,nelv
      do s35k=1,lz1
      do s35j=1,ly1
      do s35i=1,lx1
         if (mask_cage_u(s35i,s35j,s35k,s35e).eq.1) then
            s35cu2=s35cu2+
     $       u_bc_cage(s35i,s35j,s35k,s35e)**2+
     $       v_bc_cage(s35i,s35j,s35k,s35e)**2
            s35ncu=s35ncu+1
         endif
      enddo
      enddo
      enddo
      enddo
      s35cu2=glsum(s35cu2,1)
      s35ncu=iglsum(s35ncu,1)

      s35cpm=0.0
      s35cpw=0.0
      s35ncp=0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         if (mask_cage_p(s35i,s35j,s35k,s35e).eq.1) then
            s35cpm=s35cpm+p_bc_cage(s35i,s35j,s35k,s35e)
            s35cpw=s35cpw+1.0
            s35ncp=s35ncp+1
         endif
      enddo
      enddo
      enddo
      enddo
      s35cpm=glsum(s35cpm,1)
      s35cpw=glsum(s35cpw,1)
      s35ncp=iglsum(s35ncp,1)
      s35cpm=s35cpm/max(s35cpw,1.0)

      s35cp2=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         if (mask_cage_p(s35i,s35j,s35k,s35e).eq.1) then
            s35pp=p_bc_cage(s35i,s35j,s35k,s35e)-s35cpm
            s35cp2=s35cp2+s35pp*s35pp
         endif
      enddo
      enddo
      enddo
      enddo
      s35cp2=glsum(s35cp2,1)

      s35hs=0.0
      do s35i=1,phmax
         s35hs=s35hs+ph_pref(s35i)**2
      enddo
      s35hs=glsum(s35hs,1)

      if (nid.ne.0) return

      s35slot=istep+1
      if (s35mode.eq.1)
     $   write(s35name,'(A,I1,A)')
     $   'stage35AE_load_slot',s35slot,'.dat'
      if (s35mode.eq.2)
     $   write(s35name,'(A,I1,A)')
     $   'stage35AE_state_slot',s35slot,'.dat'
      if (s35mode.eq.3)
     $   write(s35name,'(A,I1,A)')
     $   'stage35AE_cage_slot',s35slot,'.dat'
      if (s35mode.eq.4)
     $   write(s35name,'(A,I9.9,A)')
     $   'stage35AE_src_step',istep,'.dat'
      if (s35mode.eq.5)
     $   write(s35name,'(A)')
     $   'stage35AE_continue_step8.dat'

      s35fu=995
      open(s35fu,file=s35name,status='replace',form='formatted')
      write(s35fu,'(A,2I12,1pE24.16)')
     $   'META ',s35mode,istep,time
      write(s35fu,'(A,1p6E24.16)')
     $   'FIELD ',s35u2,s35uz2,s35ur2,s35p2,s35px,s35px2
      write(s35fu,'(A,1p8E24.16)') 'P8C ',s35p8
      write(s35fu,'(A,1p8E24.16)') 'F8C ',s35f8
      write(s35fu,'(A,1p8E24.16)') 'P8R ',s35pr8
      write(s35fu,'(A,1p8E24.16)') 'F8R ',s35fr8
      write(s35fu,'(A,1p4E24.16)')
     $   'LP ',(p_re(s35i,1),s35i=1,4)
      write(s35fu,'(A,1p4E24.16)')
     $   'LF ',(phi_re(s35i,1),s35i=1,4)
      write(s35fu,'(A,1p4E24.16)')
     $   'LPO ',(p_re_old(s35i,1),s35i=1,4)
      write(s35fu,'(A,1p4E24.16)')
     $   'LFO ',(phi_re_old(s35i,1),s35i=1,4)
      write(s35fu,'(A,1p3E24.16)')
     $   'CAGE ',s35cu2,s35cp2,s35cpm
      write(s35fu,'(A,4I12)')
     $   'COUNT ',s35ncu,s35ncp,ph_initialized,ph_count
      write(s35fu,'(A,1p2E24.16,3I12)')
     $   'CTRL ',phys_pressure_ref,s35hs,
     $   phys_pressure_ref_step,stage24_ref_saved,phys_vmask_valid
      close(s35fu)

      return
      end

      subroutine s35af_probe(s35mode)
      include 'SIZE'
      include 'TOTAL'

      integer s35mode,s35i,s35j,s35k,s35e,s35fu,s35slot
      integer s35ncu,s35ncp
      character*96 s35name
      real s35w,s35pp,s35pm,s35psum,s35pwt
      real s35uz2,s35ur2,s35p2,s35px,s35px2
      real s35luc2,s35lpc2,s35lpm,s35lpw
      real s35duc2,s35dpc2,s35dpm,s35dpw
      real s35rx,s35ry,s35rz,s35rr
      real s35ux,s35uy,s35uz,s35pt,s35pshift
      real s35rho,s35nu,s35cut
      real s35mux,s35muy,s35mux2,s35muy2
      real s35mpx,s35mpy,s35mpx2,s35mpy2
      real s35tiny
      parameter(s35tiny=1.0e-300)

      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      real phys_ax,phys_ay,phys_az
      common /physalis_particle_accel/ phys_ax,phys_ay,phys_az

      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved
      integer phys_vmask_valid
      common /physalis_vmask_ctl/ phys_vmask_valid

      integer ph_initialized,ph_count
      common /physalis_history_i/ ph_initialized,ph_count
      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer phys_pressure_ref_step
      common /physalis_pressure_reference_i/
     $ phys_pressure_ref_step

      s35rho=max(abs(param(1)),1.0e-30)
      s35nu=abs(param(2))/s35rho
      s35cut=1.0e-10*max(phys_a,1.0e-30)

c     Separate velocity and gauge-free pressure field signatures.
      s35uz2=0.0
      s35ur2=0.0
      do s35e=1,nelv
      do s35k=1,lz1
      do s35j=1,ly1
      do s35i=1,lx1
         s35w=bm1(s35i,s35j,s35k,s35e)
         s35uz2=s35uz2+s35w*vx(s35i,s35j,s35k,s35e)**2
         s35ur2=s35ur2+s35w*vy(s35i,s35j,s35k,s35e)**2
      enddo
      enddo
      enddo
      enddo
      s35uz2=glsum(s35uz2,1)
      s35ur2=glsum(s35ur2,1)

      s35psum=0.0
      s35pwt=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         s35w=bm2(s35i,s35j,s35k,s35e)
         s35psum=s35psum+s35w*pr(s35i,s35j,s35k,s35e)
         s35pwt=s35pwt+s35w
      enddo
      enddo
      enddo
      enddo
      s35psum=glsum(s35psum,1)
      s35pwt=glsum(s35pwt,1)
      s35pm=s35psum/max(s35pwt,s35tiny)

      s35p2=0.0
      s35px=0.0
      s35px2=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         s35w=bm2(s35i,s35j,s35k,s35e)
         s35pp=pr(s35i,s35j,s35k,s35e)-s35pm
         s35p2=s35p2+s35w*s35pp*s35pp
         s35px=s35px+s35w*xm2(s35i,s35j,s35k,s35e)*s35pp
         s35px2=s35px2+s35w*xm2(s35i,s35j,s35k,s35e)**2
     $      *s35pp
      enddo
      enddo
      enddo
      enddo
      s35p2=glsum(s35p2,1)
      s35px=glsum(s35px,1)
      s35px2=glsum(s35px2,1)

c     Live U target and independent direct U8 target on same U mask.
      s35luc2=0.0
      s35duc2=0.0
      s35ncu=0
      s35mux=0.0
      s35muy=0.0
      s35mux2=0.0
      s35muy2=0.0
      do s35e=1,nelv
      do s35k=1,lz1
      do s35j=1,ly1
      do s35i=1,lx1
         if (mask_cage_u(s35i,s35j,s35k,s35e).ne.1) cycle
         s35ncu=s35ncu+1
         s35mux=s35mux+xm1(s35i,s35j,s35k,s35e)
         s35muy=s35muy+ym1(s35i,s35j,s35k,s35e)
         s35mux2=s35mux2+xm1(s35i,s35j,s35k,s35e)**2
         s35muy2=s35muy2+ym1(s35i,s35j,s35k,s35e)**2
         s35luc2=s35luc2+
     $      u_bc_cage(s35i,s35j,s35k,s35e)**2+
     $      v_bc_cage(s35i,s35j,s35k,s35e)**2

         s35rx=ym1(s35i,s35j,s35k,s35e)-phys_xp
         s35ry=0.0-phys_yp
         s35rz=xm1(s35i,s35j,s35k,s35e)-phys_zp
         s35rr=sqrt(s35rx*s35rx+s35ry*s35ry+s35rz*s35rz)
         call s35ad_axisym8_vel(s35rx,s35ry,s35rz,s35rr,
     $      phys_a,s35nu,s35ux,s35uy,s35uz)
         s35uz=phys_wp+phys_ox*s35ry-phys_oy*s35rx+s35uz
         s35ux=phys_up+phys_oy*s35rz-phys_oz*s35ry+s35ux
         if (abs(ym1(s35i,s35j,s35k,s35e)).le.s35cut)
     $      s35ux=0.0
         s35duc2=s35duc2+s35uz*s35uz+s35ux*s35ux
      enddo
      enddo
      enddo
      enddo
      s35luc2=glsum(s35luc2,1)
      s35duc2=glsum(s35duc2,1)
      s35ncu=iglsum(s35ncu,1)
      s35mux=glsum(s35mux,1)
      s35muy=glsum(s35muy,1)
      s35mux2=glsum(s35mux2,1)
      s35muy2=glsum(s35muy2,1)

c     Live P target and independent direct P8 target on same P mask.
      s35lpm=0.0
      s35lpw=0.0
      s35dpm=0.0
      s35dpw=0.0
      s35ncp=0
      s35mpx=0.0
      s35mpy=0.0
      s35mpx2=0.0
      s35mpy2=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         if (mask_cage_p(s35i,s35j,s35k,s35e).ne.1) cycle
         s35ncp=s35ncp+1
         s35mpx=s35mpx+xm2(s35i,s35j,s35k,s35e)
         s35mpy=s35mpy+ym2(s35i,s35j,s35k,s35e)
         s35mpx2=s35mpx2+xm2(s35i,s35j,s35k,s35e)**2
         s35mpy2=s35mpy2+ym2(s35i,s35j,s35k,s35e)**2
         s35lpm=s35lpm+p_bc_cage(s35i,s35j,s35k,s35e)
         s35lpw=s35lpw+1.0
         s35rx=ym2(s35i,s35j,s35k,s35e)-phys_xp
         s35ry=0.0-phys_yp
         s35rz=xm2(s35i,s35j,s35k,s35e)-phys_zp
         s35rr=sqrt(s35rx*s35rx+s35ry*s35ry+s35rz*s35rz)
         call s35ad_axisym8_press(s35rx,s35ry,s35rz,
     $      s35rr,phys_a,s35pt)
         call physalis_sp_pressure_frame_shift
     $      (s35rx,s35ry,s35rz,s35pshift)
         s35dpm=s35dpm+s35pt+s35pshift
         s35dpw=s35dpw+1.0
      enddo
      enddo
      enddo
      enddo
      s35lpm=glsum(s35lpm,1)
      s35lpw=glsum(s35lpw,1)
      s35dpm=glsum(s35dpm,1)
      s35dpw=glsum(s35dpw,1)
      s35ncp=iglsum(s35ncp,1)
      s35mpx=glsum(s35mpx,1)
      s35mpy=glsum(s35mpy,1)
      s35mpx2=glsum(s35mpx2,1)
      s35mpy2=glsum(s35mpy2,1)
      s35lpm=s35lpm/max(s35lpw,1.0)
      s35dpm=s35dpm/max(s35dpw,1.0)

      s35lpc2=0.0
      s35dpc2=0.0
      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         if (mask_cage_p(s35i,s35j,s35k,s35e).ne.1) cycle
         s35pp=p_bc_cage(s35i,s35j,s35k,s35e)-s35lpm
         s35lpc2=s35lpc2+s35pp*s35pp
         s35rx=ym2(s35i,s35j,s35k,s35e)-phys_xp
         s35ry=0.0-phys_yp
         s35rz=xm2(s35i,s35j,s35k,s35e)-phys_zp
         s35rr=sqrt(s35rx*s35rx+s35ry*s35ry+s35rz*s35rz)
         call s35ad_axisym8_press(s35rx,s35ry,s35rz,
     $      s35rr,phys_a,s35pt)
         call physalis_sp_pressure_frame_shift
     $      (s35rx,s35ry,s35rz,s35pshift)
         s35pp=s35pt+s35pshift-s35dpm
         s35dpc2=s35dpc2+s35pp*s35pp
      enddo
      enddo
      enddo
      enddo
      s35lpc2=glsum(s35lpc2,1)
      s35dpc2=glsum(s35dpc2,1)

      if (nid.ne.0) return
      s35slot=istep+1
      if (s35mode.eq.1)
     $   write(s35name,'(A,I1,A)')
     $   'stage35AF_load_slot',s35slot,'.dat'
      if (s35mode.eq.2)
     $   write(s35name,'(A,I1,A)')
     $   'stage35AF_state_slot',s35slot,'.dat'
      if (s35mode.eq.3)
     $   write(s35name,'(A,I1,A)')
     $   'stage35AF_cage_slot',s35slot,'.dat'
      if (s35mode.eq.4)
     $   write(s35name,'(A,I9.9,A)')
     $   'stage35AF_src_step',istep,'.dat'
      if (s35mode.eq.5)
     $   write(s35name,'(A)')
     $   'stage35AF_continue_step8.dat'

      s35fu=996
      open(s35fu,file=s35name,status='replace',form='formatted')
      write(s35fu,'(A)') 'S35AF_PROBE_V1'
      write(s35fu,'(A,2I12,1pE24.16)')
     $   'META ',s35mode,istep,time
      write(s35fu,'(A,1p5E24.16)')
     $   'FIELD ',s35uz2,s35ur2,s35p2,s35px,s35px2
      write(s35fu,'(A,1p4E24.16)')
     $   'UTARGET ',s35luc2,s35duc2,
     $   sqrt(max(s35luc2,0.0)),sqrt(max(s35duc2,0.0))
      write(s35fu,'(A,1p4E24.16)')
     $   'PTARGET ',s35lpc2,s35dpc2,s35lpm,s35dpm
      write(s35fu,'(A,2I12,1p8E24.16)')
     $   'MASK ',s35ncu,s35ncp,s35mux,s35muy,s35mux2,s35muy2,
     $   s35mpx,s35mpy,s35mpx2,s35mpy2
      write(s35fu,'(A,1p11E24.16)')
     $   'PART ',phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp,
     $   phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      write(s35fu,'(A,1p3E24.16)')
     $   'ACC ',phys_ax,phys_ay,phys_az
      write(s35fu,'(A,1p8E24.16)') 'P8C ',s35p8
      write(s35fu,'(A,1p8E24.16)') 'F8C ',s35f8
      write(s35fu,'(A,1p8E24.16)') 'P8R ',s35pr8
      write(s35fu,'(A,1p8E24.16)') 'F8R ',s35fr8
      write(s35fu,'(A,1pE24.16,7I12)')
     $   'CTRL ',phys_pressure_ref,phys_pressure_ref_step,
     $   stage24_active,stage24_udyn,stage24_pdyn,
     $   stage24_ref_saved,phys_vmask_valid,ph_initialized
      write(s35fu,'(A,I12)') 'PHCOUNT ',ph_count
      close(s35fu)
      return
      end


c-----------------------------------------------------------------------
      subroutine stage35bm_decode_cage(mode,uside,pside,
     $ ulayer,player)
      include 'SIZE'
      include 'TOTAL'
      integer mode,uside,pside,ulayer,player
      integer bq_uid,bq_pid,bq_ucum,bq_pcum
      uside=0
      pside=0
      ulayer=0
      player=0
c     1001-1196: Stage35BQ full factorial, single+cumulative.
      if (mode.ge.1001 .and. mode.le.1196) then
         call stage35bq_decode_cage(mode,uside,pside,
     $      ulayer,player,bq_ucum,bq_pcum)
c     61-64: Stage35BO Uout1 / Pin graph shells 1-4.
c     65-68: Stage35BO Uout1 / Pout graph shells 1-4.
      elseif (mode.ge.61 .and. mode.le.64) then
         uside=1
         pside=-1
         ulayer=1
         player=mode-60
      elseif (mode.ge.65 .and. mode.le.68) then
         uside=1
         pside=1
         ulayer=1
         player=mode-64
c     41-49: Uout1-3 x Pin1-3 cross grid.
      elseif (mode.ge.41 .and. mode.le.49) then
         uside=1
         pside=-1
         ulayer=mod(mode-41,3)+1
         player=(mode-41)/3+1
c     50: Uout2/Pout2
      elseif (mode.eq.50) then
         uside=1
         pside=1
         ulayer=2
         player=2
c     51: Uin2/Pin2
      elseif (mode.eq.51) then
         uside=-1
         pside=-1
         ulayer=2
         player=2
c     52: Uin2/Pout2
      elseif (mode.eq.52) then
         uside=-1
         pside=1
         ulayer=2
         player=2
c     53: Uout3/Pout3
      elseif (mode.eq.53) then
         uside=1
         pside=1
         ulayer=3
         player=3
c     54: Uin3/Pin3
      elseif (mode.eq.54) then
         uside=-1
         pside=-1
         ulayer=3
         player=3
c     55: Uin3/Pout3
      elseif (mode.eq.55) then
         uside=-1
         pside=1
         ulayer=3
         player=3
      else
         if (nid.eq.0) write(6,'(A,I8)')
     $      'S35BO/BM FATAL invalid cage mode=',mode
         call exitt
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage35bq_decode_cage(mode,uside,pside,
     $ ulayer,player,ucum,pcum)
      include 'SIZE'
      include 'TOTAL'
      integer mode,uside,pside,ulayer,player,ucum,pcum
      integer bq_idx,bq_uid,bq_pid

      if (mode.lt.1001 .or. mode.gt.1196) then
         if (nid.eq.0) write(6,'(A,I8)')
     $      'S35BQ FATAL invalid cage mode=',mode
         call exitt
      endif

      bq_idx=mode-1001
      bq_uid=bq_idx/14+1
      bq_pid=mod(bq_idx,14)+1

      call stage35bq_decode_one(bq_uid,uside,ulayer,ucum)
      call stage35bq_decode_one(bq_pid,pside,player,pcum)
      return
      end
c-----------------------------------------------------------------------
      subroutine stage35bq_decode_one(id,side,layer,cum)
      include 'SIZE'
      include 'TOTAL'
      integer id,side,layer,cum

      if (id.ge.1 .and. id.le.4) then
         side=1
         layer=id
         cum=0
      elseif (id.ge.5 .and. id.le.7) then
         side=1
         layer=id-3
         cum=1
      elseif (id.ge.8 .and. id.le.11) then
         side=-1
         layer=id-7
         cum=0
      elseif (id.ge.12 .and. id.le.14) then
         side=-1
         layer=id-10
         cum=1
      else
         if (nid.eq.0) write(6,'(A,I8)')
     $      'S35BQ FATAL invalid topology id=',id
         call exitt
      endif
      return
      end
c-----------------------------------------------------------------------

      subroutine stage35bm_build_topo_velocity(mode)
      include 'SIZE'
      include 'TOTAL'
      integer mode,uside,pside,ulayer,player,target
      integer ucum,pcum
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      real bmcur(lx1,ly1,lz1,lelv)
      real bmnxt(lx1,ly1,lz1,lelv)
      real bmseen(lx1,ly1,lz1,lelv)
      common /s35bm_uwrk/ bmcur,bmnxt,bmseen
      integer e,i,j,k,ntot1,ipass
      logical cross,near

      ucum=0
      pcum=0
      if (mode.ge.1001 .and. mode.le.1196) then
         call stage35bq_decode_cage(mode,uside,pside,
     $      ulayer,player,ucum,pcum)
      else
         call stage35bm_decode_cage(mode,uside,pside,
     $      ulayer,player)
      endif
      ntot1=lx1*ly1*lz1*nelv
      call rzero(bmcur,ntot1)
      call rzero(bmnxt,ntot1)
      call rzero(bmseen,ntot1)
      call izero(mask_cage_u,ntot1)
      if (uside.eq.1) then
         target=0
      else
         target=1
      endif

c     First graph-crossing shell on the requested side.
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_inside_u(i,j,k,e).ne.target) cycle
         cross=.false.
         if (i.gt.1) then
            if (mask_inside_u(i-1,j,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (i.lt.lx1) then
            if (mask_inside_u(i+1,j,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (j.gt.1) then
            if (mask_inside_u(i,j-1,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (j.lt.ly1) then
            if (mask_inside_u(i,j+1,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (mask_inside_u(i,j,k-1,e).ne.
     $             mask_inside_u(i,j,k,e)) cross=.true.
            endif
            if (k.lt.lz1) then
               if (mask_inside_u(i,j,k+1,e).ne.
     $             mask_inside_u(i,j,k,e)) cross=.true.
            endif
         endif
         if (cross) bmcur(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo
      call dsop(bmcur,'MXA',lx1,ly1,lz1)

c     Cumulative cage includes shell 1 immediately.
      if (ucum.eq.1) then
         do e=1,nelv
         do k=1,lz1
         do j=1,ly1
         do i=1,lx1
            if (bmcur(i,j,k,e).gt.0.5 .and.
     $          mask_inside_u(i,j,k,e).eq.target)
     $         mask_cage_u(i,j,k,e)=1
         enddo
         enddo
         enddo
         enddo
      endif

      if (ulayer.eq.1) then
         if (ucum.eq.0) then
            do e=1,nelv
            do k=1,lz1
            do j=1,ly1
            do i=1,lx1
               if (bmcur(i,j,k,e).gt.0.5 .and.
     $             mask_inside_u(i,j,k,e).eq.target)
     $            mask_cage_u(i,j,k,e)=1
            enddo
            enddo
            enddo
            enddo
         endif
         return
      endif

      call copy(bmseen,bmcur,ntot1)

c     Grow graph shells until the requested layer is reached.
      do ipass=2,ulayer
         call rzero(bmnxt,ntot1)
         do e=1,nelv
         do k=1,lz1
         do j=1,ly1
         do i=1,lx1
            if (mask_inside_u(i,j,k,e).ne.target) cycle
            if (bmseen(i,j,k,e).gt.0.5) cycle
            near=.false.
            if (i.gt.1) then
               if (bmcur(i-1,j,k,e).gt.0.5) near=.true.
            endif
            if (i.lt.lx1) then
               if (bmcur(i+1,j,k,e).gt.0.5) near=.true.
            endif
            if (j.gt.1) then
               if (bmcur(i,j-1,k,e).gt.0.5) near=.true.
            endif
            if (j.lt.ly1) then
               if (bmcur(i,j+1,k,e).gt.0.5) near=.true.
            endif
            if (ldim.eq.3) then
               if (k.gt.1) then
                  if (bmcur(i,j,k-1,e).gt.0.5) near=.true.
               endif
               if (k.lt.lz1) then
                  if (bmcur(i,j,k+1,e).gt.0.5) near=.true.
               endif
            endif
            if (near) bmnxt(i,j,k,e)=1.0
         enddo
         enddo
         enddo
         enddo
         call dsop(bmnxt,'MXA',lx1,ly1,lz1)

c        Cumulative cage adds every newly grown shell.
         if (ucum.eq.1) then
            do e=1,nelv
            do k=1,lz1
            do j=1,ly1
            do i=1,lx1
               if (bmnxt(i,j,k,e).gt.0.5 .and.
     $             mask_inside_u(i,j,k,e).eq.target)
     $            mask_cage_u(i,j,k,e)=1
            enddo
            enddo
            enddo
            enddo
         endif

         if (ipass.eq.ulayer) then
            if (ucum.eq.0) then
               do e=1,nelv
               do k=1,lz1
               do j=1,ly1
               do i=1,lx1
                  if (bmnxt(i,j,k,e).gt.0.5 .and.
     $                mask_inside_u(i,j,k,e).eq.target)
     $               mask_cage_u(i,j,k,e)=1
               enddo
               enddo
               enddo
               enddo
            endif
            return
         endif

         do e=1,nelv
         do k=1,lz1
         do j=1,ly1
         do i=1,lx1
            bmseen(i,j,k,e)=max(bmseen(i,j,k,e),
     $                            bmnxt(i,j,k,e))
         enddo
         enddo
         enddo
         enddo
         call copy(bmcur,bmnxt,ntot1)
      enddo
      return
      end
c-----------------------------------------------------------------------

      subroutine stage35bm_build_topo_pressure(mode)
      include 'SIZE'
      include 'TOTAL'
      integer mode,uside,pside,ulayer,player,target
      integer ucum,pcum
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      real bmcurp(lx2,ly2,lz2,lelv)
      real bmnxtp(lx2,ly2,lz2,lelv)
      real bmseenp(lx2,ly2,lz2,lelv)
      common /s35bm_pwrk/ bmcurp,bmnxtp,bmseenp
      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      integer e,i,j,k,ntot2,ipass
      real xx,yy,zz,rr
      logical cross,near

      ucum=0
      pcum=0
      if (mode.ge.1001 .and. mode.le.1196) then
         call stage35bq_decode_cage(mode,uside,pside,
     $      ulayer,player,ucum,pcum)
      else
         call stage35bm_decode_cage(mode,uside,pside,
     $      ulayer,player)
      endif
      ntot2=lx2*ly2*lz2*nelv
      call izero(mask_inside_p,ntot2)
      call izero(mask_cage_p,ntot2)
      call rzero(bmcurp,ntot2)
      call rzero(bmnxtp,ntot2)
      call rzero(bmseenp,ntot2)
      if (pside.eq.1) then
         target=0
      else
         target=1
      endif

c     Classify element-local PN-2 pressure points.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (ldim.eq.2) then
            xx=ym2(i,j,k,e)-phys_xp
            yy=0.0-phys_yp
            zz=xm2(i,j,k,e)-phys_zp
         else
            xx=xm2(i,j,k,e)-phys_xp
            yy=ym2(i,j,k,e)-phys_yp
            zz=zm2(i,j,k,e)-phys_zp
         endif
         rr=sqrt(xx*xx+yy*yy+zz*zz)
         if (rr.lt.phys_a) mask_inside_p(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo

c     First pressure-grid crossing shell.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).ne.target) cycle
         cross=.false.
         if (i.gt.1) then
            if (mask_inside_p(i-1,j,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (i.lt.lx2) then
            if (mask_inside_p(i+1,j,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (j.gt.1) then
            if (mask_inside_p(i,j-1,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (j.lt.ly2) then
            if (mask_inside_p(i,j+1,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (mask_inside_p(i,j,k-1,e).ne.
     $             mask_inside_p(i,j,k,e)) cross=.true.
            endif
            if (k.lt.lz2) then
               if (mask_inside_p(i,j,k+1,e).ne.
     $             mask_inside_p(i,j,k,e)) cross=.true.
            endif
         endif
         if (cross) bmcurp(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo

c     Cumulative pressure cage includes shell 1 immediately.
      if (pcum.eq.1) then
         do e=1,nelv
         do k=1,lz2
         do j=1,ly2
         do i=1,lx2
            if (bmcurp(i,j,k,e).gt.0.5)
     $         mask_cage_p(i,j,k,e)=1
         enddo
         enddo
         enddo
         enddo
      endif

      if (player.eq.1) then
         if (pcum.eq.0) then
            do e=1,nelv
            do k=1,lz2
            do j=1,ly2
            do i=1,lx2
               if (bmcurp(i,j,k,e).gt.0.5)
     $            mask_cage_p(i,j,k,e)=1
            enddo
            enddo
            enddo
            enddo
         endif
         return
      endif

      call copy(bmseenp,bmcurp,ntot2)

      do ipass=2,player
         call rzero(bmnxtp,ntot2)
         do e=1,nelv
         do k=1,lz2
         do j=1,ly2
         do i=1,lx2
            if (mask_inside_p(i,j,k,e).ne.target) cycle
            if (bmseenp(i,j,k,e).gt.0.5) cycle
            near=.false.
            if (i.gt.1) then
               if (bmcurp(i-1,j,k,e).gt.0.5) near=.true.
            endif
            if (i.lt.lx2) then
               if (bmcurp(i+1,j,k,e).gt.0.5) near=.true.
            endif
            if (j.gt.1) then
               if (bmcurp(i,j-1,k,e).gt.0.5) near=.true.
            endif
            if (j.lt.ly2) then
               if (bmcurp(i,j+1,k,e).gt.0.5) near=.true.
            endif
            if (ldim.eq.3) then
               if (k.gt.1) then
                  if (bmcurp(i,j,k-1,e).gt.0.5) near=.true.
               endif
               if (k.lt.lz2) then
                  if (bmcurp(i,j,k+1,e).gt.0.5) near=.true.
               endif
            endif
            if (near) bmnxtp(i,j,k,e)=1.0
         enddo
         enddo
         enddo
         enddo

c        Cumulative pressure cage adds every newly grown shell.
         if (pcum.eq.1) then
            do e=1,nelv
            do k=1,lz2
            do j=1,ly2
            do i=1,lx2
               if (bmnxtp(i,j,k,e).gt.0.5)
     $            mask_cage_p(i,j,k,e)=1
            enddo
            enddo
            enddo
            enddo
         endif

         if (ipass.eq.player) then
            if (pcum.eq.0) then
               do e=1,nelv
               do k=1,lz2
               do j=1,ly2
               do i=1,lx2
                  if (bmnxtp(i,j,k,e).gt.0.5)
     $               mask_cage_p(i,j,k,e)=1
               enddo
               enddo
               enddo
               enddo
            endif
            return
         endif

         do e=1,nelv
         do k=1,lz2
         do j=1,ly2
         do i=1,lx2
            bmseenp(i,j,k,e)=max(bmseenp(i,j,k,e),
     $                            bmnxtp(i,j,k,e))
         enddo
         enddo
         enddo
         enddo
         call copy(bmcurp,bmnxtp,ntot2)
      enddo
      return
      end
c-----------------------------------------------------------------------

c-----------------------------------------------------------------------
c  STAGE35BN pressure-lift diagnostics.
c  Existing Stage35BM pressure cages are already element-local graph
c  shells.  This stage measures how their analytic lift couples to the
c  pressure RHS.  No pressure algebra is changed.
      subroutine stage35bq_lift_pre(rhs,plift,alift)
      include 'SIZE'
      include 'TOTAL'
      real rhs(lx2,ly2,lz2,lelv)
      real plift(lx2,ly2,lz2,lelv)
      real alift(lx2,ly2,lz2,lelv)
      real bn_l2,bn_al2,bn_r2,bn_dot
      real bn_ln,bn_aln,bn_rn,bn_cos
      common /s35bn_liftd/ bn_ln,bn_aln,bn_rn,bn_cos
      integer e,i,j,k
      bn_l2=0.0
      bn_al2=0.0
      bn_r2=0.0
      bn_dot=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         bn_l2=bn_l2+bm2(i,j,k,e)*plift(i,j,k,e)**2
         bn_al2=bn_al2+bm2(i,j,k,e)*alift(i,j,k,e)**2
         bn_r2=bn_r2+bm2(i,j,k,e)*rhs(i,j,k,e)**2
         bn_dot=bn_dot+bm2(i,j,k,e)*rhs(i,j,k,e)
     $        *alift(i,j,k,e)
      enddo
      enddo
      enddo
      enddo
      bn_l2=glsum(bn_l2,1)
      bn_al2=glsum(bn_al2,1)
      bn_r2=glsum(bn_r2,1)
      bn_dot=glsum(bn_dot,1)
      bn_ln=sqrt(max(bn_l2,0.0))
      bn_aln=sqrt(max(bn_al2,0.0))
      bn_rn=sqrt(max(bn_r2,0.0))
      bn_cos=bn_dot/max(bn_rn*bn_aln,1.0e-30)
      return
      end
c-----------------------------------------------------------------------
      subroutine stage35bq_lift_post(rhs)
      include 'SIZE'
      include 'TOTAL'
      real rhs(lx2,ly2,lz2,lelv)
      real bn_ln,bn_aln,bn_rn,bn_cos
      common /s35bn_liftd/ bn_ln,bn_aln,bn_rn,bn_cos
      real bn_rp2,bn_rpn,bn_ratio,bn_ratio2
      integer e,i,j,k,fu
      logical bn_write
      bn_rp2=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         bn_rp2=bn_rp2+bm2(i,j,k,e)*rhs(i,j,k,e)**2
      enddo
      enddo
      enddo
      enddo
      bn_rp2=glsum(bn_rp2,1)
      bn_rpn=sqrt(max(bn_rp2,0.0))
      bn_ratio=bn_aln/max(bn_rn,1.0e-30)
      bn_ratio2=bn_rpn/max(bn_rn,1.0e-30)
      bn_write=.false.
      if (istep.le.10) bn_write=.true.
      if (mod(istep,1000).eq.0) bn_write=.true.
      if (bn_write .and. nid.eq.0) then
         fu=97
         open(unit=fu,file='stage35BQ_lift_diag.dat',
     $        status='unknown',position='append')
         write(fu,'(I9,1X,1P,8E18.9)') istep,time,
     $        bn_ln,bn_aln,bn_rn,bn_rpn,
     $        bn_ratio,bn_ratio2,bn_cos
         close(fu)
      endif
      return
      end
c-----------------------------------------------------------------------
