      subroutine s35ad_init_once
      integer s35n
      real s35p8(8),s35f8(8),s35pr8(8),s35fr8(8)
      common /s35ad_lamb8/ s35p8,s35f8,s35pr8,s35fr8
      logical s35first
      save s35first
      data s35first /.true./

      if (.not.s35first) return
      do s35n=1,8
         s35p8(s35n)=0.0
         s35f8(s35n)=0.0
         s35pr8(s35n)=0.0
         s35fr8(s35n)=0.0
      enddo
      call s35ad_selftest
      s35first=.false.
      return
      end

      subroutine s35ad_y0(s35n,s35x,s35y,s35dy)
      integer s35n,s35j
      real s35x,s35y,s35dy
      real s35p0,s35p1,s35p2,s35pm1
      real s35norm,s35st,s35pi

      s35pi=4.0*atan(1.0)
      s35p0=1.0
      if (s35n.eq.0) then
         s35y=sqrt(1.0/(4.0*s35pi))
         s35dy=0.0
         return
      endif

      s35p1=s35x
      if (s35n.eq.1) then
         s35p2=s35p1
         s35pm1=s35p0
      else
         do s35j=2,s35n
            s35p2=((2.0*float(s35j)-1.0)*s35x*s35p1
     $       -(float(s35j)-1.0)*s35p0)/float(s35j)
            s35p0=s35p1
            s35p1=s35p2
         enddo
         s35pm1=s35p0
      endif

      s35norm=sqrt(float(2*s35n+1)/(4.0*s35pi))
      s35y=s35norm*s35p2
      s35st=sqrt(max(0.0,1.0-s35x*s35x))
      if (s35st.gt.1.0e-14) then
         s35dy=s35norm*
     $      (float(s35n)*s35x*s35p2
     $      -float(s35n)*s35pm1)/s35st
      else
         s35dy=0.0
      endif
      return
      end

