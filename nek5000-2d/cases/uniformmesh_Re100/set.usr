      subroutine physalis_init
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer n_phys_inner
      common /physalis_inner/ n_phys_inner
      integer n_phys_inner_min
      common /physalis_inner_min/ n_phys_inner_min
      real pressure_relax_coeff
      common /physalis_pressure_relax/ pressure_relax_coeff
      integer phys_replay_enabled,phys_replay_active,phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved
      real eta3_u
      common /physalis_eta3_ctl/ eta3_u
      integer phys_leb_orient
      common /phys_leb_orientation/ phys_leb_orient
      real phys_tol_a,phys_tol_w
      common /physalis_particle_tols/ phys_tol_a,phys_tol_w
      integer spmove_enabled
      common /spmove_ctl/ spmove_enabled
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode

      integer phys_kappa_active,phys_accept_ready,phys_inner_used
      integer phys_last_begin_step,phys_last_commit_step
      common /physalis_kappa_i/ phys_kappa_active,
     $ phys_accept_ready,phys_inner_used,
     $ phys_last_begin_step,phys_last_commit_step
      real phys_ax,phys_ay,phys_az
      common /physalis_particle_accel/ phys_ax,phys_ay,phys_az
      integer ph_initialized,ph_count
      common /physalis_history_i/ ph_initialized,ph_count
      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer phys_pressure_ref_step
      common /physalis_pressure_reference_i/
     $ phys_pressure_ref_step
      integer short_test_id
      common /short_test_i/ short_test_id
      integer phys_m0_project_on
      common /physalis_m0_ctl/ phys_m0_project_on

      integer phys_diag_precon_mode
      common /phys_diag_precon_i/ phys_diag_precon_mode
      integer stage4_m0_project_on
      common /stage4_diag_i/ stage4_m0_project_on

      real stage5_vel_scale3,stage5_vel_scale4
      real stage5_coeff_scale3,stage5_coeff_scale4
      common /stage5_ctl_r/ stage5_vel_scale3,stage5_vel_scale4,
     $ stage5_coeff_scale3,stage5_coeff_scale4
      real stage6_p3_scale,stage6_phi3_scale
      real stage6_p4_scale,stage6_phi4_scale
      common /stage6_ctl_r/ stage6_p3_scale,stage6_phi3_scale,
     $ stage6_p4_scale,stage6_phi4_scale
      integer stage6_radial_clamp
      common /stage6_ctl_i/ stage6_radial_clamp

      integer stage8_fixed_cage_on
      real stage8_ru_in,stage8_ru_out,stage8_rp_in,stage8_rp_out
      common /stage8_cage_i/ stage8_fixed_cage_on
      common /stage8_cage_r/ stage8_ru_in,stage8_ru_out,
     $ stage8_rp_in,stage8_rp_out

      integer stage9_cage_mode,stage9_pcage_filter_on
      common /stage9_cage_i/ stage9_cage_mode,
     $ stage9_pcage_filter_on

      integer stage10_u_mode,stage10_ntheta_u
      integer stage10_bins_found
      real stage10_target_r_over_a
      real stage10_target_err_max,stage10_target_err_mean
      common /stage10_cage_i/ stage10_u_mode,
     $ stage10_ntheta_u,stage10_bins_found
      common /stage10_cage_r/ stage10_target_r_over_a,
     $ stage10_target_err_max,stage10_target_err_mean

      integer stage11_p_mode,stage11_ntheta_p
      integer stage11_bins_found,stage11_nodes_selected
      real stage11_target_r_over_a
      real stage11_target_err_max,stage11_target_err_mean
      common /stage11_cage_i/ stage11_p_mode,
     $ stage11_ntheta_p,stage11_bins_found,
     $ stage11_nodes_selected
      common /stage11_cage_r/ stage11_target_r_over_a,
     $ stage11_target_err_max,stage11_target_err_mean

      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on

      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved

      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid

      integer stage26_active,stage26_meanfree
      common /stage26_ctl_i/ stage26_active,stage26_meanfree

      integer stage27_active,stage27_pnmax
      common /stage27_ctl_i/ stage27_active,stage27_pnmax
      real stage25_qmean,stage25_pref_q,stage25_pref_fit
      real stage25_pref_cur,stage25_shape_mean,stage25_shift_mean
      real stage25_pref_used
      common /stage25_ref_r/ stage25_qmean,stage25_pref_q,
     $ stage25_pref_fit,stage25_pref_cur,stage25_shape_mean,
     $ stage25_shift_mean,stage25_pref_used

      real phys_vmask1_base(lx1,ly1,lz1,lelv)
      real phys_vmask2_base(lx1,ly1,lz1,lelv)
      real phys_vmask3_base(lx1,ly1,lz1,lelv)
      integer phys_vmask_valid
      common /physalis_vmask_bak/ phys_vmask1_base,
     $ phys_vmask2_base,phys_vmask3_base
      common /physalis_vmask_ctl/ phys_vmask_valid

      logical initialized
      save initialized
      data initialized /.false./

      if (initialized) return
      call validation_config
      call zp_validation_config

      short_test_id    = 2302
      phys_diag_precon_mode = 1
      stage4_m0_project_on = 1
      stage5_vel_scale3 = 1.00000000
      stage5_vel_scale4 = 0.00000000
      stage5_coeff_scale3 = 1.00000000
      stage5_coeff_scale4 = 0.00000000
      stage6_p3_scale = 1.00000000
      stage6_phi3_scale = 1.00000000
      stage6_p4_scale = 0.00000000
      stage6_phi4_scale = 0.00000000
      stage6_radial_clamp = 0
      stage8_fixed_cage_on = 1
      stage8_ru_in  = 1.002800000
      stage8_ru_out = 1.075100000
      stage8_rp_in  = 0.916500000
      stage8_rp_out = 1.000000000
      stage9_cage_mode = 1008
      stage9_pcage_filter_on = 0
      stage10_u_mode = 0
      stage10_ntheta_u = 12
      stage10_bins_found = 0
      stage10_target_r_over_a = 1.00000000
      stage10_target_err_max = 0.0
      stage10_target_err_mean = 0.0
      stage11_p_mode = 0
      stage11_ntheta_p = 8
      stage11_bins_found = 0
      stage11_nodes_selected = 0
      stage11_target_r_over_a = 0.90000000
      stage11_target_err_max = 0.0
      stage11_target_err_mean = 0.0
      stage23_active = 1
      stage23_freeze = 0
      stage23_interior_on = 1
      stage23_lift_on = 1
      stage24_active = 1
      stage24_udyn = 1
      stage24_pdyn = 1
      stage24_ref_saved = 0
      stage25_active = 0
      stage25_pref_mode = 2
      stage25_qvalid = 0
      stage25_qmean = 0.0
      stage25_pref_q = 0.0
      stage25_pref_fit = 0.0
      stage25_pref_cur = 0.0
      stage25_shape_mean = 0.0
      stage25_shift_mean = 0.0
      stage25_pref_used = 0.0
      stage26_active = 1
      stage26_meanfree = 1
      stage27_active = 1
      stage27_pnmax = 3
      stage12_virtual_p_on = 0
      stage12_ntheta_p = 8
      stage12_setup_done = 0
      stage12_ncon = 0
      stage12_rp_over_a = 0.90000000
      stage12_geom_err_max = 0.0
      stage12_row_ref_err_max = 0.0
      stage12_phys_err_max = 0.0
      stage12_poly_err_max = 0.0
      stage12_gram_pivmin = 0.0
      stage12_constraint_rel = 0.0
      stage12_constraint_abs = 0.0
      stage12_constraint_target = 0.0
      stage12_constraint_tol = 0.0
      stage12_constraint_fatal = 0.0
      stage12_constraint_warn_count = 0
      phys_mode=7
      n_phys_iter      = 1
      n_phys_inner     = 0
      n_phys_inner_min = 4
      lmax             = 3
      pressure_mode    = 0
      beta_coeff       = 0.01000000
      pressure_relax_coeff = 1.00000000
      phys_tol_coeff   = 5.00000000e-04
      phys_tol_cage    = 1.0e-8
      phys_tol_a       = 2.00000000e-05
      phys_tol_w       = 2.00000000e-05
      r_sample_over_a = 1.14000000
      cage_thickness_u = 1.00000000
      cage_thickness_p = 1.00000000
      eta3_u = 1.0d0

      phys_m0_project_on = 1

      phys_vmask_valid = 0

      initialized=.true.
      spmove_enabled=0
      phys_replay_enabled=0
      phys_replay_active  = 0
      phys_state_saved    = 0
      phys_kappa_active = 0
      phys_accept_ready = 0
      phys_inner_used = 0
      phys_last_begin_step = -999999
      phys_last_commit_step = -999999
      phys_ax=0.0
      phys_ay=0.0
      phys_az=0.0
      phys_leb_orient=0
      ph_initialized=0
      ph_count=0
      phys_pressure_ref=0.0

      phys_pressure_ref_step=-999999

      call stage5_zero_diag
      call stage6_zero_diag
      call physalis_init_lamb_arrays
      call physalis_lebedev_init
      call physalis_check_harmonics
      call physalis_init_lamb_arrays
      if (nid.eq.0) then
         write(6,*) 'RE100 STAGE27: MEANFREE_PRESSURE_HARMONICS'
         write(6,*) 'Physalis/Nek ZP/SP validation enabled'
         write(6,*) 'Physalis/Nek: SPB embedded B runtime V20'
         write(6,*) 'Physalis/Nek: validation_case=',validation_case
         write(6,*) 'Physalis/Nek: zp_problem=',zp_problem
         call validation_print_extractor_banner
         write(6,*) 'Physalis/Nek: not yet a full np>1 solver'
         write(6,*) 'Physalis/Nek: q checked by cage/sample gap'
         write(6,*) 'Physalis/Nek: phys_mode=', phys_mode
         write(6,*) 'Physalis/Nek: lx1=', lx1
         write(6,*) 'Physalis/Nek: lx2=', lx2
         write(6,*) 'Physalis/Nek: P_vel=', lx1-1
         write(6,*) 'Physalis/Nek: lmax=', lmax
         write(6,*) 'Physalis/Nek: r_sample/a=', r_sample_over_a
         write(6,*) 'Physalis/Nek: nominal q=',r_sample_over_a
         write(6,*) 'STAGE8 SP scalar-product path retained'
         write(6,*) 'STAGE9 topology cage diagnostic'
         write(6,*) 'Physalis/Nek: beta_coeff=', beta_coeff
         write(6,*) 'STAGE4 m0_project_on=',stage4_m0_project_on
         write(6,*) 'STAGE4 diag_precon_mode=',phys_diag_precon_mode
         write(6,*) 'STAGE5 vel_scale n3/n4=',
     $      stage5_vel_scale3,stage5_vel_scale4
         write(6,*) 'STAGE5 coeff_scale n3/n4=',
     $      stage5_coeff_scale3,stage5_coeff_scale4
         write(6,*) 'STAGE6 pressure scales P3/Phi3=',
     $      stage6_p3_scale,stage6_phi3_scale
         write(6,*) 'STAGE6 pressure scales P4/Phi4=',
     $      stage6_p4_scale,stage6_phi4_scale
         write(6,*) 'STAGE6 radial_clamp=',stage6_radial_clamp
         write(6,*) 'STAGE8 fixed_cage=',stage8_fixed_cage_on
         write(6,*) 'STAGE8 cage U rin/rout=',
     $      stage8_ru_in,stage8_ru_out
         write(6,*) 'STAGE8 cage P rin/rout=',
     $      stage8_rp_in,stage8_rp_out
         write(6,*) 'STAGE9 cage mode/Pfilter=',
     $      stage9_cage_mode,stage9_pcage_filter_on
         write(6,*) 'STAGE23 SP-Nek active/frozen=',
     $      stage23_active,stage23_freeze
         write(6,*) 'STAGE23 interior/lift=',
     $      stage23_interior_on,stage23_lift_on
         write(6,*) 'STAGE24 Udynamic/Pdynamic=',
     $      stage24_udyn,stage24_pdyn
         write(6,*) 'STAGE25 pressure reference mode=',
     $      stage25_pref_mode
         write(6,*) 'STAGE26 direct mean-free correction=',
     $      stage26_meanfree
         write(6,*) 'STAGE27 pressure-cage pnmax=',stage27_pnmax
         write(6,*)
     $    'STAGE23 pressure unknowns=EXTERIOR_ONLY'
         write(6,*) 'STAGE10 U mode/ntheta=',
     $      stage10_u_mode,stage10_ntheta_u
         write(6,*) 'STAGE10 U target r/a=',
     $      stage10_target_r_over_a
         write(6,*) 'STAGE11 P mode/ntheta=',
     $      stage11_p_mode,stage11_ntheta_p
         write(6,*) 'STAGE11 P target r/a=',
     $      stage11_target_r_over_a
         write(6,*) 'STAGE12 virtual P on/ntheta=',
     $      stage12_virtual_p_on,stage12_ntheta_p
         write(6,*) 'STAGE12 virtual P target r/a=',
     $      stage12_rp_over_a
         write(6,*) 'Physalis/Nek: coeff mixer=Anderson7 m=2'
         write(6,*)
     $    'Physalis/Nek: solver=S23_SPNEK_PEXT_GMRES'
         write(6,*) 'Physalis/Nek: gate=current-state global L2'
         write(6,*) 'Physalis/Nek: inactive coeff beta=',0.30
         write(6,*) 'Physalis/Nek: Anderson beta0/fallback=',
     $      0.5,0.35
         write(6,*) 'Physalis/Nek: safeguard=window+Picard5'
         write(6,*)
     $      'Physalis/Nek: sampling=step-cache+owner-local-eval'
         write(6,*) 'Physalis/Nek: eta3_u velocity cage=', eta3_u
         write(6,*) 'Physalis/Nek: velocity cage gate tol=',5.0e-3
         write(6,*) 'Physalis/Nek: n_phys_iter=', n_phys_iter
         write(6,*) 'Physalis/Nek: pressure_relax_coeff=',
     $      pressure_relax_coeff
      endif

      return
      end


      subroutine physalis_update_particle_state
c  Expose either the committed particle state or the active kappa work
c  state to every frame transform and cage reconstruction routine.
      include 'SIZE'
      include 'TOTAL'
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      real sp_cons_reomega
      common /sp_cons_r/ sp_cons_reomega
      real phys_ax,phys_ay,phys_az
      common /physalis_particle_accel/ phys_ax,phys_ay,phys_az
      integer spmove_enabled
      common /spmove_ctl/ spmove_enabled
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized

      real pk_xn,pk_yn,pk_zn,pk_un,pk_vn,pk_wn
      real pk_anx,pk_any,pk_anz,pk_uk,pk_vk,pk_wk
      real pk_akx,pk_aky,pk_akz,pk_uc,pk_vc,pk_wc
      real pk_acx,pk_acy,pk_acz
      real coeff_resid_raw,coeff_resid_relaxed
      real particle_resid_a,particle_resid_w,closure_resid
      common /physalis_kappa_r/ pk_xn,pk_yn,pk_zn,
     $ pk_un,pk_vn,pk_wn,pk_anx,pk_any,pk_anz,
     $ pk_uk,pk_vk,pk_wk,pk_akx,pk_aky,pk_akz,
     $ pk_uc,pk_vc,pk_wc,pk_acx,pk_acy,pk_acz,
     $ coeff_resid_raw,coeff_resid_relaxed,
     $ particle_resid_a,particle_resid_w,closure_resid
      integer phys_kappa_active,phys_accept_ready,phys_inner_used
      integer phys_last_begin_step,phys_last_commit_step
      common /physalis_kappa_i/ phys_kappa_active,
     $ phys_accept_ready,phys_inner_used,
     $ phys_last_begin_step,phys_last_commit_step

      if (spmove_enabled.eq.1) then
         if (phys_kappa_active.eq.1) then
            phys_xp=pk_xn
            phys_yp=pk_yn
            phys_zp=pk_zn
            phys_up=pk_uk
            phys_vp=pk_vk
            phys_wp=pk_wk
            phys_ax=pk_akx
            phys_ay=pk_aky
            phys_az=pk_akz
         else
            phys_xp=sm_x
            phys_yp=sm_y
            phys_zp=sm_z
            phys_up=sm_u
            phys_vp=sm_v
            phys_wp=sm_w
            phys_ax=sm_ax_prev
            phys_ay=sm_ay_prev
            phys_az=sm_az_prev
         endif
         phys_ox=0.0
         phys_oy=0.0
         phys_oz=0.0
         phys_a=sm_a
         phys_rhop=sm_rhop*param(1)
      else
         call validation_config
         phys_xp=cfg_center(1)
         phys_yp=cfg_center(2)
         phys_zp=cfg_center(3)
         phys_up=0.0
         phys_vp=0.0
         phys_wp=0.0
         phys_ax=0.0
         phys_ay=0.0
         phys_az=0.0
         phys_ox=0.0
         phys_oy=0.0
         phys_oz=0.0
         phys_a=cfg_radius
         phys_rhop=cfg_rhop_ratio*param(1)
      endif
c     Optional fixed angular-momentum validation: prescribe steady
c     rotation about the Physalis axial z direction.
      call sp_conservation_config
      if (sp_cons_mode.eq.2) then
         phys_ox=0.0
         phys_oy=0.0
         phys_oz=sp_cons_reomega*abs(param(2))
     $          /max(phys_a**2,1.0e-30)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_build_gll_cage
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer stage8_fixed_cage_on
      real stage8_ru_in,stage8_ru_out,stage8_rp_in,stage8_rp_out
      common /stage8_cage_i/ stage8_fixed_cage_on
      common /stage8_cage_r/ stage8_ru_in,stage8_ru_out,
     $ stage8_rp_in,stage8_rp_out

      integer stage9_cage_mode,stage9_pcage_filter_on
      common /stage9_cage_i/ stage9_cage_mode,
     $ stage9_pcage_filter_on
      integer s35ba_uside,s35ba_pside,s35ba_layer
      integer s35bm_uside,s35bm_pside
      integer s35bm_ulayer,s35bm_player

      integer stage10_u_mode,stage10_ntheta_u
      integer stage10_bins_found
      real stage10_target_r_over_a
      real stage10_target_err_max,stage10_target_err_mean
      common /stage10_cage_i/ stage10_u_mode,
     $ stage10_ntheta_u,stage10_bins_found
      common /stage10_cage_r/ stage10_target_r_over_a,
     $ stage10_target_err_max,stage10_target_err_mean

      integer stage11_p_mode,stage11_ntheta_p
      integer stage11_bins_found,stage11_nodes_selected
      real stage11_target_r_over_a
      real stage11_target_err_max,stage11_target_err_mean
      common /stage11_cage_i/ stage11_p_mode,
     $ stage11_ntheta_p,stage11_bins_found,
     $ stage11_nodes_selected
      common /stage11_cage_r/ stage11_target_r_over_a,
     $ stage11_target_err_max,stage11_target_err_mean

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      integer e,i,j,k
      integer n_inside_u_l,n_cage_u_l,n_inside_p_l,n_cage_p_l
      real drx,dry,drz,r,ra,uc,vc,wc
      real prx,pry,prz,rp,crx,cry,crz,rc
      real cage_x,cage_y,cage_z
      real hs,hsum,hcnt,hmin
      real hp,hpsum,hpcnt,hpmin
      real minru,maxru,minrp,maxrp
      real rin_u,rout_u,rin_p,rout_p
      real delta_p_cage_local,delta_p_lift_local
      common /stage33c_pwidth_r/ delta_p_cage_local,
     $ delta_p_lift_local
      real sample_gap_h
      real num,den,eps
      logical first_cage_report
      save first_cage_report
      data first_cage_report/.true./

      ntot1 = lx1*ly1*lz1*nelv
      ntot2 = lx2*ly2*lz2*nelv
      call izero(mask_inside_u,ntot1)
      call izero(mask_cage_u,ntot1)
      call izero(mask_inside_p,ntot2)
      call izero(mask_cage_p,ntot2)
      call rzero(u_bc_cage,ntot1)
      call rzero(v_bc_cage,ntot1)
      call rzero(w_bc_cage,ntot1)
      call rzero(p_bc_cage,ntot2)

      call physalis_gll_spacing(hsum,hcnt,hmin)
      call physalis_p_spacing(hpsum,hpcnt,hpmin)

      h_gll_min  = glmin(hmin,1)
      h_gll_mean = glsum(hsum,1)/max(glsum(hcnt,1),1.0)
      h_p_min    = glmin(hpmin,1)
      h_p_mean   = glsum(hpsum,1)/max(glsum(hpcnt,1),1.0)

      if (h_gll_min.gt.1.0e19) h_gll_min = phys_a
      if (h_gll_mean.le.0.0) h_gll_mean = phys_a
      if (h_p_min.gt.1.0e19) h_p_min = h_gll_min
      if (h_p_mean.le.0.0) h_p_mean = h_gll_mean

      call zp_get_cage_center(phys_xp,phys_yp,phys_zp,phys_a,
     $ cage_x,cage_y,cage_z)
c     STAGE33C split pressure cage geometry from analytic lift support.
c     delta_p_local remains the geometric cage-width diagnostic.
      if (stage8_fixed_cage_on.eq.1) then
         rin_u  = stage8_ru_in*phys_a
         rout_u = stage8_ru_out*phys_a
         rin_p  = max(0.0,stage8_rp_in*phys_a)
         rout_p = stage8_rp_out*phys_a
         delta_u_local = rout_u-rin_u
         delta_p_cage_local = rout_p-rin_p
         delta_p_lift_local = cage_thickness_p*h_p_mean
         delta_p_local = delta_p_cage_local
      else
         delta_u_local = cage_thickness_u*h_gll_mean
         delta_p_cage_local = cage_thickness_p*h_p_mean
         delta_p_lift_local = delta_p_cage_local
         delta_p_local = delta_p_cage_local
         rin_u  = phys_a + 0.25*h_gll_mean
         rout_u = phys_a + delta_u_local + 0.25*h_gll_mean
         rin_p  = max(0.0,phys_a-delta_p_cage_local)
         rout_p = phys_a
      endif

      n_inside_u_l = 0
      n_cage_u_l   = 0
      n_inside_p_l = 0
      n_cage_p_l   = 0
      minru = 1.0e20
      maxru = 0.0
      minrp = 1.0e20
      maxrp = 0.0

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (ldim.eq.2) then
            prx=ym1(i,j,k,e)-phys_xp
            pry=0.0-phys_yp
            prz=xm1(i,j,k,e)-phys_zp
         else
            prx=xm1(i,j,k,e)-phys_xp
            pry=ym1(i,j,k,e)-phys_yp
            prz=zm1(i,j,k,e)-phys_zp
         endif
         rp=sqrt(prx*prx+pry*pry+prz*prz)
         if (ldim.eq.2) then
            crx=ym1(i,j,k,e)-cage_x
            cry=0.0-cage_y
            crz=xm1(i,j,k,e)-cage_z
         else
            crx=xm1(i,j,k,e)-cage_x
            cry=ym1(i,j,k,e)-cage_y
            crz=zm1(i,j,k,e)-cage_z
         endif
         rc=sqrt(crx*crx+cry*cry+crz*crz)
         if (rp.lt.phys_a) then
            mask_inside_u(i,j,k,e)=1
            n_inside_u_l=n_inside_u_l+1
         elseif (rc.ge.rin_u .and. rc.le.rout_u) then
            mask_cage_u(i,j,k,e)=1
            n_cage_u_l=n_cage_u_l+1
            ra=rc/max(phys_a,1.0e-20)
            minru=min(minru,ra)
            maxru=max(maxru,ra)
         endif

         drx=prx
         dry=pry
         drz=prz
         uc=phys_up+phys_oy*drz-phys_oz*dry
         vc=phys_vp+phys_oz*drx-phys_ox*drz
         wc=phys_wp+phys_ox*dry-phys_oy*drx
         if (mask_inside_u(i,j,k,e).eq.1 .or.
     $       mask_cage_u(i,j,k,e).eq.1) then
            if (ldim.eq.2) then
               u_bc_cage(i,j,k,e) = wc
               v_bc_cage(i,j,k,e) = uc
               if (sp_cons_mode.eq.2) then
                  w_bc_cage(i,j,k,e) = vc
               else
                  w_bc_cage(i,j,k,e) = 0.0
               endif
            else
               u_bc_cage(i,j,k,e) = uc
               v_bc_cage(i,j,k,e) = vc
               w_bc_cage(i,j,k,e) = wc
            endif
         endif
      enddo
      enddo
      enddo
      enddo

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (ldim.eq.2) then
            prx=ym2(i,j,k,e)-phys_xp
            pry=0.0-phys_yp
            prz=xm2(i,j,k,e)-phys_zp
         else
            prx=xm2(i,j,k,e)-phys_xp
            pry=ym2(i,j,k,e)-phys_yp
            prz=zm2(i,j,k,e)-phys_zp
         endif
         rp=sqrt(prx*prx+pry*pry+prz*prz)
         if (ldim.eq.2) then
            crx=ym2(i,j,k,e)-cage_x
            cry=0.0-cage_y
            crz=xm2(i,j,k,e)-cage_z
         else
            crx=xm2(i,j,k,e)-cage_x
            cry=ym2(i,j,k,e)-cage_y
            crz=zm2(i,j,k,e)-cage_z
         endif
         rc=sqrt(crx*crx+cry*cry+crz*crz)
         if (rp.lt.rin_p) then
            mask_inside_p(i,j,k,e)=1
            n_inside_p_l=n_inside_p_l+1
         elseif (rc.ge.rin_p .and. rc.lt.rout_p) then
            mask_cage_p(i,j,k,e)=1
            n_cage_p_l=n_cage_p_l+1
            ra=rc/max(phys_a,1.0e-20)
            minrp=min(minrp,ra)
            maxrp=max(maxrp,ra)
         endif
      enddo
      enddo
      enddo
      enddo

c     STAGE9 topology-preserving SEM cage options.
c     mode 0: original radial U + radial P
c     mode 1: outer graph-cross U + radial P
c     mode 2: outer graph-cross U + inner graph-cross P
c     mode 3: inner graph-cross U + inner graph-cross P
c     mode 4: original radial U + inner graph-cross P
      if (stage9_cage_mode.ge.1001 .and.
     $    stage9_cage_mode.le.1196) then
         call stage35bm_build_topo_velocity(stage9_cage_mode)
         call stage35bm_build_topo_pressure(stage9_cage_mode)
      elseif ((stage9_cage_mode.ge.41 .and.
     $        stage9_cage_mode.le.55) .or.
     $       (stage9_cage_mode.ge.61 .and.
     $        stage9_cage_mode.le.68)) then
         call stage35bm_build_topo_velocity(stage9_cage_mode)
         call stage35bm_build_topo_pressure(stage9_cage_mode)
      elseif (stage9_cage_mode.ge.21 .and.
     $        stage9_cage_mode.le.28) then
         call stage35ba_build_topo_velocity(stage9_cage_mode)
         call stage35ba_build_topo_pressure(stage9_cage_mode)
      else
         if (stage9_cage_mode.ge.1 .and.
     $       stage9_cage_mode.le.3)
     $      call stage9_build_topo_velocity(stage9_cage_mode)
         if (stage9_cage_mode.ge.2)
     $      call stage9_build_topo_pressure
      endif
      if (stage10_u_mode.eq.1) then
         call stage10_build_angular_velocity
      endif
      if (stage11_p_mode.eq.1) then
         call stage11_build_angular_pressure
      elseif (stage11_p_mode.eq.2) then
c        Explicit pressure-cage OFF diagnostic: no hidden P mask.
         call izero(mask_cage_p,ntot2)
      endif
      if (stage12_virtual_p_on.eq.1) then
c        Stage12 uses no nodal pressure Dirichlet rows.
         call izero(mask_cage_p,ntot2)
         call stage12_setup_virtual_pressure
      endif
      if (stage9_pcage_filter_on.eq.1 .and.
     $    stage11_p_mode.ne.1 .and.
     $    stage12_virtual_p_on.eq.0)
     $   call physalis_axisym_uniform_pcage_filter
      call stage9_seed_velocity_bc
      call stage9_recount_masks(n_inside_u_l,n_cage_u_l,
     $ n_inside_p_l,n_cage_p_l,minru,maxru,minrp,maxrp)

      n_inside_u_g = iglsum(n_inside_u_l,1)
      n_cage_u_g   = iglsum(n_cage_u_l,1)
      n_inside_p_g = iglsum(n_inside_p_l,1)
      n_cage_p_g   = iglsum(n_cage_p_l,1)

      if (n_cage_u_l.eq.0) minru = 1.0e20
      if (n_cage_p_l.eq.0) minrp = 1.0e20
      min_ru_over_a = glmin(minru,1)
      max_ru_over_a = glmax(maxru,1)
      min_rp_over_a = glmin(minrp,1)
      max_rp_over_a = glmax(maxrp,1)
      if (min_ru_over_a.gt.1.0e19) min_ru_over_a = 0.0
      if (min_rp_over_a.gt.1.0e19) min_rp_over_a = 0.0

      sample_gap_h=(r_sample_over_a-max_ru_over_a)*phys_a
     $            /max(h_gll_mean,1.0e-30)
c     UM0R Q130 diagnostic override:
c     keep zero-cage as fatal, but report small/negative R2H gap only.
c     This is intentionally for global-uniform mesh screening at fixed q/a=1.30.
      if (phys_mode.ge.4) then
         if (n_cage_u_g.le.0) then
            if (nid.eq.0) write(6,'(A,I8,3E16.8)')
     $       'ERROR: R2H zero velocity cage: ',n_cage_u_g,
     $       max_ru_over_a,r_sample_over_a,sample_gap_h
            call exitt
         endif
         if (sample_gap_h.lt.0.15) then
            if (nid.eq.0) write(6,'(A,I8,3E16.8)')
     $       'WARNING: R2H cage/sample separation: ',n_cage_u_g,
     $       max_ru_over_a,r_sample_over_a,sample_gap_h
         endif
      endif

      if (first_cage_report .and. nid.eq.0) then
         write(6,'(A,2I6)') 'STAGE9 cage mode/Pfilter=',
     $      stage9_cage_mode,stage9_pcage_filter_on
         write(6,'(A,3I8)') 'STAGE10 U mode/ntheta/found=',
     $      stage10_u_mode,stage10_ntheta_u,stage10_bins_found
         write(6,'(A,3E16.8)')
     $      'STAGE10 U target r/a,maxerr/a,meanerr/a=',
     $      stage10_target_r_over_a,stage10_target_err_max,
     $      stage10_target_err_mean
         write(6,'(A,4I8)')
     $      'STAGE11 P mode/ntheta/found/selected=',
     $      stage11_p_mode,stage11_ntheta_p,
     $      stage11_bins_found,stage11_nodes_selected
         write(6,'(A,3E16.8)')
     $      'STAGE11 P target r/a,maxerr/a,meanerr/a=',
     $      stage11_target_r_over_a,stage11_target_err_max,
     $      stage11_target_err_mean
         write(6,'(A,4I8)')
     $      'STAGE12 virtual on/ncon/ntheta/setup=',
     $      stage12_virtual_p_on,stage12_ncon,
     $      stage12_ntheta_p,stage12_setup_done
         write(6,'(A,3E16.8)')
     $      'STAGE12 rp/a,geomerr/a,gram_pivmin=',
     $      stage12_rp_over_a,stage12_geom_err_max,
     $      stage12_gram_pivmin
         write(6,'(A,I8,A,2E16.8,A,I8)')
     $      'Physalis cage_u nodes=',n_cage_u_g,
     $      ' r/a[min,max]=',min_ru_over_a,max_ru_over_a,
     $      ' inside_u nodes=',n_inside_u_g
         write(6,'(A,I8,A,2E16.8,A,I8)')
     $      'Physalis cage_p nodes=',n_cage_p_g,
     $      ' r/a[min,max]=',min_rp_over_a,max_rp_over_a,
     $      ' inside_p nodes=',n_inside_p_g
         write(6,'(A,E16.8,A,2E16.8,A,2E16.8)')
     $      'Physalis r_sample/a=',r_sample_over_a,
     $      ' h_u_local[min,mean]=',h_gll_min,h_gll_mean,
     $      ' h_p_local[min,mean]=',h_p_min,h_p_mean
         write(6,'(A,E16.8)')
     $      'Physalis R2H inner gap [hmean]=',sample_gap_h
         write(6,'(A,E16.8)')
      endif

      if (phys_mode.ge.5) then
         if (stage12_virtual_p_on.eq.1) then
            if (stage12_setup_done.ne.1 .or.
     $          stage12_ncon.ne.stage12_ntheta_p) then
               if (nid.eq.0) write(6,'(A,3I8)')
     $            'ERROR: invalid Stage12 virtual P setup=',
     $            stage12_setup_done,stage12_ncon,
     $            stage12_ntheta_p
               call exitt
            endif
            if (first_cage_report .and. nid.eq.0) then
               write(6,'(A,I8,A,E16.8)')
     $            'Stage12 virtual pressure constraints=',
     $            stage12_ncon,' physical r/a=',
     $            stage12_rp_over_a
               first_cage_report=.false.
            endif
         elseif (stage11_p_mode.eq.2) then
            if (first_cage_report .and. nid.eq.0) then
               write(6,'(A,I8,A,I8)')
     $            'S&P pressure cage intentionally OFF: nodes=',
     $            n_cage_p_g,' stage11_p_mode=',stage11_p_mode
               first_cage_report=.false.
            endif
         else
            if ((stage9_cage_mode.ge.1001 .and.
     $           stage9_cage_mode.le.1196) .or.
     $          (stage9_cage_mode.ge.41 .and.
     $           stage9_cage_mode.le.55) .or.
     $          (stage9_cage_mode.ge.61 .and.
     $           stage9_cage_mode.le.68)) then
               call stage35bm_decode_cage(stage9_cage_mode,
     $            s35bm_uside,s35bm_pside,
     $            s35bm_ulayer,s35bm_player)
               if (s35bm_pside.eq.1) then
                  if (n_cage_p_g.le.0 .or.
     $                min_rp_over_a.le.1.0) then
                     if (nid.eq.0) write(6,'(A,I8,2E16.8)')
     $               'S35BM ERROR outer P count,min,max=',
     $               n_cage_p_g,min_rp_over_a,max_rp_over_a
                     call exitt
                  endif
               else
                  if (n_cage_p_g.le.0 .or.
     $                max_rp_over_a.ge.1.0) then
                     if (nid.eq.0) write(6,'(A,I8,2E16.8)')
     $               'S35BM ERROR inner P count,min,max=',
     $               n_cage_p_g,min_rp_over_a,max_rp_over_a
                     call exitt
                  endif
               endif
               if (first_cage_report .and. nid.eq.0) then
                  write(6,'(A,4I5,A,I8,A,2E16.8)')
     $             'S35BM U/Pside U/Player=',
     $             s35bm_uside,s35bm_pside,
     $             s35bm_ulayer,s35bm_player,
     $             ' Pnodes=',n_cage_p_g,' r/a=',min_rp_over_a,
     $             max_rp_over_a
                  first_cage_report=.false.
               endif
            elseif (stage9_cage_mode.ge.21 .and.
     $          stage9_cage_mode.le.28) then
               call stage35ba_decode_cage(stage9_cage_mode,
     $            s35ba_uside,s35ba_pside,s35ba_layer)
               if (s35ba_pside.eq.1) then
                  if (n_cage_p_g.le.0 .or.
     $                min_rp_over_a.le.1.0) then
                     if (nid.eq.0) write(6,'(A,I8,2E16.8)')
     $               'S35BA ERROR outer p-cage count,min,max=',
     $               n_cage_p_g,min_rp_over_a,max_rp_over_a
                     call exitt
                  endif
               else
                  if (n_cage_p_g.le.0 .or.
     $                max_rp_over_a.ge.1.0) then
                     if (nid.eq.0) write(6,'(A,I8,2E16.8)')
     $               'S35BA ERROR inner p-cage count,min,max=',
     $               n_cage_p_g,min_rp_over_a,max_rp_over_a
                     call exitt
                  endif
               endif
               if (first_cage_report .and. nid.eq.0) then
                  write(6,'(A,3I5,A,I8,A,2E16.8)')
     $             'S35BA cage Uside/Pside/layer=',
     $             s35ba_uside,s35ba_pside,s35ba_layer,
     $             ' Pnodes=',n_cage_p_g,' r/a=',min_rp_over_a,
     $             max_rp_over_a
                  first_cage_report=.false.
               endif
            else
               if (n_cage_p_g.le.0 .or.
     $             max_rp_over_a.ge.1.0) then
                  if (nid.eq.0) write(6,'(A,I8,2E16.8)')
     $               'ERROR: invalid inner p-cage: count,min,max=',
     $               n_cage_p_g,min_rp_over_a,max_rp_over_a
                  call exitt
               endif
               if (first_cage_report .and. nid.eq.0) then
                  write(6,'(A,I8,A,2E16.8,A,I8)')
     $             'S&P interior pressure cage nodes=',n_cage_p_g,
     $             ' r/a[min,max]=',min_rp_over_a,max_rp_over_a,
     $             ' deep-interior nodes=',n_inside_p_g
                  first_cage_report=.false.
               endif
            endif
         endif
      endif

      eps = 1.0e-30
      num = 0.0
      den = 0.0
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_cage_u(i,j,k,e).ne.1) cycle
         if (ldim.eq.2) then
            num = num + bm1(i,j,k,e) *
     $       ((vx(i,j,k,e)-u_bc_cage(i,j,k,e))**2 +
     $        (vy(i,j,k,e)-v_bc_cage(i,j,k,e))**2)
            den = den + bm1(i,j,k,e) *
     $       (u_bc_cage(i,j,k,e)**2 + v_bc_cage(i,j,k,e)**2)
         else
            num = num + bm1(i,j,k,e) *
     $       ((vx(i,j,k,e)-u_bc_cage(i,j,k,e))**2 +
     $        (vy(i,j,k,e)-v_bc_cage(i,j,k,e))**2 +
     $        (vz(i,j,k,e)-w_bc_cage(i,j,k,e))**2)
            den = den + bm1(i,j,k,e) *
     $       (u_bc_cage(i,j,k,e)**2 + v_bc_cage(i,j,k,e)**2 +
     $        w_bc_cage(i,j,k,e)**2)
         endif
      enddo
      enddo
      enddo
      enddo
      num = glsum(num,1)
      den = glsum(den,1)
      if (phys_mode.lt.3) then
         cage_vel_res = -1.0
      else
         cage_vel_res = sqrt(num/max(den,eps))
      endif
      if (phys_mode.lt.5) pressure_cage_res = -1.0
      div_norm = 0.0

      return
      end



c=======================================================================
c  STAGE9: topology-preserving Nek/GLL cage diagnostics.
c
c  This is a Nek spectral-element analogue of the one-layer cage idea.
c  It is NOT a literal staggered finite-difference S&P cage.
c=======================================================================


c=======================================================================
c  STAGE10: fixed-angular nearest-surface velocity cage.
c=======================================================================


c=======================================================================
c  STAGE11: fixed-angular, fixed-radius pressure cage on PN-2 mesh.
c
c  This is a Nek diagnostic construction.  For each fixed polar-angle
c  target at r=stage11_target_r_over_a*a, choose the globally nearest
c  pressure point that lies strictly inside the physical particle.
c=======================================================================


c=======================================================================
c  STAGE12 virtual pressure constraint implementation
c  STAGE12 v8: v7 formulation retained; Gram MPI reduction
c  now covers full s12max-by-s12max Fortran storage.
c=======================================================================


      subroutine stage12_setup_virtual_pressure
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      integer n,e,m,i,j,k
      integer iloc(s12max),iwrk(s12max)
      integer e_local(s12max)
      real r_local(s12max),s_local(s12max)
      real err_local(s12max),err_global(s12max)
      real rwrk(s12max)
      real gmat(s12max,s12max),gwork(s12max*s12max)
      real rr,pi12,pivmin,tolown
      real erow,ephys,epoly,eg
      real rstn(ldim)
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      if (stage12_virtual_p_on.eq.0) return
      if (stage12_setup_done.eq.1) return

      stage12_ncon=stage12_ntheta_p
      if (stage12_ncon.lt.4 .or. stage12_ncon.gt.s12max) then
         if (nid.eq.0) write(6,'(A,I8)')
     $      'ERROR: Stage12 bad pressure ntheta=',stage12_ncon
         call exitt
      endif
      if (stage12_rp_over_a.le.0.70 .or.
     $    stage12_rp_over_a.ge.1.0) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 bad virtual rp/a=',stage12_rp_over_a
         call exitt
      endif

      pi12=4.0*atan(1.0)
      rr=stage12_rp_over_a*phys_a
      do n=1,stage12_ncon
         s12_theta(n)=(dfloat(n)-0.5)*pi12/
     $      dfloat(stage12_ncon)
c        Nek x is axial, Nek y is radius.
         s12_xt(n)=phys_zp+rr*cos(s12_theta(n))
         s12_yt(n)=phys_xp+rr*sin(s12_theta(n))
         s12_zt(n)=0.0
      enddo

      call rzero(s12_w,lx2*ly2*lz2*s12max)
      stage12_geom_err_max=0.0
      stage12_row_ref_err_max=0.0
      stage12_phys_err_max=0.0
      stage12_poly_err_max=0.0

c     The present NP carrier is generated by generate_np_re2.py as
c     axis-aligned affine rectangles.  Locate each target directly on
c     the actual scaled M1 coordinates.  This avoids GSLIB's standard
c     GLL reference-coordinate assumption on IFRZER/GLJ elements.
      do n=1,stage12_ncon
         err_local(n)=1.0e30
         e_local(n)=0
         r_local(n)=0.0
         s_local(n)=0.0
         do e=1,nelv
            call stage12_try_affine_element(e,s12_xt(n),
     $         s12_yt(n),r_local(n),s_local(n),eg)
            if (eg.lt.err_local(n)) then
               err_local(n)=eg
               e_local(n)=e
            endif
         enddo
      enddo

c     Global minimum localization error for each target.
      call copy(err_global,err_local,stage12_ncon)
      call gop(err_global,rwrk,'m  ',stage12_ncon)

c     Pick exactly one MPI owner for each point.
      tolown=1.0e-12*max(phys_a,1.0e-30)
      do n=1,stage12_ncon
         iloc(n)=1000000000
         if (e_local(n).gt.0 .and.
     $       abs(err_local(n)-err_global(n)).le.tolown)
     $      iloc(n)=nid
      enddo
      call igop(iloc,iwrk,'m  ',stage12_ncon)

      do n=1,stage12_ncon
         if (iloc(n).ge.1000000000) then
            if (nid.eq.0) write(6,'(A,I8,E16.8)')
     $         'ERROR: Stage12 no owner for virtual point=',
     $         n,err_global(n)
            call exitt
         endif
         s12_owner(n)=iloc(n)
         s12_elem(n)=0

         stage12_geom_err_max=max(stage12_geom_err_max,
     $      err_global(n)/max(phys_a,1.0e-30))

         if (s12_owner(n).eq.nid) then
c           Recompute r,s for the winning local element.  Do not reuse
c           a trial value overwritten by another element in the search.
            call stage12_affine_rst(e_local(n),s12_xt(n),
     $         s12_yt(n),rstn(1),rstn(2),eg)
            if (eg.gt.1.0e-10*max(phys_a,1.0e-30)) then
               write(6,*) 'ERROR: Stage12 winning affine map bad',
     $            nid,n,e_local(n),eg
               call exitt
            endif
            s12_elem(n)=e_local(n)

            call stage12_build_pressure_row(s12_elem(n),n,rstn)
            call stage12_row_reference_error(
     $         s12_elem(n),n,rstn,erow)
            call stage12_row_physical_error(
     $         s12_elem(n),n,ephys)
            call stage12_row_polynomial_error(
     $         s12_elem(n),n,rstn,epoly)
         else
            erow=0.0
            ephys=0.0
            epoly=0.0
         endif

         erow=glmax(erow,1)
         ephys=glmax(ephys,1)
         epoly=glmax(epoly,1)
         stage12_row_ref_err_max=max(
     $      stage12_row_ref_err_max,erow)
         stage12_phys_err_max=max(stage12_phys_err_max,
     $      ephys/max(phys_a,1.0e-30))
         stage12_poly_err_max=max(
     $      stage12_poly_err_max,epoly)
      enddo

c     These are strict implementation gates, not tunable tolerances.
      if (stage12_geom_err_max.gt.1.0e-10) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 affine location error/a=',
     $      stage12_geom_err_max
         call exitt
      endif
      if (stage12_row_ref_err_max.gt.1.0e-11) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 pressure-row reference error=',
     $      stage12_row_ref_err_max
         call exitt
      endif
      if (stage12_phys_err_max.gt.1.0e-10) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 pressure physical error/a=',
     $      stage12_phys_err_max
         call exitt
      endif
      if (stage12_poly_err_max.gt.1.0e-10) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 pressure polynomial error=',
     $      stage12_poly_err_max
         call exitt
      endif

c     Gram matrix G=C*C^T for the low-rank projector.
      call rzero(gmat,s12max*s12max)
      do n=1,stage12_ncon
      do m=1,stage12_ncon
         if (s12_owner(n).eq.nid .and.
     $       s12_owner(m).eq.nid .and.
     $       s12_elem(n).eq.s12_elem(m)) then
            e=s12_elem(n)
            do k=1,lz2
            do j=1,ly2
            do i=1,lx2
               gmat(n,m)=gmat(n,m)+
     $            s12_w(i,j,k,n)*s12_w(i,j,k,m)
            enddo
            enddo
            enddo
         endif
      enddo
      enddo
c     IMPORTANT: gmat is dimensioned (s12max,s12max).  The leading
c     ncon-by-ncon block is not contiguous when ncon < s12max.
c     Reduce the full storage so every active matrix column is global.
      call gop(gmat,gwork,'+  ',s12max*s12max)
      call stage12_check_gram(gmat,stage12_ncon)
      call stage12_invert_small(gmat,s12_ginv,stage12_ncon,
     $   pivmin)
      stage12_gram_pivmin=pivmin
      if (stage12_gram_pivmin.lt.1.0e-10) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 constraint Gram nearly singular=',
     $      stage12_gram_pivmin
         call exitt
      endif

      stage12_setup_done=1
      if (nid.eq.0) then
         write(6,'(A,I8,5E16.8)')
     $      'STAGE12 v6 n,rp,loc,ref,phys,poly=',
     $      stage12_ncon,stage12_rp_over_a,
     $      stage12_geom_err_max,stage12_row_ref_err_max,
     $      stage12_phys_err_max,stage12_poly_err_max
         write(6,'(A,E16.8)')
     $      'STAGE12 v6 Gram pivot min=',stage12_gram_pivmin
      endif

      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_try_affine_element(e,xt,yt,rr,ss,err)
      include 'SIZE'
      include 'TOTAL'
      integer e
      real xt,yt,rr,ss,err
      real xmin,xmax,ymin,ymax,pad
      real rt,st,xr,yr
      integer i,j,k

      xmin=1.0e30
      xmax=-1.0e30
      ymin=1.0e30
      ymax=-1.0e30
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         xmin=min(xmin,xm1(i,j,k,e))
         xmax=max(xmax,xm1(i,j,k,e))
         ymin=min(ymin,ym1(i,j,k,e))
         ymax=max(ymax,ym1(i,j,k,e))
      enddo
      enddo
      enddo

      pad=1.0e-10*max(xmax-xmin,ymax-ymin,1.0e-30)
      err=1.0e30
      if (xt.lt.xmin-pad .or. xt.gt.xmax+pad) return
      if (yt.lt.ymin-pad .or. yt.gt.ymax+pad) return
      if (xmax-xmin.le.1.0e-30 .or.
     $    ymax-ymin.le.1.0e-30) return

      rt=(2.0*xt-xmin-xmax)/(xmax-xmin)
      st=(2.0*yt-ymin-ymax)/(ymax-ymin)
      if (rt.lt.-1.00000001 .or. rt.gt.1.00000001) return
      if (st.lt.-1.00000001 .or. st.gt.1.00000001) return

      call stage12_eval_m1_geom(e,rt,st,xr,yr)
      err=sqrt((xr-xt)**2+(yr-yt)**2)
      rr=rt
      ss=st
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_affine_rst(e,xt,yt,rr,ss,err)
      include 'SIZE'
      include 'TOTAL'
      integer e
      real xt,yt,rr,ss,err
      real xmin,xmax,ymin,ymax,xr,yr
      integer i,j,k

      xmin=1.0e30
      xmax=-1.0e30
      ymin=1.0e30
      ymax=-1.0e30
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         xmin=min(xmin,xm1(i,j,k,e))
         xmax=max(xmax,xm1(i,j,k,e))
         ymin=min(ymin,ym1(i,j,k,e))
         ymax=max(ymax,ym1(i,j,k,e))
      enddo
      enddo
      enddo

      rr=(2.0*xt-xmin-xmax)/(xmax-xmin)
      ss=(2.0*yt-ymin-ymax)/(ymax-ymin)
      call stage12_eval_m1_geom(e,rr,ss,xr,yr)
      err=sqrt((xr-xt)**2+(yr-yt)**2)
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_eval_m1_geom(e,rr,ss,xv,yv)
      include 'SIZE'
      include 'TOTAL'
      integer e,i,j,k
      real rr,ss,xv,yv
      real li(lx1),lj(ly1),lk(lz1),w

      call stage12_lagrange_1d(rr,zgm1(1,1),lx1,li)
      if (ldim.eq.2 .and. ifaxis .and. ifrzer(e)) then
         call stage12_lagrange_1d(ss,zam1,ly1,lj)
      else
         call stage12_lagrange_1d(ss,zgm1(1,2),ly1,lj)
      endif
      if (ldim.eq.3) then
         call stage12_lagrange_1d(0.0,zgm1(1,3),lz1,lk)
      else
         lk(1)=1.0
      endif

      xv=0.0
      yv=0.0
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         w=li(i)*lj(j)*lk(k)
         xv=xv+w*xm1(i,j,k,e)
         yv=yv+w*ym1(i,j,k,e)
      enddo
      enddo
      enddo
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_build_pressure_row(e,n,rstn)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      integer e,n,i,j,k
      real rstn(ldim)
      real li(lx2),lj(ly2),lk(lz2)

      call stage12_lagrange_1d(rstn(1),
     $   zgm2(1,1),lx2,li)
      if (ldim.eq.2 .and. ifaxis .and. ifrzer(e)) then
         call stage12_lagrange_1d(rstn(2),zam2,ly2,lj)
      else
         call stage12_lagrange_1d(rstn(2),
     $      zgm2(1,2),ly2,lj)
      endif
      if (ldim.eq.3) then
         call stage12_lagrange_1d(rstn(3),
     $      zgm2(1,3),lz2,lk)
      else
         lk(1)=1.0
      endif

      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         s12_w(i,j,k,n)=li(i)*lj(j)*lk(k)
      enddo
      enddo
      enddo
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_row_reference_error(e,n,rstn,err)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      integer e,n,i,j,k
      real rstn(ldim),err
      real sw,rv,sv,zr,zs,w

      sw=0.0
      rv=0.0
      sv=0.0
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         w=s12_w(i,j,k,n)
         zr=zgm2(i,1)
         if (ldim.eq.2 .and. ifaxis .and. ifrzer(e)) then
            zs=zam2(j)
         else
            zs=zgm2(j,2)
         endif
         sw=sw+w
         rv=rv+w*zr
         sv=sv+w*zs
      enddo
      enddo
      enddo
      err=sqrt((sw-1.0)**2+(rv-rstn(1))**2+
     $   (sv-rstn(2))**2)
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_row_physical_error(e,n,err)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      integer e,n,i,j,k
      real err,xv,yv,zv,w

      xv=0.0
      yv=0.0
      zv=0.0
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         w=s12_w(i,j,k,n)
         xv=xv+w*xm2(i,j,k,e)
         yv=yv+w*ym2(i,j,k,e)
         if (ldim.eq.3) zv=zv+w*zm2(i,j,k,e)
      enddo
      enddo
      enddo

      if (ldim.eq.2) then
         err=sqrt((xv-s12_xt(n))**2+
     $      (yv-s12_yt(n))**2)
      else
         err=sqrt((xv-s12_xt(n))**2+
     $      (yv-s12_yt(n))**2+
     $      (zv-s12_zt(n))**2)
      endif
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_row_polynomial_error(e,n,rstn,err)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      integer e,n,i,j,k,s12ip,s12jp
      real rstn(ldim),err,zr,zs,w,val,exact,dif

      err=0.0
      do s12jp=0,ly2-1
      do s12ip=0,lx2-1
         val=0.0
         do k=1,lz2
         do j=1,ly2
         do i=1,lx2
            zr=zgm2(i,1)
            if (ldim.eq.2 .and. ifaxis .and.
     $          ifrzer(e)) then
               zs=zam2(j)
            else
               zs=zgm2(j,2)
            endif
            w=s12_w(i,j,k,n)
            val=val+w*(zr**s12ip)*(zs**s12jp)
         enddo
         enddo
         enddo
         exact=(rstn(1)**s12ip)*(rstn(2)**s12jp)
         dif=abs(val-exact)
         err=max(err,dif)
      enddo
      enddo
      return
      end

c-----------------------------------------------------------------------


      subroutine stage12_lagrange_1d(x,z,n,l)
      integer n,i,m
      real x,z(n),l(n),den
      do i=1,n
         l(i)=1.0
         do m=1,n
            if (m.ne.i) then
               den=z(i)-z(m)
               if (abs(den).le.1.0e-30) then
                  write(6,*) 'ERROR: Stage12 duplicate GL nodes'
                  call exitt
               endif
               l(i)=l(i)*(x-z(m))/den
            endif
         enddo
      enddo
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_row_geom_error(e,n,err)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      integer e,n,i,j,k
      real err,xv,yv,zv,w
      xv=0.0
      yv=0.0
      zv=0.0
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         w=s12_w(i,j,k,n)
         xv=xv+w*xm2(i,j,k,e)
         yv=yv+w*ym2(i,j,k,e)
         if (ldim.eq.3) zv=zv+w*zm2(i,j,k,e)
      enddo
      enddo
      enddo
      if (ldim.eq.2) then
         err=sqrt((xv-s12_xt(n))**2+(yv-s12_yt(n))**2)
      else
         err=sqrt((xv-s12_xt(n))**2+(yv-s12_yt(n))**2+
     $      (zv-s12_zt(n))**2)
      endif
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_eval_constraints(v,cv)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv)
      real cv(s12max),wrk(s12max)
      integer n,e,i,j,k

      call rzero(cv,s12max)
      do n=1,stage12_ncon
         if (s12_owner(n).eq.nid) then
            e=s12_elem(n)
            do k=1,lz2
            do j=1,ly2
            do i=1,lx2
               cv(n)=cv(n)+s12_w(i,j,k,n)*v(i,j,k,e)
            enddo
            enddo
            enddo
         endif
      enddo
      call gop(cv,wrk,'+  ',stage12_ncon)
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_add_ct(v,lam,alpha)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv),lam(s12max),alpha
      integer n,e,i,j,k

      do n=1,stage12_ncon
         if (s12_owner(n).eq.nid) then
            e=s12_elem(n)
            do k=1,lz2
            do j=1,ly2
            do i=1,lx2
               v(i,j,k,e)=v(i,j,k,e)+alpha*lam(n)*
     $            s12_w(i,j,k,n)
            enddo
            enddo
            enddo
         endif
      enddo
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_project_m2(v)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv)
      real cv(s12max),lam(s12max)
      integer n,m

      if (stage12_virtual_p_on.eq.0) return
      if (stage12_setup_done.ne.1) return

      call stage12_eval_constraints(v,cv)
      call rzero(lam,s12max)
      do n=1,stage12_ncon
         do m=1,stage12_ncon
            lam(n)=lam(n)+s12_ginv(n,m)*cv(m)
         enddo
      enddo
      call stage12_add_ct(v,lam,-1.0)
      return
      end

c-----------------------------------------------------------------------
c-----------------------------------------------------------------------
      subroutine stage12_constraint_metrics(v,target,errabs,tgnorm,rel)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv),target(s12max)
      real cv(s12max),num,den,errabs,tgnorm,rel
      integer n
      call stage12_eval_constraints(v,cv)
      num=0.0
      den=0.0
      do n=1,stage12_ncon
         num=num+(cv(n)-target(n))**2
         den=den+target(n)**2
      enddo
      errabs=sqrt(max(num,0.0))
      tgnorm=sqrt(max(den,0.0))
      rel=errabs/max(tgnorm,1.0e-30)
      return
      end
      subroutine stage12_constraint_error(v,target,rel)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv),target(s12max)
      real rel,errabs,tgnorm
      call stage12_constraint_metrics(v,target,errabs,tgnorm,rel)
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_constraint_mean(v,s12cmean)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv),cv(s12max)
      real s12cmean,sw,w
      integer n

      if (stage12_setup_done.ne.1) then
         s12cmean=0.0
         return
      endif
      call stage12_eval_constraints(v,cv)
      s12cmean=0.0
      sw=0.0
      do n=1,stage12_ncon
c        Axisymmetric spherical surface-area weight.
         w=max(sin(s12_theta(n)),1.0e-12)
         s12cmean=s12cmean+w*cv(n)
         sw=sw+w
      enddo
      s12cmean=s12cmean/max(sw,1.0e-30)
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_virtual_pbc_values(pbc)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real pbc(s12max)
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real dxp,dyp,dzp,rr,ptil,pshift
      integer n

      rr=stage12_rp_over_a*phys_a
      do n=1,stage12_ncon
         dxp=s12_yt(n)-phys_xp
         dyp=0.0-phys_yp
         dzp=s12_xt(n)-phys_zp
         call physalis_lamb_pressure_at_point(dxp,dyp,dzp,rr,
     $      phys_a,p_re,p_im,phi_re,phi_im,lmax,ptil)
         call physalis_sp_pressure_frame_shift(dxp,dyp,dzp,pshift)
         pbc(n)=ptil+phys_pressure_ref+pshift
      enddo
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_build_target_phi(up,scaledt,gamma,target)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real up(lx2,ly2,lz2,lelv)
      real scaledt,gamma,target(s12max)
      real cup(s12max),pbc(s12max)
      integer n
      call stage12_eval_constraints(up,cup)
      call stage12_virtual_pbc_values(pbc)
      do n=1,stage12_ncon
         target(n)=gamma*(pbc(n)-cup(n))*scaledt
      enddo
      return
      end

c-----------------------------------------------------------------------
      subroutine stage12_force_lift_constraints(v,target)
c  Same lift equation; Stage13 changes only its numerical audit.
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv),target(s12max)
      real cv(s12max),del(s12max),lam(s12max)
      real s12_atol,rtol_warn,rtol_fatal
      integer n,m
      parameter(s12_atol=1.0e-11)
      parameter(rtol_warn=1.0e-8)
      parameter(rtol_fatal=1.0e-6)

      call stage12_eval_constraints(v,cv)
      do n=1,stage12_ncon
         del(n)=target(n)-cv(n)
      enddo
      call rzero(lam,s12max)
      do n=1,stage12_ncon
         do m=1,stage12_ncon
            lam(n)=lam(n)+s12_ginv(n,m)*del(m)
         enddo
      enddo
      call stage12_add_ct(v,lam,1.0)

      call stage12_constraint_metrics(v,target,
     $ stage12_constraint_abs,stage12_constraint_target,
     $ stage12_constraint_rel)
      stage12_constraint_tol=s12_atol+
     $ rtol_warn*stage12_constraint_target
      stage12_constraint_fatal=s12_atol+
     $ rtol_fatal*stage12_constraint_target

      if (stage12_constraint_abs.gt.stage12_constraint_tol) then
         stage12_constraint_warn_count=
     $    stage12_constraint_warn_count+1
         if (nid.eq.0 .and.
     $    (stage12_constraint_warn_count.le.5 .or.
     $     mod(stage12_constraint_warn_count,100).eq.0)) then
            write(6,'(A,I9,4E16.8)')
     $       'WARN Stage12 lift step abs/tgt/rel/tol=',
     $       istep,stage12_constraint_abs,
     $       stage12_constraint_target,stage12_constraint_rel,
     $       stage12_constraint_tol
         endif
      endif

      if (stage12_constraint_abs.gt.stage12_constraint_fatal) then
         if (nid.eq.0) write(6,'(A,I9,4E16.8)')
     $      'ERROR Stage12 lift step abs/tgt/rel/fatal=',
     $      istep,stage12_constraint_abs,
     $      stage12_constraint_target,stage12_constraint_rel,
     $      stage12_constraint_fatal
         call exitt
      endif
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_pressure_constraint_residual(v,res)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real v(lx2,ly2,lz2,lelv),res
      real cv(s12max),pbc(s12max),num,den,w
      integer n
      call stage12_eval_constraints(v,cv)
      call stage12_virtual_pbc_values(pbc)
      num=0.0
      den=0.0
      do n=1,stage12_ncon
         w=max(sin(s12_theta(n)),1.0e-12)
         num=num+w*(cv(n)-pbc(n))**2
         den=den+w*max(cv(n)**2,pbc(n)**2)
      enddo
      res=sqrt(num/max(den,1.0e-30))
      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_check_gram(g,nc)
      include 'SIZE'
      include 'STAGE12'
      real g(s12max,s12max)
      integer nc,i,j
      real dmin,dmax,symerr,den,rel

      dmin=1.0e30
      dmax=0.0
      symerr=0.0
      do j=1,nc
      do i=1,nc
         den=max(abs(g(i,j)),abs(g(j,i)),1.0e-30)
         rel=abs(g(i,j)-g(j,i))/den
         symerr=max(symerr,rel)
      enddo
         dmin=min(dmin,g(j,j))
         dmax=max(dmax,g(j,j))
      enddo

      if (nid.eq.0) then
         write(6,'(A,3E16.8)')
     $      'STAGE12 Gram diag[min,max],symerr=',
     $      dmin,dmax,symerr
      endif

      if (dmin.le.1.0e-12) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 nonpositive Gram diagonal=',dmin
         call exitt
      endif
      if (symerr.gt.1.0e-12) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: Stage12 nonsymmetric Gram=',symerr
         call exitt
      endif

      return
      end

c-----------------------------------------------------------------------

      subroutine stage12_invert_small(a,ainv,n,pivmin)
      include 'SIZE'
      include 'STAGE12'
      real a(s12max,s12max),ainv(s12max,s12max)
      real aug(s12max,2*s12max)
      real pivmin,piv,fac,tmp,pmax
      integer n,i,j,k,ip

      call rzero(aug,s12max*2*s12max)
      do i=1,n
         do j=1,n
            aug(i,j)=a(i,j)
         enddo
         aug(i,n+i)=1.0
      enddo

      pivmin=1.0e30
      do k=1,n
         ip=k
         pmax=abs(aug(k,k))
         do i=k+1,n
            if (abs(aug(i,k)).gt.pmax) then
               pmax=abs(aug(i,k))
               ip=i
            endif
         enddo
         if (pmax.le.1.0e-14) then
            if (nid.eq.0) write(6,'(A,I8,E16.8)')
     $         'ERROR: Stage12 singular Gram pivot=',k,pmax
            call exitt
         endif
         if (ip.ne.k) then
            do j=1,2*n
               tmp=aug(k,j)
               aug(k,j)=aug(ip,j)
               aug(ip,j)=tmp
            enddo
         endif
         piv=aug(k,k)
         pivmin=min(pivmin,abs(piv))
         do j=1,2*n
            aug(k,j)=aug(k,j)/piv
         enddo
         do i=1,n
            if (i.ne.k) then
               fac=aug(i,k)
               do j=1,2*n
                  aug(i,j)=aug(i,j)-fac*aug(k,j)
               enddo
            endif
         enddo
      enddo

      call rzero(ainv,s12max*s12max)
      do i=1,n
         do j=1,n
            ainv(i,j)=aug(i,n+j)
         enddo
      enddo
      return
      end

c-----------------------------------------------------------------------

      subroutine stage11_build_angular_pressure
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer stage11_p_mode,stage11_ntheta_p
      integer stage11_bins_found,stage11_nodes_selected
      real stage11_target_r_over_a
      real stage11_target_err_max,stage11_target_err_mean
      common /stage11_cage_i/ stage11_p_mode,
     $ stage11_ntheta_p,stage11_bins_found,
     $ stage11_nodes_selected
      common /stage11_cage_r/ stage11_target_r_over_a,
     $ stage11_target_err_max,stage11_target_err_mean

      integer s11_nmax
      parameter(s11_nmax=64)
      real s11_best(s11_nmax),s11_work(s11_nmax)
      real s11_theta(s11_nmax)

      integer e,i,j,k,jt,nth,ntot2,nfound,nsel_l
      real crx,cry,crz,rad,rc,theta,pi_loc
      real rtar,ytar,ztar,dist,tol
      real esum,emax
      logical candidate

      nth=stage11_ntheta_p
      if (nth.lt.4 .or. nth.gt.s11_nmax) then
         if (nid.eq.0) write(6,'(A,I8)')
     $      'ERROR: bad STAGE11 pressure ntheta=',nth
         call exitt
      endif

      if (stage11_target_r_over_a.lt.0.70 .or.
     $    stage11_target_r_over_a.ge.1.0) then
         if (nid.eq.0) write(6,'(A,E16.8)')
     $      'ERROR: bad STAGE11 pressure target r/a=',
     $      stage11_target_r_over_a
         call exitt
      endif

      ntot2=lx2*ly2*lz2*nelv
      call izero(mask_inside_p,ntot2)
      call izero(mask_cage_p,ntot2)

      pi_loc=4.0*atan(1.0)
      rtar=stage11_target_r_over_a*phys_a

      do jt=1,nth
         s11_theta(jt)=(dfloat(jt)-0.5)*pi_loc/dfloat(nth)
         s11_best(jt)=1.0e20
      enddo

c     Classify the PN-2 pressure points and find each bin's global best
c     distance to its fixed physical target.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (ldim.eq.2) then
            crx=ym2(i,j,k,e)-phys_xp
            cry=0.0-phys_yp
            crz=xm2(i,j,k,e)-phys_zp
         else
            crx=xm2(i,j,k,e)-phys_xp
            cry=ym2(i,j,k,e)-phys_yp
            crz=zm2(i,j,k,e)-phys_zp
         endif

         rad=sqrt(crx*crx+cry*cry)
         rc=sqrt(rad*rad+crz*crz)
         if (rc.lt.phys_a) mask_inside_p(i,j,k,e)=1
         candidate=(rc.lt.phys_a)
         if (.not.candidate) cycle

         theta=atan2(rad,crz)
         jt=int(theta/pi_loc*dfloat(nth))+1
         jt=max(1,min(nth,jt))

         ytar=rtar*sin(s11_theta(jt))
         ztar=rtar*cos(s11_theta(jt))
         dist=(rad-ytar)**2+(crz-ztar)**2
         s11_best(jt)=min(s11_best(jt),dist)
      enddo
      enddo
      enddo
      enddo

      call gop(s11_best,s11_work,'m  ',nth)

      nfound=0
      esum=0.0
      emax=0.0
      do jt=1,nth
         if (s11_best(jt).lt.1.0e19) then
            nfound=nfound+1
            esum=esum+sqrt(max(s11_best(jt),0.0))
            emax=max(emax,sqrt(max(s11_best(jt),0.0)))
         endif
      enddo

      stage11_bins_found=nfound
      stage11_target_err_max=emax/max(phys_a,1.0e-30)
      if (nfound.gt.0) then
         stage11_target_err_mean=
     $      esum/dfloat(nfound)/max(phys_a,1.0e-30)
      else
         stage11_target_err_mean=1.0e20
      endif

      if (nfound.ne.nth) then
         if (nid.eq.0) write(6,'(A,2I8)')
     $      'ERROR: STAGE11 pressure bins missing=',nfound,nth
         call exitt
      endif

c     Tight tolerance plus exact selected-count gate below prevents
c     accidental multiple winners in one angular bin.
      tol=1.0e-12*max(phys_a*phys_a,1.0e-30)

c     Retain the winner of each pressure point's assigned angular bin.
c     PN-2 pressure points are element-local, so no GLL DSOP is used.
      nsel_l=0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).ne.1) cycle

         if (ldim.eq.2) then
            crx=ym2(i,j,k,e)-phys_xp
            cry=0.0-phys_yp
            crz=xm2(i,j,k,e)-phys_zp
         else
            crx=xm2(i,j,k,e)-phys_xp
            cry=ym2(i,j,k,e)-phys_yp
            crz=zm2(i,j,k,e)-phys_zp
         endif

         rad=sqrt(crx*crx+cry*cry)
         theta=atan2(rad,crz)
         jt=int(theta/pi_loc*dfloat(nth))+1
         jt=max(1,min(nth,jt))

         ytar=rtar*sin(s11_theta(jt))
         ztar=rtar*cos(s11_theta(jt))
         dist=(rad-ytar)**2+(crz-ztar)**2

         if (abs(dist-s11_best(jt)).le.tol) then
            mask_cage_p(i,j,k,e)=1
            nsel_l=nsel_l+1
         endif
      enddo
      enddo
      enddo
      enddo

      stage11_nodes_selected=iglsum(nsel_l,1)

c     Fixed angular DOF means exactly one selected pressure point/bin.
c     Abort rather than silently changing the pressure constraint count.
      if (stage11_nodes_selected.ne.nth) then
         if (nid.eq.0) write(6,'(A,2I8)')
     $      'ERROR: STAGE11 P selected/target=',
     $      stage11_nodes_selected,nth
         call exitt
      endif

      return
      end

c-----------------------------------------------------------------------

      subroutine stage10_build_angular_velocity
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer stage10_u_mode,stage10_ntheta_u
      integer stage10_bins_found
      real stage10_target_r_over_a
      real stage10_target_err_max,stage10_target_err_mean
      common /stage10_cage_i/ stage10_u_mode,
     $ stage10_ntheta_u,stage10_bins_found
      common /stage10_cage_r/ stage10_target_r_over_a,
     $ stage10_target_err_max,stage10_target_err_mean

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      integer s10_nmax
      parameter(s10_nmax=64)
      real s10_best(s10_nmax),s10_work(s10_nmax)
      real s10_theta(s10_nmax)
      real s10tmp(lx1,ly1,lz1,lelv)
      common /stage10_maskwrk/ s10tmp

      integer e,i,j,k,jt,ntot1,nth,nfound
      real crx,cry,crz,rad,rc,theta,pi_loc
      real rtar,ytar,ztar,dist,tol,rmax
      real esum,emax
      logical candidate

      pi_loc=4.0*atan(1.0)
      nth=stage10_ntheta_u
      if (nth.lt.4 .or. nth.gt.s10_nmax) then
         if (nid.eq.0) write(6,'(A,I8)')
     $      'ERROR: bad STAGE10 velocity ntheta=',nth
         call exitt
      endif

      ntot1=lx1*ly1*lz1*nelv
      call rzero(s10tmp,ntot1)

      rtar=stage10_target_r_over_a*phys_a
      rmax=r_sample_over_a*phys_a-0.15*h_gll_mean

      do jt=1,nth
         s10_theta(jt)=(dfloat(jt)-0.5)*pi_loc/dfloat(nth)
         s10_best(jt)=1.0e20
      enddo

c     First pass: assign every outside candidate to one angle bin.
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_inside_u(i,j,k,e).eq.1) cycle
         if (ldim.eq.2) then
            crx=ym1(i,j,k,e)-phys_xp
            cry=0.0-phys_yp
            crz=xm1(i,j,k,e)-phys_zp
         else
            crx=xm1(i,j,k,e)-phys_xp
            cry=ym1(i,j,k,e)-phys_yp
            crz=zm1(i,j,k,e)-phys_zp
         endif
         rad=sqrt(crx*crx+cry*cry)
         rc=sqrt(rad*rad+crz*crz)
         candidate=(rc.ge.phys_a .and. rc.le.rmax)
         if (.not.candidate) cycle

         theta=atan2(rad,crz)
         jt=int(theta/pi_loc*dfloat(nth))+1
         jt=max(1,min(nth,jt))
         ytar=rtar*sin(s10_theta(jt))
         ztar=rtar*cos(s10_theta(jt))
         dist=(rad-ytar)**2+(crz-ztar)**2
         s10_best(jt)=min(s10_best(jt),dist)
      enddo
      enddo
      enddo
      enddo

      call gop(s10_best,s10_work,'m  ',nth)

      nfound=0
      esum=0.0
      emax=0.0
      do jt=1,nth
         if (s10_best(jt).lt.1.0e19) then
            nfound=nfound+1
            esum=esum+sqrt(max(s10_best(jt),0.0))
            emax=max(emax,sqrt(max(s10_best(jt),0.0)))
         endif
      enddo
      stage10_bins_found=nfound
      stage10_target_err_max=emax/max(phys_a,1.0e-30)
      if (nfound.gt.0) then
         stage10_target_err_mean=
     $      esum/dfloat(nfound)/max(phys_a,1.0e-30)
      else
         stage10_target_err_mean=1.0e20
      endif

      if (nfound.ne.nth) then
         if (nid.eq.0) write(6,'(A,2I8,2E16.8)')
     $      'ERROR: STAGE10 angular bins missing=',nfound,nth,
     $      rmax/max(phys_a,1.0e-30),r_sample_over_a
         call exitt
      endif

      tol=1.0e-10*max(h_gll_mean*h_gll_mean,1.0e-30)

c     Second pass: keep the global winner in each assigned angle bin.
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_inside_u(i,j,k,e).eq.1) cycle
         if (ldim.eq.2) then
            crx=ym1(i,j,k,e)-phys_xp
            cry=0.0-phys_yp
            crz=xm1(i,j,k,e)-phys_zp
         else
            crx=xm1(i,j,k,e)-phys_xp
            cry=ym1(i,j,k,e)-phys_yp
            crz=zm1(i,j,k,e)-phys_zp
         endif
         rad=sqrt(crx*crx+cry*cry)
         rc=sqrt(rad*rad+crz*crz)
         candidate=(rc.ge.phys_a .and. rc.le.rmax)
         if (.not.candidate) cycle

         theta=atan2(rad,crz)
         jt=int(theta/pi_loc*dfloat(nth))+1
         jt=max(1,min(nth,jt))
         ytar=rtar*sin(s10_theta(jt))
         ztar=rtar*cos(s10_theta(jt))
         dist=(rad-ytar)**2+(crz-ztar)**2
         if (abs(dist-s10_best(jt)).le.tol)
     $      s10tmp(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo

      call dsop(s10tmp,'MXA',lx1,ly1,lz1)

      call izero(mask_cage_u,ntot1)
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (s10tmp(i,j,k,e).gt.0.5)
     $      mask_cage_u(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine stage35ba_decode_cage(mode,uside,pside,layer)
      include 'SIZE'
      include 'TOTAL'
      integer mode,uside,pside,layer

c     side convention: +1=outside, -1=inside.
      uside=0
      pside=0
      layer=0
      if (mode.eq.21) then
         uside= 1
         pside=-1
         layer=1
      elseif (mode.eq.22) then
         uside=-1
         pside=-1
         layer=1
      elseif (mode.eq.23) then
         uside=-1
         pside= 1
         layer=1
      elseif (mode.eq.24) then
         uside= 1
         pside= 1
         layer=1
      elseif (mode.eq.25) then
         uside= 1
         pside=-1
         layer=2
      elseif (mode.eq.26) then
         uside=-1
         pside=-1
         layer=2
      elseif (mode.eq.27) then
         uside=-1
         pside= 1
         layer=2
      elseif (mode.eq.28) then
         uside= 1
         pside= 1
         layer=2
      else
         if (nid.eq.0) write(6,'(A,I8)')
     $      'S35BA FATAL invalid cage mode=',mode
         call exitt
      endif
      return
      end
c-----------------------------------------------------------------------

      subroutine stage35ba_build_topo_velocity(mode)
      include 'SIZE'
      include 'TOTAL'
      integer mode,uside,pside,layer,target
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      real cur(lx1,ly1,lz1,lelv)
      real nxt(lx1,ly1,lz1,lelv)
      common /s35ba_uwrk/ cur,nxt
      integer e,i,j,k,ntot1
      logical cross,near

      call stage35ba_decode_cage(mode,uside,pside,layer)
      ntot1=lx1*ly1*lz1*nelv
      call rzero(cur,ntot1)
      call rzero(nxt,ntot1)
      call izero(mask_cage_u,ntot1)
      if (uside.eq.1) then
         target=0
      else
         target=1
      endif

c     Layer 1: requested-side endpoint of a local edge crossing r=a.
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_inside_u(i,j,k,e).ne.target) cycle
         cross=.false.
         if (i.gt.1) then
            if (mask_inside_u(i-1,j,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (i.lt.lx1) then
            if (mask_inside_u(i+1,j,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (j.gt.1) then
            if (mask_inside_u(i,j-1,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (j.lt.ly1) then
            if (mask_inside_u(i,j+1,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (mask_inside_u(i,j,k-1,e).ne.
     $             mask_inside_u(i,j,k,e)) cross=.true.
            endif
            if (k.lt.lz1) then
               if (mask_inside_u(i,j,k+1,e).ne.
     $             mask_inside_u(i,j,k,e)) cross=.true.
            endif
         endif
         if (cross) cur(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo
      call dsop(cur,'MXA',lx1,ly1,lz1)

      if (layer.eq.1) then
         do e=1,nelv
         do k=1,lz1
         do j=1,ly1
         do i=1,lx1
            if (cur(i,j,k,e).gt.0.5 .and.
     $          mask_inside_u(i,j,k,e).eq.target)
     $         mask_cage_u(i,j,k,e)=1
         enddo
         enddo
         enddo
         enddo
         return
      endif

c     Layer 2: next graph shell on same side; layer 1 is excluded.
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_inside_u(i,j,k,e).ne.target) cycle
         if (cur(i,j,k,e).gt.0.5) cycle
         near=.false.
         if (i.gt.1) then
            if (cur(i-1,j,k,e).gt.0.5) near=.true.
         endif
         if (i.lt.lx1) then
            if (cur(i+1,j,k,e).gt.0.5) near=.true.
         endif
         if (j.gt.1) then
            if (cur(i,j-1,k,e).gt.0.5) near=.true.
         endif
         if (j.lt.ly1) then
            if (cur(i,j+1,k,e).gt.0.5) near=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (cur(i,j,k-1,e).gt.0.5) near=.true.
            endif
            if (k.lt.lz1) then
               if (cur(i,j,k+1,e).gt.0.5) near=.true.
            endif
         endif
         if (near) nxt(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo
      call dsop(nxt,'MXA',lx1,ly1,lz1)

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (nxt(i,j,k,e).gt.0.5 .and.
     $       cur(i,j,k,e).le.0.5 .and.
     $       mask_inside_u(i,j,k,e).eq.target)
     $      mask_cage_u(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo
      return
      end
c-----------------------------------------------------------------------

      subroutine stage35ba_build_topo_pressure(mode)
      include 'SIZE'
      include 'TOTAL'
      integer mode,uside,pside,layer,target
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      real cur(lx2,ly2,lz2,lelv)
      real nxt(lx2,ly2,lz2,lelv)
      common /s35ba_pwrk/ cur,nxt
      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      integer e,i,j,k,ntot2
      real xx,yy,zz,rr
      logical cross,near

      call stage35ba_decode_cage(mode,uside,pside,layer)
      ntot2=lx2*ly2*lz2*nelv
      call izero(mask_inside_p,ntot2)
      call izero(mask_cage_p,ntot2)
      call rzero(cur,ntot2)
      call rzero(nxt,ntot2)
      if (pside.eq.1) then
         target=0
      else
         target=1
      endif

c     PN-2 pressure nodes are element-local; no GLL dsop is used here.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (ldim.eq.2) then
            xx=ym2(i,j,k,e)-phys_xp
            yy=0.0-phys_yp
            zz=xm2(i,j,k,e)-phys_zp
         else
            xx=xm2(i,j,k,e)-phys_xp
            yy=ym2(i,j,k,e)-phys_yp
            zz=zm2(i,j,k,e)-phys_zp
         endif
         rr=sqrt(xx*xx+yy*yy+zz*zz)
         if (rr.lt.phys_a) mask_inside_p(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo

c     Layer 1: requested-side endpoint of a pressure-grid crossing.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).ne.target) cycle
         cross=.false.
         if (i.gt.1) then
            if (mask_inside_p(i-1,j,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (i.lt.lx2) then
            if (mask_inside_p(i+1,j,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (j.gt.1) then
            if (mask_inside_p(i,j-1,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (j.lt.ly2) then
            if (mask_inside_p(i,j+1,k,e).ne.
     $          mask_inside_p(i,j,k,e)) cross=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (mask_inside_p(i,j,k-1,e).ne.
     $             mask_inside_p(i,j,k,e)) cross=.true.
            endif
            if (k.lt.lz2) then
               if (mask_inside_p(i,j,k+1,e).ne.
     $             mask_inside_p(i,j,k,e)) cross=.true.
            endif
         endif
         if (cross) cur(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo

      if (layer.eq.1) then
         do e=1,nelv
         do k=1,lz2
         do j=1,ly2
         do i=1,lx2
            if (cur(i,j,k,e).gt.0.5)
     $         mask_cage_p(i,j,k,e)=1
         enddo
         enddo
         enddo
         enddo
         return
      endif

c     Layer 2: next element-local graph shell; layer 1 is excluded.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).ne.target) cycle
         if (cur(i,j,k,e).gt.0.5) cycle
         near=.false.
         if (i.gt.1) then
            if (cur(i-1,j,k,e).gt.0.5) near=.true.
         endif
         if (i.lt.lx2) then
            if (cur(i+1,j,k,e).gt.0.5) near=.true.
         endif
         if (j.gt.1) then
            if (cur(i,j-1,k,e).gt.0.5) near=.true.
         endif
         if (j.lt.ly2) then
            if (cur(i,j+1,k,e).gt.0.5) near=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (cur(i,j,k-1,e).gt.0.5) near=.true.
            endif
            if (k.lt.lz2) then
               if (cur(i,j,k+1,e).gt.0.5) near=.true.
            endif
         endif
         if (near) nxt(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (nxt(i,j,k,e).gt.0.5 .and.
     $       cur(i,j,k,e).le.0.5)
     $      mask_cage_p(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo
      return
      end
c-----------------------------------------------------------------------


      subroutine stage9_build_topo_velocity(mode)
      include 'SIZE'
      include 'TOTAL'

      integer mode
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u

      real s9tmp(lx1,ly1,lz1,lelv)
      common /stage9_maskwrk/ s9tmp

      integer e,i,j,k,ntot1
      logical want,cross

      ntot1=lx1*ly1*lz1*nelv
      call rzero(s9tmp,ntot1)

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         cross=.false.
         if (i.gt.1) then
            if (mask_inside_u(i-1,j,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (i.lt.lx1) then
            if (mask_inside_u(i+1,j,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (j.gt.1) then
            if (mask_inside_u(i,j-1,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (j.lt.ly1) then
            if (mask_inside_u(i,j+1,k,e).ne.
     $          mask_inside_u(i,j,k,e)) cross=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (mask_inside_u(i,j,k-1,e).ne.
     $             mask_inside_u(i,j,k,e)) cross=.true.
            endif
            if (k.lt.lz1) then
               if (mask_inside_u(i,j,k+1,e).ne.
     $             mask_inside_u(i,j,k,e)) cross=.true.
            endif
         endif

         want=.false.
         if (cross) then
            if (mode.eq.3) then
               if (mask_inside_u(i,j,k,e).eq.1) want=.true.
            else
               if (mask_inside_u(i,j,k,e).eq.0) want=.true.
            endif
         endif
         if (want) s9tmp(i,j,k,e)=1.0
      enddo
      enddo
      enddo
      enddo

c     Shared GLL nodes must receive one consistent cage decision.
c     MXA takes the union of the local interface markings.
      call dsop(s9tmp,'MXA',lx1,ly1,lz1)

      call izero(mask_cage_u,ntot1)
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (s9tmp(i,j,k,e).gt.0.5)
     $      mask_cage_u(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------

      subroutine stage9_build_topo_pressure
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer e,i,j,k,ntot2
      real s9x,s9y,s9z,s9r
      logical cross

      ntot2=lx2*ly2*lz2*nelv
      call izero(mask_inside_p,ntot2)
      call izero(mask_cage_p,ntot2)

c     Classify the PN-2 pressure points by the physical particle surface.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (ldim.eq.2) then
            s9x=ym2(i,j,k,e)-phys_xp
            s9y=0.0-phys_yp
            s9z=xm2(i,j,k,e)-phys_zp
         else
            s9x=xm2(i,j,k,e)-phys_xp
            s9y=ym2(i,j,k,e)-phys_yp
            s9z=zm2(i,j,k,e)-phys_zp
         endif
         s9r=sqrt(s9x*s9x+s9y*s9y+s9z*s9z)
         if (s9r.lt.phys_a) mask_inside_p(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo

c     Select the INSIDE endpoint of each element-local pressure-grid
c     edge that crosses the particle surface.  PN-2 pressure points are
c     element-local, so no GLL gather-scatter is applied here.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).ne.1) cycle
         cross=.false.
         if (i.gt.1) then
            if (mask_inside_p(i-1,j,k,e).eq.0) cross=.true.
         endif
         if (i.lt.lx2) then
            if (mask_inside_p(i+1,j,k,e).eq.0) cross=.true.
         endif
         if (j.gt.1) then
            if (mask_inside_p(i,j-1,k,e).eq.0) cross=.true.
         endif
         if (j.lt.ly2) then
            if (mask_inside_p(i,j+1,k,e).eq.0) cross=.true.
         endif
         if (ldim.eq.3) then
            if (k.gt.1) then
               if (mask_inside_p(i,j,k-1,e).eq.0) cross=.true.
            endif
            if (k.lt.lz2) then
               if (mask_inside_p(i,j,k+1,e).eq.0) cross=.true.
            endif
         endif
         if (cross) mask_cage_p(i,j,k,e)=1
      enddo
      enddo
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------

      subroutine stage9_seed_velocity_bc
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode

      integer e,i,j,k
      real s9x,s9y,s9z,s9u,s9v,s9w

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_inside_u(i,j,k,e).ne.1 .and.
     $       mask_cage_u(i,j,k,e).ne.1) cycle
         if (ldim.eq.2) then
            s9x=ym1(i,j,k,e)-phys_xp
            s9y=0.0-phys_yp
            s9z=xm1(i,j,k,e)-phys_zp
         else
            s9x=xm1(i,j,k,e)-phys_xp
            s9y=ym1(i,j,k,e)-phys_yp
            s9z=zm1(i,j,k,e)-phys_zp
         endif
         s9u=phys_up+phys_oy*s9z-phys_oz*s9y
         s9v=phys_vp+phys_oz*s9x-phys_ox*s9z
         s9w=phys_wp+phys_ox*s9y-phys_oy*s9x
         if (ldim.eq.2) then
            u_bc_cage(i,j,k,e)=s9w
            v_bc_cage(i,j,k,e)=s9u
            if (sp_cons_mode.eq.2) then
               w_bc_cage(i,j,k,e)=s9v
            else
               w_bc_cage(i,j,k,e)=0.0
            endif
         else
            u_bc_cage(i,j,k,e)=s9u
            v_bc_cage(i,j,k,e)=s9v
            w_bc_cage(i,j,k,e)=s9w
         endif
      enddo
      enddo
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------

      subroutine stage9_recount_masks(niu,ncu,nip,ncp,
     $ minru,maxru,minrp,maxrp)
      include 'SIZE'
      include 'TOTAL'

      integer niu,ncu,nip,ncp
      real minru,maxru,minrp,maxrp

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer e,i,j,k
      real s9x,s9y,s9z,s9r,s9ra

      niu=0
      ncu=0
      nip=0
      ncp=0
      minru=1.0e20
      maxru=0.0
      minrp=1.0e20
      maxrp=0.0

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_inside_u(i,j,k,e).eq.1 .and.
     $       mask_cage_u(i,j,k,e).ne.1) niu=niu+1
         if (mask_cage_u(i,j,k,e).eq.1) then
            ncu=ncu+1
            if (ldim.eq.2) then
               s9x=ym1(i,j,k,e)-phys_xp
               s9y=0.0-phys_yp
               s9z=xm1(i,j,k,e)-phys_zp
            else
               s9x=xm1(i,j,k,e)-phys_xp
               s9y=ym1(i,j,k,e)-phys_yp
               s9z=zm1(i,j,k,e)-phys_zp
            endif
            s9r=sqrt(s9x*s9x+s9y*s9y+s9z*s9z)
            s9ra=s9r/max(phys_a,1.0e-30)
            minru=min(minru,s9ra)
            maxru=max(maxru,s9ra)
         endif
      enddo
      enddo
      enddo
      enddo

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).eq.1 .and.
     $       mask_cage_p(i,j,k,e).ne.1) nip=nip+1
         if (mask_cage_p(i,j,k,e).eq.1) then
            ncp=ncp+1
            if (ldim.eq.2) then
               s9x=ym2(i,j,k,e)-phys_xp
               s9y=0.0-phys_yp
               s9z=xm2(i,j,k,e)-phys_zp
            else
               s9x=xm2(i,j,k,e)-phys_xp
               s9y=ym2(i,j,k,e)-phys_yp
               s9z=zm2(i,j,k,e)-phys_zp
            endif
            s9r=sqrt(s9x*s9x+s9y*s9y+s9z*s9z)
            s9ra=s9r/max(phys_a,1.0e-30)
            minrp=min(minrp,s9ra)
            maxrp=max(maxrp,s9ra)
         endif
      enddo
      enddo
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------

      subroutine physalis_axisym_uniform_pcage_filter
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      integer n_theta_max
      parameter(n_theta_max=200)
      real best_dist(n_theta_max),work(n_theta_max)
      real target_theta(n_theta_max)

      real cage_x,cage_y,cage_z,rin_p,rout_p,r_mid
      real crx,cry,crz,rc,rad,rtar,ztar,dist,pi_loc,tol
      integer n_theta_bins,jt,e,i,j,k,n_l,n_g
      real minrp,maxrp,ra
      logical won

      pi_loc = 4.0*atan(1.0)
      call zp_get_cage_center(phys_xp,phys_yp,phys_zp,phys_a,
     $   cage_x,cage_y,cage_z)

      rin_p  = max(0.0,phys_a-cage_thickness_p*h_p_mean)
      rout_p = phys_a
      r_mid  = 0.5*(rin_p+rout_p)

      tol = 1.0e-9*max(h_p_mean*h_p_mean,1.0e-30)

      n_theta_bins = max(4,min(n_theta_max,
     $   nint(pi_loc*phys_a/max(h_p_mean,1.0e-30))))

      do jt=1,n_theta_bins
         target_theta(jt) =
     $      (dfloat(jt)-0.5)*pi_loc/dfloat(n_theta_bins)
         best_dist(jt)=1.0e20
      enddo

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).ne.1) cycle

         if (ldim.eq.2) then
            crx=ym2(i,j,k,e)-cage_x
            cry=0.0-cage_y
            crz=xm2(i,j,k,e)-cage_z
         else
            crx=xm2(i,j,k,e)-cage_x
            cry=ym2(i,j,k,e)-cage_y
            crz=zm2(i,j,k,e)-cage_z
         endif
         rad=sqrt(crx*crx+cry*cry)

         do jt=1,n_theta_bins
            rtar=r_mid*sin(target_theta(jt))
            ztar=r_mid*cos(target_theta(jt))
            dist=(rad-rtar)**2+(crz-ztar)**2
            best_dist(jt)=min(best_dist(jt),dist)
         enddo
      enddo
      enddo
      enddo
      enddo

      call gop(best_dist,work,'m  ',n_theta_bins)

      n_l=0
      minrp=1.0e20
      maxrp=0.0

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).ne.1) cycle

         if (ldim.eq.2) then
            crx=ym2(i,j,k,e)-cage_x
            cry=0.0-cage_y
            crz=xm2(i,j,k,e)-cage_z
         else
            crx=xm2(i,j,k,e)-cage_x
            cry=ym2(i,j,k,e)-cage_y
            crz=zm2(i,j,k,e)-cage_z
         endif

         rc=sqrt(crx*crx+cry*cry+crz*crz)
         rad=sqrt(crx*crx+cry*cry)
         won=.false.

         do jt=1,n_theta_bins
            rtar=r_mid*sin(target_theta(jt))
            ztar=r_mid*cos(target_theta(jt))
            dist=(rad-rtar)**2+(crz-ztar)**2
            if (abs(dist-best_dist(jt)).le.tol) won=.true.
         enddo

         if (.not.won) then
            mask_cage_p(i,j,k,e)=0
         else
            n_l=n_l+1
            ra=rc/max(phys_a,1.0e-20)
            minrp=min(minrp,ra)
            maxrp=max(maxrp,ra)
         endif
      enddo
      enddo
      enddo
      enddo

      n_g=iglsum(n_l,1)
      n_cage_p_g=n_g
      if (n_l.eq.0) minrp=1.0e20
      min_rp_over_a=glmin(minrp,1)
      max_rp_over_a=glmax(maxrp,1)
      if (min_rp_over_a.gt.1.0e19) min_rp_over_a=0.0

      return
      end

      subroutine physalis_gll_spacing(hsum,hcnt,hmin)
c-----------------------------------------------------------------------
c  Local velocity-GLL spacing used to size the Physalis cage.
c
c  On the BF-S4 stretched carrier, the far-field spacing must not set
c  the particle-cage thickness.  Count only edge segments whose midpoint
c  is within 2a of the current particle center.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'
      real hsum,hcnt,hmin
      integer e,i,j,k
      real dx,dy,dz,h
      real xxloc,yyloc,zzloc,rrloc,rcutl
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      hsum=0.0
      hcnt=0.0
      hmin=1.0e20
      rcutl=2.0*phys_a

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (i.lt.lx1) then
            dx=xm1(i+1,j,k,e)-xm1(i,j,k,e)
            dy=ym1(i+1,j,k,e)-ym1(i,j,k,e)
            dz=zm1(i+1,j,k,e)-zm1(i,j,k,e)
            xxloc=0.5*(xm1(i+1,j,k,e)+xm1(i,j,k,e))
            yyloc=0.5*(ym1(i+1,j,k,e)+ym1(i,j,k,e))
            zzloc=0.5*(zm1(i+1,j,k,e)+zm1(i,j,k,e))
            if (ldim.eq.2) then
               rrloc=sqrt((yyloc-phys_xp)**2
     $              +(0.0-phys_yp)**2
     $              +(xxloc-phys_zp)**2)
            else
               rrloc=sqrt((xxloc-phys_xp)**2
     $              +(yyloc-phys_yp)**2
     $              +(zzloc-phys_zp)**2)
            endif
            if (rrloc.le.rcutl) then
               h=sqrt(dx*dx+dy*dy+dz*dz)
               hsum=hsum+h
               hcnt=hcnt+1.0
               hmin=min(hmin,h)
            endif
         endif
         if (j.lt.ly1) then
            dx=xm1(i,j+1,k,e)-xm1(i,j,k,e)
            dy=ym1(i,j+1,k,e)-ym1(i,j,k,e)
            dz=zm1(i,j+1,k,e)-zm1(i,j,k,e)
            xxloc=0.5*(xm1(i,j+1,k,e)+xm1(i,j,k,e))
            yyloc=0.5*(ym1(i,j+1,k,e)+ym1(i,j,k,e))
            zzloc=0.5*(zm1(i,j+1,k,e)+zm1(i,j,k,e))
            if (ldim.eq.2) then
               rrloc=sqrt((yyloc-phys_xp)**2
     $              +(0.0-phys_yp)**2
     $              +(xxloc-phys_zp)**2)
            else
               rrloc=sqrt((xxloc-phys_xp)**2
     $              +(yyloc-phys_yp)**2
     $              +(zzloc-phys_zp)**2)
            endif
            if (rrloc.le.rcutl) then
               h=sqrt(dx*dx+dy*dy+dz*dz)
               hsum=hsum+h
               hcnt=hcnt+1.0
               hmin=min(hmin,h)
            endif
         endif
         if (k.lt.lz1) then
            dx=xm1(i,j,k+1,e)-xm1(i,j,k,e)
            dy=ym1(i,j,k+1,e)-ym1(i,j,k,e)
            dz=zm1(i,j,k+1,e)-zm1(i,j,k,e)
            xxloc=0.5*(xm1(i,j,k+1,e)+xm1(i,j,k,e))
            yyloc=0.5*(ym1(i,j,k+1,e)+ym1(i,j,k,e))
            zzloc=0.5*(zm1(i,j,k+1,e)+zm1(i,j,k,e))
            if (ldim.eq.2) then
               rrloc=sqrt((yyloc-phys_xp)**2
     $              +(0.0-phys_yp)**2
     $              +(xxloc-phys_zp)**2)
            else
               rrloc=sqrt((xxloc-phys_xp)**2
     $              +(yyloc-phys_yp)**2
     $              +(zzloc-phys_zp)**2)
            endif
            if (rrloc.le.rcutl) then
               h=sqrt(dx*dx+dy*dy+dz*dz)
               hsum=hsum+h
               hcnt=hcnt+1.0
               hmin=min(hmin,h)
            endif
         endif
      enddo
      enddo
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_p_spacing(hsum,hcnt,hmin)
c-----------------------------------------------------------------------
c  Local pressure-grid spacing used to size the pressure cage.
c  Use only edge segments whose midpoint lies within 2a of the particle.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'
      real hsum,hcnt,hmin
      integer e,i,j,k
      real dx,dy,dz,h
      real xxloc,yyloc,zzloc,rrloc,rcutl
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      hsum=0.0
      hcnt=0.0
      hmin=1.0e20
      rcutl=2.0*phys_a

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (i.lt.lx2) then
            dx=xm2(i+1,j,k,e)-xm2(i,j,k,e)
            dy=ym2(i+1,j,k,e)-ym2(i,j,k,e)
            dz=zm2(i+1,j,k,e)-zm2(i,j,k,e)
            xxloc=0.5*(xm2(i+1,j,k,e)+xm2(i,j,k,e))
            yyloc=0.5*(ym2(i+1,j,k,e)+ym2(i,j,k,e))
            zzloc=0.5*(zm2(i+1,j,k,e)+zm2(i,j,k,e))
            if (ldim.eq.2) then
               rrloc=sqrt((yyloc-phys_xp)**2
     $              +(0.0-phys_yp)**2
     $              +(xxloc-phys_zp)**2)
            else
               rrloc=sqrt((xxloc-phys_xp)**2
     $              +(yyloc-phys_yp)**2
     $              +(zzloc-phys_zp)**2)
            endif
            if (rrloc.le.rcutl) then
               h=sqrt(dx*dx+dy*dy+dz*dz)
               hsum=hsum+h
               hcnt=hcnt+1.0
               hmin=min(hmin,h)
            endif
         endif
         if (j.lt.ly2) then
            dx=xm2(i,j+1,k,e)-xm2(i,j,k,e)
            dy=ym2(i,j+1,k,e)-ym2(i,j,k,e)
            dz=zm2(i,j+1,k,e)-zm2(i,j,k,e)
            xxloc=0.5*(xm2(i,j+1,k,e)+xm2(i,j,k,e))
            yyloc=0.5*(ym2(i,j+1,k,e)+ym2(i,j,k,e))
            zzloc=0.5*(zm2(i,j+1,k,e)+zm2(i,j,k,e))
            if (ldim.eq.2) then
               rrloc=sqrt((yyloc-phys_xp)**2
     $              +(0.0-phys_yp)**2
     $              +(xxloc-phys_zp)**2)
            else
               rrloc=sqrt((xxloc-phys_xp)**2
     $              +(yyloc-phys_yp)**2
     $              +(zzloc-phys_zp)**2)
            endif
            if (rrloc.le.rcutl) then
               h=sqrt(dx*dx+dy*dy+dz*dz)
               hsum=hsum+h
               hcnt=hcnt+1.0
               hmin=min(hmin,h)
            endif
         endif
         if (k.lt.lz2) then
            dx=xm2(i,j,k+1,e)-xm2(i,j,k,e)
            dy=ym2(i,j,k+1,e)-ym2(i,j,k,e)
            dz=zm2(i,j,k+1,e)-zm2(i,j,k,e)
            xxloc=0.5*(xm2(i,j,k+1,e)+xm2(i,j,k,e))
            yyloc=0.5*(ym2(i,j,k+1,e)+ym2(i,j,k,e))
            zzloc=0.5*(zm2(i,j,k+1,e)+zm2(i,j,k,e))
            if (ldim.eq.2) then
               rrloc=sqrt((yyloc-phys_xp)**2
     $              +(0.0-phys_yp)**2
     $              +(xxloc-phys_zp)**2)
            else
               rrloc=sqrt((xxloc-phys_xp)**2
     $              +(yyloc-phys_yp)**2
     $              +(zzloc-phys_zp)**2)
            endif
            if (rrloc.le.rcutl) then
               h=sqrt(dx*dx+dy*dy+dz*dz)
               hsum=hsum+h
               hcnt=hcnt+1.0
               hmin=min(hmin,h)
            endif
         endif
      enddo
      enddo
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_update_divergence_norm
c  Weighted L2 norm of velocity divergence on exterior-fluid pressure
c  nodes.  Cage and particle-interior nodes are excluded because their
c  values belong to the internal constrained region, not the physical
c  exterior-fluid incompressibility gate.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      real div(lx2,ly2,lz2,lelv)
      real num,den,eps
      integer e,i,j,k

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      eps = 1.0e-30
      call opdiv(div,vx,vy,vz)

      num = 0.0
      den = 0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).eq.1 .or.
     $       mask_cage_p(i,j,k,e).eq.1) cycle
         num = num + bm2(i,j,k,e)*div(i,j,k,e)**2
         den = den + bm2(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

      num = glsum(num,1)
      den = glsum(den,1)
      div_norm = sqrt(num/max(den,eps))

      return
      end

c-----------------------------------------------------------------------
      subroutine write_physalis_coeff_modes
c  Time history of force-relevant Lamb coefficients and symmetry modes.
c  This is the same diagnostic written by the successful 3D angular
c  validation.  It is called only in the fixed angular branch.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      real eta3_u
      common /physalis_eta3_ctl/ eta3_u

      real p10,phi10,p30,phi30,v30,score
      real p11r,p11i,phi11r,phi11i
      real p31r,p31i,phi31r,phi31i
      integer fu
      parameter (fu=86)
      logical first_call
      save first_call
      data first_call /.true./

      if (istep.gt.10 .and. mod(istep,10).ne.0) return
      if (nid.ne.0) return

      p10    = p_re(1,1)
      phi10  = phi_re(1,1)
      p30    = p_re(3,1)
      phi30  = phi_re(3,1)
      v30    = v_re(3,1)
      p11r   = p_re(1,2)
      p11i   = p_im(1,2)
      phi11r = phi_re(1,2)
      phi11i = phi_im(1,2)
      p31r   = p_re(3,2)
      p31i   = p_im(3,2)
      phi31r = phi_re(3,2)
      phi31i = phi_im(3,2)
      score  = p10 + 6.0*phi10

      if (first_call) then
         open(fu,file='physalis_coeff_modes.dat',status='replace')
         write(fu,'(A)') '# step t eta3_u p10 phi10 p30 phi30 ' //
     $      'v30 p11_re p11_im phi11_re phi11_im ' //
     $      'p31_re p31_im phi31_re phi31_im S_p10_6phi10'
         first_call = .false.
      else
         open(fu,file='physalis_coeff_modes.dat',status='old',
     $      position='append')
      endif

      write(fu,'(I8,1X,16E16.8)') istep,time,eta3_u,
     $   p10,phi10,p30,phi30,v30,
     $   p11r,p11i,phi11r,phi11i,
     $   p31r,p31i,phi31r,phi31i,score
      close(fu)

      return
      end

c-----------------------------------------------------------------------
      subroutine sp_outer_stress_couple(Ld,Fd,sarea,nfaces)
c  Angular-momentum diagnostic copied from the successful 3D angular
c  validation, with a separate 2D-axisymmetric branch.
c
c  3D branch:
c       Ld = integral_S r x (sigma.n) dS.
c
c  2D axisymmetric branch:
c       Nek x = axial z, Nek y = cylindrical radius r, Nek vz = swirl.
c       The torque about the axial direction is approximated from the
c       azimuthal traction,
c          t_theta = mu [ dw/dz n_z + (dw/dr - w/r) n_r ],
c       and Lz = integral r t_theta dS over the revolved outer boundary.
      include 'SIZE'
      include 'TOTAL'

      real Ld(3),Fd(3),sarea
      integer nfaces
      real ux_x(lx1,ly1,lz1,lelv)
      real ux_y(lx1,ly1,lz1,lelv)
      real ux_z(lx1,ly1,lz1,lelv)
      real uy_x(lx1,ly1,lz1,lelv)
      real uy_y(lx1,ly1,lz1,lelv)
      real uy_z(lx1,ly1,lz1,lelv)
      real uz_x(lx1,ly1,lz1,lelv)
      real uz_y(lx1,ly1,lz1,lelv)
      real uz_z(lx1,ly1,lz1,lelv)
      real pm1(lx1,ly1,lz1,lelv)
      real pw1(lx1,ly2,lz2),pw2(lx1,ly1,lz2)
      common /sp_cons_grad_work/ ux_x,ux_y,ux_z,
     $ uy_x,uy_y,uy_z,uz_x,uz_y,uz_z,pm1

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      real mu,nx,ny,nz,pv,tx,ty,tz,dxloc,dyloc,dzloc
      real darea_loc,rabs,ttheta,pi0
      real zrel,epsr,rp,rm,utp,utm,ut0,dutdr,dutdz
      real ldloc(3),fdloc(3),area_loc
      integer e,f,ix,iy,iz,ia
      integer kx1,kx2,ky1,ky2,kz1,kz2,ntot,nfl
      character*1 b1
      character*3 bc_tmp

      ntot=lx1*ly1*lz1*nelv
      mu=param(1)*abs(param(2))
      call gradm1(ux_x,ux_y,ux_z,vx)
      call gradm1(uy_x,uy_y,uy_z,vy)
      call gradm1(uz_x,uz_y,uz_z,vz)
      if (lx2.ne.lx1) then
         call mappr(pm1,pr,pw1,pw2)
      else
         call copy(pm1,pr,ntot)
      endif

      call rzero(ldloc,3)
      call rzero(fdloc,3)
      area_loc=0.0
      nfl=0
      pi0=4.0*atan(1.0)

      do e=1,nelv
      do f=1,2*ldim
         bc_tmp=cbc(f,e,1)
         b1=bc_tmp(1:1)
         if (b1.eq.'A' .or. b1.eq.'a' .or.
     $       b1.eq.'E' .or. b1.eq.'e' .or. b1.eq.' ') cycle
         if (ldim.eq.2) then
c           In the 2D axisymmetric angular surrogate, P faces are axial
c           periodic identification planes, not physical outer surfaces.
c           Counting them as stress boundaries double-counts periodic
c           flux and makes Lstar nearly a factor of two too large.
            if (b1.eq.'P' .or. b1.eq.'p') cycle
         endif
         if (b1.eq.'P' .or. b1.eq.'p' .or.
     $       b1.eq.'W' .or. b1.eq.'w' .or.
     $       b1.eq.'O' .or. b1.eq.'o' .or.
     $       b1.eq.'v' .or. b1.eq.'V') then
            nfl=nfl+1
            call facind(kx1,kx2,ky1,ky2,kz1,kz2,
     $                  lx1,ly1,lz1,f)
            ia=0
            do iz=kz1,kz2
            do iy=ky1,ky2
            do ix=kx1,kx2
               ia=ia+1
               nx=unx(ia,1,f,e)
               ny=uny(ia,1,f,e)
               nz=unz(ia,1,f,e)
               pv=pm1(ix,iy,iz,e)
               if (ldim.eq.2) then
c                 Use the actual simulated swirl field (vz) and its real
c                 gradients (already computed above via gradm1 on vz),
c                 not an analytic Lamb reconstruction -- Ld must be an
c                 independent CFD-based check of T_phys, not a quantity
c                 algebraically tied to the same Lamb coefficients.
                  rabs=max(abs(ym1(ix,iy,iz,e)),1.0e-30)
                  ut0=vz(ix,iy,iz,e)
                  dutdz=uz_x(ix,iy,iz,e)
                  dutdr=uz_y(ix,iy,iz,e)
c                 area(ia,1,f,e) already carries one power of r under
c                 IFAXIS (Nek multiplies by ym1 internally), so the
c                 revolved physical area is just 2*pi*area, not
c                 2*pi*r*area.
                  darea_loc=2.0*pi0*area(ia,1,f,e)
                  ttheta=mu*(dutdz*nx+(dutdr-ut0/rabs)*ny)
                  ldloc(3)=ldloc(3)+rabs*ttheta*darea_loc
                  area_loc=area_loc+darea_loc
               else
                  tx=-pv*nx+mu*(2.0*ux_x(ix,iy,iz,e)*nx+
     $               (ux_y(ix,iy,iz,e)+uy_x(ix,iy,iz,e))*ny+
     $               (ux_z(ix,iy,iz,e)+uz_x(ix,iy,iz,e))*nz)
                  ty=-pv*ny+mu*
     $               ((uy_x(ix,iy,iz,e)+ux_y(ix,iy,iz,e))*nx+
     $                2.0*uy_y(ix,iy,iz,e)*ny+
     $               (uy_z(ix,iy,iz,e)+uz_y(ix,iy,iz,e))*nz)
                  tz=-pv*nz+mu*
     $               ((uz_x(ix,iy,iz,e)+ux_z(ix,iy,iz,e))*nx+
     $               (uz_y(ix,iy,iz,e)+uy_z(ix,iy,iz,e))*ny+
     $                2.0*uz_z(ix,iy,iz,e)*nz)
                  dxloc=xm1(ix,iy,iz,e)-phys_xp
                  dyloc=ym1(ix,iy,iz,e)-phys_yp
                  dzloc=zm1(ix,iy,iz,e)-phys_zp
                  darea_loc=area(ia,1,f,e)
                  fdloc(1)=fdloc(1)+tx*darea_loc
                  fdloc(2)=fdloc(2)+ty*darea_loc
                  fdloc(3)=fdloc(3)+tz*darea_loc
                  ldloc(1)=ldloc(1)+(dyloc*tz-dzloc*ty)*darea_loc
                  ldloc(2)=ldloc(2)+(dzloc*tx-dxloc*tz)*darea_loc
                  ldloc(3)=ldloc(3)+(dxloc*ty-dyloc*tx)*darea_loc
                  area_loc=area_loc+darea_loc
               endif
            enddo
            enddo
            enddo
         endif
      enddo
      enddo

      Ld(1)=glsum(ldloc(1),1)
      Ld(2)=glsum(ldloc(2),1)
      Ld(3)=glsum(ldloc(3),1)
      Fd(1)=glsum(fdloc(1),1)
      Fd(2)=glsum(fdloc(2),1)
      Fd(3)=glsum(fdloc(3),1)
      sarea=glsum(area_loc,1)
      nfaces=iglsum(nfl,1)
      return
      end

c-----------------------------------------------------------------------
      subroutine sp_axisym_lamb_swirl(rabs,zrel,utheta)
c  Evaluate the axisymmetric swirl velocity used by the 2D angular
c  diagnostic from the current Lamb coefficients.
c
c  In the 2D axisymmetric mapping, Nek x is the axial coordinate z and
c  Nek y is cylindrical radius r.  The azimuthal/swirl velocity is the
c  Cartesian y-component of the reconstructed 3D Lamb field at phi=0,
c  plus the prescribed rigid-body rotational velocity.
      include 'SIZE'
      include 'TOTAL'

      real rabs,zrel,utheta
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode

      real drx,dry,drz,rr,nu,ulx,uly,ulz

      drx=rabs
      dry=0.0
      drz=zrel
      rr=sqrt(drx*drx+dry*dry+drz*drz)
      nu=abs(param(2))
      call physalis_lamb_vel_at_point(drx,dry,drz,rr,phys_a,nu,
     $   p_re,p_im,phi_re,phi_im,zp_lmax,ulx,uly,ulz)
      utheta=phys_vp+phys_oz*drx-phys_ox*drz+uly
      return
      end

c-----------------------------------------------------------------------
      subroutine sp_fluid_angular_momentum(Hz,fluid_vol)
c  Fluid angular momentum about the particle center.  In 2D axisymmetry,
c  Nek x is axial, Nek y is radius, and Nek vz is the swirl velocity.
      include 'SIZE'
      include 'TOTAL'
      real Hz,fluid_vol
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      real hzloc,volloc,dxloc,dyloc,dzloc,r2loc,rho
      real rabs,pi0,wgt
      integer i,j,k,e
      hzloc=0.0
      volloc=0.0
      rho=param(1)
      pi0=4.0*atan(1.0)
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (ldim.eq.2) then
            dxloc=ym1(i,j,k,e)-phys_xp
            dyloc=0.0
            dzloc=xm1(i,j,k,e)-phys_zp
            r2loc=dxloc*dxloc+dzloc*dzloc
            if (r2loc.ge.phys_a*phys_a) then
               rabs=max(abs(ym1(i,j,k,e)),0.0)
c              bm1 already carries one power of r under IFAXIS, so the
c              physical volume element is just 2*pi*bm1 (dV=r dr dz dth
c              integrated over theta); rabs below supplies the single
c              extra power of r needed for the r*v_theta moment arm.
               wgt=2.0*pi0*bm1(i,j,k,e)
               hzloc=hzloc+rho*wgt*rabs*vz(i,j,k,e)
               volloc=volloc+wgt
            endif
         else
            dxloc=xm1(i,j,k,e)-phys_xp
            dyloc=ym1(i,j,k,e)-phys_yp
            dzloc=zm1(i,j,k,e)-phys_zp
            r2loc=dxloc*dxloc+dyloc*dyloc+dzloc*dzloc
            if (r2loc.ge.phys_a*phys_a) then
               hzloc=hzloc+rho*bm1(i,j,k,e)*
     $              (dxloc*vy(i,j,k,e)-dyloc*vx(i,j,k,e))
               volloc=volloc+bm1(i,j,k,e)
            endif
         endif
      enddo
      enddo
      enddo
      enddo
      Hz=glsum(hzloc,1)
      fluid_vol=glsum(volloc,1)
      return
      end

c-----------------------------------------------------------------------
      subroutine write_sp_angular_momentum_history
c  S&P/G&P angular-momentum diagnostic.  For ldim=2, this reports the
c  axisymmetric swirl analogue of the 3D rotating-sphere test.
      include 'SIZE'
      include 'TOTAL'
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      real sp_cons_reomega
      common /sp_cons_r/ sp_cons_reomega
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      real Ld(3),Fd(3),sarea,Hz,fluid_vol,prev_Hz,prev_time
      real dHzdt,dtloc,Lstar,Lstar_abs,error_signed,error_abs
      real balance,balance_rel,omega_re,Tstokes,Tp_over_Tstokes
      real ttrans_lamb,ttrans_outer
      real pi0,mu
      integer nfaces,fu
      parameter(fu=84)
      logical first
      save first,prev_Hz,prev_time
      data first/.true./
      data prev_Hz,prev_time/0.0,0.0/

      call zp_validation_config
      if (istep.gt.10 .and. mod(istep,zp_stride).ne.0) return
      call sp_outer_stress_couple(Ld,Fd,sarea,nfaces)
      call sp_fluid_angular_momentum(Hz,fluid_vol)

      dHzdt=0.0
      if (.not.first) then
         dtloc=time-prev_time
         if (dtloc.gt.0.0) dHzdt=(Hz-prev_Hz)/dtloc
      endif
      Lstar=Ld(3)/max(abs(T_phys(3)),1.0e-30)
      if (T_phys(3).lt.0.0) Lstar=-Lstar
      Lstar_abs=abs(Ld(3))/max(abs(T_phys(3)),1.0e-30)
      error_signed=Lstar-1.0
      error_abs=abs(Lstar_abs-1.0)
      balance=dHzdt-(Ld(3)-T_phys(3))
      balance_rel=balance/max(abs(Ld(3)),abs(T_phys(3)),
     $                         1.0e-30)
      omega_re=phys_a**2*phys_oz/max(abs(param(2)),1.0e-30)
      pi0=4.0*atan(1.0)
      mu=param(1)*abs(param(2))
      Tstokes=-8.0*pi0*mu*phys_a**3*phys_oz
      Tp_over_Tstokes=T_phys(3)/max(abs(Tstokes),1.0e-30)
      if (Tstokes.lt.0.0) Tp_over_Tstokes=-Tp_over_Tstokes
      ttrans_lamb=sqrt(T_phys(1)**2+T_phys(2)**2)
     $ /max(abs(T_phys(3)),1.0e-30)
      ttrans_outer=sqrt(Ld(1)**2+Ld(2)**2)
     $ /max(abs(Ld(3)),1.0e-30)

      if (nid.eq.0) then
         if (first) then
            open(fu,file='physalis_sp_angular_momentum.dat',
     $           status='replace')
            write(fu,'(A)') '# step t Omega_z Re_Omega ' //
     $       'Lp_x Lp_y Lp_z Ld_x Ld_y Ld_z ' //
     $       'Lstar_signed Lstar_abs error_signed error_abs ' //
     $       'Hz_fluid dHz_dt transient_balance balance_rel ' //
     $       'outer_Fx outer_Fy outer_Fz outer_area ' //
     $       'fluid_vol boundary_face_count ' //
     $       'T_stokes_unbounded Lp_over_Tstokes ' //
     $       'transverse_Lp transverse_Ld coeff_resid'
         else
            open(fu,file='physalis_sp_angular_momentum.dat',
     $           status='old',position='append')
         endif
         write(fu,'(I8,1X,22E18.10,1X,I8,1X,5E18.10)')
     $    istep,time,phys_oz,omega_re,
     $    T_phys(1),T_phys(2),T_phys(3),Ld(1),Ld(2),Ld(3),
     $    Lstar,Lstar_abs,error_signed,error_abs,
     $    Hz,dHzdt,balance,balance_rel,
     $    Fd(1),Fd(2),Fd(3),sarea,fluid_vol,
     $    nfaces,Tstokes,Tp_over_Tstokes,
     $    ttrans_lamb,ttrans_outer,coeff_resid
         close(fu)
      endif
      prev_Hz=Hz
      prev_time=time
      first=.false.
      return
      end

c-----------------------------------------------------------------------

      subroutine physalis_init_lamb_arrays
c  Zero all Lamb coefficient arrays and force arrays on first call.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid

      logical intp_phys_rdy
      common /phys_intp_rdy/ intp_phys_rdy

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      real delta_p_cage_local,delta_p_lift_local
      common /stage33c_pwidth_r/ delta_p_cage_local,
     $ delta_p_lift_local

      integer i,j,ntot1,ntot2
      intp_phys_rdy = .false.

      ntot1 = lx1*ly1*lz1*nelv
      ntot2 = lx2*ly2*lz2*nelv
      call izero(mask_inside_u,ntot1)
      call izero(mask_cage_u,ntot1)
      call izero(mask_inside_p,ntot2)
      call izero(mask_cage_p,ntot2)
      call rzero(u_bc_cage,ntot1)
      call rzero(v_bc_cage,ntot1)
      call rzero(w_bc_cage,ntot1)
      call rzero(p_bc_cage,ntot2)

      n_inside_u_g = 0
      n_cage_u_g   = 0
      n_inside_p_g = 0
      n_cage_p_g   = 0
      h_gll_min = 0.0
      h_gll_mean = 0.0
      h_p_min = 0.0
      h_p_mean = 0.0
      delta_u_local = 0.0
      delta_p_local = 0.0
      delta_p_cage_local = 0.0
      delta_p_lift_local = 0.0
      min_ru_over_a = 0.0
      max_ru_over_a = 0.0
      min_rp_over_a = 0.0
      max_rp_over_a = 0.0
      cage_vel_res = 0.0
      pressure_cage_res = 0.0
      div_norm = 0.0

      do j=1,5
      do i=1,4
         p_re(i,j)=0.0;  p_im(i,j)=0.0
         phi_re(i,j)=0.0;phi_im(i,j)=0.0
         v_re(i,j)=0.0;  v_im(i,j)=0.0
         p_re_old(i,j)=0.0;  p_im_old(i,j)=0.0
         phi_re_old(i,j)=0.0;phi_im_old(i,j)=0.0
         v_re_old(i,j)=0.0;  v_im_old(i,j)=0.0
      enddo
      enddo
      F_phys(1)=0.0; F_phys(2)=0.0; F_phys(3)=0.0
      T_phys(1)=0.0; T_phys(2)=0.0; T_phys(3)=0.0
      coeff_resid=0.0
      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_lebedev_init
c  Hard-code Lebedev sphere.  nleb controls all array sizes and loops.
c  Weights w_k satisfy sum_k w_k = 4*pi (full sphere solid angle).
c  38-point Lebedev rule, exact through degree 9.
c  This covers lmax=4 scalar products because products of Y_4m modes
c  reach degree 8.
c-----------------------------------------------------------------------
      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d

      real s3,pi,w1,w2,w3,a38,b38
      integer k,isx,isy,isz

      pi = 4.0*atan(1.0)
      s3 = 1.0/sqrt(3.0)
      a38 = 0.459700843380983
      b38 = sqrt(1.0 - a38*a38)
      w1 = 4.0*pi/105.0
      w2 = 9.0*pi/70.0
      w3 = 4.0*pi/35.0

c     6 face points (axial)
      k=1
      xleb_d(k)= 1.0;yleb_d(k)= 0.0;zleb_d(k)= 0.0;wleb_d(k)=w1;k=k+1
      xleb_d(k)=-1.0;yleb_d(k)= 0.0;zleb_d(k)= 0.0;wleb_d(k)=w1;k=k+1
      xleb_d(k)= 0.0;yleb_d(k)= 1.0;zleb_d(k)= 0.0;wleb_d(k)=w1;k=k+1
      xleb_d(k)= 0.0;yleb_d(k)=-1.0;zleb_d(k)= 0.0;wleb_d(k)=w1;k=k+1
      xleb_d(k)= 0.0;yleb_d(k)= 0.0;zleb_d(k)= 1.0;wleb_d(k)=w1;k=k+1
      xleb_d(k)= 0.0;yleb_d(k)= 0.0;zleb_d(k)=-1.0;wleb_d(k)=w1;k=k+1

c     8 vertex points
      do isx=-1,1,2
      do isy=-1,1,2
      do isz=-1,1,2
         xleb_d(k)=isx*s3;yleb_d(k)=isy*s3
         zleb_d(k)=isz*s3;wleb_d(k)=w2;k=k+1
      enddo
      enddo
      enddo

c     24 points: all signs/permutations of (0,a38,b38).
c     The zero coordinate and the a/b ordering are both permuted.  Using
c     (a38,a38,b38) here preserves degree two but breaks the degree-nine
c     rule, which is why the former grid passed n=1 and failed n>=2 tests.
      do isx=-1,1,2
      do isy=-1,1,2
         xleb_d(k)=0.0;yleb_d(k)=isx*a38
         zleb_d(k)=isy*b38;wleb_d(k)=w3;k=k+1
         xleb_d(k)=0.0;yleb_d(k)=isx*b38
         zleb_d(k)=isy*a38;wleb_d(k)=w3;k=k+1
         xleb_d(k)=isx*a38;yleb_d(k)=0.0
         zleb_d(k)=isy*b38;wleb_d(k)=w3;k=k+1
         xleb_d(k)=isx*b38;yleb_d(k)=0.0
         zleb_d(k)=isy*a38;wleb_d(k)=w3;k=k+1
         xleb_d(k)=isx*a38;yleb_d(k)=isy*b38
         zleb_d(k)=0.0;wleb_d(k)=w3;k=k+1
         xleb_d(k)=isx*b38;yleb_d(k)=isy*a38
         zleb_d(k)=0.0;wleb_d(k)=w3;k=k+1
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_n1_cartesian_gradient(xh,yh,zh,m,
     $ yre,yim,gxr,gyr,gzr,gxi,gyi,gzi)
c  Degree-one harmonics and Cartesian surface gradients on the unit
c  sphere.  This form is finite at all coordinate-axis points, unlike
c  separate theta/phi components.  The convention has no CS phase.
c-----------------------------------------------------------------------
      real xh,yh,zh,yre,yim,gxr,gyr,gzr,gxi,gyi,gzi
      real pi,n10,n11
      integer m

      pi = 4.0*atan(1.0)
      n10 = sqrt(3.0/(4.0*pi))
      n11 = sqrt(3.0/(8.0*pi))

      yre=0.0; yim=0.0
      gxr=0.0; gyr=0.0; gzr=0.0
      gxi=0.0; gyi=0.0; gzi=0.0

      if (m.eq.0) then
         yre = n10*zh
         gxr = -n10*zh*xh
         gyr = -n10*zh*yh
         gzr =  n10*(1.0-zh*zh)
      else if (m.eq.1) then
         yre = n11*xh
         yim = n11*yh
         gxr =  n11*(1.0-xh*xh)
         gyr = -n11*xh*yh
         gzr = -n11*xh*zh
         gxi = -n11*yh*xh
         gyi =  n11*(1.0-yh*yh)
         gzi = -n11*yh*zh
      endif

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_check_harmonics
c  Startup identity and end-to-end round-trip tests for every harmonic
c  degree supported here.  This catches normalization, pole-gradient,
c  projection, and cage-reconstruction inconsistencies before time stepping.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d

      real y0r,y0i,g0xr,g0yr,g0zr,g0xi,g0yi,g0zi
      real y1r,y1i,g1xr,g1yr,g1zr,g1xi,g1yi,g1zi
      real yn0,yn1,gn0,gn1,ycross,gcross,tanmax,errmax
      real Yt_re(4,5),Yt_im(4,5),Gt_xr(4,5),Gt_yr(4,5)
      real Gt_zr(4,5),Gt_xi(4,5),Gt_yi(4,5),Gt_zi(4,5)
      real ynorm(4,5),gnorm(4,5),allnormerr,alltangent
      real dotr,doti,tol
      real pt_re(4,5),pt_im(4,5),ft_re(4,5),ft_im(4,5)
      real ux,uy,uz,rs,ap,bp,au,bu,cv,ddet,gn,hn
      real sp,su,sv,pfield,cx,cy,cz,pseed,fseed,vseed
      real prec,frec,vrec,p1rec,f1rec,v1rec,rterr,allrterr
      real nosliperr,usq
      real roa,aor,fn
      real pc_re(4,5),pc_im(4,5),fc_re(4,5),fc_im(4,5)
      real vc_re(4,5),vc_im(4,5),po_re(4,5),po_im(4,5)
      real fo_re(4,5),fo_im(4,5),vo_re(4,5),vo_im(4,5)
      common /phys_lamb/ pc_re,pc_im,fc_re,fc_im,vc_re,vc_im,
     $ po_re,po_im,fo_re,fo_im,vo_re,vo_im
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      integer k,fu,i,j,n,m

      yn0=0.0; yn1=0.0; gn0=0.0; gn1=0.0
      ycross=0.0; gcross=0.0; tanmax=0.0
      allnormerr=0.0; alltangent=0.0
      do n=1,4
      do m=1,5
         ynorm(n,m)=0.0
         gnorm(n,m)=0.0
      enddo
      enddo
      do k=1,nleb
         call physalis_n1_cartesian_gradient(xleb_d(k),yleb_d(k),
     $      zleb_d(k),0,y0r,y0i,g0xr,g0yr,g0zr,g0xi,g0yi,g0zi)
         call physalis_n1_cartesian_gradient(xleb_d(k),yleb_d(k),
     $      zleb_d(k),1,y1r,y1i,g1xr,g1yr,g1zr,g1xi,g1yi,g1zi)
         call physalis_ylm_surface_gradient(xleb_d(k),yleb_d(k),
     $      zleb_d(k),1.0,4,Yt_re,Yt_im,Gt_xr,Gt_yr,Gt_zr,
     $      Gt_xi,Gt_yi,Gt_zi)

         yn0 = yn0 + wleb_d(k)*y0r*y0r
         yn1 = yn1 + wleb_d(k)*(y1r*y1r+y1i*y1i)
         gn0 = gn0 + wleb_d(k)*(g0xr*g0xr+g0yr*g0yr+
     $         g0zr*g0zr)
         gn1 = gn1 + wleb_d(k)*(g1xr*g1xr+g1yr*g1yr+
     $         g1zr*g1zr+g1xi*g1xi+g1yi*g1yi+g1zi*g1zi)
         ycross = ycross + wleb_d(k)*y0r*(y1r+y1i)
         gcross = gcross + wleb_d(k)*(g0xr*(g1xr+g1xi)+
     $         g0yr*(g1yr+g1yi)+g0zr*(g1zr+g1zi))

         dotr=xleb_d(k)*g0xr+yleb_d(k)*g0yr+zleb_d(k)*g0zr
         tanmax=max(tanmax,abs(dotr))
         dotr=xleb_d(k)*g1xr+yleb_d(k)*g1yr+zleb_d(k)*g1zr
         doti=xleb_d(k)*g1xi+yleb_d(k)*g1yi+zleb_d(k)*g1zi
         tanmax=max(tanmax,abs(dotr),abs(doti))

         do n=1,4
         do m=0,n
            ynorm(n,m+1)=ynorm(n,m+1)+wleb_d(k)*(
     $         Yt_re(n,m+1)**2+Yt_im(n,m+1)**2)
            gnorm(n,m+1)=gnorm(n,m+1)+wleb_d(k)*(
     $         Gt_xr(n,m+1)**2+Gt_yr(n,m+1)**2+
     $         Gt_zr(n,m+1)**2+Gt_xi(n,m+1)**2+
     $         Gt_yi(n,m+1)**2+Gt_zi(n,m+1)**2)
            dotr=xleb_d(k)*Gt_xr(n,m+1)+
     $           yleb_d(k)*Gt_yr(n,m+1)+
     $           zleb_d(k)*Gt_zr(n,m+1)
            doti=xleb_d(k)*Gt_xi(n,m+1)+
     $           yleb_d(k)*Gt_yi(n,m+1)+
     $           zleb_d(k)*Gt_zi(n,m+1)
            alltangent=max(alltangent,abs(dotr),abs(doti))
         enddo
         enddo
      enddo

      do n=1,4
      do m=0,n
         allnormerr=max(allnormerr,abs(ynorm(n,m+1)-1.0),
     $      abs(gnorm(n,m+1)-float(n*(n+1))))
      enddo
      enddo

      errmax=max(abs(yn0-1.0),abs(yn1-1.0),abs(gn0-2.0),
     $ abs(gn1-2.0),abs(ycross),abs(gcross),tanmax)

c     End-to-end n=1,m=0 coefficient round trip at configured r_s/a.
c     Unit a, nu, and mu remove dimensional prefactors from the test.
      do i=1,4
      do j=1,5
         pt_re(i,j)=0.0; pt_im(i,j)=0.0
         ft_re(i,j)=0.0; ft_im(i,j)=0.0
      enddo
      enddo
      pseed=0.70
      fseed=-0.40
      vseed=0.25
      pt_re(1,1)=pseed
      ft_re(1,1)=fseed
      vc_re(1,1)=vseed
      rs=r_sample_over_a
      roa=rs
      aor=1.0/rs
      ap=(1.0-0.25*aor**3)*roa
      bp=-1.5*aor**2
      gn=8.0/5.0
      hn=-1.0-3.0/5.0*aor**2
      au=0.25*(gn+hn*aor**3)*roa**2
      gn=2.0
      hn=-1.5*roa**2-0.5
      bu=(gn+hn*aor**3)
      cv=2.0*(aor**3-1.0)*roa
      ddet=ap*bu-au*bp
      sp=0.0; su=0.0; sv=0.0
      do k=1,nleb
         call physalis_n1_cartesian_gradient(xleb_d(k),yleb_d(k),
     $      zleb_d(k),0,y0r,y0i,g0xr,g0yr,g0zr,g0xi,g0yi,g0zi)
         call physalis_lamb_vel_at_point(rs*xleb_d(k),
     $      rs*yleb_d(k),rs*zleb_d(k),rs,1.0,1.0,
     $      pt_re,pt_im,ft_re,ft_im,1,ux,uy,uz)
         pfield=(ap*pseed+bp*fseed)*y0r
         sp=sp+wleb_d(k)*y0r*pfield
         su=su+wleb_d(k)*(g0xr*ux+g0yr*uy+g0zr*uz)
         cx=yleb_d(k)*g0zr-zleb_d(k)*g0yr
         cy=zleb_d(k)*g0xr-xleb_d(k)*g0zr
         cz=xleb_d(k)*g0yr-yleb_d(k)*g0xr
         sv=sv+wleb_d(k)*(cx*ux+cy*uy+cz*uz)
      enddo
      prec=(sp*bu-su*bp)/ddet
      frec=(ap*su-au*sp)/ddet
      vrec=sv/cv
      p1rec=prec; f1rec=frec; v1rec=vrec
      rterr=max(abs(prec-pseed),abs(frec-fseed),abs(vrec-vseed))
      vc_re(1,1)=0.0

c     Repeat the reconstruction/projection test for m=0 of n=1..4.
      allrterr=0.0
      do n=1,4
         do i=1,4
         do j=1,5
            pt_re(i,j)=0.0; pt_im(i,j)=0.0
            ft_re(i,j)=0.0; ft_im(i,j)=0.0
            vc_re(i,j)=0.0; vc_im(i,j)=0.0
         enddo
         enddo
         pt_re(n,1)=pseed
         ft_re(n,1)=fseed
         vc_re(n,1)=vseed
         fn=float(n)
         ap=(1.0-0.5*fn*(2.0*fn-1.0)/(fn+1.0)*
     $      aor**(2*n+1))*roa**n
         bp=-(fn*(2.0*fn-1.0)*(2.0*fn+1.0)/(fn+1.0))*
     $      aor**(n+1)
         gn=2.0*(fn+3.0)/(2.0*fn+3.0)
         hn=fn-2.0-fn*(2.0*fn+1.0)/(2.0*fn+3.0)*aor**2
         au=0.25*fn*(gn+hn*aor**(2*n+1))*roa**(n+1)
         gn=fn+1.0
         hn=0.5*((fn-2.0)*(2.0*fn+1.0)*roa**2-
     $      fn*(2.0*fn-1.0))
         bu=fn*(gn+hn*aor**(2*n+1))*roa**(n-1)
         cv=fn*(fn+1.0)*(aor**(2*n+1)-1.0)*roa**n
         ddet=ap*bu-au*bp
         sp=0.0; su=0.0; sv=0.0
         do k=1,nleb
            call physalis_ylm_surface_gradient(xleb_d(k),yleb_d(k),
     $         zleb_d(k),1.0,4,Yt_re,Yt_im,Gt_xr,Gt_yr,Gt_zr,
     $         Gt_xi,Gt_yi,Gt_zi)
            call physalis_lamb_vel_at_point(rs*xleb_d(k),
     $         rs*yleb_d(k),rs*zleb_d(k),rs,1.0,1.0,
     $         pt_re,pt_im,ft_re,ft_im,n,ux,uy,uz)
            pfield=(ap*pseed+bp*fseed)*Yt_re(n,1)
            sp=sp+wleb_d(k)*Yt_re(n,1)*pfield
            su=su+wleb_d(k)*(Gt_xr(n,1)*ux+Gt_yr(n,1)*uy+
     $         Gt_zr(n,1)*uz)
            cx=yleb_d(k)*Gt_zr(n,1)-zleb_d(k)*Gt_yr(n,1)
            cy=zleb_d(k)*Gt_xr(n,1)-xleb_d(k)*Gt_zr(n,1)
            cz=xleb_d(k)*Gt_yr(n,1)-yleb_d(k)*Gt_xr(n,1)
            sv=sv+wleb_d(k)*(cx*ux+cy*uy+cz*uz)
         enddo
         prec=(sp*bu-su*bp)/ddet
         frec=(ap*su-au*sp)/ddet
         vrec=sv/cv
         allrterr=max(allrterr,abs(prec-pseed),abs(frec-fseed),
     $      abs(vrec-vseed))

c        Repeat with a purely imaginary m=1 coefficient.  For a real
c        physical field, 2*Re(C*Y)=-2*C_im*Y_im.  This test is essential:
c        the conjugate projection carries a second minus sign, so an
c        inconsistent toroidal reconstruction otherwise flips v_im on each
c        inner iteration and destabilizes all coupled Lamb coefficients.
         do i=1,4
         do j=1,5
            pt_re(i,j)=0.0; pt_im(i,j)=0.0
            ft_re(i,j)=0.0; ft_im(i,j)=0.0
            vc_re(i,j)=0.0; vc_im(i,j)=0.0
         enddo
         enddo
         pt_im(n,2)=pseed
         ft_im(n,2)=fseed
         vc_im(n,2)=vseed
         sp=0.0; su=0.0; sv=0.0
         do k=1,nleb
            call physalis_ylm_surface_gradient(xleb_d(k),yleb_d(k),
     $         zleb_d(k),1.0,4,Yt_re,Yt_im,Gt_xr,Gt_yr,Gt_zr,
     $         Gt_xi,Gt_yi,Gt_zi)
            call physalis_lamb_vel_at_point(rs*xleb_d(k),
     $         rs*yleb_d(k),rs*zleb_d(k),rs,1.0,1.0,
     $         pt_re,pt_im,ft_re,ft_im,n,ux,uy,uz)
            pfield=-2.0*(ap*pseed+bp*fseed)*Yt_im(n,2)
            sp=sp-wleb_d(k)*Yt_im(n,2)*pfield
            su=su-wleb_d(k)*(Gt_xi(n,2)*ux+Gt_yi(n,2)*uy+
     $         Gt_zi(n,2)*uz)
            cx=yleb_d(k)*Gt_zi(n,2)-zleb_d(k)*Gt_yi(n,2)
            cy=zleb_d(k)*Gt_xi(n,2)-xleb_d(k)*Gt_zi(n,2)
            cz=xleb_d(k)*Gt_yi(n,2)-yleb_d(k)*Gt_xi(n,2)
            sv=sv-wleb_d(k)*(cx*ux+cy*uy+cz*uz)
         enddo
         prec=(sp*bu-su*bp)/ddet
         frec=(ap*su-au*sp)/ddet
         vrec=sv/cv
         allrterr=max(allrterr,abs(prec-pseed),abs(frec-fseed),
     $      abs(vrec-vseed))
      enddo
c     Every completed Lamb velocity basis must vanish at r=a independent
c     of truncation order (S&P Sec. 2.1 and App. A.11).  Test independent
c     p, phi, and toroidal m=0 basis functions for every supported n.
      nosliperr=0.0
      do n=1,4
         do i=1,4
         do j=1,5
            pt_re(i,j)=0.0; pt_im(i,j)=0.0
            ft_re(i,j)=0.0; ft_im(i,j)=0.0
            vc_re(i,j)=0.0; vc_im(i,j)=0.0
         enddo
         enddo
         pt_re(n,1)=1.0
         do k=1,nleb
            call physalis_lamb_vel_at_point(xleb_d(k),yleb_d(k),
     $         zleb_d(k),1.0,1.0,1.0,pt_re,pt_im,ft_re,ft_im,
     $         n,ux,uy,uz)
            usq=sqrt(ux*ux+uy*uy+uz*uz)
            nosliperr=max(nosliperr,usq)
         enddo

         pt_re(n,1)=0.0
         ft_re(n,1)=1.0
         do k=1,nleb
            call physalis_lamb_vel_at_point(xleb_d(k),yleb_d(k),
     $         zleb_d(k),1.0,1.0,1.0,pt_re,pt_im,ft_re,ft_im,
     $         n,ux,uy,uz)
            usq=sqrt(ux*ux+uy*uy+uz*uz)
            nosliperr=max(nosliperr,usq)
         enddo

         ft_re(n,1)=0.0
         vc_re(n,1)=1.0
         do k=1,nleb
            call physalis_lamb_vel_at_point(xleb_d(k),yleb_d(k),
     $         zleb_d(k),1.0,1.0,1.0,pt_re,pt_im,ft_re,ft_im,
     $         n,ux,uy,uz)
            usq=sqrt(ux*ux+uy*uy+uz*uz)
            nosliperr=max(nosliperr,usq)
         enddo
      enddo

      do i=1,4
      do j=1,5
         vc_re(i,j)=0.0; vc_im(i,j)=0.0
      enddo
      enddo
      errmax=max(errmax,rterr,allrterr,allnormerr,alltangent,
     $           nosliperr)
      tol=1.0e-10

      if (nid.eq.0) then
         fu=989
         open(fu,file='physalis_harmonic_selftest.dat',
     $        status='replace')
         write(fu,'(A)') '# Y10_norm Y11_complex_norm grad10_norm ' //
     $      'grad11_complex_norm Y_cross grad_cross tangent_max ' //
     $      'p10_recovered phi10_recovered v10_recovered ' //
     $      'roundtrip_err allmode_roundtrip_err allmode_norm_err ' //
     $      'allmode_tangent surface_noslip_err err_max'
         write(fu,'(16E22.12)') yn0,yn1,gn0,gn1,ycross,gcross,
     $      tanmax,p1rec,f1rec,v1rec,rterr,allrterr,allnormerr,
     $      alltangent,nosliperr,errmax
         close(fu)
         write(6,'(A,7E13.5)') 'Physalis harmonic self-test: ',
     $      p1rec,f1rec,v1rec,rterr,allrterr,nosliperr,errmax
      endif

      if (errmax.gt.tol) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: Physalis harmonic self-test failed.'
         call exitt
      endif

      return
      end

c-----------------------------------------------------------------------

      subroutine physalis_iteration
      include 'SIZE'
      include 'TOTAL'

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      real p_re_start(4,5),p_im_start(4,5)
      real phi_re_start(4,5),phi_im_start(4,5)
      real v_re_start(4,5),v_im_start(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      real F_raw_diag(3),T_raw_diag(3)
      common /phys_raw_force/ F_raw_diag,T_raw_diag
      real raw_p10_diag,raw_phi10_diag
      real raw_coeff_norm_diag,commit_coeff_norm_diag
      real raw_defect_diag
      common /phys_beta_diag/ raw_p10_diag,raw_phi10_diag,
     $ raw_coeff_norm_diag,commit_coeff_norm_diag,raw_defect_diag
      integer stage4_m0_project_on
      common /stage4_diag_i/ stage4_m0_project_on
      real s4_m0_norm,s4_mgt0_norm,s4_mgt0_ratio
      real s4_rt_u_pre,s4_rt_p_pre,s4_rt_u_post,s4_rt_p_post
      common /stage4_diag_r/ s4_m0_norm,s4_mgt0_norm,
     $ s4_mgt0_ratio,s4_rt_u_pre,s4_rt_p_pre,
     $ s4_rt_u_post,s4_rt_p_post

      integer nleb
      parameter(nleb=38)
      real u_til_l(nleb,3),p_til_l(nleb)
      common /phys_tilde/ u_til_l,p_til_l
      real U_lab_l(nleb,3),p_lab_l(nleb)
      common /phys_leb_fields/ U_lab_l,p_lab_l
      real Sp_re(4,5),Sp_im(4,5),Su_re(4,5),Su_im(4,5)
      real Sv_re(4,5),Sv_im(4,5)
      common /phys_sprods/ Sp_re,Sp_im,Su_re,Su_im,Sv_re,Sv_im
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer k,n,m
      real cres_num,cres_den,cres_eps
      real rnum,rden,cnorm2
      integer s19_freeze_coeff
      logical s19_frozen_ready,s19_freeze_banner
      save s19_frozen_ready,s19_freeze_banner
      data s19_frozen_ready /.false./
      data s19_freeze_banner /.false./
      parameter(s19_freeze_coeff=0)

      cres_eps = 1.0e-30

c     Stage19 FROZEN mode:
c     after the first normal field->Lamb extraction, retain the same
c     coefficients and reconstruct the same physical cage target.
      if (s19_freeze_coeff.eq.1 .and. s19_frozen_ready) then
         if (nid.eq.0 .and. .not.s19_freeze_banner) then
            write(6,*) 'STAGE19: FROZEN LAMB COEFFICIENTS ACTIVE'
            s19_freeze_banner=.true.
         endif
         goto 890
      endif

      do m=1,5
      do n=1,4
         p_re_old(n,m)  =p_re(n,m);   p_im_old(n,m)  =p_im(n,m)
         phi_re_old(n,m)=phi_re(n,m); phi_im_old(n,m)=phi_im(n,m)
         v_re_old(n,m)  =v_re(n,m);   v_im_old(n,m)  =v_im(n,m)
         p_re_start(n,m)  =p_re(n,m)
         p_im_start(n,m)  =p_im(n,m)
         phi_re_start(n,m)=phi_re(n,m)
         phi_im_start(n,m)=phi_im(n,m)
         v_re_start(n,m)  =v_re(n,m)
         v_im_start(n,m)  =v_im(n,m)
      enddo
      enddo

      do k=1,n_phys_iter

         call physalis_sample_sem_fields
         call physalis_transform_frame

         call physalis_scalar_products

         call physalis_lamb_solve

c        STAGE4: quantify axisymmetric m>0 leakage and extractor/reconstructor
c        round-trip BEFORE any projection.  Then optionally project the live
c        raw coefficients to m=0 before they enter force/relaxation/cage.
         call stage4_measure_mleak
         call stage4_roundtrip_current(s4_rt_u_pre,s4_rt_p_pre)
         if (ldim.eq.2 .and. stage4_m0_project_on.eq.1)
     $      call stage4_project_live_m0

c        STAGE5: measure degree content before optional n=3/n=4 filter.
         call stage5_measure_raw_degree
         call stage5_apply_coeff_filter

         call stage4_roundtrip_current(s4_rt_u_post,s4_rt_p_post)

c        STAGE3: evaluate RAW Lamb force before coefficient relaxation.
c        This is diagnostic only; the committed relaxed force remains F_phys.
         call physalis_compute_lamb_force_arrays(
     $      p_re,p_im,phi_re,phi_im,v_re,v_im,
     $      F_raw_diag,T_raw_diag)

c        STAGE2: save RAW extractor output before coefficient relaxation.
         raw_p10_diag = p_re(1,1)
         raw_phi10_diag = phi_re(1,1)
         rnum = 0.0
         rden = 0.0
         do m=1,5
         do n=1,4
            rnum=rnum+
     $         (p_re(n,m)-p_re_old(n,m))**2+
     $         (p_im(n,m)-p_im_old(n,m))**2+
     $         (phi_re(n,m)-phi_re_old(n,m))**2+
     $         (phi_im(n,m)-phi_im_old(n,m))**2+
     $         (v_re(n,m)-v_re_old(n,m))**2+
     $         (v_im(n,m)-v_im_old(n,m))**2
            rden=rden+
     $         p_re(n,m)**2+p_im(n,m)**2+
     $         phi_re(n,m)**2+phi_im(n,m)**2+
     $         v_re(n,m)**2+v_im(n,m)**2
         enddo
         enddo
         raw_coeff_norm_diag=sqrt(max(rden,0.0))
         raw_defect_diag=sqrt(rnum/max(rden,cres_eps))

         call physalis_relax_coefficients

      enddo

      if (s19_freeze_coeff.eq.1) then
         s19_frozen_ready=.true.
         if (nid.eq.0) write(6,*)
     $      'STAGE19: freeze coefficients after first extraction'
      endif

  890 continue
c     STAGE5: norm of each committed harmonic degree.
      call stage5_measure_commit_degree

c     STAGE2: norm of the relaxed/committed state used for cage and force.
      cnorm2=0.0
      do m=1,5
      do n=1,4
         cnorm2=cnorm2+
     $      p_re(n,m)**2+p_im(n,m)**2+
     $      phi_re(n,m)**2+phi_im(n,m)**2+
     $      v_re(n,m)**2+v_im(n,m)**2
      enddo
      enddo
      commit_coeff_norm_diag=sqrt(max(cnorm2,0.0))

      call s35ad_axisym8_update
      if (phys_mode.ge.3) then
         call physalis_reconstruct_velocity_cage
      endif
      if (phys_mode.ge.5) then
         call physalis_reconstruct_pressure_cage
      endif
      call stage24_apply_target_mode

      call physalis_compute_lamb_force

      cres_num = 0.0
      cres_den = 0.0
      do m=1,5
      do n=1,4
         cres_num = cres_num +
     $      (phi_re(n,m)-phi_re_start(n,m))**2 +
     $      (phi_im(n,m)-phi_im_start(n,m))**2 +
     $      (p_re(n,m) -p_re_start(n,m) )**2 +
     $      (p_im(n,m) -p_im_start(n,m) )**2 +
     $      (v_re(n,m) -v_re_start(n,m) )**2 +
     $      (v_im(n,m) -v_im_start(n,m) )**2
         cres_den = cres_den +
     $      phi_re(n,m)**2 + phi_im(n,m)**2 +
     $      p_re(n,m)**2   + p_im(n,m)**2 +
     $      v_re(n,m)**2   + v_im(n,m)**2
      enddo
      enddo
      coeff_resid = sqrt(cres_num/max(cres_den,cres_eps))

      return
      end


      subroutine physalis_true_inner_loop(igeom)
      include 'SIZE'
      include 'TOTAL'
      integer igeom
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      integer n_phys_inner
      common /physalis_inner/ n_phys_inner
      integer n_phys_inner_min
      common /physalis_inner_min/ n_phys_inner_min
      real phys_tol_a,phys_tol_w
      common /physalis_particle_tols/ phys_tol_a,phys_tol_w
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer phys_m0_project_on
      common /physalis_m0_ctl/ phys_m0_project_on

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      real F_raw_diag(3),T_raw_diag(3)
      common /phys_raw_force/ F_raw_diag,T_raw_diag
      real s16_acc_coeff,s16_acc_cage,s16_acc_p,s16_acc_div
      real s16_def_rms,s16_def_max
      integer s16_acc_inner
      common /stage16_accept_r/ s16_acc_coeff,s16_acc_cage,
     $ s16_acc_p,s16_acc_div,s16_def_rms,s16_def_max
      common /stage16_accept_i/ s16_acc_inner
      real raw_p10_diag,raw_phi10_diag
      real raw_coeff_norm_diag,commit_coeff_norm_diag
      real raw_defect_diag
      common /phys_beta_diag/ raw_p10_diag,raw_phi10_diag,
     $ raw_coeff_norm_diag,commit_coeff_norm_diag,raw_defect_diag
      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real pk_xn,pk_yn,pk_zn,pk_un,pk_vn,pk_wn
      real pk_anx,pk_any,pk_anz,pk_uk,pk_vk,pk_wk
      real pk_akx,pk_aky,pk_akz,pk_uc,pk_vc,pk_wc
      real pk_acx,pk_acy,pk_acz
      real coeff_resid_raw,coeff_resid_relaxed
      real particle_resid_a,particle_resid_w,closure_resid
      common /physalis_kappa_r/ pk_xn,pk_yn,pk_zn,
     $ pk_un,pk_vn,pk_wn,pk_anx,pk_any,pk_anz,
     $ pk_uk,pk_vk,pk_wk,pk_akx,pk_aky,pk_akz,
     $ pk_uc,pk_vc,pk_wc,pk_acx,pk_acy,pk_acz,
     $ coeff_resid_raw,coeff_resid_relaxed,
     $ particle_resid_a,particle_resid_w,closure_resid
      integer phys_kappa_active,phys_accept_ready,phys_inner_used
      integer phys_last_begin_step,phys_last_commit_step
      common /physalis_kappa_i/ phys_kappa_active,
     $ phys_accept_ready,phys_inner_used,
     $ phys_last_begin_step,phys_last_commit_step

      real pprev_r(4,5),pprev_i(4,5),fprev_r(4,5),fprev_i(4,5)
      real vprev_r(4,5),vprev_i(4,5)
      real prraw(4,5),piraw(4,5),frraw(4,5),firaw(4,5)
      real vrraw(4,5),viraw(4,5)
      real pracc(4,5),piacc(4,5),fracc(4,5),fiacc(4,5)
      real vracc(4,5),viacc(4,5)
      real Fraw(3),Traw(3)
      real ycur(7),yraw(7),ynext(7),yscale(7)
      real and_rnorm,asec_rnorm,anext_a
      real aoldx,aoldy,aoldz,woldx,woldy,woldz
      real amapx,amapy,amapz,wmapx,wmapy,wmapz
      real cclose,aclose,wclose,ascale,wscale,cfloor
      real cbase,beta_warm,beta_inactive
      real trust_radius,trust_step_norm,trust_scale
      integer use_anderson,anderson_start_k,strict_vel_gate
      real phys_tol_div_audit,phys_tol_vel_audit
      integer k,n,m,i,and_method,and_kk,asec_method
      integer gb_coeff,gb_a,gb_w,gb_p,gb_div,gb_vel
      logical closure_ok
      parameter(beta_warm=0.50000000,
     $ beta_inactive=0.50000000)
      parameter(use_anderson=1,
     $ anderson_start_k=2,strict_vel_gate=0)
      parameter(trust_radius=0.00000000)
      parameter(phys_tol_div_audit=1.0e-4)
      parameter(phys_tol_vel_audit=5.0e-3)

      if (phys_mode.lt.7) return
      if (igeom.lt.2) return
      if (n_phys_inner.le.0) return
      if (phys_kappa_active.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: coupled loop entered without active particle step'
         call exitt
      endif

      closure_ok=.false.
      phys_accept_ready=0
      gb_coeff=0
      gb_a=0
      gb_w=0
      gb_p=0
      gb_div=0
      gb_vel=0
      cfloor=1.0e-8
      do k=1,n_phys_inner
         aoldx=pk_akx
         aoldy=pk_aky
         aoldz=pk_akz
         woldx=pk_uk
         woldy=pk_vk
         woldz=pk_wk

         do n=1,4
         do m=1,5
            pprev_r(n,m)=p_re(n,m)
            pprev_i(n,m)=p_im(n,m)
            fprev_r(n,m)=phi_re(n,m)
            fprev_i(n,m)=phi_im(n,m)
            vprev_r(n,m)=v_re(n,m)
            vprev_i(n,m)=v_im(n,m)
         enddo
         enddo

         call physalis_extract_selected
         do n=1,4
         do m=1,5
            prraw(n,m)=p_re(n,m)
            piraw(n,m)=p_im(n,m)
            frraw(n,m)=phi_re(n,m)
            firaw(n,m)=phi_im(n,m)
            vrraw(n,m)=v_re(n,m)
            viraw(n,m)=v_im(n,m)
         enddo
         enddo
         call physalis_coeff_residual_pair(
     $      prraw,piraw,frraw,firaw,vrraw,viraw,
     $      pprev_r,pprev_i,fprev_r,fprev_i,
     $      vprev_r,vprev_i,lmax,coeff_resid_raw)

         call physalis_compute_lamb_force_arrays(
     $      prraw,piraw,frraw,firaw,vrraw,viraw,Fraw,Traw)
         call physalis_particle_map_force(aoldx,aoldy,aoldz,
     $      Fraw(3),pk_acx,pk_acy,pk_acz,pk_uc,pk_vc,pk_wc)

         ascale=max(abs(sm_gz),1.0e-6)
         wscale=max(abs(pk_wc),abs(woldz),
     $              sqrt(abs(sm_gz)*sm_a),1.0e-10)
         particle_resid_a=abs(pk_acz-aoldz)/ascale
         particle_resid_w=abs(pk_wc-woldz)/wscale
         closure_resid=max(coeff_resid_raw,particle_resid_a,
     $                     particle_resid_w)
         if (coeff_resid_raw.ge.phys_tol_coeff)
     $      gb_coeff=gb_coeff+1
         if (particle_resid_a.ge.phys_tol_a)
     $      gb_a=gb_a+1
         if (particle_resid_w.ge.phys_tol_w)
     $      gb_w=gb_w+1

         if (k.ge.n_phys_inner_min .and.
     $       coeff_resid_raw.lt.phys_tol_coeff .and.
     $       particle_resid_a.lt.phys_tol_a .and.
     $       particle_resid_w.lt.phys_tol_w) then
            call physalis_update_velocity_cage_residual
            call physalis_update_divergence_norm
            if (cage_vel_res.ge.phys_tol_vel_audit)
     $         gb_vel=gb_vel+1
            if (pressure_cage_res.ge.phys_tol_cage)
     $         gb_p=gb_p+1
            if (div_norm.ge.phys_tol_div_audit)
     $         gb_div=gb_div+1
            if (nid.eq.0) write(6,'(A,I8,I5,6E13.4)')
     $       'Physalis gate: step/k coeff/a/w/cage/p/div=',
     $       istep,k,coeff_resid_raw,particle_resid_a,
     $       particle_resid_w,cage_vel_res,pressure_cage_res,
     $       div_norm
c           cage_vel_res is a post-solve diagnostic, not the nonlinear
c           fixed-point residual.  v3 incorrectly used it as a hard gate.
            if (pressure_cage_res.lt.phys_tol_cage .and.
     $          div_norm.lt.phys_tol_div_audit .and.
     $          (strict_vel_gate.eq.0 .or.
     $           cage_vel_res.lt.phys_tol_vel_audit)) then
               do n=1,4
               do m=1,5
                  p_re(n,m)=pprev_r(n,m)
                  p_im(n,m)=pprev_i(n,m)
                  phi_re(n,m)=fprev_r(n,m)
                  phi_im(n,m)=fprev_i(n,m)
                  v_re(n,m)=vprev_r(n,m)
                  v_im(n,m)=vprev_i(n,m)
                  p_re_old(n,m)=pprev_r(n,m)
                  p_im_old(n,m)=pprev_i(n,m)
                  phi_re_old(n,m)=fprev_r(n,m)
                  phi_im_old(n,m)=fprev_i(n,m)
                  v_re_old(n,m)=vprev_r(n,m)
                  v_im_old(n,m)=vprev_i(n,m)
               enddo
               enddo
               coeff_resid=coeff_resid_raw
               raw_p10_diag=prraw(1,1)
               raw_phi10_diag=frraw(1,1)
               call physalis_stage13_coeff_norms(
     $            prraw,piraw,frraw,firaw,vrraw,viraw,
     $            pprev_r,pprev_i,fprev_r,fprev_i,
     $            vprev_r,vprev_i,lmax,
     $            raw_coeff_norm_diag,commit_coeff_norm_diag)
               raw_defect_diag=coeff_resid_raw
               do i=1,3
                  F_raw_diag(i)=Fraw(i)
                  T_raw_diag(i)=Traw(i)
               enddo
               call physalis_compute_lamb_force
               closure_ok=.true.
c              STAGE16 preserve accepted nonlinear state before any
c              later cage rebuild resets the live diagnostic COMMON.
               s16_acc_coeff=coeff_resid_raw
               s16_acc_cage=cage_vel_res
               s16_acc_p=pressure_cage_res
               s16_acc_div=div_norm
               s16_acc_inner=k
               call physalis_stage16_defect_norms(
     $            s16_def_rms,s16_def_max)
               phys_accept_ready=1
               phys_inner_used=k
               call physalis_write_gate_summary(k,1,gb_coeff,gb_a,
     $            gb_w,gb_vel,gb_p,gb_div,coeff_resid_raw,
     $            particle_resid_a,particle_resid_w,cage_vel_res,
     $            pressure_cage_res,div_norm)
               if (nid.eq.0) write(6,'(A,I8,I5,6E13.4)')
     $          'Physalis converged: step/k/res=',istep,k,
     $          coeff_resid_raw,particle_resid_a,
     $          particle_resid_w,cage_vel_res,pressure_cage_res,
     $          div_norm
               goto 100
            endif
         endif

         if (k.eq.1 .or. k.eq.2) then
            yscale(1)=ascale
            cbase=max(abs(pprev_r(1,1)),abs(prraw(1,1)),
     $                abs(fprev_r(1,1)),abs(frraw(1,1)),1.0)
            yscale(2)=max(abs(pprev_r(1,1)),abs(prraw(1,1)),
     $                    1.0e-4*cbase,cfloor)
            yscale(3)=max(abs(fprev_r(1,1)),abs(frraw(1,1)),
     $                    1.0e-4*cbase,cfloor)
            yscale(4)=max(abs(pprev_r(2,1)),abs(prraw(2,1)),
     $                    1.0e-4*cbase,cfloor)
            yscale(5)=max(abs(fprev_r(2,1)),abs(frraw(2,1)),
     $                    1.0e-4*cbase,cfloor)
            yscale(6)=max(abs(pprev_r(3,1)),abs(prraw(3,1)),
     $                    1.0e-4*cbase,cfloor)
            yscale(7)=max(abs(fprev_r(3,1)),abs(frraw(3,1)),
     $                    1.0e-4*cbase,cfloor)
         endif

         ycur(1)=aoldz/yscale(1)
         ycur(2)=pprev_r(1,1)/yscale(2)
         ycur(3)=fprev_r(1,1)/yscale(3)
         ycur(4)=pprev_r(2,1)/yscale(4)
         ycur(5)=fprev_r(2,1)/yscale(5)
         ycur(6)=pprev_r(3,1)/yscale(6)
         ycur(7)=fprev_r(3,1)/yscale(7)
         yraw(1)=pk_acz/yscale(1)
         yraw(2)=prraw(1,1)/yscale(2)
         yraw(3)=frraw(1,1)/yscale(3)
         yraw(4)=prraw(2,1)/yscale(4)
         yraw(5)=frraw(2,1)/yscale(5)
         yraw(6)=prraw(3,1)/yscale(6)
         yraw(7)=frraw(3,1)/yscale(7)

         if (use_anderson.eq.0 .or. k.lt.anderson_start_k) then
            and_rnorm=0.0
            do i=1,7
               and_rnorm=and_rnorm+(yraw(i)-ycur(i))**2
               ynext(i)=ycur(i)+beta_warm*(yraw(i)-ycur(i))
            enddo
            and_rnorm=sqrt(and_rnorm)
            and_method=0
         else
            and_kk=k-anderson_start_k+1
            call physalis_anderson7_mix(and_kk,ycur,yraw,ynext,
     $         and_method,and_rnorm)
         endif

c        Optional trust radius in the SAME normalized seven-component
c        nonlinear state.  This limits an inner update, never a physical
c        timestep-to-timestep low-pass filter.
         if (trust_radius.gt.0.0) then
            trust_step_norm=0.0
            do i=1,7
               trust_step_norm=trust_step_norm+
     $            (ynext(i)-ycur(i))**2
            enddo
            trust_step_norm=sqrt(trust_step_norm)
            if (trust_step_norm.gt.trust_radius) then
               trust_scale=trust_radius/
     $            max(trust_step_norm,1.0e-30)
               do i=1,7
                  ynext(i)=ycur(i)+trust_scale*
     $               (ynext(i)-ycur(i))
               enddo
               and_method=4
            endif
         endif
         anext_a=ynext(1)*yscale(1)
         asec_method=and_method
         asec_rnorm=particle_resid_a
         if (nid.eq.0 .and.
     $      (k.le.4 .or. mod(k,5).eq.0)) then
            write(6,'(A,I8,I4,4E13.4,I4)')
     $       'Physalis block: step/k a/Graw/anext/Ra/method=',
     $       istep,k,aoldz,pk_acz,anext_a,asec_rnorm,asec_method
         endif

         do n=1,4
         do m=1,5
            p_re(n,m)=pprev_r(n,m)+beta_inactive*
     $         (prraw(n,m)-pprev_r(n,m))
            p_im(n,m)=pprev_i(n,m)+beta_inactive*
     $         (piraw(n,m)-pprev_i(n,m))
            phi_re(n,m)=fprev_r(n,m)+beta_inactive*
     $         (frraw(n,m)-fprev_r(n,m))
            phi_im(n,m)=fprev_i(n,m)+beta_inactive*
     $         (firaw(n,m)-fprev_i(n,m))
            v_re(n,m)=vprev_r(n,m)+beta_inactive*
     $         (vrraw(n,m)-vprev_r(n,m))
            v_im(n,m)=vprev_i(n,m)+beta_inactive*
     $         (viraw(n,m)-vprev_i(n,m))
         enddo
         enddo
         p_re(1,1)=ynext(2)*yscale(2)
         phi_re(1,1)=ynext(3)*yscale(3)
         p_re(2,1)=ynext(4)*yscale(4)
         phi_re(2,1)=ynext(5)*yscale(5)
         p_re(3,1)=ynext(6)*yscale(6)
         phi_re(3,1)=ynext(7)*yscale(7)

         pk_akx=pk_acx
         pk_aky=pk_acy
         pk_akz=ynext(1)*yscale(1)
         pk_uk=pk_uc
         pk_vk=pk_vc
         pk_wk=pk_wn+0.5*dt*(pk_akz+pk_anz)
         if (validation_case.le.2) then
            call validation_prescribed_kinematics(time,
     $         amapx,amapy,amapz,pk_uk,pk_vk,pk_wk,
     $         pk_akx,pk_aky,pk_akz)
         endif

         do n=1,4
         do m=1,5
            p_re_old(n,m)=p_re(n,m)
            p_im_old(n,m)=p_im(n,m)
            phi_re_old(n,m)=phi_re(n,m)
            phi_im_old(n,m)=phi_im(n,m)
            v_re_old(n,m)=v_re(n,m)
            v_im_old(n,m)=v_im(n,m)
         enddo
         enddo

         if (ldim.eq.2 .and. phys_m0_project_on.eq.1)
     $      call physalis_axisym_project_m0('after_mix')
         call physalis_coeff_residual_pair(
     $      p_re,p_im,phi_re,phi_im,v_re,v_im,
     $      pprev_r,pprev_i,fprev_r,fprev_i,
     $      vprev_r,vprev_i,lmax,coeff_resid_relaxed)
         coeff_resid=coeff_resid_raw

         call physalis_compute_lamb_force
         call physalis_update_particle_state

         call physalis_build_gll_cage
         if (phys_mode.ge.3) call physalis_reconstruct_velocity_cage
         if (phys_mode.ge.5) call physalis_reconstruct_pressure_cage
         call physalis_replay_timestep(igeom,k)

      enddo

  100 continue
      if (.not.closure_ok) then
         call physalis_write_gate_summary(n_phys_inner,0,gb_coeff,
     $      gb_a,gb_w,gb_vel,gb_p,gb_div,coeff_resid_raw,
     $      particle_resid_a,particle_resid_w,cage_vel_res,
     $      pressure_cage_res,div_norm)
         if (nid.eq.0) write(6,'(A,I10,4E14.5)')
     $      'ERROR: coupled Physalis loop failed at step ',istep,
     $      coeff_resid_raw,particle_resid_a,
     $      particle_resid_w,closure_resid
         if (nid.eq.0) write(6,'(A,3E14.5)')
     $      ' final cage/pressure/div residuals: ',
     $      cage_vel_res,pressure_cage_res,div_norm
         if (nid.eq.0) write(6,'(A,6E14.5)')
     $      ' final a(cur/raw/mix), w(cur/raw/mix): ',
     $      aoldz,pk_acz,pk_akz,woldz,pk_wc,pk_wk
         if (nid.eq.0) write(6,'(A,I5,E14.5)')
     $      ' final coefficient mix method/rnorm: ',and_method,
     $      and_rnorm
         if (nid.eq.0) write(6,'(A,I5,E14.5)')
     $      ' final acceleration mix method/resid: ',asec_method,
     $      asec_rnorm
         call exitt
      endif

      call spmove_commit_particle
      return
      end

      subroutine physalis_anderson7_mix(kk,ycur,yraw,ynext,
     $ method,rnorm)
c  Safeguarded type-II Anderson mixing for a seven-component scaled state.
c  Memory m=2.  History resets at every physical step and after a rejected
c  Anderson proposal.  method: 0=initial Picard, 1/2=Anderson depth,
c  -1=safeguarded fallback.
      include 'SIZE'
      include 'TOTAL'
      integer kk,method
      real ycur(7),yraw(7),ynext(7),rnorm
      real y1(7),y2(7),r1(7),r2(7)
      real resv(7),dr1(7),dr2(7),dy1(7),dy2(7)
      real step(7),pstep(7)
      real a11,a12,a22,b1,b2,det,lam,g1,g2
      real beta0,betafb,stepcap,gammacap,growth
      real trace,pnorm,snorm,prev_norm,best_norm
      real rwin(6),wmin
      integer nhist,last_step,grow_count,i,j,nwin,nup
      integer no_improve,picard_left
      logical fallback,reset_hist,bad,trend_bad,force_picard
      save y1,y2,r1,r2,nhist,last_step,grow_count,prev_norm
      save best_norm,rwin,nwin,no_improve,picard_left
      data nhist /0/,last_step /-999999/,grow_count /0/
      data prev_norm /0.0/,best_norm /1.0e30/
      data rwin /6*0.0/,nwin /0/,no_improve /0/
      data picard_left /0/
      parameter(beta0=0.5,betafb=0.02,stepcap=6.0)
      parameter(gammacap=100.0,growth=1.02)

      if (istep.ne.last_step .or. kk.eq.1) then
         nhist=0
         grow_count=0
         prev_norm=0.0
         best_norm=1.0e30
         nwin=0
         no_improve=0
         picard_left=0
         do i=1,6
            rwin(i)=0.0
         enddo
         last_step=istep
      endif

      rnorm=0.0
      do i=1,7
         resv(i)=yraw(i)-ycur(i)
         rnorm=rnorm+resv(i)*resv(i)
         pstep(i)=beta0*resv(i)
      enddo
      rnorm=sqrt(rnorm)

c     Track both local growth and a six-iterate cumulative trend.
c     The old two-consecutive-growth test misses smooth drift whenever a
c     small downward fluctuation resets grow_count.  The window test asks
c     whether at least three of five increments grow and whether the net
c     rise exceeds one percent.  A second test catches sustained loss of
c     progress relative to the best residual of the physical step.
      if (nhist.gt.0) then
         if (rnorm.gt.growth*max(prev_norm,1.0e-30)) then
            grow_count=grow_count+1
         else
            grow_count=0
         endif
      endif
      do j=1,5
         rwin(j)=rwin(j+1)
      enddo
      rwin(6)=rnorm
      nwin=min(nwin+1,6)
      if (rnorm.lt.0.98*best_norm) then
         best_norm=rnorm
         no_improve=0
      else
         no_improve=no_improve+1
      endif
      trend_bad=.false.
      if (nwin.ge.6) then
         nup=0
         wmin=rwin(1)
         do j=2,6
            wmin=min(wmin,rwin(j))
            if (rwin(j).gt.1.0005*rwin(j-1)) nup=nup+1
         enddo
         if (nup.ge.3 .and. rnorm.gt.1.01*rwin(1))
     $      trend_bad=.true.
      endif
      if (no_improve.ge.6 .and. rnorm.gt.1.05*best_norm)
     $   trend_bad=.true.
      if (trend_bad .and. picard_left.eq.0) then
         picard_left=5
         nhist=0
         grow_count=0
         no_improve=0
         best_norm=rnorm
      endif
      if (grow_count.ge.2 .and. picard_left.eq.0) then
         picard_left=3
         nhist=0
         grow_count=0
      endif
      force_picard=picard_left.gt.0

      fallback=.false.
      reset_hist=.false.
      method=0
      do i=1,7
         step(i)=pstep(i)
      enddo

      if (force_picard) then
         fallback=.true.
         reset_hist=.true.
         picard_left=picard_left-1
      else if (nhist.eq.1) then
         a11=0.0
         b1=0.0
         do i=1,7
            dr1(i)=resv(i)-r1(i)
            dy1(i)=ycur(i)-y1(i)
            a11=a11+dr1(i)*dr1(i)
            b1=b1+dr1(i)*resv(i)
         enddo
         lam=1.0e-4*max(a11,1.0e-20)
         if (a11+lam.le.1.0e-24) then
            fallback=.true.
            reset_hist=.true.
         else
            g1=b1/(a11+lam)
            if (abs(g1).gt.gammacap) then
               fallback=.true.
               reset_hist=.true.
            else
               do i=1,7
                  step(i)=beta0*resv(i)-
     $               (dy1(i)+beta0*dr1(i))*g1
               enddo
               method=1
            endif
         endif
      else if (nhist.ge.2) then
         a11=0.0
         a12=0.0
         a22=0.0
         b1=0.0
         b2=0.0
         do i=1,7
            dr1(i)=r1(i)-r2(i)
            dy1(i)=y1(i)-y2(i)
            dr2(i)=resv(i)-r1(i)
            dy2(i)=ycur(i)-y1(i)
            a11=a11+dr1(i)*dr1(i)
            a12=a12+dr1(i)*dr2(i)
            a22=a22+dr2(i)*dr2(i)
            b1=b1+dr1(i)*resv(i)
            b2=b2+dr2(i)*resv(i)
         enddo
         trace=a11+a22
         lam=1.0e-4*max(trace,1.0e-20)
         a11=a11+lam
         a22=a22+lam
         det=a11*a22-a12*a12
         if (abs(det).le.1.0e-14*max(a11*a22,1.0e-30)) then
            fallback=.true.
            reset_hist=.true.
         else
            g1=( b1*a22-b2*a12)/det
            g2=(-b1*a12+b2*a11)/det
            if (max(abs(g1),abs(g2)).gt.gammacap) then
               fallback=.true.
               reset_hist=.true.
            else
               do i=1,7
                  step(i)=beta0*resv(i)-
     $               (dy1(i)+beta0*dr1(i))*g1-
     $               (dy2(i)+beta0*dr2(i))*g2
               enddo
               method=2
            endif
         endif
      endif

c     Reject excessively large or non-finite Anderson proposals.
      pnorm=0.0
      snorm=0.0
      bad=.false.
      do i=1,7
         pnorm=pnorm+pstep(i)*pstep(i)
         snorm=snorm+step(i)*step(i)
         if (step(i).ne.step(i)) bad=.true.
         if (abs(step(i)).gt.1.0e30) bad=.true.
      enddo
      pnorm=sqrt(pnorm)
      snorm=sqrt(snorm)
      if (snorm.gt.stepcap*max(pnorm,1.0e-12) .and.
     $    .not.fallback) then
c        Retain the Anderson direction but cap its scaled step norm.
         do i=1,7
            step(i)=step(i)*stepcap*max(pnorm,1.0e-12)/snorm
         enddo
         method=3
      endif
      if (bad) then
         fallback=.true.
         reset_hist=.true.
      endif

      if (fallback) then
         method=-1
         do i=1,7
            step(i)=betafb*resv(i)
         enddo
      endif
      do i=1,7
         ynext(i)=ycur(i)+step(i)
      enddo

c     Save only accepted input/residual pairs for the next iteration.
      if (reset_hist) then
         if (picard_left.gt.0) then
            nhist=0
         else
            do i=1,7
               y1(i)=ycur(i)
               r1(i)=resv(i)
            enddo
            nhist=1
         endif
         grow_count=0
      else if (nhist.eq.0) then
         do i=1,7
            y1(i)=ycur(i)
            r1(i)=resv(i)
         enddo
         nhist=1
      else if (nhist.eq.1) then
         do i=1,7
            y2(i)=y1(i)
            r2(i)=r1(i)
            y1(i)=ycur(i)
            r1(i)=resv(i)
         enddo
         nhist=2
      else
         do i=1,7
            y2(i)=y1(i)
            r2(i)=r1(i)
            y1(i)=ycur(i)
            r1(i)=resv(i)
         enddo
         nhist=2
      endif
      prev_norm=rnorm
      return
      end
c-----------------------------------------------------------------------

      subroutine physalis_extract_selected
c     Direct 38-point Lebedev extractor at the ACTIVE r_sample_over_a.
c     The uploaded dormant full-inner helper forced q=1.25 even though
c     N00 uses q=1.20.  That would confound coupling and q in this matrix.
c     Keep the same direct orientation/m=0 logic but do not override q.
      include 'SIZE'
      include 'TOTAL'
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      integer phys_leb_orient
      common /phys_leb_orientation/ phys_leb_orient
      integer phys_m0_project_on
      common /physalis_m0_ctl/ phys_m0_project_on
      real qd_p10,qd_phi10,qd_fhat
      common /phys_q125direct_diag/ qd_p10,qd_phi10,qd_fhat
      real Fdir(3),Tdir(3)

      call physalis_lebedev_init
      phys_leb_orient=0
      call physalis_sample_sem_fields
      call physalis_transform_frame
      call physalis_scalar_products
      call physalis_lamb_solve
      if (ldim.eq.2 .and. phys_m0_project_on.eq.1)
     $   call physalis_axisym_project_m0('after_solve')
      call physalis_compute_lamb_force_arrays(
     $   p_re,p_im,phi_re,phi_im,v_re,v_im,Fdir,Tdir)
      qd_p10=p_re(1,1)
      qd_phi10=phi_re(1,1)
      qd_fhat=Fdir(3)
      return
      end

c-----------------------------------------------------------------------
      subroutine validation_print_extractor_banner
      include 'SIZE'
      include 'TOTAL'
      integer extractor_mode
      common /validation_extractor_i/ extractor_mode
      integer EXTRACT_DUALROT,EXTRACT_SHLS,EXTRACT_R2H
      integer EXTRACT_DIRECT
      parameter(EXTRACT_DUALROT=1,EXTRACT_SHLS=2,EXTRACT_R2H=3,
     $          EXTRACT_DIRECT=4)

      write(6,*) 'Physalis/Nek: extractor_mode=',extractor_mode
      if (extractor_mode.eq.EXTRACT_DUALROT) then
         write(6,*) 'Physalis/Nek: estimator=q125 dual orientation'
         write(6,*) 'Physalis/Nek: q150 is not used in particle force'
         write(6,*) 'Physalis/Nek: role=isolated/full-sphere default'
      elseif (extractor_mode.eq.EXTRACT_SHLS) then
         write(6,*) 'Physalis/Nek: estimator=q125 76point SHLS'
         write(6,*) 'Physalis/Nek: q150 is not used in particle force'
         write(6,*) 'Physalis/Nek: mask geometry not yet implemented'
      elseif (extractor_mode.eq.EXTRACT_R2H) then
         write(6,*) 'Physalis/Nek: estimator=q125/q150 robust radius'
         write(6,*) 'Physalis/Nek: q150 participates in particle force'
         write(6,*) 'Physalis/Nek: role=diagnostic, not dense default'
      elseif (extractor_mode.eq.EXTRACT_DIRECT) then
         write(6,*) 'Physalis/Nek: estimator=q125 direct Lebedev'
         write(6,*) 'Physalis/Nek: same 38 points as 3D master'
         write(6,*) 'Physalis/Nek: IFAXIS rotate/sample/rotate bridge'
      else
         write(6,*) 'Physalis/Nek: ERROR invalid extractor mode'
      endif
      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_extract_q125_direct
c  S&P/G&P-style reference extractor: one canonical 38-point Lebedev
c  scalar-product map at r/a=1.25.  No rotated second map, no least-squares
c  fit, and no q=1.50 radius enters the particle force.
      include 'SIZE'
      include 'TOTAL'

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      integer phys_leb_orient
      common /phys_leb_orientation/ phys_leb_orient

      real qd_p10,qd_phi10,qd_fhat
      common /phys_q125direct_diag/ qd_p10,qd_phi10,qd_fhat
      real Fdir(3),Tdir(3),rsave

      integer phys_m0_project_on
      common /physalis_m0_ctl/ phys_m0_project_on

      rsave=r_sample_over_a
      r_sample_over_a = 1.14000000
c     Reinitialize to the canonical single Lebedev orientation.  This makes
c     direct mode independent of any previous rotated diagnostic call.
      call physalis_lebedev_init
      phys_leb_orient=0

      call physalis_sample_sem_fields
      call physalis_transform_frame
      call physalis_scalar_products
      call physalis_lamb_solve

c     Hard m=0 projection immediately after raw coefficient recovery,
c     before any force is computed from these coefficients or they are
c     copied into the caller's "raw" arrays.  See
c     physalis_axisym_project_m0 for rationale.
      if (ldim.eq.2 .and. phys_m0_project_on.eq.1)
     $   call physalis_axisym_project_m0('after_solve')
      call physalis_compute_lamb_force_arrays(
     $   p_re,p_im,phi_re,phi_im,v_re,v_im,Fdir,Tdir)

      qd_p10=p_re(1,1)
      qd_phi10=phi_re(1,1)
      qd_fhat=Fdir(3)
      r_sample_over_a=rsave
      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_axisym_project_m0(tag)
c  Enforce axisymmetric spherical-harmonic consistency.
c
c  A true 2D axisymmetric Nek solve has no azimuthal variation, so only
c  m=0 spherical-harmonic (Lamb) coefficients are physically
c  representable.  Any m>0 content recovered by the 3D
c  Lebedev-sensing/scalar-product machinery is numerical leakage
c  (interpolation, quadrature, or Anderson history carryover) and must
c  not be imposed back onto the axisymmetric cage, or it aliases into
c  the meridional field as a spurious per-step force bias.
c
c  Projects both the live and the _old (history) coefficient arrays
c  together, so the mixing history cannot resurrect removed m>0 content
c  on the next inner iteration or the next physical timestep.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      character*(*) tag
      integer n,m
      real leak,leak_g

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      leak = 0.0
      do n=1,4
      do m=2,5
         leak = max(leak,abs(p_re(n,m)))
         leak = max(leak,abs(p_im(n,m)))
         leak = max(leak,abs(phi_re(n,m)))
         leak = max(leak,abs(phi_im(n,m)))
         leak = max(leak,abs(v_re(n,m)))
         leak = max(leak,abs(v_im(n,m)))

         p_re(n,m)   = 0.0
         p_im(n,m)   = 0.0
         phi_re(n,m) = 0.0
         phi_im(n,m) = 0.0
         v_re(n,m)   = 0.0
         v_im(n,m)   = 0.0

         p_re_old(n,m)   = 0.0
         p_im_old(n,m)   = 0.0
         phi_re_old(n,m) = 0.0
         phi_im_old(n,m) = 0.0
         v_re_old(n,m)   = 0.0
         v_im_old(n,m)   = 0.0
      enddo
      enddo

c     For m=0, the imaginary parts are also non-physical; zero them too.
      do n=1,4
         p_im(n,1)       = 0.0
         phi_im(n,1)     = 0.0
         v_im(n,1)       = 0.0
         p_im_old(n,1)   = 0.0
         phi_im_old(n,1) = 0.0
         v_im_old(n,1)   = 0.0
      enddo

      leak_g = glmax(leak,1)
      if (nid.eq.0 .and. mod(istep,10).eq.0) then
         write(6,'(A,A,A,E16.8)') 'AXISYM-M0-PROJECT ',tag,
     $      ' leak=',leak_g
      endif

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_sample_sem_fields
c  Production wrapper around the generic SEM sampling path.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      call physalis_sample_sem_arrays(vx,vy,vz,pr)

      return
      end

c-----------------------------------------------------------------------

      subroutine physalis_sample_sem_arrays(u_in,v_in,w_in,p_in)
      include 'SIZE'
      include 'TOTAL'

      real u_in(lx1,ly1,lz1,lelt)
      real v_in(lx1,ly1,lz1,lelt)
      real w_in(lx1,ly1,lz1,lelt)
      real p_in(lx2,ly2,lz2,lelt)

      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d
      integer phys_leb_orient
      common /phys_leb_orientation/ phys_leb_orient

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real U_lab_l(nleb,3),p_lab_l(nleb)
      common /phys_leb_fields/ U_lab_l,p_lab_l

      common /intp_h/ ih_intp
      common /nekmpi/ nidd,npp,nekcomm,nekgroup,nekreal

      logical intp_phys_rdy
      common /phys_intp_rdy/ intp_phys_rdy

      integer nrad_cache
      parameter(nrad_cache=2)
      integer iwk_cache(nleb,3,nrad_cache),iwk_work(nleb,3)
      real r_cache(ldim,nleb,nrad_cache),r_work(ldim,nleb)
      real dist2_cache(nleb,nrad_cache),dist2_work(nleb)
      real xp_cache(nleb,nrad_cache),yp_cache(nleb,nrad_cache)
      real zp_cache(nleb,nrad_cache),cache_q(nrad_cache)
      real cache_x(nrad_cache),cache_y(nrad_cache)
      real cache_z(nrad_cache),cache_a(nrad_cache)
      integer cache_step(nrad_cache),sample_calls,local_eval_mode
      integer cache_slot
      logical cache_ready(nrad_cache),cache_checked(nrad_cache)
      save iwk_cache,r_cache,dist2_cache
      save xp_cache,yp_cache,zp_cache,cache_q
      save cache_x,cache_y,cache_z,cache_a
      save cache_step,sample_calls,cache_ready,cache_checked
      save local_eval_mode
      data cache_step/2*-999999/,sample_calls/0/
      data cache_q/2*-1.0/
      data cache_x/2*1.0e30/,cache_y/2*1.0e30/
      data cache_z/2*1.0e30/,cache_a/2*-1.0/
      data local_eval_mode/-1/
      data cache_ready/2*.false./
      data cache_checked/2*.false./

      integer el_loc(nleb),pt_loc(nleb)
      real r_loc(ldim,nleb),eval_loc(nleb)
      real field_sum(4*nleb),field_work(4*nleb)
      real remote_ref(4*nleb),sample_diff,sample_scale
      integer k,j,nloc,nloc_g,ltot,ifield_save
      integer omin,omax
      real rs,tol_l
      real ax_sx,ax_sy,ax_sz,ax_x3,ax_y3,ax_z3
      real ax_rad,ax_erx,ax_ery,ax_ur,ax_ut,ax_uz
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode

      real pm1_tmp(lx1,ly1,lz1,lelt)
      real px_tmp(lx1,ly1,lz1,lelt),py_tmp(lx1,ly1,lz1,lelt)
      common /phys_pm1scratch/ pm1_tmp,px_tmp,py_tmp

      if (.not.intp_phys_rdy) then
         tol_l=5.0e-13
         call fgslib_findpts_setup(ih_intp,nekcomm,npp,ldim,
     $      xm1,ym1,zm1,lx1,ly1,lz1,
     $      nelt,2*lx1,2*ly1,2*lz1,0.01,
     $      lx1*ly1*lz1*nelt,lx1*ly1*lz1*nelt,256,tol_l)
         intp_phys_rdy=.true.
      endif

      rs=r_sample_over_a*phys_a
      if (ldim.eq.2) then
         if (abs(phys_xp).gt.1.0e-12*max(phys_a,1.0e-30) .or.
     $       abs(phys_yp).gt.1.0e-12*max(phys_a,1.0e-30)) then
            if (nid.eq.0) write(6,'(A,2E16.8)')
     $       'ERROR: IFAXIS particle off symmetry axis: ',
     $       phys_xp,phys_yp
            call exitt
         endif
      endif
      sample_calls=sample_calls+1

      cache_slot=1
      if (phys_leb_orient.eq.1) cache_slot=2
      if (phys_leb_orient.lt.0 .or. phys_leb_orient.gt.1) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: invalid Physalis Lebedev orientation',
     $      phys_leb_orient
         call exitt
      endif

      if (.not.cache_ready(cache_slot) .or.
     $    cache_step(cache_slot).ne.istep .or.
     $    abs(cache_q(cache_slot)-r_sample_over_a).gt.1.0e-10
     $    .or.abs(cache_x(cache_slot)-phys_xp).gt.1.0e-12
     $    .or.abs(cache_y(cache_slot)-phys_yp).gt.1.0e-12
     $    .or.abs(cache_z(cache_slot)-phys_zp).gt.1.0e-12
     $    .or.abs(cache_a(cache_slot)-phys_a).gt.1.0e-12) then
         do k=1,nleb
            if (ldim.eq.2) then
               ax_sx=xleb_d(k)
               ax_sy=yleb_d(k)
               ax_sz=zleb_d(k)
               ax_x3=phys_xp+rs*ax_sx
               ax_y3=phys_yp+rs*ax_sy
               ax_z3=phys_zp+rs*ax_sz
               ax_rad=sqrt(ax_x3*ax_x3+ax_y3*ax_y3)
               xp_cache(k,cache_slot)=ax_z3
               yp_cache(k,cache_slot)=ax_rad
               zp_cache(k,cache_slot)=0.0
            else
               xp_cache(k,cache_slot)=phys_xp+rs*xleb_d(k)
               yp_cache(k,cache_slot)=phys_yp+rs*yleb_d(k)
               zp_cache(k,cache_slot)=phys_zp+rs*zleb_d(k)
            endif
         enddo

         call fgslib_findpts(ih_intp,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,r_cache(1,1,cache_slot),ldim,
     $      dist2_cache(1,cache_slot),1,
     $      xp_cache(1,cache_slot),1,
     $      yp_cache(1,cache_slot),1,
     $      zp_cache(1,cache_slot),1,nleb)
         call physalis_check_findpts(
     $      iwk_cache(1,1,cache_slot),nleb,
     $      'lamb_sampling_cache')

         if (nid.ne.0) then
            call izero(iwk_cache(1,1,cache_slot),3*nleb)
            call rzero(r_cache(1,1,cache_slot),ldim*nleb)
            call rzero(dist2_cache(1,cache_slot),nleb)
         endif
         call igop(iwk_cache(1,1,cache_slot),iwk_work,'+  ',3*nleb)
         call gop(r_cache(1,1,cache_slot),r_work,'+  ',ldim*nleb)
         call gop(dist2_cache(1,cache_slot),dist2_work,'+  ',nleb)

         cache_step(cache_slot)=istep
         cache_q(cache_slot)=r_sample_over_a
         cache_x(cache_slot)=phys_xp
         cache_y(cache_slot)=phys_yp
         cache_z(cache_slot)=phys_zp
         cache_a(cache_slot)=phys_a
         cache_ready(cache_slot)=.true.
      endif

      nloc=0
      omin=npp
      omax=-1
      do k=1,nleb
         omin=min(omin,iwk_cache(k,3,cache_slot))
         omax=max(omax,iwk_cache(k,3,cache_slot))
         if (iwk_cache(k,1,cache_slot).lt.2 .and.
     $       iwk_cache(k,3,cache_slot).eq.nid) then
            nloc=nloc+1
            pt_loc(nloc)=k
            el_loc(nloc)=iwk_cache(k,2,cache_slot)
            do j=1,ldim
               r_loc(j,nloc)=r_cache(j,k,cache_slot)
            enddo
         endif
      enddo
      nloc_g=iglsum(nloc,1)

      if (local_eval_mode.lt.0) then
         if (nloc_g.eq.nleb) then
            local_eval_mode=1
         else
            local_eval_mode=0
            if (nid.eq.0) write(6,'(A,4I10)')
     $       'WARNING: local sampling disabled count/min/max/np=',
     $       nloc_g,omin,omax,npp
         endif
      else if (local_eval_mode.eq.1 .and. nloc_g.ne.nleb) then
         local_eval_mode=0
         if (nid.eq.0) write(6,'(A,I3,4I10)')
     $    'WARNING: radius cache fallback slot/count/min/max/np=',
     $    cache_slot,nloc_g,omin,omax,npp
      endif

      ltot=lx1*ly1*lz1*nelt

      if (lx2.ne.lx1) then
         call mappr(pm1_tmp,p_in,px_tmp,py_tmp)
      else
         call copy(pm1_tmp,p_in,ltot)
      endif

      if (local_eval_mode.eq.1) then
         call rzero(field_sum,4*nleb)
         if (nloc.gt.0) then
            call fgslib_findpts_eval_local(ih_intp,eval_loc,1,
     $         el_loc,1,r_loc,ldim,nloc,u_in)
            do j=1,nloc
               field_sum(pt_loc(j))=eval_loc(j)
            enddo

            call fgslib_findpts_eval_local(ih_intp,eval_loc,1,
     $         el_loc,1,r_loc,ldim,nloc,v_in)
            do j=1,nloc
               field_sum(nleb+pt_loc(j))=eval_loc(j)
            enddo

            call fgslib_findpts_eval_local(ih_intp,eval_loc,1,
     $         el_loc,1,r_loc,ldim,nloc,w_in)
            do j=1,nloc
               field_sum(2*nleb+pt_loc(j))=eval_loc(j)
            enddo

            call fgslib_findpts_eval_local(ih_intp,eval_loc,1,
     $         el_loc,1,r_loc,ldim,nloc,pm1_tmp)
            do j=1,nloc
               field_sum(3*nleb+pt_loc(j))=eval_loc(j)
            enddo
         endif
         call gop(field_sum,field_work,'+  ',4*nleb)
      else
         call fgslib_findpts_eval(ih_intp,field_sum(1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,u_in)
         call fgslib_findpts_eval(ih_intp,field_sum(nleb+1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,v_in)
         call fgslib_findpts_eval(ih_intp,field_sum(2*nleb+1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,w_in)
         call fgslib_findpts_eval(ih_intp,field_sum(3*nleb+1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,pm1_tmp)
      endif

      if (.not.cache_checked(cache_slot) .and.
     $    local_eval_mode.eq.1) then
         call fgslib_findpts_eval(ih_intp,remote_ref(1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,u_in)
         call fgslib_findpts_eval(ih_intp,remote_ref(nleb+1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,v_in)
         call fgslib_findpts_eval(ih_intp,remote_ref(2*nleb+1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,w_in)
         call fgslib_findpts_eval(ih_intp,remote_ref(3*nleb+1),1,
     $      iwk_cache(1,1,cache_slot),1,iwk_cache(1,3,cache_slot),1,
     $      iwk_cache(1,2,cache_slot),1,
     $      r_cache(1,1,cache_slot),ldim,nleb,pm1_tmp)
         sample_diff=0.0
         sample_scale=1.0
         do k=1,4*nleb
            sample_diff=max(sample_diff,
     $         abs(field_sum(k)-remote_ref(k)))
            sample_scale=max(sample_scale,abs(remote_ref(k)))
         enddo
         sample_diff=glmax(sample_diff,1)
         sample_scale=glmax(sample_scale,1)
         sample_diff=sample_diff/sample_scale
         if (nid.eq.0) write(6,'(A,E14.5)')
     $      'Physalis local-sample equivalence error=',sample_diff
         if (sample_diff.gt.1.0e-11) then
            local_eval_mode=0
            call copy(field_sum,remote_ref,4*nleb)
            if (nid.eq.0) write(6,*)
     $       'WARNING: using cached distributed sampling fallback'
         endif
         cache_checked(cache_slot)=.true.
      endif

      do k=1,nleb
         if (ldim.eq.2) then
            ax_x3=phys_xp+rs*xleb_d(k)
            ax_y3=phys_yp+rs*yleb_d(k)
            ax_rad=sqrt(ax_x3*ax_x3+ax_y3*ax_y3)
            ax_erx=0.0
            ax_ery=0.0
            if (ax_rad.gt.1.0e-14) then
               ax_erx=ax_x3/ax_rad
               ax_ery=ax_y3/ax_rad
            endif
            ax_uz=field_sum(k)
            ax_ur=field_sum(nleb+k)
            ax_ut=0.0
            if (sp_cons_mode.eq.2) ax_ut=field_sum(2*nleb+k)
            U_lab_l(k,1)=ax_ur*ax_erx-ax_ut*ax_ery
            U_lab_l(k,2)=ax_ur*ax_ery+ax_ut*ax_erx
            U_lab_l(k,3)=ax_uz
         else
            U_lab_l(k,1)=field_sum(k)
            U_lab_l(k,2)=field_sum(nleb+k)
            U_lab_l(k,3)=field_sum(2*nleb+k)
         endif
         p_lab_l(k)=field_sum(3*nleb+k)
      enddo

      if (nid.eq.0 .and. (sample_calls.eq.1 .or.
     $    sample_calls.eq.500 .or. sample_calls.eq.511 .or.
     $    sample_calls.eq.512 .or. sample_calls.eq.513 .or.
     $    mod(sample_calls,1024).eq.0)) then
         write(6,'(A,4I10)')
     $    'Physalis sample cache: calls/step/nloc/mode=',
     $    sample_calls,istep,nloc,local_eval_mode
         call flush(6)
      endif

      return
      end

      subroutine physalis_transform_frame
c  Subtract rigid-body particle motion to get particle-frame tilde fields.
c  u_tilde = U_lab - w_p - Omega_p x r
c  S&P A.2 for this fixed, nonrotating validation particle:
c    p_lab = p_tilde + rho*g.r, so p_tilde = p_lab - rho*g.r.
c  The arbitrary periodic-pressure mean is removed separately.
c-----------------------------------------------------------------------
      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d

      real U_lab_l(nleb,3), p_lab_l(nleb)
      common /phys_leb_fields/ U_lab_l, p_lab_l

      real u_til_l(nleb,3), p_til_l(nleb)
      common /phys_tilde/ u_til_l, p_til_l

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      real r_sample_over_a
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real rs,rx,ry,rz,ocx,ocy,ocz,pmean,wsum,pshift
      integer k

      rs = r_sample_over_a * phys_a

      pmean = 0.0
      wsum  = 0.0
      do k=1,nleb
         pmean = pmean + wleb_d(k)*p_lab_l(k)
         wsum  = wsum  + wleb_d(k)
      enddo
      pmean = pmean/max(wsum,1.0e-30)

      do k=1,nleb
         rx = rs * xleb_d(k)
         ry = rs * yleb_d(k)
         rz = rs * zleb_d(k)
         ocx = phys_oy*rz - phys_oz*ry
         ocy = phys_oz*rx - phys_ox*rz
         ocz = phys_ox*ry - phys_oy*rx
         u_til_l(k,1) = U_lab_l(k,1) - phys_up - ocx
         u_til_l(k,2) = U_lab_l(k,2) - phys_vp - ocy
         u_til_l(k,3) = U_lab_l(k,3) - phys_wp - ocz
         call physalis_sp_pressure_frame_shift(rx,ry,rz,pshift)
         if (pressure_mode.eq.0) then
            p_til_l(k) = p_lab_l(k) - pmean - pshift
         else
            p_til_l(k) = p_lab_l(k) - pmean - pshift
         endif
      enddo
      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_sp_pressure_frame_shift(dxp,dyp,dzp,
     $ pshift)
c  Pressure-frame term selected by the actual validation problem.
c
c  Fixed OP3:
c     Nek applies P.grad/rho through userf, so its periodic pressure
c     variable is already the S&P modified pressure.  The SEM/Physalis
c     conversion therefore has zero shift.
c  Moving nonrotating cases:
c     p_tilde = p_lab - mean(p_lab) + rho_f*a_k.r
c
c  spmove_enabled cannot select this frame because it is intentionally
c  one for both prescribed/fixed and moving full-replay cases.
      include 'SIZE'
      include 'TOTAL'
      real dxp,dyp,dzp,pshift
      real sp_a,sp_pstar,rho_f,nu,mu,pgrad
      real phys_ax,phys_ay,phys_az
      common /physalis_particle_accel/ phys_ax,phys_ay,phys_az
      integer phys_m1_active
      common /phys_m1_ctl/ phys_m1_active
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode

      rho_f=param(1)
      call zp_validation_config
      pshift=0.0

c     M1 is an isolated manufactured acceleration-frame test.  Its force
c     routine already suppresses the fixed OP3 force correction while this
c     flag is active; the pressure transform must use the same override.
      if (phys_m1_active.eq.1) then
         pshift=-rho_f*(phys_ax*dxp+phys_ay*dyp+
     $                  phys_az*dzp)
         return
      endif

      if (zp_problem.ge.31 .and. zp_problem.le.34 .and.
     $    zp_moving.eq.0) then
c        Do not add P.grad(r) here.  userf has already represented that
c        nonperiodic pressure gradient as a uniform acceleration, leaving
c        Nek's stored periodic pressure equal to S&P p_tilde.  Adding the
c        linear term here applies the fixed pressure frame twice.
         pshift=0.0
         return
      endif

      if (zp_moving.eq.1) then
         pshift=-rho_f*(phys_ax*dxp+phys_ay*dyp+phys_az*dzp)
         return
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_ylm_point(rx,ry,rz,r,lmax_use,
     $                               Yre,Yim,dYdth_re,dYdth_im)
c  Compute normalized real spherical harmonics and polar-angle derivatives
c  at a point (rx,ry,rz) with |r|=r, for n=1..lmax_use, m=0..n.
c  Convention: NO Condon-Shortley phase.
c  Arrays: Yre(n,m), Yim(n,m), dYdth_re(n,m), dYdth_im(n,m)
c  Index m runs from 1 to n+1 (m_array = m+1, m=0..n).
c  Derivatives: dY_{nm,re}/dphi = -m*Y_{nm,im}
c               dY_{nm,im}/dphi =  m*Y_{nm,re}
c-----------------------------------------------------------------------
      real rx,ry,rz,r
      integer lmax_use
      real Yre(4,5),Yim(4,5),dYdth_re(4,5),dYdth_im(4,5)
      real Gxr(4,5),Gyr(4,5),Gzr(4,5)
      real Gxi(4,5),Gyi(4,5),Gzi(4,5)

      real pi,cth,sth,cphi,sphi,rho,phi_angle
      real Pnm(0:4,0:4),dPnm_dth(0:4,0:4)
      real Nnm(4,0:4)
      real cos_mphi(0:4),sin_mphi(0:4)
      real eps
      integer n,m
      real fac,rtmp

      pi  = 4.0*atan(1.0)
      eps = 1.0e-30

      cth = rz / max(r,eps)
      rho = sqrt(rx*rx + ry*ry)
      sth = rho / max(r,eps)
      if (rho.gt.eps) then
         cphi = rx/rho
         sphi = ry/rho
         phi_angle = atan2(ry,rx)
      else
         cphi = 1.0
         sphi = 0.0
         phi_angle = 0.0
      endif

c     Precompute cos(m*phi) and sin(m*phi) for m=0..lmax_use
      cos_mphi(0)=1.0; sin_mphi(0)=0.0
      do m=1,lmax_use
         cos_mphi(m) = cos(float(m)*phi_angle)
         sin_mphi(m) = sin(float(m)*phi_angle)
      enddo

c     Associated Legendre polynomials P(n,m) without CS phase
      Pnm(0,0) = 1.0
      Pnm(1,0) = cth
      Pnm(1,1) = sth
      Pnm(2,0) = 0.5*(3.0*cth*cth - 1.0)
      Pnm(2,1) = 3.0*cth*sth
      Pnm(2,2) = 3.0*sth*sth
      Pnm(3,0) = 0.5*(5.0*cth*cth - 3.0)*cth
      Pnm(3,1) = 1.5*(5.0*cth*cth - 1.0)*sth
      Pnm(3,2) = 15.0*cth*sth*sth
      Pnm(3,3) = 15.0*sth*sth*sth
      if (lmax_use.ge.4) then
         Pnm(4,0) = 0.125*(35.0*cth**4 - 30.0*cth*cth + 3.0)
         Pnm(4,1) = 2.5*(7.0*cth**3 - 3.0*cth)*sth
         Pnm(4,2) = 7.5*(7.0*cth*cth - 1.0)*sth*sth
         Pnm(4,3) = 105.0*cth*sth**3
         Pnm(4,4) = 105.0*sth**4
      endif

c     dPnm/dth using: sin(th)*dP/dth = n*cos(th)*P(n,m)-(n+m)*P(n-1,m)
c     with P(-1,m)=0, P(0,m>0)=0
c     dPnm/dth = [n*cth*P(n,m) - (n+m)*P(n-1,m)] / max(sth,eps)
      do n=1,lmax_use
      do m=0,n
         rtmp = float(n)*cth*Pnm(n,m)
         if (n.ge.1 .and. m.le.n-1) rtmp = rtmp - float(n+m)*Pnm(n-1,m)
         dPnm_dth(n,m) = rtmp / max(sth,eps)
      enddo
      enddo

c     Normalization N(n,m) = sqrt((2n+1)/(4pi)*(n-m)!/(n+m)!)
      do n=1,lmax_use
      do m=0,n
         fac = 1.0
         do rtmp=float(n-m+1),float(n+m)
            fac = fac * rtmp
         enddo
         Nnm(n,m) = sqrt( float(2*n+1)/(4.0*pi) / max(fac,eps) )
      enddo
      enddo

c     Fill output arrays (index 2 = m+1 to store m=0..n)
c     m=0: only real part; m>0: Y_re=N*P*cos(m*phi), Y_im=N*P*sin(m*phi)
      do n=1,lmax_use
      do m=0,n
         Yre(n,m+1)      = Nnm(n,m)*Pnm(n,m)*cos_mphi(m)
         Yim(n,m+1)      = Nnm(n,m)*Pnm(n,m)*sin_mphi(m)
         dYdth_re(n,m+1) = Nnm(n,m)*dPnm_dth(n,m)*cos_mphi(m)
         dYdth_im(n,m+1) = Nnm(n,m)*dPnm_dth(n,m)*sin_mphi(m)
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_ylm_surface_gradient(rx,ry,rz,r,lmax_use,
     $ Yre,Yim,Gxr,Gyr,Gzr,Gxi,Gyi,Gzi)
c  Pole-safe Cartesian surface gradients for all retained harmonics.
c  Away from the poles this converts the analytic theta/phi derivatives.
c  At a z-axis pole only m=1 has a nonzero finite limit:
c    grad_s Y_n1 = N_n1*n(n+1)/2*(ex+i ey), with south-pole parity.
c-----------------------------------------------------------------------
      real rx,ry,rz,r
      integer lmax_use
      real Yre(4,5),Yim(4,5),Gxr(4,5),Gyr(4,5),Gzr(4,5)
      real Gxi(4,5),Gyi(4,5),Gzi(4,5)
      real dth_re(4,5),dth_im(4,5)
      real cth,sth,cphi,sphi,rho,ethx,ethy,ethz,ephx,ephy
      real dph_re,dph_im,pi,fac,nn,amp,parity,eps
      integer n,m,ii

      eps=1.0e-12
      pi=4.0*atan(1.0)
      cth=rz/max(r,1.0e-30)
      rho=sqrt(rx*rx+ry*ry)
      sth=rho/max(r,1.0e-30)
      if (rho.gt.eps*r) then
         cphi=rx/rho
         sphi=ry/rho
      else
         cphi=1.0
         sphi=0.0
      endif
      ethx=cth*cphi
      ethy=cth*sphi
      ethz=-sth
      ephx=-sphi
      ephy=cphi

      call physalis_ylm_point(rx,ry,rz,r,lmax_use,
     $                        Yre,Yim,dth_re,dth_im)

      do n=1,4
      do m=1,5
         Gxr(n,m)=0.0; Gyr(n,m)=0.0; Gzr(n,m)=0.0
         Gxi(n,m)=0.0; Gyi(n,m)=0.0; Gzi(n,m)=0.0
      enddo
      enddo

      if (sth.gt.eps) then
         do n=1,lmax_use
         do m=0,n
            dph_re=-float(m)*Yim(n,m+1)
            dph_im= float(m)*Yre(n,m+1)
            Gxr(n,m+1)=dth_re(n,m+1)*ethx+
     $                  dph_re/sth*ephx
            Gyr(n,m+1)=dth_re(n,m+1)*ethy+
     $                  dph_re/sth*ephy
            Gzr(n,m+1)=dth_re(n,m+1)*ethz
            Gxi(n,m+1)=dth_im(n,m+1)*ethx+
     $                  dph_im/sth*ephx
            Gyi(n,m+1)=dth_im(n,m+1)*ethy+
     $                  dph_im/sth*ephy
            Gzi(n,m+1)=dth_im(n,m+1)*ethz
         enddo
         enddo
      else
         parity=1.0
         do n=1,lmax_use
            if (rz.lt.0.0 .and. mod(n+1,2).ne.0) parity=-1.0
            if (rz.lt.0.0 .and. mod(n+1,2).eq.0) parity= 1.0
            fac=1.0
            do ii=n, n+1
               fac=fac*float(ii)
            enddo
            nn=sqrt(float(2*n+1)/(4.0*pi)/fac)
            amp=parity*nn*0.5*float(n*(n+1))
            Gxr(n,2)=amp
            Gyi(n,2)=amp
         enddo
      endif

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_scalar_products
c  Compute pressure (Sp) and transverse velocity (Su) scalar products
c  on the nleb-point Lebedev sphere.
c  Stores raw scalar products in common /phys_sprods/.
c-----------------------------------------------------------------------
      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d

      real u_til_l(nleb,3), p_til_l(nleb)
      common /phys_tilde/ u_til_l, p_til_l

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

c     Raw scalar products (stored as m+1 index)
      real Sp_re(4,5),Sp_im(4,5),Su_re(4,5),Su_im(4,5)
      real Sv_re(4,5),Sv_im(4,5)
      common /phys_sprods/ Sp_re,Sp_im,Su_re,Su_im,Sv_re,Sv_im

      real Yre(4,5),Yim(4,5),dYre(4,5),dYim(4,5)
      real Gxr(4,5),Gyr(4,5),Gzr(4,5)
      real Gxi(4,5),Gyi(4,5),Gzi(4,5)
      real rx,ry,rz,rs,rr
      real cth,sth,cphi,sphi,rho
      real uth,uph,wk
      real eth_x,eth_y,eth_z,eph_x,eph_y,eph_z
      real xh,yh,zh
      real curlx,curly,curlz
      real eps
      integer k,n,m

      eps = 1.0e-30
      rs  = r_sample_over_a * phys_a
      do n=1,4
      do m=1,5
         Sp_re(n,m)=0.0; Sp_im(n,m)=0.0
         Su_re(n,m)=0.0; Su_im(n,m)=0.0
         Sv_re(n,m)=0.0; Sv_im(n,m)=0.0
      enddo
      enddo

      do k=1,nleb
         rx = rs*xleb_d(k)
         ry = rs*yleb_d(k)
         rz = rs*zleb_d(k)
         rr = rs

         cth = rz/max(rr,eps)
         rho = sqrt(rx*rx+ry*ry)
         sth = rho/max(rr,eps)
         if (rho.gt.eps) then
            cphi = rx/rho
            sphi = ry/rho
         else
            cphi = 1.0
            sphi = 0.0
         endif

c        Spherical harmonics and pole-safe Cartesian surface gradients.
         call physalis_ylm_surface_gradient(rx,ry,rz,rr,lmax,
     $      Yre,Yim,Gxr,Gyr,Gzr,Gxi,Gyi,Gzi)

c        Unit vectors e_theta, e_phi in Cartesian
         eth_x = cth*cphi;  eth_y = cth*sphi;  eth_z = -sth
         eph_x = -sphi;     eph_y = cphi;       eph_z = 0.0

c        Parallel (tangential) velocity = u_tilde - u_r * e_r
         uth = u_til_l(k,1)*eth_x + u_til_l(k,2)*eth_y +
     $         u_til_l(k,3)*eth_z
         uph = u_til_l(k,1)*eph_x + u_til_l(k,2)*eph_y +
     $         u_til_l(k,3)*eph_z

         wk = wleb_d(k)

         do n=1,lmax
         do m=0,n
c           Pressure scalar product: Sp = int Y_nm* p_tilde dOmega
c           Sp_re += w * Y_re * p_tilde;  Sp_im += -w * Y_im * p_tilde
            Sp_re(n,m+1) = Sp_re(n,m+1)
     $            + wk * Yre(n,m+1) * p_til_l(k)
            Sp_im(n,m+1) = Sp_im(n,m+1)
     $            - wk * Yim(n,m+1) * p_til_l(k)

c           Su = int grad_s(Y_nm*) . u dOmega.
            Su_re(n,m+1)=Su_re(n,m+1)+wk*(
     $         Gxr(n,m+1)*u_til_l(k,1)+Gyr(n,m+1)*u_til_l(k,2)+
     $         Gzr(n,m+1)*u_til_l(k,3))
            Su_im(n,m+1)=Su_im(n,m+1)-wk*(
     $         Gxi(n,m+1)*u_til_l(k,1)+Gyi(n,m+1)*u_til_l(k,2)+
     $         Gzi(n,m+1)*u_til_l(k,3))

c           Sv = int (e_r x grad_s(Y_nm*)) . u dOmega.
            xh=rx/max(rr,eps); yh=ry/max(rr,eps); zh=rz/max(rr,eps)
            curlx=yh*Gzr(n,m+1)-zh*Gyr(n,m+1)
            curly=zh*Gxr(n,m+1)-xh*Gzr(n,m+1)
            curlz=xh*Gyr(n,m+1)-yh*Gxr(n,m+1)
            Sv_re(n,m+1)=Sv_re(n,m+1)+wk*(
     $         curlx*u_til_l(k,1)+curly*u_til_l(k,2)+
     $         curlz*u_til_l(k,3))
            curlx=yh*Gzi(n,m+1)-zh*Gyi(n,m+1)
            curly=zh*Gxi(n,m+1)-xh*Gzi(n,m+1)
            curlz=xh*Gyi(n,m+1)-yh*Gxi(n,m+1)
            Sv_im(n,m+1)=Sv_im(n,m+1)-wk*(
     $         curlx*u_til_l(k,1)+curly*u_til_l(k,2)+
     $         curlz*u_til_l(k,3))
         enddo
         enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_lamb_solve
c  For each (n,m), solve 2x2 system for raw p_nm, phi_nm.
c  Equations (from G&P / spec section 2):
c    Sp_scaled = Ap*p_nm + Bp*phi_nm
c    Su_scaled = Au*p_nm + Bu*phi_nm
c  where rs = r_sample.
c  Result stored in raw arrays (over-writes old raw, not yet relaxed).
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      real Sp_re(4,5),Sp_im(4,5),Su_re(4,5),Su_im(4,5)
      real Sv_re(4,5),Sv_im(4,5)
      common /phys_sprods/ Sp_re,Sp_im,Su_re,Su_im,Sv_re,Sv_im

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real rs,a,roa,aor,rho_f,nu,mu
      real Ap,Bp,Au,Bu,Ddet,Cv
      real Sp_sc_re,Sp_sc_im,Su_sc_re,Su_sc_im,Sv_sc_re,Sv_sc_im
      real fn,gn,hn
      real eps
      integer n,m

      eps = 1.0e-30
      a   = phys_a
      rs  = r_sample_over_a * a
      roa = rs/max(a,eps)
      aor = a/max(rs,eps)
      rho_f = max(abs(param(1)),eps)
      mu    = abs(param(2))
      nu    = mu/max(rho_f,eps)

      do n=1,lmax
         fn = float(n)
c        Coefficient matrices (spec sections 2.1, 2.2)
c        A_p = [1 - n/2*(2n-1)/(n+1)*(a/rs)^{2n+1}] * (rs/a)^n
         Ap = (1.0 - 0.5*fn*(2.0*fn-1.0)/(fn+1.0)*aor**(2*n+1))
     $        * roa**n
c        B_p = -n*(2n-1)*(2n+1)/(n+1) * (a/rs)^{n+1}
         Bp = -(fn*(2.0*fn-1.0)*(2.0*fn+1.0)/(fn+1.0))*aor**(n+1)

c        A_u = n/4*[2(n+3)/(2n+3)+(n-2-n(2n+1)/(2n+3)*(a/rs)^2)*
c              (a/rs)^{2n+1}] * (rs/a)^{n+1}
         gn = 2.0*(fn+3.0)/(2.0*fn+3.0)
         hn = fn-2.0 - fn*(2.0*fn+1.0)/(2.0*fn+3.0)*aor**2
         Au = 0.25*fn*(gn + hn*aor**(2*n+1)) * roa**(n+1)

c        B_u = n*[(n+1)+0.5*((n-2)(2n+1)*(rs/a)^2-n(2n-1))*
c              (a/rs)^{2n+1}] * (rs/a)^{n-1}
         gn = fn+1.0
         hn = 0.5*((fn-2.0)*(2.0*fn+1.0)*roa**2 - fn*(2.0*fn-1.0))
         Bu = fn*(gn + hn*aor**(2*n+1)) * roa**(n-1)

         Ddet = Ap*Bu - Au*Bp

         do m=0,n
c           Scale scalar products: Sp_sc = a^2/(mu*nu)*Sp
c                                   Su_sc = a/nu*Su
            Sp_sc_re = (a*a/(mu*nu)) * Sp_re(n,m+1)
            Sp_sc_im = (a*a/(mu*nu)) * Sp_im(n,m+1)
            Su_sc_re = (a/nu)        * Su_re(n,m+1)
            Su_sc_im = (a/nu)        * Su_im(n,m+1)

            if (abs(Ddet).gt.eps) then
               p_re(n,m+1)  =(Sp_sc_re*Bu - Su_sc_re*Bp)/Ddet
               p_im(n,m+1)  =(Sp_sc_im*Bu - Su_sc_im*Bp)/Ddet
               phi_re(n,m+1)=(Ap*Su_sc_re - Au*Sp_sc_re)/Ddet
               phi_im(n,m+1)=(Ap*Su_sc_im - Au*Sp_sc_im)/Ddet
            else
               p_re(n,m+1)  =0.0; p_im(n,m+1)  =0.0
               phi_re(n,m+1)=0.0; phi_im(n,m+1)=0.0
            endif

c           Rotation coefficient: (a/nu)*Sv = Cv*v_nm
c           Cv = n*(n+1)*[(a/rs)^{2n+1}-1]*(rs/a)^n  (S&P A.13c)
c           aor<1 so Cv<0, which is correct
            Cv = fn*(fn+1.0)*(aor**(2*n+1)-1.0)*roa**n
            Sv_sc_re = (a/nu) * Sv_re(n,m+1)
            Sv_sc_im = (a/nu) * Sv_im(n,m+1)
            if (abs(Cv).gt.eps) then
               v_re(n,m+1) = Sv_sc_re / Cv
               v_im(n,m+1) = Sv_sc_im / Cv
            else
               v_re(n,m+1) = 0.0
               v_im(n,m+1) = 0.0
            endif
         enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine stage4_measure_mleak
c  Measure raw coefficient content that is representable in 2-D axisymmetry
c  (m=0 real) and the non-axisymmetric leakage (m>0 plus m=0 imaginary).
c  Diagnostic only: this routine does not modify the coefficients.
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real s4_m0_norm,s4_mgt0_norm,s4_mgt0_ratio
      real s4_rt_u_pre,s4_rt_p_pre,s4_rt_u_post,s4_rt_p_post
      common /stage4_diag_r/ s4_m0_norm,s4_mgt0_norm,
     $ s4_mgt0_ratio,s4_rt_u_pre,s4_rt_p_pre,
     $ s4_rt_u_post,s4_rt_p_post
      real a0,a1,eps
      integer n,m

      eps=1.0e-30
      a0=0.0
      a1=0.0
      do n=1,4
         a0=a0+p_re(n,1)**2+phi_re(n,1)**2+v_re(n,1)**2
         a1=a1+p_im(n,1)**2+phi_im(n,1)**2+v_im(n,1)**2
         do m=2,5
            a1=a1+p_re(n,m)**2+p_im(n,m)**2+
     $         phi_re(n,m)**2+phi_im(n,m)**2+
     $         v_re(n,m)**2+v_im(n,m)**2
         enddo
      enddo
      s4_m0_norm=sqrt(max(a0,0.0))
      s4_mgt0_norm=sqrt(max(a1,0.0))
      s4_mgt0_ratio=s4_mgt0_norm/max(s4_m0_norm,eps)
      return
      end

c-----------------------------------------------------------------------
      subroutine stage4_project_live_m0
c  Project ONLY the current raw/live Lamb arrays to the axisymmetric m=0
c  subspace.  Unlike physalis_axisym_project_m0, this does not touch _old
c  history arrays; physalis_relax_coefficients commits the projected state
c  and then updates _old in one place.
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      integer n,m
      do n=1,4
         p_im(n,1)=0.0
         phi_im(n,1)=0.0
         v_im(n,1)=0.0
         do m=2,5
            p_re(n,m)=0.0
            p_im(n,m)=0.0
            phi_re(n,m)=0.0
            phi_im(n,m)=0.0
            v_re(n,m)=0.0
            v_im(n,m)=0.0
         enddo
      enddo
      return
      end

c-----------------------------------------------------------------------
      subroutine stage4_lamb_pressure_at_point(rx,ry,rz,rr,a,mu,nu,
     $ p_re,p_im,phi_re,phi_im,lmax_use,pl)
c  Reconstruct particle-frame tilde pressure from the same Ap/Bp radial
c  functions used by physalis_reconstruct_pressure_cage.
      real rx,ry,rz,rr,a,mu,nu,pl
      integer lmax_use
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real Yre(4,5),Yim(4,5),d1(4,5),d2(4,5)
      real roa,aor,fn,Ap,Bp,py,phiy,facm,eps
      integer n,m

      eps=1.0e-30
      roa=rr/max(a,eps)
      aor=a/max(rr,eps)
      call physalis_ylm_point(rx,ry,rz,rr,lmax_use,
     $                        Yre,Yim,d1,d2)
      pl=0.0
      do n=1,lmax_use
         fn=float(n)
         Ap=(1.0-0.5*fn*(2.0*fn-1.0)/(fn+1.0)
     $      *aor**(2*n+1))*roa**n
         Bp=-(fn*(2.0*fn-1.0)*(2.0*fn+1.0)/(fn+1.0))
     $      *aor**(n+1)
         do m=0,n
            facm=1.0
            if (m.gt.0) facm=2.0
            py=facm*(p_re(n,m+1)*Yre(n,m+1)
     $         -p_im(n,m+1)*Yim(n,m+1))
            phiy=facm*(phi_re(n,m+1)*Yre(n,m+1)
     $         -phi_im(n,m+1)*Yim(n,m+1))
            pl=pl+Ap*py+Bp*phiy
         enddo
      enddo
      pl=(mu*nu/(a*a))*pl
      return
      end

c-----------------------------------------------------------------------
      subroutine stage5_zero_diag
      real s5_raw_norm(4),s5_commit_norm(4),s5_ucage_rms(4)
      common /stage5_diag_r/ s5_raw_norm,s5_commit_norm,
     $ s5_ucage_rms
      integer n
      do n=1,4
         s5_raw_norm(n)=0.0
         s5_commit_norm(n)=0.0
         s5_ucage_rms(n)=0.0
      enddo
      return
      end

c-----------------------------------------------------------------------
      subroutine stage5_measure_raw_degree
c  Norm after m=0 projection, before Stage-5 coefficient filtering.
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real s5_raw_norm(4),s5_commit_norm(4),s5_ucage_rms(4)
      common /stage5_diag_r/ s5_raw_norm,s5_commit_norm,
     $ s5_ucage_rms
      real ss
      integer n,m
      do n=1,4
         ss=0.0
         do m=1,5
            ss=ss+p_re(n,m)**2+p_im(n,m)**2+
     $         phi_re(n,m)**2+phi_im(n,m)**2+
     $         v_re(n,m)**2+v_im(n,m)**2
         enddo
         s5_raw_norm(n)=sqrt(max(ss,0.0))
      enddo
      return
      end

c-----------------------------------------------------------------------
      subroutine stage5_measure_commit_degree
c  Norm after relaxation; this is the committed state used by cages.
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real s5_raw_norm(4),s5_commit_norm(4),s5_ucage_rms(4)
      common /stage5_diag_r/ s5_raw_norm,s5_commit_norm,
     $ s5_ucage_rms
      real ss
      integer n,m
      do n=1,4
         ss=0.0
         do m=1,5
            ss=ss+p_re(n,m)**2+p_im(n,m)**2+
     $         phi_re(n,m)**2+phi_im(n,m)**2+
     $         v_re(n,m)**2+v_im(n,m)**2
         enddo
         s5_commit_norm(n)=sqrt(max(ss,0.0))
      enddo
      return
      end

c-----------------------------------------------------------------------
      subroutine stage5_apply_coeff_filter
c  Optional diagnostic scaling of LIVE raw n=3 and n=4 coefficients.
c  Raw degree norms above remain unfiltered for diagnosis.
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real stage5_vel_scale3,stage5_vel_scale4
      real stage5_coeff_scale3,stage5_coeff_scale4
      common /stage5_ctl_r/ stage5_vel_scale3,stage5_vel_scale4,
     $ stage5_coeff_scale3,stage5_coeff_scale4
      real sc
      integer n,m
      do n=3,4
         if (n.eq.3) sc=stage5_coeff_scale3
         if (n.eq.4) sc=stage5_coeff_scale4
         do m=1,5
            p_re(n,m)=sc*p_re(n,m)
            p_im(n,m)=sc*p_im(n,m)
            phi_re(n,m)=sc*phi_re(n,m)
            phi_im(n,m)=sc*phi_im(n,m)
            v_re(n,m)=sc*v_re(n,m)
            v_im(n,m)=sc*v_im(n,m)
         enddo
      enddo
      return
      end

c-----------------------------------------------------------------------
      subroutine stage4_roundtrip_current(rvel,rpres)
c  Compare the current raw/live Lamb reconstruction with the SAME q=1.25
c  Lebedev samples that were just used for coefficient recovery.
c  rvel/rpres are weighted relative RMS residuals.  These are diagnostics,
c  not acceptance criteria.
      include 'SIZE'
      include 'INPUT'
      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d
      real u_til_l(nleb,3),p_til_l(nleb)
      common /phys_tilde/ u_til_l,p_til_l
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real rvel,rpres,s4rs,s4x,s4y,s4z,s4r,s4ux,s4uy,s4uz,s4pl
      real s4rho,s4mu,s4nu,s4nvu,s4dvu,s4npp,s4dpp,s4w,s4eps
      integer k

      s4eps=1.0e-30
      s4rho=max(abs(param(1)),s4eps)
      s4mu=abs(param(2))
      s4nu=s4mu/s4rho
      s4rs=r_sample_over_a*phys_a
      s4nvu=0.0
      s4dvu=0.0
      s4npp=0.0
      s4dpp=0.0
      do k=1,nleb
         s4x=s4rs*xleb_d(k)
         s4y=s4rs*yleb_d(k)
         s4z=s4rs*zleb_d(k)
         s4r=s4rs
         call physalis_lamb_vel_at_point(s4x,s4y,s4z,s4r,phys_a,s4nu,
     $      p_re,p_im,phi_re,phi_im,lmax,s4ux,s4uy,s4uz)
         call stage4_lamb_pressure_at_point(s4x,s4y,s4z,s4r,phys_a,
     $      s4mu,s4nu,p_re,p_im,phi_re,phi_im,lmax,s4pl)
         s4w=wleb_d(k)
         s4nvu=s4nvu+s4w*((s4ux-u_til_l(k,1))**2+
     $                 (s4uy-u_til_l(k,2))**2+
     $                 (s4uz-u_til_l(k,3))**2)
         s4dvu=s4dvu+s4w*(u_til_l(k,1)**2+u_til_l(k,2)**2+
     $                 u_til_l(k,3)**2)
         s4npp=s4npp+s4w*(s4pl-p_til_l(k))**2
         s4dpp=s4dpp+s4w*p_til_l(k)**2
      enddo
      rvel=sqrt(s4nvu/max(s4dvu,s4eps))
      rpres=sqrt(s4npp/max(s4dpp,s4eps))
      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_relax_coefficients
c  Under-relax Lamb coefficients: C = (1-beta)*C_old + beta*C_raw
c  Uses the current phi_re/im, p_re/im as "raw" values and updates them.
c-----------------------------------------------------------------------
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real blend_old,blend_new,raw_re,raw_im,beta_mode,fn
      integer n,m

      do n=1,lmax
      do m=0,n
         fn = float(n)
         beta_mode = beta_coeff
c        True S&P validation uses the same coefficient update for every
c        retained harmonic.  The previous n-dependent beta made lmax>1
c        appear converged while effectively freezing the higher modes.
         blend_old = 1.0 - beta_mode
         blend_new = beta_mode

         raw_re        = phi_re(n,m+1)
         raw_im        = phi_im(n,m+1)
         phi_re(n,m+1) = blend_old*phi_re_old(n,m+1)
     $                  + blend_new*raw_re
         phi_im(n,m+1) = blend_old*phi_im_old(n,m+1)
     $                  + blend_new*raw_im

         raw_re        = p_re(n,m+1)
         raw_im        = p_im(n,m+1)
         p_re(n,m+1)   = blend_old*p_re_old(n,m+1)
     $                  + blend_new*raw_re
         p_im(n,m+1)   = blend_old*p_im_old(n,m+1)
     $                  + blend_new*raw_im

         raw_re        = v_re(n,m+1)
         raw_im        = v_im(n,m+1)
         v_re(n,m+1)   = blend_old*v_re_old(n,m+1)
     $                  + blend_new*raw_re
         v_im(n,m+1)   = blend_old*v_im_old(n,m+1)
     $                  + blend_new*raw_im
      enddo
      enddo

      do n=1,lmax
      do m=0,n
         phi_re_old(n,m+1) = phi_re(n,m+1)
         phi_im_old(n,m+1) = phi_im(n,m+1)
         p_re_old(n,m+1)   = p_re(n,m+1)
         p_im_old(n,m+1)   = p_im(n,m+1)
         v_re_old(n,m+1)   = v_re(n,m+1)
         v_im_old(n,m+1)   = v_im(n,m+1)
      enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
c-----------------------------------------------------------------------
      subroutine physalis_reconstruct_velocity_cage
c-----------------------------------------------------------------------
c  STAGE35BL: generalized layer-1 U-side EDGE/RIGID branch.
c
c  s35bf_variant:
c    1 strict edgeghost + surface GLL no-slip; surface-hit helper rigid
c    2 surface hit tries one more GLL point for a 2-step exterior ghost
c    3 surface-only: inside cage rigid, exact surface GLL no-slip only
c    4 strict edgeghost with amplification capped at 2 (diagnostic)
c    5 50 percent strict edgeghost + 50 percent rigid (diagnostic)
c
c  Every local temporary/dummy uses a zbf_* prefix to avoid collisions
c  with Nek TOTAL/GEOM COMMON symbols such as rx/ry/rz.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      integer stage9_cage_mode,stage9_pcage_filter_on
      common /stage9_cage_i/ stage9_cage_mode,
     $ stage9_pcage_filter_on

      real zbf_u(lx1,ly1,lz1,lelv)
      real zbf_v(lx1,ly1,lz1,lelv)
      real zbf_w(lx1,ly1,lz1,lelv)
      real zbf_n(lx1,ly1,lz1,lelv)
      real zbf_s(lx1,ly1,lz1,lelv)
      common /s35bf_edgewrk/ zbf_u,zbf_v,zbf_w,zbf_n,zbf_s

      integer s35bf_variant
      common /s35bf_variant_i/ s35bf_variant

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer zbf_e,zbf_i,zbf_j,zbf_k,zbf_nt
      integer bq_us,bq_ps,bq_ul,bq_pl,bq_uc,bq_pc
      integer zbf_na_l,zbf_na_g,zbf_ns_l,zbf_ns_g
      integer zbf_nb_l,zbf_nb_g,zbf_nz_l,zbf_nz_g
      integer zbf_nn_l,zbf_nn_g,zbf_n2_l,zbf_n2_g
      real zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm
      real zbf_gtn,zbf_gtx,zbf_gan,zbf_gax
      real zbf_grn,zbf_grx,zbf_um,zbf_gum
      real zbf_xr,zbf_yr,zbf_zr,zbf_rad,zbf_tol
      logical zbf_first
      save zbf_first
      data zbf_first /.true./

c     Case-local runtime selector.  This must come after declarations.
      s35bf_variant=1

c     Stage35BQ: OUT uses direct exterior Lamb reconstruction.
c     All IN single/deep/cumulative topologies use RIGID variant 3.
      if (stage9_cage_mode.ge.1001 .and.
     $    stage9_cage_mode.le.1196) then
         call stage35bq_decode_cage(stage9_cage_mode,
     $      bq_us,bq_ps,bq_ul,bq_pl,bq_uc,bq_pc)
         if (bq_us.eq.1) then
            call s35bd_direct_exterior_velocity_cage
            return
         else
            s35bf_variant=3
         endif
      elseif (stage9_cage_mode.ne.22 .and.
     $        stage9_cage_mode.ne.23 .and.
     $        stage9_cage_mode.ne.51 .and.
     $        stage9_cage_mode.ne.52 .and.
     $        stage9_cage_mode.ne.54 .and.
     $        stage9_cage_mode.ne.55) then
         call s35bd_direct_exterior_velocity_cage
         return
      endif

      zbf_nt=lx1*ly1*lz1*nelv
      call rzero(zbf_u,zbf_nt)
      call rzero(zbf_v,zbf_nt)
      call rzero(zbf_w,zbf_nt)
      call rzero(zbf_n,zbf_nt)
      call rzero(zbf_s,zbf_nt)

      zbf_na_l=0
      zbf_ns_l=0
      zbf_nb_l=0
      zbf_n2_l=0
      zbf_tn=1.0e20
      zbf_tx=0.0
      zbf_an=1.0e20
      zbf_ax=0.0
      zbf_rn=1.0e20
      zbf_rxm=0.0
      zbf_tol=1.0e-8*max(phys_a,1.0e-30)

      do zbf_e=1,nelv
      do zbf_k=1,lz1
      do zbf_j=1,ly1
      do zbf_i=1,lx1
         if (mask_cage_u(zbf_i,zbf_j,zbf_k,zbf_e).ne.1)
     $      cycle

         call s35bf_relxyz(zbf_i,zbf_j,zbf_k,zbf_e,
     $      zbf_xr,zbf_yr,zbf_zr,zbf_rad)

         if (abs(zbf_rad-phys_a).le.zbf_tol) cycle
         if (mask_inside_u(zbf_i,zbf_j,zbf_k,zbf_e).ne.1) then
            zbf_nb_l=zbf_nb_l+1
            cycle
         endif

c        Variant 3 intentionally leaves every inside helper rigid.
c        We still scan edges to discover exact-surface GLL points.
         if (zbf_i.gt.1)
     $      call s35bf_edge(zbf_e,zbf_i,zbf_j,zbf_k,
     $      zbf_i-1,zbf_j,zbf_k,zbf_u,zbf_v,zbf_w,zbf_n,
     $      zbf_s,zbf_na_l,zbf_ns_l,zbf_nb_l,zbf_n2_l,
     $      zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm)
         if (zbf_i.lt.lx1)
     $      call s35bf_edge(zbf_e,zbf_i,zbf_j,zbf_k,
     $      zbf_i+1,zbf_j,zbf_k,zbf_u,zbf_v,zbf_w,zbf_n,
     $      zbf_s,zbf_na_l,zbf_ns_l,zbf_nb_l,zbf_n2_l,
     $      zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm)
         if (zbf_j.gt.1)
     $      call s35bf_edge(zbf_e,zbf_i,zbf_j,zbf_k,
     $      zbf_i,zbf_j-1,zbf_k,zbf_u,zbf_v,zbf_w,zbf_n,
     $      zbf_s,zbf_na_l,zbf_ns_l,zbf_nb_l,zbf_n2_l,
     $      zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm)
         if (zbf_j.lt.ly1)
     $      call s35bf_edge(zbf_e,zbf_i,zbf_j,zbf_k,
     $      zbf_i,zbf_j+1,zbf_k,zbf_u,zbf_v,zbf_w,zbf_n,
     $      zbf_s,zbf_na_l,zbf_ns_l,zbf_nb_l,zbf_n2_l,
     $      zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm)
         if (ldim.eq.3) then
            if (zbf_k.gt.1)
     $         call s35bf_edge(zbf_e,zbf_i,zbf_j,zbf_k,
     $         zbf_i,zbf_j,zbf_k-1,zbf_u,zbf_v,zbf_w,zbf_n,
     $         zbf_s,zbf_na_l,zbf_ns_l,zbf_nb_l,zbf_n2_l,
     $         zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm)
            if (zbf_k.lt.lz1)
     $         call s35bf_edge(zbf_e,zbf_i,zbf_j,zbf_k,
     $         zbf_i,zbf_j,zbf_k+1,zbf_u,zbf_v,zbf_w,zbf_n,
     $         zbf_s,zbf_na_l,zbf_ns_l,zbf_nb_l,zbf_n2_l,
     $         zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm)
         endif
      enddo
      enddo
      enddo
      enddo

      call dsop(zbf_u,'+  ',lx1,ly1,lz1)
      call dsop(zbf_v,'+  ',lx1,ly1,lz1)
      call dsop(zbf_w,'+  ',lx1,ly1,lz1)
      call dsop(zbf_n,'+  ',lx1,ly1,lz1)
      call dsop(zbf_s,'MXA',lx1,ly1,lz1)

c     Exact surface GLL points become true no-slip internal Dirichlet.
      zbf_nn_l=0
      do zbf_e=1,nelv
      do zbf_k=1,lz1
      do zbf_j=1,ly1
      do zbf_i=1,lx1
         if (zbf_s(zbf_i,zbf_j,zbf_k,zbf_e).le.0.5) cycle
         mask_cage_u(zbf_i,zbf_j,zbf_k,zbf_e)=1
         call s35bf_set_rigid(zbf_i,zbf_j,zbf_k,zbf_e)
         zbf_nn_l=zbf_nn_l+1
      enddo
      enddo
      enddo
      enddo

      zbf_nz_l=0
      zbf_um=0.0
      do zbf_e=1,nelv
      do zbf_k=1,lz1
      do zbf_j=1,ly1
      do zbf_i=1,lx1
         if (mask_cage_u(zbf_i,zbf_j,zbf_k,zbf_e).ne.1)
     $      cycle

         call s35bf_relxyz(zbf_i,zbf_j,zbf_k,zbf_e,
     $      zbf_xr,zbf_yr,zbf_zr,zbf_rad)

         if (abs(zbf_rad-phys_a).le.zbf_tol) then
            call s35bf_set_rigid(zbf_i,zbf_j,zbf_k,zbf_e)
            cycle
         endif
         if (mask_inside_u(zbf_i,zbf_j,zbf_k,zbf_e).ne.1)
     $      cycle

         if (s35bf_variant.eq.3) then
            call s35bf_set_rigid(zbf_i,zbf_j,zbf_k,zbf_e)
         elseif (zbf_n(zbf_i,zbf_j,zbf_k,zbf_e).gt.0.5) then
            u_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)=
     $         zbf_u(zbf_i,zbf_j,zbf_k,zbf_e)/
     $         zbf_n(zbf_i,zbf_j,zbf_k,zbf_e)
            v_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)=
     $         zbf_v(zbf_i,zbf_j,zbf_k,zbf_e)/
     $         zbf_n(zbf_i,zbf_j,zbf_k,zbf_e)
            w_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)=
     $         zbf_w(zbf_i,zbf_j,zbf_k,zbf_e)/
     $         zbf_n(zbf_i,zbf_j,zbf_k,zbf_e)
         else
            zbf_nz_l=zbf_nz_l+1
            call s35bf_set_rigid(zbf_i,zbf_j,zbf_k,zbf_e)
         endif

         zbf_gum=sqrt(
     $      u_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)**2+
     $      v_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)**2+
     $      w_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)**2)
         zbf_um=max(zbf_um,zbf_gum)
      enddo
      enddo
      enddo
      enddo

      zbf_na_g=iglsum(zbf_na_l,1)
      zbf_ns_g=iglsum(zbf_ns_l,1)
      zbf_nb_g=iglsum(zbf_nb_l,1)
      zbf_nz_g=iglsum(zbf_nz_l,1)
      zbf_nn_g=iglsum(zbf_nn_l,1)
      zbf_n2_g=iglsum(zbf_n2_l,1)
      zbf_gtn=glmin(zbf_tn,1)
      zbf_gtx=glmax(zbf_tx,1)
      zbf_gan=glmin(zbf_an,1)
      zbf_gax=glmax(zbf_ax,1)
      zbf_grn=glmin(zbf_rn,1)
      zbf_grx=glmax(zbf_rxm,1)
      zbf_gum=glmax(zbf_um,1)

      if (zbf_nb_g.gt.0) then
         if (nid.eq.0) write(6,'(A,I10)')
     $      'S35BF FATAL true-invalid edges=',zbf_nb_g
         call exitt
      endif

      if (zbf_first .and. nid.eq.0) then
         write(6,'(A,I4)')
     $      'S35BF UIN-5WAY active variant=',s35bf_variant
         write(6,'(A,5I10)')
     $      'S35BF edge/surf/zero/snode/twostep=',
     $      zbf_na_g,zbf_ns_g,zbf_nz_g,zbf_nn_g,zbf_n2_g
         write(6,'(A,2E16.8)')
     $      'S35BF crossing t[min,max]=',zbf_gtn,zbf_gtx
         write(6,'(A,2E16.8)')
     $      'S35BF amp used[min,max]=',zbf_gan,zbf_gax
         write(6,'(A,2E16.8)')
     $      'S35BF exterior r/a[min,max]=',zbf_grn,zbf_grx
         write(6,'(A,E16.8)')
     $      'S35BF ghost |U| max=',zbf_gum
         open(979,file='stage35BF_edgeghost_audit.dat',
     $        status='replace')
         write(979,'(A)')
     $ '# var edge surf bad zero snode twostep tmin tmax amin amax'
         write(979,*) s35bf_variant,zbf_na_g,zbf_ns_g,zbf_nb_g,
     $      zbf_nz_g,zbf_nn_g,zbf_n2_g,zbf_gtn,zbf_gtx,
     $      zbf_gan,zbf_gax,zbf_grn,zbf_grx,zbf_gum
         close(979)
         zbf_first=.false.
      endif

      call physalis_update_velocity_cage_residual
      return
      end
      subroutine s35bf_edge(zbf_e,zbf_ii,zbf_ji,zbf_ki,
     $ zbf_io,zbf_jo,zbf_ko,zbf_gu,zbf_gv,zbf_gw,zbf_gn,
     $ zbf_sf,zbf_na,zbf_ns,zbf_nb,zbf_n2,
     $ zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm)
      include 'SIZE'
      include 'TOTAL'

      integer zbf_e,zbf_ii,zbf_ji,zbf_ki
      integer zbf_io,zbf_jo,zbf_ko
      integer zbf_na,zbf_ns,zbf_nb,zbf_n2
      real zbf_gu(lx1,ly1,lz1,lelv)
      real zbf_gv(lx1,ly1,lz1,lelv)
      real zbf_gw(lx1,ly1,lz1,lelv)
      real zbf_gn(lx1,ly1,lz1,lelv)
      real zbf_sf(lx1,ly1,lz1,lelv)
      real zbf_tn,zbf_tx,zbf_an,zbf_ax,zbf_rn,zbf_rxm

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode

      integer s35bf_variant
      common /s35bf_variant_i/ s35bf_variant

      integer zbf_di,zbf_dj,zbf_dk,zbf_i2,zbf_j2,zbf_k2
      real zbf_xi,zbf_yi,zbf_zi,zbf_xo,zbf_yo,zbf_zo
      real zbf_x2,zbf_y2,zbf_z2
      real zbf_dx,zbf_dy,zbf_dz,zbf_aa,zbf_bb,zbf_cc
      real zbf_disc,zbf_t,zbf_den,zbf_amp,zbf_ampuse
      real zbf_xs,zbf_ys,zbf_zs,zbf_ri,zbf_ro,zbf_tol
      real zbf_ulx,zbf_uly,zbf_ulz
      real zbf_uox,zbf_uoy,zbf_uoz
      real zbf_usx,zbf_usy,zbf_usz
      real zbf_ugx,zbf_ugy,zbf_ugz
      real zbf_rho,zbf_nu,zbf_blend
      logical zbf_have2

      if (mask_inside_u(zbf_io,zbf_jo,zbf_ko,zbf_e).ne.0)
     $   return

      call s35bf_relxyz(zbf_ii,zbf_ji,zbf_ki,zbf_e,
     $   zbf_xi,zbf_yi,zbf_zi,zbf_ri)
      call s35bf_relxyz(zbf_io,zbf_jo,zbf_ko,zbf_e,
     $   zbf_xo,zbf_yo,zbf_zo,zbf_ro)

      zbf_tol=1.0e-8*max(phys_a,1.0e-30)

c     Exact-surface neighbor.
      if (abs(zbf_ro-phys_a).le.zbf_tol) then
         zbf_sf(zbf_io,zbf_jo,zbf_ko,zbf_e)=1.0
         zbf_ns=zbf_ns+1

c        Variant 2 tries the next point in the same graph direction.
         if (s35bf_variant.eq.2) then
            zbf_di=zbf_io-zbf_ii
            zbf_dj=zbf_jo-zbf_ji
            zbf_dk=zbf_ko-zbf_ki
            zbf_i2=zbf_io+zbf_di
            zbf_j2=zbf_jo+zbf_dj
            zbf_k2=zbf_ko+zbf_dk
            zbf_have2=.true.
            if (zbf_i2.lt.1 .or. zbf_i2.gt.lx1) zbf_have2=.false.
            if (zbf_j2.lt.1 .or. zbf_j2.gt.ly1) zbf_have2=.false.
            if (zbf_k2.lt.1 .or. zbf_k2.gt.lz1) zbf_have2=.false.

            if (zbf_have2) then
               if (mask_inside_u(zbf_i2,zbf_j2,zbf_k2,zbf_e)
     $             .ne.0) zbf_have2=.false.
            endif

            if (zbf_have2) then
               call s35bf_relxyz(zbf_i2,zbf_j2,zbf_k2,zbf_e,
     $            zbf_x2,zbf_y2,zbf_z2,zbf_ro)
               if (zbf_ro.gt.phys_a+zbf_tol .and.
     $             zbf_ro/phys_a.lt.r_sample_over_a) then
                  zbf_xo=zbf_x2
                  zbf_yo=zbf_y2
                  zbf_zo=zbf_z2
                  zbf_n2=zbf_n2+1
                  goto 100
               endif
            endif
         endif

c        Variants 1,3,4,5 and variant-2 fallback:
c        keep the adjacent inside helper rigid.
         call s35bf_add_rigid_candidate(zbf_e,
     $      zbf_ii,zbf_ji,zbf_ki,zbf_gu,zbf_gv,zbf_gw,zbf_gn)
         return
      endif

      if (zbf_ro.lt.phys_a-zbf_tol) then
         zbf_nb=zbf_nb+1
         return
      endif
      if (zbf_ro/phys_a.ge.r_sample_over_a) then
         zbf_nb=zbf_nb+1
         return
      endif

  100 continue
      zbf_dx=zbf_xo-zbf_xi
      zbf_dy=zbf_yo-zbf_yi
      zbf_dz=zbf_zo-zbf_zi
      zbf_aa=zbf_dx*zbf_dx+zbf_dy*zbf_dy+zbf_dz*zbf_dz
      zbf_bb=2.0*(zbf_xi*zbf_dx+zbf_yi*zbf_dy+
     $   zbf_zi*zbf_dz)
      zbf_cc=zbf_ri*zbf_ri-phys_a*phys_a
      if (zbf_aa.le.1.0e-30) then
         zbf_nb=zbf_nb+1
         return
      endif

      zbf_disc=zbf_bb*zbf_bb-4.0*zbf_aa*zbf_cc
      if (zbf_disc.lt.-1.0e-12*zbf_aa*phys_a*phys_a) then
         zbf_nb=zbf_nb+1
         return
      endif
      zbf_disc=max(zbf_disc,0.0)
      zbf_t=(-zbf_bb+sqrt(zbf_disc))/(2.0*zbf_aa)
      if (zbf_t.le.0.0 .or. zbf_t.ge.1.0) then
         zbf_nb=zbf_nb+1
         return
      endif
      zbf_den=1.0-zbf_t
      if (zbf_den.le.1.0e-10) then
         zbf_nb=zbf_nb+1
         return
      endif

      zbf_amp=zbf_t/zbf_den
      zbf_ampuse=zbf_amp
      if (s35bf_variant.eq.4) zbf_ampuse=min(zbf_amp,2.0)

      zbf_xs=zbf_xi+zbf_t*zbf_dx
      zbf_ys=zbf_yi+zbf_t*zbf_dy
      zbf_zs=zbf_zi+zbf_t*zbf_dz

      zbf_ro=sqrt(zbf_xo*zbf_xo+zbf_yo*zbf_yo+
     $   zbf_zo*zbf_zo)
      zbf_rho=max(abs(param(1)),1.0e-30)
      zbf_nu=abs(param(2))/zbf_rho

      call s35ad_axisym8_vel(zbf_xo,zbf_yo,zbf_zo,zbf_ro,
     $   phys_a,zbf_nu,zbf_ulx,zbf_uly,zbf_ulz)

      zbf_uox=phys_up+phys_oy*zbf_zo-phys_oz*zbf_yo+zbf_ulx
      zbf_uoy=phys_vp+phys_oz*zbf_xo-phys_ox*zbf_zo+zbf_uly
      zbf_uoz=phys_wp+phys_ox*zbf_yo-phys_oy*zbf_xo+zbf_ulz

      zbf_usx=phys_up+phys_oy*zbf_zs-phys_oz*zbf_ys
      zbf_usy=phys_vp+phys_oz*zbf_xs-phys_ox*zbf_zs
      zbf_usz=phys_wp+phys_ox*zbf_ys-phys_oy*zbf_xs

c     Normal linear ghost is exact for the chosen edge interpolation.
      if (s35bf_variant.eq.4) then
c        Diagnostic cap: damp only the disturbance from rigid surface.
         zbf_ugx=zbf_usx-zbf_ampuse*(zbf_uox-zbf_usx)
         zbf_ugy=zbf_usy-zbf_ampuse*(zbf_uoy-zbf_usy)
         zbf_ugz=zbf_usz-zbf_ampuse*(zbf_uoz-zbf_usz)
      else
         zbf_ugx=(zbf_usx-zbf_t*zbf_uox)/zbf_den
         zbf_ugy=(zbf_usy-zbf_t*zbf_uoy)/zbf_den
         zbf_ugz=(zbf_usz-zbf_t*zbf_uoz)/zbf_den
      endif

      if (s35bf_variant.eq.5) then
         zbf_blend=0.5
         zbf_ugx=zbf_usx+zbf_blend*(zbf_ugx-zbf_usx)
         zbf_ugy=zbf_usy+zbf_blend*(zbf_ugy-zbf_usy)
         zbf_ugz=zbf_usz+zbf_blend*(zbf_ugz-zbf_usz)
      endif

c     Axisymmetric mapping: Nek (u,v,w)=physical (z,x,y).
      zbf_gu(zbf_ii,zbf_ji,zbf_ki,zbf_e)=
     $ zbf_gu(zbf_ii,zbf_ji,zbf_ki,zbf_e)+zbf_ugz
      zbf_gv(zbf_ii,zbf_ji,zbf_ki,zbf_e)=
     $ zbf_gv(zbf_ii,zbf_ji,zbf_ki,zbf_e)+zbf_ugx
      if (sp_cons_mode.eq.2) then
         zbf_gw(zbf_ii,zbf_ji,zbf_ki,zbf_e)=
     $    zbf_gw(zbf_ii,zbf_ji,zbf_ki,zbf_e)+zbf_ugy
      endif
      zbf_gn(zbf_ii,zbf_ji,zbf_ki,zbf_e)=
     $ zbf_gn(zbf_ii,zbf_ji,zbf_ki,zbf_e)+1.0

      zbf_na=zbf_na+1
      zbf_tn=min(zbf_tn,zbf_t)
      zbf_tx=max(zbf_tx,zbf_t)
      zbf_an=min(zbf_an,zbf_ampuse)
      zbf_ax=max(zbf_ax,zbf_ampuse)
      zbf_rn=min(zbf_rn,zbf_ro/phys_a)
      zbf_rxm=max(zbf_rxm,zbf_ro/phys_a)
      return
      end

      subroutine s35bf_relxyz(zbf_i,zbf_j,zbf_k,zbf_e,
     $ zbf_xr,zbf_yr,zbf_zr,zbf_rad)
      include 'SIZE'
      include 'TOTAL'
      integer zbf_i,zbf_j,zbf_k,zbf_e
      real zbf_xr,zbf_yr,zbf_zr,zbf_rad
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      if (ldim.eq.2) then
         zbf_xr=ym1(zbf_i,zbf_j,zbf_k,zbf_e)-phys_xp
         zbf_yr=0.0-phys_yp
         zbf_zr=xm1(zbf_i,zbf_j,zbf_k,zbf_e)-phys_zp
      else
         zbf_xr=xm1(zbf_i,zbf_j,zbf_k,zbf_e)-phys_xp
         zbf_yr=ym1(zbf_i,zbf_j,zbf_k,zbf_e)-phys_yp
         zbf_zr=zm1(zbf_i,zbf_j,zbf_k,zbf_e)-phys_zp
      endif
      zbf_rad=sqrt(zbf_xr*zbf_xr+zbf_yr*zbf_yr+
     $ zbf_zr*zbf_zr)
      return
      end

      subroutine s35bf_set_rigid(zbf_i,zbf_j,zbf_k,zbf_e)
      include 'SIZE'
      include 'TOTAL'
      integer zbf_i,zbf_j,zbf_k,zbf_e

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode

      real zbf_xr,zbf_yr,zbf_zr,zbf_rad
      call s35bf_relxyz(zbf_i,zbf_j,zbf_k,zbf_e,
     $ zbf_xr,zbf_yr,zbf_zr,zbf_rad)

      u_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)=
     $ phys_wp+phys_ox*zbf_yr-phys_oy*zbf_xr
      v_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)=
     $ phys_up+phys_oy*zbf_zr-phys_oz*zbf_yr
      if (sp_cons_mode.eq.2) then
         w_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)=
     $    phys_vp+phys_oz*zbf_xr-phys_ox*zbf_zr
      else
         w_bc_cage(zbf_i,zbf_j,zbf_k,zbf_e)=0.0
      endif
      return
      end

      subroutine s35bf_add_rigid_candidate(zbf_e,
     $ zbf_i,zbf_j,zbf_k,zbf_gu,zbf_gv,zbf_gw,zbf_gn)
      include 'SIZE'
      include 'TOTAL'
      integer zbf_e,zbf_i,zbf_j,zbf_k
      real zbf_gu(lx1,ly1,lz1,lelv)
      real zbf_gv(lx1,ly1,lz1,lelv)
      real zbf_gw(lx1,ly1,lz1,lelv)
      real zbf_gn(lx1,ly1,lz1,lelv)

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode

      real zbf_xr,zbf_yr,zbf_zr,zbf_rad
      real zbf_ux,zbf_uy,zbf_uz
      call s35bf_relxyz(zbf_i,zbf_j,zbf_k,zbf_e,
     $ zbf_xr,zbf_yr,zbf_zr,zbf_rad)

      zbf_ux=phys_up+phys_oy*zbf_zr-phys_oz*zbf_yr
      zbf_uy=phys_vp+phys_oz*zbf_xr-phys_ox*zbf_zr
      zbf_uz=phys_wp+phys_ox*zbf_yr-phys_oy*zbf_xr

      zbf_gu(zbf_i,zbf_j,zbf_k,zbf_e)=
     $ zbf_gu(zbf_i,zbf_j,zbf_k,zbf_e)+zbf_uz
      zbf_gv(zbf_i,zbf_j,zbf_k,zbf_e)=
     $ zbf_gv(zbf_i,zbf_j,zbf_k,zbf_e)+zbf_ux
      if (sp_cons_mode.eq.2) then
         zbf_gw(zbf_i,zbf_j,zbf_k,zbf_e)=
     $    zbf_gw(zbf_i,zbf_j,zbf_k,zbf_e)+zbf_uy
      endif
      zbf_gn(zbf_i,zbf_j,zbf_k,zbf_e)=
     $ zbf_gn(zbf_i,zbf_j,zbf_k,zbf_e)+1.0
      return
      end




      subroutine s35bd_direct_exterior_velocity_cage
c     Keep a safe fallback for non-Uin Stage35BA modes.  This package
c     actually runs mode 22 only.
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      integer e,i,j,k
      real bd_rx,bd_ry,bd_rz,bd_rr
      real bd_ux,bd_uy,bd_uz,bd_rho,bd_nu,bd_cut

      bd_rho=max(abs(param(1)),1.0e-30)
      bd_nu=abs(param(2))/bd_rho
      bd_cut=1.0e-10*max(phys_a,1.0e-30)

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_cage_u(i,j,k,e).ne.1) cycle
         if (ldim.eq.2) then
            bd_rx=ym1(i,j,k,e)-phys_xp
            bd_ry=0.0-phys_yp
            bd_rz=xm1(i,j,k,e)-phys_zp
         else
            bd_rx=xm1(i,j,k,e)-phys_xp
            bd_ry=ym1(i,j,k,e)-phys_yp
            bd_rz=zm1(i,j,k,e)-phys_zp
         endif
         bd_rr=sqrt(bd_rx*bd_rx+bd_ry*bd_ry+bd_rz*bd_rz)
         call s35ad_axisym8_vel(bd_rx,bd_ry,bd_rz,bd_rr,
     $      phys_a,bd_nu,bd_ux,bd_uy,bd_uz)
         u_bc_cage(i,j,k,e)=
     $      phys_wp+phys_ox*bd_ry-phys_oy*bd_rx+bd_uz
         v_bc_cage(i,j,k,e)=
     $      phys_up+phys_oy*bd_rz-phys_oz*bd_ry+bd_ux
         if (sp_cons_mode.eq.2) then
            w_bc_cage(i,j,k,e)=
     $         phys_vp+phys_oz*bd_rx-phys_ox*bd_rz+bd_uy
         else
            w_bc_cage(i,j,k,e)=0.0
         endif
         if (abs(ym1(i,j,k,e)).le.bd_cut)
     $      v_bc_cage(i,j,k,e)=0.0
      enddo
      enddo
      enddo
      enddo

      call physalis_update_velocity_cage_residual
      return
      end



      subroutine physalis_update_velocity_cage_residual
c  Recompute the SEM-versus-reconstructed velocity mismatch on the cage.
c  DIAGNOSTIC ONLY.  Do not use this post-solve mismatch as the nonlinear
c  acceptance gate.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      real num,den,eps
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      real sum_fluid,sum_bc,sum_diff,cnt
      real max_fluid,max_bc,max_diff
      real vfluid2,vbc2,vdiff2,vfluid,vbc,diffmag
      real rms_fluid,rms_bc,rms_diff
      integer e,i,j,k
      integer fu
      parameter (fu=90)
      logical first_call
      save first_call
      data first_call /.true./

      eps = 1.0e-30
      num = 0.0
      den = 0.0
      sum_fluid = 0.0
      sum_bc    = 0.0
      sum_diff  = 0.0
      cnt       = 0.0
      max_fluid = 0.0
      max_bc    = 0.0
      max_diff  = 0.0
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_cage_u(i,j,k,e).ne.1) cycle
         if (ldim.eq.2) then
            vfluid2 =
     $         vx(i,j,k,e)**2 + vy(i,j,k,e)**2
            vbc2 =
     $         u_bc_cage(i,j,k,e)**2 + v_bc_cage(i,j,k,e)**2
            vdiff2 =
     $         (vx(i,j,k,e)-u_bc_cage(i,j,k,e))**2 +
     $         (vy(i,j,k,e)-v_bc_cage(i,j,k,e))**2
            if (sp_cons_mode.eq.2) then
c              Axisymmetric angular validation carries the azimuthal
c              velocity as Nek's third component even though ldim=2.
               vfluid2 = vfluid2 + vz(i,j,k,e)**2
               vbc2 = vbc2 + w_bc_cage(i,j,k,e)**2
               vdiff2 = vdiff2 +
     $            (vz(i,j,k,e)-w_bc_cage(i,j,k,e))**2
            endif
         else
            vfluid2 =
     $         vx(i,j,k,e)**2 + vy(i,j,k,e)**2 +
     $         vz(i,j,k,e)**2
            vbc2 =
     $         u_bc_cage(i,j,k,e)**2 + v_bc_cage(i,j,k,e)**2 +
     $         w_bc_cage(i,j,k,e)**2
            vdiff2 =
     $         (vx(i,j,k,e)-u_bc_cage(i,j,k,e))**2 +
     $         (vy(i,j,k,e)-v_bc_cage(i,j,k,e))**2 +
     $         (vz(i,j,k,e)-w_bc_cage(i,j,k,e))**2
         endif
         num = num + bm1(i,j,k,e) *
     $      vdiff2
         den = den + bm1(i,j,k,e) * vbc2
         sum_fluid = sum_fluid + bm1(i,j,k,e) * vfluid2
         sum_bc    = sum_bc    + bm1(i,j,k,e) * vbc2
         sum_diff  = sum_diff  + bm1(i,j,k,e) * vdiff2
         cnt       = cnt       + bm1(i,j,k,e)
         vfluid = sqrt(vfluid2)
         vbc    = sqrt(vbc2)
         diffmag = sqrt(vdiff2)
         max_fluid = max(max_fluid,vfluid)
         max_bc    = max(max_bc,   vbc)
         max_diff  = max(max_diff, diffmag)
      enddo
      enddo
      enddo
      enddo

      num = glsum(num,1)
      den = glsum(den,1)
      sum_fluid = glsum(sum_fluid,1)
      sum_bc    = glsum(sum_bc,1)
      sum_diff  = glsum(sum_diff,1)
      cnt       = glsum(cnt,1)
      max_fluid = glmax(max_fluid,1)
      max_bc    = glmax(max_bc,1)
      max_diff  = glmax(max_diff,1)

      rms_fluid = sqrt(sum_fluid/max(cnt,eps))
      rms_bc    = sqrt(sum_bc   /max(cnt,eps))
      rms_diff  = sqrt(sum_diff /max(cnt,eps))
      cage_vel_res = rms_diff/max(abs(sm_vt),eps)

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_lamb_vel_at_point(rx,ry,rz,rr,a,nu,
     $    p_re,p_im,phi_re,phi_im,lmax_use,ulx,uly,ulz)
c  Compute Lamb modified velocity at point (rx,ry,rz) from coefficients.
c  Uses GP/SP no-slip-completed radial functions.  The regular Lamb
c  field and singular (a/r) terms are represented by the same Au/Bu/Cv
c  functions used for scalar-product coefficient recovery.
c-----------------------------------------------------------------------
      integer lmax_use
      real rx,ry,rz,rr,a,nu
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real ulx,uly,ulz

c     Access v_re/v_im from common block for toroidal contribution
      real v_re_c(4,5),v_im_c(4,5)
      real p_re_c(4,5),p_im_c(4,5),phi_re_c(4,5),phi_im_c(4,5)
      real p_re_old_c(4,5),p_im_old_c(4,5)
      real phi_re_old_c(4,5),phi_im_old_c(4,5)
      real v_re_old_c(4,5),v_im_old_c(4,5)
      common /phys_lamb/ p_re_c,p_im_c,phi_re_c,phi_im_c,
     $ v_re_c,v_im_c,p_re_old_c,p_im_old_c,
     $ phi_re_old_c,phi_im_old_c,v_re_old_c,v_im_old_c

      real Yre(4,5),Yim(4,5),dYdth_re(4,5),dYdth_im(4,5)
      real Gxr(4,5),Gyr(4,5),Gzr(4,5)
      real Gxi(4,5),Gyi(4,5),Gzi(4,5)
      real cth,sth,cphi,sphi,rho
      real eth_x,eth_y,eth_z,eph_x,eph_y,eph_z
      real er_x,er_y,er_z
      real fn,roa,aor
      real dYdph_re,dYdph_im
      real gpx_re,gpy_re,gpz_re
      real gphi_x_re,gphi_y_re,gphi_z_re
      real pn_re,phin_re
      real pref,phiref
      real tv_x,tv_y,tv_z,coef_v
      real grad_x,grad_y,grad_z,curl_x,curl_y,curl_z
      real yval,pcval,phicval,vval
      real Au1,Au2,Au3,Bu1,Bu2,Bu3
      real q1,q2,q3,Tc,Rc,coef
      real eps,coef_p,coef_phi
      real py,pyth,pyph,phiy,phiyth,phiyph,facm
      real y1r,y1i,g1xr,g1yr,g1zr,g1xi,g1yi,g1zi
      integer n,m

      eps = 1.0e-30
      ulx = 0.0
      uly = 0.0
      ulz = 0.0

      roa  = rr/max(a,eps)
      aor  = a/max(rr,eps)
      cth  = rz/max(rr,eps)
      rho  = sqrt(rx*rx+ry*ry)
      sth  = rho/max(rr,eps)
      if (rho.gt.eps) then
         cphi = rx/rho;  sphi = ry/rho
      else
         cphi = 1.0;     sphi = 0.0
      endif

      er_x=rx/max(rr,eps); er_y=ry/max(rr,eps); er_z=rz/max(rr,eps)
      eth_x=cth*cphi; eth_y=cth*sphi; eth_z=-sth
      eph_x=-sphi;    eph_y=cphi;     eph_z=0.0

      call physalis_ylm_surface_gradient(rx,ry,rz,rr,lmax_use,
     $   Yre,Yim,Gxr,Gyr,Gzr,Gxi,Gyi,Gzi)

      do n=1,lmax_use
         fn   = float(n)
         do m=0,n
            facm = 1.0
            if (m.gt.0) facm = 2.0
            dYdph_re = -float(m)*Yim(n,m+1)
            dYdph_im =  float(m)*Yre(n,m+1)

c           Complex reconstruction convention matches scalar products.
c           S&P A.8 uses C0*Y0 + 2*Re(Cm*Ym) for m>0.
            yval = Yre(n,m+1)
            py   = facm*(p_re(n,m+1)*Yre(n,m+1)
     $           - p_im(n,m+1)*Yim(n,m+1))
            pyth = facm*(p_re(n,m+1)*dYdth_re(n,m+1)
     $           - p_im(n,m+1)*dYdth_im(n,m+1))
            pyph = facm*(p_re(n,m+1)*dYdph_re
     $           - p_im(n,m+1)*dYdph_im)

            phiy   = facm*(phi_re(n,m+1)*Yre(n,m+1)
     $             - phi_im(n,m+1)*Yim(n,m+1))
            phiyth = facm*(phi_re(n,m+1)*dYdth_re(n,m+1)
     $             - phi_im(n,m+1)*dYdth_im(n,m+1))
            phiyph = facm*(phi_re(n,m+1)*dYdph_re
     $             - phi_im(n,m+1)*dYdph_im)

            grad_x=facm*(p_re(n,m+1)*Gxr(n,m+1)-
     $              p_im(n,m+1)*Gxi(n,m+1))
            grad_y=facm*(p_re(n,m+1)*Gyr(n,m+1)-
     $              p_im(n,m+1)*Gyi(n,m+1))
            grad_z=facm*(p_re(n,m+1)*Gzr(n,m+1)-
     $              p_im(n,m+1)*Gzi(n,m+1))

c           GP/SP no-slip-completed poloidal p contribution.
c           Au terms are decomposed by radial power q; divergence-free
c           radial coefficient is Au/(q+2).  The first term is the
c           regular Lamb field, the latter two are singular corrections.
            Au1 = fn*(fn+3.0)/(2.0*(2.0*fn+3.0))
     $            *roa**(n+1)
            Au2 = 0.25*fn*(fn-2.0)*roa**(-n)
            Au3 = -0.25*fn*fn*(2.0*fn+1.0)
     $            /(2.0*fn+3.0)*roa**(-(n+2))
            q1 = fn+1.0
            q2 = -fn
            q3 = -(fn+2.0)

            coef = Au1
            Tc = (nu/a)*coef/(fn*(fn+1.0))
            Rc = (nu/a)*coef/(q1+2.0)
            ulx = ulx + Rc*py*er_x + Tc*grad_x
            uly = uly + Rc*py*er_y + Tc*grad_y
            ulz = ulz + Rc*py*er_z + Tc*grad_z

            if (abs(Au2).gt.eps .and. abs(q2+2.0).gt.eps) then
               coef = Au2
               Tc = (nu/a)*coef/(fn*(fn+1.0))
               Rc = (nu/a)*coef/(q2+2.0)
               ulx = ulx + Rc*py*er_x + Tc*grad_x
               uly = uly + Rc*py*er_y + Tc*grad_y
               ulz = ulz + Rc*py*er_z + Tc*grad_z
            else if (n.eq.2) then
c              Removable n=2 limit: Au2/(2-n) -> -n/4*R**(-n).
c              Its tangential part is zero, but its radial part is not.
               Rc = -(nu/a)*0.25*fn*roa**(-n)
               ulx = ulx + Rc*py*er_x
               uly = uly + Rc*py*er_y
               ulz = ulz + Rc*py*er_z
            endif

            coef = Au3
            Tc = (nu/a)*coef/(fn*(fn+1.0))
            Rc = (nu/a)*coef/(q3+2.0)
            ulx = ulx + Rc*py*er_x + Tc*grad_x
            uly = uly + Rc*py*er_y + Tc*grad_y
            ulz = ulz + Rc*py*er_z + Tc*grad_z

            grad_x=facm*(phi_re(n,m+1)*Gxr(n,m+1)-
     $              phi_im(n,m+1)*Gxi(n,m+1))
            grad_y=facm*(phi_re(n,m+1)*Gyr(n,m+1)-
     $              phi_im(n,m+1)*Gyi(n,m+1))
            grad_z=facm*(phi_re(n,m+1)*Gzr(n,m+1)-
     $              phi_im(n,m+1)*Gzi(n,m+1))

c           GP/SP no-slip-completed poloidal phi contribution.
            Bu1 = fn*(fn+1.0)*roa**(n-1)
            Bu2 = 0.5*fn*(fn-2.0)*(2.0*fn+1.0)*roa**(-n)
            Bu3 = -0.5*fn*fn*(2.0*fn-1.0)*roa**(-(n+2))
            q1 = fn-1.0
            q2 = -fn
            q3 = -(fn+2.0)

            coef = Bu1
            Tc = (nu/a)*coef/(fn*(fn+1.0))
            Rc = (nu/a)*coef/(q1+2.0)
            ulx = ulx + Rc*phiy*er_x + Tc*grad_x
            uly = uly + Rc*phiy*er_y + Tc*grad_y
            ulz = ulz + Rc*phiy*er_z + Tc*grad_z

            if (abs(Bu2).gt.eps .and. abs(q2+2.0).gt.eps) then
               coef = Bu2
               Tc = (nu/a)*coef/(fn*(fn+1.0))
               Rc = (nu/a)*coef/(q2+2.0)
               ulx = ulx + Rc*phiy*er_x + Tc*grad_x
               uly = uly + Rc*phiy*er_y + Tc*grad_y
               ulz = ulz + Rc*phiy*er_z + Tc*grad_z
            else if (n.eq.2) then
c              Removable n=2 limit:
c              Bu2/(2-n) -> -n(2n+1)/2*R**(-n).
               Rc = -(nu/a)*0.5*fn*(2.0*fn+1.0)*roa**(-n)
               ulx = ulx + Rc*phiy*er_x
               uly = uly + Rc*phiy*er_y
               ulz = ulz + Rc*phiy*er_z
            endif

            coef = Bu3
            Tc = (nu/a)*coef/(fn*(fn+1.0))
            Rc = (nu/a)*coef/(q3+2.0)
            ulx = ulx + Rc*phiy*er_x + Tc*grad_x
            uly = uly + Rc*phiy*er_y + Tc*grad_y
            ulz = ulz + Rc*phiy*er_z + Tc*grad_z

c           Toroidal no-slip completion from GP/SP Cv:
c           coef_v = (nu/a)*Cv/[n(n+1)] =
c                    (nu/a)*(roa^(-n-1)-roa^n).
            curl_x=er_y*Gzr(n,m+1)-er_z*Gyr(n,m+1)
            curl_y=er_z*Gxr(n,m+1)-er_x*Gzr(n,m+1)
            curl_z=er_x*Gyr(n,m+1)-er_y*Gxr(n,m+1)
            vval = facm*v_re_c(n,m+1)
            coef_v = (nu/a)*(roa**(-(n+1)) - roa**n)
            ulx = ulx + coef_v*vval*curl_x
            uly = uly + coef_v*vval*curl_y
            ulz = ulz + coef_v*vval*curl_z

            curl_x=er_y*Gzi(n,m+1)-er_z*Gyi(n,m+1)
            curl_y=er_z*Gxi(n,m+1)-er_x*Gzi(n,m+1)
            curl_z=er_x*Gyi(n,m+1)-er_y*Gxi(n,m+1)
            vval = -facm*v_im_c(n,m+1)
            ulx = ulx + coef_v*vval*curl_x
            uly = uly + coef_v*vval*curl_y
            ulz = ulz + coef_v*vval*curl_z
         enddo
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine physalis_compute_lamb_force
c  Production wrapper around the array-explicit Lamb force map.
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      call physalis_compute_lamb_force_arrays(
     $ p_re,p_im,phi_re,phi_im,v_re,v_im,F_phys,T_phys)
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_compute_lamb_force_arrays(
     $ pin_re,pin_im,fin_re,fin_im,vin_re,vin_im,Fout,Tout)
c  Read-only S&P A.22-A.23 force/torque from explicit coefficient arrays.
c  Moving runs return Fhat; fixed validation retains its p-gradient term.
      include 'SIZE'
      include 'TOTAL'
      real pin_re(4,5),pin_im(4,5),fin_re(4,5),fin_im(4,5)
      real vin_re(4,5),vin_im(4,5),Fout(3),Tout(3)
      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      real a,rho_f,nu,mu,Vp,sp_a_ref,pstar,pgrad,pi_loc
      integer spmove_enabled
      common /spmove_ctl/ spmove_enabled
      integer phys_m1_active
      common /phys_m1_ctl/ phys_m1_active
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real phi10r,phi11r,phi11i,N0,N1
      real p10r,p11r,p11i
      real Px,Py,Pz,Phix,Phiy,Phiz
      real Xx,Xy,Xz
      real Fhatx,Fhaty,Fhatz

      pi_loc = 4.0*atan(1.0)
      a     = phys_a
      rho_f = max(abs(param(1)),1.0e-30)
      mu    = abs(param(2))
      nu    = mu/rho_f
      Vp    = 4.0/3.0*pi_loc*a**3
      N0    = sqrt(3.0/(4.0*pi_loc))
      N1    = sqrt(3.0/(8.0*pi_loc))

      phi11r = fin_re(1,2)
      phi11i = fin_im(1,2)
      phi10r = fin_re(1,1)
      p11r = pin_re(1,2)
      p11i = pin_im(1,2)
      p10r = pin_re(1,1)

      Px   = -2.0*N1*p11r
      Py   =  2.0*N1*p11i
      Pz   =       N0*p10r
      Phix = -2.0*N1*phi11r
      Phiy =  2.0*N1*phi11i
      Phiz =       N0*phi10r

      Fhatx = pi_loc*mu*nu*(6.0*Phix + Px)
      Fhaty = pi_loc*mu*nu*(6.0*Phiy + Py)
      Fhatz = pi_loc*mu*nu*(6.0*Phiz + Pz)
      Fout(1)=Fhatx
      Fout(2)=Fhaty
      call zp_validation_config
      if (zp_problem.ge.31 .and. zp_problem.le.34 .and.
     $    phys_m1_active.eq.0) then
         call physalis_sp_validation_params(sp_a_ref,pstar)
         pgrad=pstar*mu*nu/max(sp_a_ref**3,1.0e-30)
         Fout(3)=Fhatz-Vp*pgrad
      else
         Fout(3)=Fhatz
      endif

      Xx = -2.0*N1*vin_re(1,2)
      Xy =  2.0*N1*vin_im(1,2)
      Xz =       N0*vin_re(1,1)
      Tout(1) = 8.0*pi_loc*mu*nu*a * Xx
      Tout(2) = 8.0*pi_loc*mu*nu*a * Xy
      Tout(3) = 8.0*pi_loc*mu*nu*a * Xz
      return
      end
c-----------------------------------------------------------------------

      subroutine physalis_inject_cage_bc_bcdirvc(
     $    tmp1,tmp2,tmp3,mask1,mask2,mask3,nel_in)
      include 'SIZE'
      include 'TOTAL'

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      integer nel_in
      real tmp1(lx1,ly1,lz1,nel_in)
      real tmp2(lx1,ly1,lz1,nel_in)
      real tmp3(lx1,ly1,lz1,nel_in)
      real mask1(lx1,ly1,lz1,nel_in)
      real mask2(lx1,ly1,lz1,nel_in)
      real mask3(lx1,ly1,lz1,nel_in)

      integer e,i,j,k,ntotv
      real phys_vmask1_base(lx1,ly1,lz1,lelv)
      real phys_vmask2_base(lx1,ly1,lz1,lelv)
      real phys_vmask3_base(lx1,ly1,lz1,lelv)
      integer phys_vmask_valid
      common /physalis_vmask_bak/ phys_vmask1_base,
     $ phys_vmask2_base,phys_vmask3_base
      common /physalis_vmask_ctl/ phys_vmask_valid

      if (phys_mode.lt.4) return
      if (istep.le.0) return
      if (n_cage_u_g.le.0) return

      if (phys_vmask_valid.eq.0) then
         ntotv=lx1*ly1*lz1*nelv
         call copy(phys_vmask1_base,mask1,ntotv)
         call copy(phys_vmask2_base,mask2,ntotv)
         call copy(phys_vmask3_base,mask3,ntotv)
         phys_vmask_valid=1
      endif

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_cage_u(i,j,k,e).eq.1 .or.
     $       mask_inside_u(i,j,k,e).eq.1) then
            tmp1(i,j,k,e)  = u_bc_cage(i,j,k,e)
            tmp2(i,j,k,e)  = v_bc_cage(i,j,k,e)
            tmp3(i,j,k,e)  = w_bc_cage(i,j,k,e)
            mask1(i,j,k,e) = 0.0
            mask2(i,j,k,e) = 0.0
            mask3(i,j,k,e) = 0.0
         endif
      enddo
      enddo
      enddo
      enddo

      return
      end

      subroutine physalis_restore_cage_mask(mask1,mask2,mask3)
      include 'SIZE'
      include 'TOTAL'

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      real mask1(lx1,ly1,lz1,lelv)
      real mask2(lx1,ly1,lz1,lelv)
      real mask3(lx1,ly1,lz1,lelv)

      integer e,i,j,k,ntotv
      integer phys_replay_enabled,phys_replay_active,phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved
      integer phys_surface_inner_current
      common /phys_surface_audit_i/ phys_surface_inner_current
      real phys_vmask1_base(lx1,ly1,lz1,lelv)
      real phys_vmask2_base(lx1,ly1,lz1,lelv)
      real phys_vmask3_base(lx1,ly1,lz1,lelv)
      integer phys_vmask_valid
      common /physalis_vmask_bak/ phys_vmask1_base,
     $ phys_vmask2_base,phys_vmask3_base
      common /physalis_vmask_ctl/ phys_vmask_valid

      if (phys_mode.lt.4) return
      if (istep.le.0) return
      if (n_cage_u_g.le.0) return

      if (phys_vmask_valid.eq.1) then
         ntotv=lx1*ly1*lz1*nelv
         call copy(mask1,phys_vmask1_base,ntotv)
         call copy(mask2,phys_vmask2_base,ntotv)
         call copy(mask3,phys_vmask3_base,ntotv)
         phys_vmask_valid=0
      endif

      return
      end

      subroutine physalis_enforce_pressure_cage(pr_in)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_p/ p_bc_cage

      real pr_in(lx2,ly2,lz2,lelv)
      integer e,i,j,k

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      real num,den,eps
      real w,prv,pbcv,prf,pbcf,dgf
      real sw,spr,spbc,spr2,spbc2
      real mean_pr,mean_pbc
      real num_gf,den_gf,sprf2,spbcf2
      real raw_res,gf_res,rms_pr,rms_pbc,rms_prf,rms_pbcf
      integer fu
      logical first_detail
      save first_detail
      data first_detail /.true./
      eps = 1.0e-30

      if (phys_mode.lt.5) return

      if (stage12_virtual_p_on.eq.1) then
         call stage12_pressure_constraint_residual(pr_in,
     $      pressure_cage_res)
         return
      endif

      num = 0.0
      den = 0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            w = bm2(i,j,k,e)
            prv  = pr_in(i,j,k,e)
            pbcv = p_bc_cage(i,j,k,e)
            num = num + w*(prv-pbcv)**2
            den = den + w*max(prv*prv,pbcv*pbcv)
         endif
      enddo
      enddo
      enddo
      enddo
      num = glsum(num,1)
      den = glsum(den,1)
      pressure_cage_res = sqrt(num/max(den,eps))
      raw_res = pressure_cage_res

      sw    = 0.0
      spr   = 0.0
      spbc  = 0.0
      spr2  = 0.0
      spbc2 = 0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            w = bm2(i,j,k,e)
            prv  = pr_in(i,j,k,e)
            pbcv = p_bc_cage(i,j,k,e)
            sw    = sw    + w
            spr   = spr   + w*prv
            spbc  = spbc  + w*pbcv
            spr2  = spr2  + w*prv*prv
            spbc2 = spbc2 + w*pbcv*pbcv
         endif
      enddo
      enddo
      enddo
      enddo
      sw    = glsum(sw,1)
      spr   = glsum(spr,1)
      spbc  = glsum(spbc,1)
      spr2  = glsum(spr2,1)
      spbc2 = glsum(spbc2,1)
      mean_pr  = spr /max(sw,eps)
      mean_pbc = spbc/max(sw,eps)
      rms_pr   = sqrt(spr2 /max(sw,eps))
      rms_pbc  = sqrt(spbc2/max(sw,eps))

      num_gf = 0.0
      den_gf = 0.0
      sprf2  = 0.0
      spbcf2 = 0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            w = bm2(i,j,k,e)
            prf  = pr_in(i,j,k,e) - mean_pr
            pbcf = p_bc_cage(i,j,k,e) - mean_pbc
            dgf  = prf - pbcf
            num_gf = num_gf + w*dgf*dgf
            den_gf = den_gf + w*pbcf*pbcf
            sprf2  = sprf2  + w*prf*prf
            spbcf2 = spbcf2 + w*pbcf*pbcf
         endif
      enddo
      enddo
      enddo
      enddo
      num_gf = glsum(num_gf,1)
      den_gf = glsum(den_gf,1)
      sprf2  = glsum(sprf2,1)
      spbcf2 = glsum(spbcf2,1)
      gf_res  = sqrt(num_gf/max(den_gf,eps))
      rms_prf = sqrt(sprf2 /max(sw,eps))
      rms_pbcf= sqrt(spbcf2/max(sw,eps))

      return
      end

      subroutine physalis_lamb_pressure_at_point(dxp,dyp,dzp,rmag,a,
     $   p_re,p_im,phi_re,phi_im,lmax_use,ptil)
c  Modified Lamb pressure in the active nondimensional unit system.
c  radial reconstruction used for the production pressure cage.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'INPUT'

      integer lmax_use
      real dxp,dyp,dzp,rmag,a,ptil
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real Yre(4,5),Yim(4,5),dYre(4,5),dYim(4,5)
      real roa,aor,fn,Ap,Bp,py,phiy,facm,pl
      real rho_f,nu,mu,eps
      integer n,m

      eps=1.0e-30
      ptil=0.0
      if (rmag.le.eps) return

      rho_f=max(abs(param(1)),eps)
      mu=abs(param(2))
      nu=mu/max(rho_f,eps)
      roa=rmag/max(a,eps)
      aor=a/max(rmag,eps)
      call physalis_ylm_point(dxp,dyp,dzp,rmag,lmax_use,
     $   Yre,Yim,dYre,dYim)

      pl=0.0
      do n=1,lmax_use
         fn=float(n)
         Ap=(1.0-0.5*fn*(2.0*fn-1.0)/(fn+1.0)
     $      *aor**(2*n+1))*roa**n
         Bp=-(fn*(2.0*fn-1.0)*(2.0*fn+1.0)/(fn+1.0))
     $      *aor**(n+1)
         do m=0,n
            facm=1.0
            if (m.gt.0) facm=2.0
            py=facm*(p_re(n,m+1)*Yre(n,m+1)
     $         -p_im(n,m+1)*Yim(n,m+1))
            phiy=facm*(phi_re(n,m+1)*Yre(n,m+1)
     $         -phi_im(n,m+1)*Yim(n,m+1))
            pl=pl+Ap*py+Bp*phiy
         enddo
      enddo
      ptil=(mu*nu/(a*a))*pl

      return
      end

