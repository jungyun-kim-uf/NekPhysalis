c-----------------------------------------------------------------------
      subroutine physalis_lock_pressure_reference
c  Lock the arbitrary pressure gauge once per physical step from the
c  time-n pressure field.  Inner replays must not recompute this gauge
c  from the current replay output.
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer phys_pressure_ref_step
      common /physalis_pressure_reference_i/
     $ phys_pressure_ref_step

      real psum,wtsum,w
      integer e,i,j,k

      if (stage12_virtual_p_on.eq.1) then
         call stage12_constraint_mean(pr,phys_pressure_ref)
         phys_pressure_ref_step=istep
         if (nio.eq.0 .and.
     $      (istep.le.5 .or. mod(istep,25).eq.0)) then
            write(6,'(A,I8,1X,E16.8)')
     $         'Stage12 virtual pressure reference: ',istep,
     $         phys_pressure_ref
         endif
         return
      endif

      psum=0.0
      wtsum=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            w=bm2(i,j,k,e)
            psum=psum+w*pr(i,j,k,e)
            wtsum=wtsum+w
         endif
      enddo
      enddo
      enddo
      enddo
      psum=glsum(psum,1)
      wtsum=glsum(wtsum,1)
      if (wtsum.gt.0.0) then
         phys_pressure_ref=psum/wtsum
      else
         phys_pressure_ref=0.0
      endif
      phys_pressure_ref_step=istep

      if (nio.eq.0 .and.
     $   (istep.le.5 .or. mod(istep,25).eq.0)) then
         write(6,'(A,I8,1X,E16.8)')
     $      'Physalis pressure reference locked: ',istep,
     $      phys_pressure_ref
      endif

      return
      end

c-----------------------------------------------------------------------

      subroutine stage6_zero_diag
      real s6_pc_raw_rms(4),s6_pc_raw_max(4)
      real s6_pc_app_rms(4),s6_pc_app_max(4)
      common /stage6_diag_r/ s6_pc_raw_rms,s6_pc_raw_max,
     $ s6_pc_app_rms,s6_pc_app_max
      integer n
      do n=1,4
         s6_pc_raw_rms(n)=0.0
         s6_pc_raw_max(n)=0.0
         s6_pc_app_rms(n)=0.0
         s6_pc_app_max(n)=0.0
      enddo
      return
      end

c-----------------------------------------------------------------------

      subroutine physalis_reconstruct_pressure_cage
c     STAGE35AD final candidate: fixed-sphere axisymmetric U8/P8 path.
c     Pressure target uses the SAME committed GL128 m=0 N=1..8 Lamb
c     coefficients as the velocity target.  Stage23 subsequently removes
c     the cage correction mean, so no absolute pressure gauge is imposed.
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_p/ p_bc_cage

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real s35rx,s35ry,s35rz,s35rr,s35ptil,s35pshift
      integer s35e,s35i,s35j,s35k,s35nt

      if (phys_mode.lt.5) return
      if (ldim.ne.2) then
         if (nid.eq.0) write(6,*)
     $      'S35AD ERROR: U8/P8 pressure cage requires ldim=2'
         call exitt
      endif

      s35nt=lx2*ly2*lz2*nelv
      call rzero(p_bc_cage,s35nt)

      do s35e=1,nelv
      do s35k=1,lz2
      do s35j=1,ly2
      do s35i=1,lx2
         if (mask_cage_p(s35i,s35j,s35k,s35e).ne.1) cycle

c        Axisymmetric map: Physalis z = Nek x, Physalis x = Nek r.
         s35rx=ym2(s35i,s35j,s35k,s35e)-phys_xp
         s35ry=0.0-phys_yp
         s35rz=xm2(s35i,s35j,s35k,s35e)-phys_zp
         s35rr=sqrt(s35rx*s35rx+s35ry*s35ry+s35rz*s35rz)

         call s35ad_axisym8_press(s35rx,s35ry,s35rz,
     $      s35rr,phys_a,s35ptil)
         call physalis_sp_pressure_frame_shift
     $      (s35rx,s35ry,s35rz,s35pshift)

         p_bc_cage(s35i,s35j,s35k,s35e)=
     $      s35ptil+s35pshift
      enddo
      enddo
      enddo
      enddo

      return
      end




c-----------------------------------------------------------------------

      subroutine physalis_setup_uzawa_dirich(dp, up, scaledt)
c  Called from induct.f::incomprn after cmult(dp,scaledt) and before
c  esolver.  For phys_mode>=5, computes the scaled pressure-correction
c  Dirichlet value at cage nodes.  The pressure-correction cage value is
c  relaxed separately from the Lamb coefficient iteration:
c    phi_cage_bc_scaled(cage) =
c       (p_bc_cage - up) * scaledt
c  Pressure-cage lifted solve test.  Compute and log the desired cage
c  pressure-correction target, then activate the UZAWA hooks that solve
c  for x = lift + y with y(cage)=0.  The lift contribution is subtracted
c  from the RHS in phys_cage_lift_rhs, so the final cage restore is the
c  known Dirichlet value rather than an unconstrained pressure spike.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      real dp(lx2,ly2,lz2,lelv), up(lx2,ly2,lz2,lelv)
      real scaledt

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real pressure_relax_coeff
      common /physalis_pressure_relax/ pressure_relax_coeff

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_p/ p_bc_cage

      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled, phys_uzawa_dirich_on
      integer phys_lift_restore_pending
      common /phys_cage_lift_state/ phys_lift_restore_pending

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      real delta_p_cage_local,delta_p_lift_local
      common /stage33c_pwidth_r/ delta_p_cage_local,
     $ delta_p_lift_local

      integer e,i,j,k,ntot2
      real gamma_p
      real pbc,upv,delp,phiv,dpv
      real drx,dry,drz,rr,roa,ramp,lift_full,lift_outer,pi_lift
      real lift_inner_full,lift_inner_zero
      real sum_pbc2,sum_up2,sum_del2,sum_phi2,sum_dp2
      real max_pbc,max_up,max_del,max_phi,max_dp,cnt
      integer fu
      logical first_call
      save first_call
      data first_call /.true./

      phys_uzawa_dirich_on = 0
      phys_lift_restore_pending = 0
      if (phys_mode.lt.5) return
c     Honor the configured pressure-correction relaxation.  The previous
c     hard-coded gamma_p=1 made pressure_relax_coeff ineffective.
      gamma_p = pressure_relax_coeff
      if (gamma_p.lt.0.0) gamma_p = 0.0
      if (gamma_p.gt.1.0) gamma_p = 1.0
      if (gamma_p.le.1.0e-12) return
c     STAGE18-v2: pressure OFF must be genuinely OFF.  If neither
c     Stage12 nor a nodal pressure cage exists, do not activate the
c     custom Uzawa Dirichlet/lift path.
      if (stage12_virtual_p_on.eq.0 .and.
     $    n_cage_p_g.le.0) return
c     Activate homogeneous-correction UZAWA path:
c        A*y = rhs - A*lift,  y(cage)=0,  dp = y + lift
      phys_uzawa_dirich_on = 1
      ntot2 = lx2*ly2*lz2*nelv
      call rzero(phi_cage_bc_scaled,ntot2)
      pi_lift = 4.0*atan(1.0)
c     Use the smooth analytic continuation that previously gave
c     57--121 UZAWA iterations at tolerance 1e-6.  Only mask_cage_p
c     defines Dirichlet rows; the remaining support is a lift, not a
c     prescribed pressure region.
      if (stage12_virtual_p_on.eq.1) then
c        Algebraic lift support is fixed in r/a across resolution.
         lift_inner_zero = 0.60
         lift_inner_full = 0.75
         lift_full       = 1.05
         lift_outer      = 1.15
      else
         lift_full  = 1.50
         lift_outer = 2.00
         lift_inner_full=max(0.25,1.0-delta_p_lift_local/
     $      max(phys_a,1.0e-30))
         lift_inner_zero=max(0.25,lift_inner_full-
     $      delta_p_lift_local/max(phys_a,1.0e-30))
      endif

      sum_pbc2 = 0.0
      sum_up2  = 0.0
      sum_del2 = 0.0
      sum_phi2 = 0.0
      sum_dp2  = 0.0
      max_pbc  = 0.0
      max_up   = 0.0
      max_del  = 0.0
      max_phi  = 0.0
      max_dp   = 0.0
      cnt      = 0.0

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (ldim.eq.2) then
            drx = ym2(i,j,k,e) - phys_xp
            dry = 0.0 - phys_yp
            drz = xm2(i,j,k,e) - phys_zp
         else
            drx = xm2(i,j,k,e) - phys_xp
            dry = ym2(i,j,k,e) - phys_yp
            drz = zm2(i,j,k,e) - phys_zp
         endif
         rr  = sqrt(drx*drx+dry*dry+drz*drz)
         roa = rr/max(phys_a,1.0e-30)
         ramp = 0.0
         if (roa.lt.lift_inner_zero) then
            ramp = 0.0
         elseif (roa.lt.lift_inner_full) then
            ramp = 0.5*(1.0-cos(pi_lift*(roa-lift_inner_zero)
     $             /max(lift_inner_full-lift_inner_zero,1.0e-30)))
         elseif (roa.le.lift_full) then
            ramp = 1.0
         elseif (roa.lt.lift_outer) then
            ramp = 0.5*(1.0+cos(pi_lift*(roa-lift_full)
     $             /(lift_outer-lift_full)))
         endif
         if (mask_cage_p(i,j,k,e).eq.1) ramp=1.0
         if (ramp.gt.0.0) then
            pbc = p_bc_cage(i,j,k,e)
            upv = up(i,j,k,e)
            delp = pbc - upv
            phi_cage_bc_scaled(i,j,k,e) =
     $         ramp*gamma_p*delp*scaledt
            phiv = phi_cage_bc_scaled(i,j,k,e)
            dpv = dp(i,j,k,e)
            sum_pbc2 = sum_pbc2 + pbc*pbc
            sum_up2  = sum_up2  + upv*upv
            sum_del2 = sum_del2 + delp*delp
            sum_phi2 = sum_phi2 + phiv*phiv
            sum_dp2  = sum_dp2  + dpv*dpv
            max_pbc = max(max_pbc,abs(pbc))
            max_up  = max(max_up, abs(upv))
            max_del = max(max_del,abs(delp))
            max_phi = max(max_phi,abs(phiv))
            max_dp  = max(max_dp, abs(dpv))
            cnt = cnt + 1.0
c           Diagnostic only: do not alter the Poisson RHS at cage nodes.
c           dp(i,j,k,e) = 0.0
         endif
      enddo
      enddo
      enddo
      enddo

      if (stage12_virtual_p_on.eq.1) then
         call stage12_build_target_phi(up,scaledt,gamma_p,
     $      s12_target_phi)
         call stage12_force_lift_constraints(
     $      phi_cage_bc_scaled,s12_target_phi)
      endif

      sum_pbc2 = glsum(sum_pbc2,1)
      sum_up2  = glsum(sum_up2,1)
      sum_del2 = glsum(sum_del2,1)
      sum_phi2 = glsum(sum_phi2,1)
      sum_dp2  = glsum(sum_dp2,1)
      cnt      = glsum(cnt,1)
      max_pbc  = glmax(max_pbc,1)
      max_up   = glmax(max_up,1)
      max_del  = glmax(max_del,1)
      max_phi  = glmax(max_phi,1)
      max_dp   = glmax(max_dp,1)

      if (first_call .and. nio.eq.0) then
         write(6,*) 'PHYSALIS PRESSURE DIRICHLET: SMOOTH_LIFT'
         write(6,'(A,5E13.5)') 'PHYSALIS FIRST LIFT RMS ' //
     $      'pbc/up/delta/phi/rhs=',
     $      sqrt(sum_pbc2/max(cnt,1.0e-30)),
     $      sqrt(sum_up2 /max(cnt,1.0e-30)),
     $      sqrt(sum_del2/max(cnt,1.0e-30)),
     $      sqrt(sum_phi2/max(cnt,1.0e-30)),
     $      sqrt(sum_dp2 /max(cnt,1.0e-30))
         write(6,'(A,5E13.5)') 'PHYSALIS FIRST LIFT MAX ' //
     $      'pbc/up/delta/phi/rhs=',
     $      max_pbc,max_up,max_del,max_phi,max_dp
         first_call=.false.
      endif

      return
      end

c-----------------------------------------------------------------------
      subroutine phys_cage_lift_rhs(zbj_rcg,zbj_xcg,zbj_wp,
     $ zbj_h1,zbj_h2,zbj_h2inv,zbj_intype,zbj_ntot2)
c-----------------------------------------------------------------------
c  Stage35BJ pressure-lift guard for axisymmetric PCG.
c
c  INCOMPRN already calls stage23_pressure_rhs_lift() before ESOLVER.
c  That routine subtracts A*L, projects the RHS, and sets
c  phys_lift_restore_pending=1.
c
c  The historical PCG UZAWA path then called this routine and subtracted
c  A*L AGAIN.  When pending=1, do not apply the lift twice.  Only enforce
c  the same exterior pressure-space projection used by the PCG vectors.
c
c  The legacy path below is retained for a caller that reaches UZAWA
c  without the pre-ESOLVER Stage23 lift.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      real zbj_rcg(lx2,ly2,lz2,lelv)
      real zbj_xcg(lx2,ly2,lz2,lelv)
      real zbj_wp(lx2,ly2,lz2,lelv)
      real zbj_h1(lx1,ly1,lz1,lelv)
      real zbj_h2(lx1,ly1,lz1,lelv)
      real zbj_h2inv(lx1,ly1,lz1,lelv)
      integer zbj_intype,zbj_ntot2

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on

      integer phys_lift_restore_pending
      common /phys_cage_lift_state/ phys_lift_restore_pending

      integer zbj_e,zbj_i,zbj_j,zbj_k
      logical zbj_first
      save zbj_first
      data zbj_first /.true./

      if (phys_uzawa_dirich_on.eq.0) return

c     Normal Stage23 path: the lift was already applied in INCOMPRN.
      if (phys_lift_restore_pending.eq.1) then
         call stage23_pressure_project(zbj_rcg)
         call rzero(zbj_xcg,zbj_ntot2)
         call rzero(zbj_wp,zbj_ntot2)
         if (zbj_first .and. nid.eq.0) then
            write(6,'(A)')
     $       'S35BJ PCG: skip duplicate pressure-lift subtraction'
            write(6,'(A)')
     $       'S35BJ PCG: project inside_p and cage_p every iteration'
            zbj_first=.false.
         endif
         return
      endif

c     Legacy fallback: build and subtract the pressure lift once.
      phys_lift_restore_pending=1
      call copy(zbj_xcg,phi_cage_bc_scaled,zbj_ntot2)
      call cdabdtp(zbj_wp,zbj_xcg,zbj_h1,zbj_h2,zbj_h2inv,
     $ zbj_intype)
      call add2s2(zbj_rcg,zbj_wp,-1.0,zbj_ntot2)

      if (stage12_virtual_p_on.eq.1) then
         call stage12_project_m2(zbj_rcg)
      else
         call stage23_pressure_project(zbj_rcg)
      endif

      call rzero(zbj_xcg,zbj_ntot2)
      return
      end
c-----------------------------------------------------------------------

      subroutine physalis_zero_cage_m2(v)
c  Stage35BJ true exterior-only pressure projector for the axisymmetric
c  PCG path.  Stage23 declares both particle-interior pressure points
c  and the pressure-cage points removed from the correction space.
c  Keep every PCG vector in that same reduced space.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      real v(lx2,ly2,lz2,lelv)

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on

      integer zbj_e,zbj_i,zbj_j,zbj_k

      if (phys_uzawa_dirich_on.eq.0) return

      if (stage12_virtual_p_on.eq.1) then
         call stage12_project_m2(v)
         return
      endif

      do zbj_e=1,nelv
      do zbj_k=1,lz2
      do zbj_j=1,ly2
      do zbj_i=1,lx2
         if (mask_inside_p(zbj_i,zbj_j,zbj_k,zbj_e).eq.1
     $       .or.
     $       mask_cage_p(zbj_i,zbj_j,zbj_k,zbj_e).eq.1)
     $      v(zbj_i,zbj_j,zbj_k,zbj_e)=0.0
      enddo
      enddo
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------

      subroutine physalis_restore_xcg_dirich(v)
c  Complete the lifting decomposition x=lift+y exactly once.  The CG
c  correction y is zero only at actual cage nodes; it remains free on
c  the smooth lift support.  incomprn calls this after ESOLVER returns;
c  phys_lift_restore_pending guards against accidental duplicate calls.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      real v(lx2,ly2,lz2,lelv)

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled, phys_uzawa_dirich_on
      integer phys_lift_restore_pending
      common /phys_cage_lift_state/ phys_lift_restore_pending

      integer e,i,j,k,ntot2
      integer fu
      real w,dv,tv,sw,sbefore2,starget2,safter2
      real rel_before,rel_after,eps
      logical first_call
      save first_call
      data first_call /.true./

      if (phys_uzawa_dirich_on.eq.0) return
      if (phys_lift_restore_pending.eq.0) return

      ntot2 = lx2*ly2*lz2*nelv
      eps = 1.0e-30
      if (stage12_virtual_p_on.eq.1) then
c        Re-project after Nek ORTHO and add the exact virtual lift.
         call stage12_project_m2(v)
         call add2(v,phi_cage_bc_scaled,ntot2)
         call stage12_constraint_error(v,s12_target_phi,
     $      stage12_constraint_rel)
         phys_lift_restore_pending=0
         if (stage12_constraint_rel.gt.1.0e-2) then
            if (nio.eq.0) write(6,'(A,E16.8)')
     $         'ERROR: STAGE12 restored C(dp) failed=',
     $         stage12_constraint_rel
            call exitt
         endif
         if (first_call .and. nio.eq.0) then
            write(6,'(A,E16.8)')
     $         'STAGE12 restored C(dp) relative error=',
     $         stage12_constraint_rel
            first_call=.false.
         endif
         return
      endif
      sw = 0.0
      sbefore2 = 0.0
      starget2 = 0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            w = bm2(i,j,k,e)
            dv = v(i,j,k,e)
            tv = phi_cage_bc_scaled(i,j,k,e)
            sw = sw + w
            sbefore2 = sbefore2 + w*(dv-tv)**2
            starget2 = starget2 + w*tv*tv
         endif
      enddo
      enddo
      enddo
      enddo
c     uzawa calls ortho(y) before this hook, which can put a constant
c     component back on the cage.  Re-project y_D=0 before adding lift.
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) v(i,j,k,e) = 0.0
      enddo
      enddo
      enddo
      enddo
      call add2(v, phi_cage_bc_scaled, ntot2)

      safter2 = 0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            w = bm2(i,j,k,e)
            dv = v(i,j,k,e)
            tv = phi_cage_bc_scaled(i,j,k,e)
            safter2 = safter2 + w*(dv-tv)**2
         endif
      enddo
      enddo
      enddo
      enddo

      sw       = glsum(sw,1)
      sbefore2 = glsum(sbefore2,1)
      starget2 = glsum(starget2,1)
      safter2  = glsum(safter2,1)
      rel_before = sqrt(sbefore2/max(starget2,eps))
      rel_after  = sqrt(safter2 /max(starget2,eps))

      phys_lift_restore_pending = 0

      return
      end

c=======================================================================
c  SEM/GLL <-> PHYSALIS TRANSFER AUDIT AND CORRECTION
c=======================================================================

c-----------------------------------------------------------------------
      subroutine zp_validation_config
      include 'SIZE'
      include 'TOTAL'
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      integer case_id
      common /physalis_2d_case_i/ case_id
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real sp_cons_reomega
      common /sp_cons_r/ sp_cons_reomega
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      logical initialized
      save initialized
      data initialized/.false./
      if (initialized) return
      call sp_conservation_config
      call validation_config

c     Benchmark problem: 51=current S&P/Mordant settling deck.
      zp_problem=51
      if (sp_cons_mode.eq.2) zp_problem=62
      if (case_id.eq.4) zp_problem=71
c     Highest retained Lamb/spherical-harmonic degree.
      zp_lmax=3
c     Particle motion: 0=fixed/prescribed, 1=integrated translation.
      zp_moving=1
      if (sp_cons_mode.eq.2) zp_moving=0
      if (case_id.eq.4) zp_moving=0
c     Validation-output stride in timesteps.
      zp_stride=10
c     Cage motion: 0=particle-concentric, 2=ZP shifted cage.
      zp_cage_mode=0
c     Imposed background velocity scale; zero in quiescent B.
      zp_flow=0.0
      if (case_id.eq.4) zp_flow=cfg_flow(3)
c     ZP periodic pressure parameter; unused in B.
      zp_pstar=0.0
c     ZP gravity parameter; nondimensional cfg_gz drives this B case.
      zp_gstar=0.0
c     Reference Reynolds number for audit only, never feedback.
      zp_target_re=1.0
      if (sp_cons_mode.eq.2) zp_target_re=sp_cons_reomega
      if (case_id.eq.4) zp_target_re=
     $ 2.0d0*cfg_radius*abs(zp_flow)*max(abs(param(1)),1.0d-30)
     $ /max(abs(param(2)),1.0d-30)
c     Particle offset [x,y,z]; zero in B.
      zp_poff(1)=0.0
      zp_poff(2)=0.0
      zp_poff(3)=0.0
c     Cage offset [x,y,z]; zero in B.
      zp_coff(1)=0.0
      zp_coff(2)=0.0
      zp_coff(3)=0.0

      if (.not.(zp_problem.eq.11 .or. zp_problem.eq.12 .or.
     $ zp_problem.eq.21 .or.
     $ zp_problem.eq.22 .or.
     $ (zp_problem.ge.31 .and. zp_problem.le.34) .or.
     $ zp_problem.eq.41 .or. zp_problem.eq.51 .or.
     $ zp_problem.eq.62 .or. zp_problem.eq.71)) then
         if (nid.eq.0) write(6,*) 'ERROR: bad zp_problem',zp_problem
         call exitt
      endif
      if (zp_lmax.lt.1 .or. zp_lmax.gt.4 .or.
     $    zp_stride.le.0) then
         if (nid.eq.0) write(6,*) 'ERROR: bad ZP lmax/stride'
         call exitt
      endif
      initialized=.true.
      return
      end
c-----------------------------------------------------------------------
      subroutine zp_get_cage_center(xp,yp,zp,a,cx,cy,cz)
c  OP3 permits independent particle/cage offsets.  OP4 reproduces the
c  Z&P standard-cage rule with nominal h=a/8.  Other cases use a cage
c  concentric with the particle.
      real xp,yp,zp,a,cx,cy,cz
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      real csx,csy,csz,h
      logical init
      save csx,csy,csz,init
      data init/.false./
      call zp_validation_config
      if (zp_problem.eq.41 .and. zp_cage_mode.eq.2) then
         h=a/8.0
         if (.not.init) then
            csx=xp
            csy=yp
            csz=zp
            init=.true.
         endif
  10     if (xp-csx.gt.0.5*h) then
            csx=csx+h
            goto 10
         endif
  20     if (xp-csx.lt.-0.5*h) then
            csx=csx-h
            goto 20
         endif
  30     if (yp-csy.gt.0.5*h) then
            csy=csy+h
            goto 30
         endif
  40     if (yp-csy.lt.-0.5*h) then
            csy=csy-h
            goto 40
         endif
  50     if (zp-csz.gt.0.5*h) then
            csz=csz+h
            goto 50
         endif
  60     if (zp-csz.lt.-0.5*h) then
            csz=csz-h
            goto 60
         endif
         cx=csx
         cy=csy
         cz=csz
      else
         cx=xp+zp_coff(1)
         cy=yp+zp_coff(2)
         cz=zp+zp_coff(3)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine zp_wrap_op4_particle
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real lz
      lz=sm_zmax-sm_zmin
      if (lz.le.0.0) return
  10  if (sm_z.lt.sm_zmin) then
         sm_z=sm_z+lz
         goto 10
      endif
  20  if (sm_z.ge.sm_zmax) then
         sm_z=sm_z-lz
         goto 20
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine zp_op1_exact_coeffs(pe,pi,fe,fi,ve,vi)
c  Z&P Table 2.  Their axisymmetric Legendre coefficients A,C,E are
c  converted to the normalized Y_n^0 convention used by Candidate B:
c  coefficient_CB=coefficient_ZP/sqrt((2n+1)/(4*pi)).
      real pe(4,5),pi(4,5),fe(4,5),fi(4,5)
      real ve(4,5),vi(4,5),pi0,norm,zval
      integer n,m
      pi0=4.0*atan(1.0)
      do n=1,4
      do m=1,5
         pe(n,m)=0.0
         pi(n,m)=0.0
         fe(n,m)=0.0
         fi(n,m)=0.0
         ve(n,m)=0.0
         vi(n,m)=0.0
      enddo
      enddo
      do n=1,3
         if (n.eq.1) zval=0.5
         if (n.eq.2) zval=0.125
         if (n.eq.3) zval=0.03125
         norm=sqrt(float(2*n+1)/(4.0*pi0))
         pe(n,1)=zval/norm
         fe(n,1)=zval/norm
         ve(n,1)=zval/norm
      enddo
      return
      end
c-----------------------------------------------------------------------
      subroutine zp_op1_exact_velocity(xg,yg,zg,ux,uy,uz)
      include 'SIZE'
      include 'TOTAL'
      real xg,yg,zg,ux,uy,uz
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real pe_ex(4,5),pim_ex(4,5),fe_ex(4,5),fi_ex(4,5)
      real ve_ex(4,5),vi_ex(4,5)
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5),p_ro(4,5),p_io(4,5)
      real f_ro(4,5),f_io(4,5),v_ro(4,5),v_io(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_ro,p_io,f_ro,f_io,v_ro,v_io
      real vsave_re(4,5),vsave_im(4,5),dxp,dyp,dzp,rmag,nu
      integer n,m
      call validation_config
      call zp_op1_exact_coeffs(pe_ex,pim_ex,fe_ex,fi_ex,
     $ ve_ex,vi_ex)
      dxp=xg-cfg_center(1)
      dyp=yg-cfg_center(2)
      dzp=zg-cfg_center(3)
      rmag=sqrt(dxp*dxp+dyp*dyp+dzp*dzp)
      ux=0.0
      uy=0.0
      uz=0.0
      if (rmag.lt.cfg_radius) return
      do n=1,4
      do m=1,5
         vsave_re(n,m)=v_re(n,m)
         vsave_im(n,m)=v_im(n,m)
         v_re(n,m)=ve_ex(n,m)
         v_im(n,m)=vi_ex(n,m)
      enddo
      enddo
      nu=abs(param(2))
      call physalis_lamb_vel_at_point(dxp,dyp,dzp,rmag,
     $ cfg_radius,nu,pe_ex,pim_ex,fe_ex,fi_ex,4,ux,uy,uz)
      do n=1,4
      do m=1,5
         v_re(n,m)=vsave_re(n,m)
         v_im(n,m)=vsave_im(n,m)
      enddo
      enddo
      return
      end
      subroutine zp_write_run_metadata
      include 'SIZE'
      include 'TOTAL'
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real phys_tol_a,phys_tol_w
      common /physalis_particle_tols/ phys_tol_a,phys_tol_w
      integer short_test_id
      common /short_test_i/ short_test_id
      integer fu,pressure_frame_mode
      parameter(fu=99)
      if (nid.ne.0) return
      pressure_frame_mode=0
      if (zp_problem.ge.31 .and. zp_problem.le.34 .and.
     $    zp_moving.eq.0) pressure_frame_mode=1
      if (zp_moving.eq.1) pressure_frame_mode=2
      open(fu,file='zp_run_metadata.txt',status='replace')
      write(fu,'(A,I8)') 'zp_problem: ',zp_problem
      write(fu,'(A,I8)') 'lmax: ',zp_lmax
      write(fu,'(A,I8)') 'moving_particle: ',zp_moving
      write(fu,'(A,I8)')
     $ 'pressure_frame_mode_0none_1fixedP_2movingAccel: ',
     $ pressure_frame_mode
      write(fu,'(A,I8)') 'output_stride: ',zp_stride
      write(fu,'(A,I8)') 'cage_mode: ',zp_cage_mode
      write(fu,'(A,E16.8)') 'flow_speed: ',zp_flow
      write(fu,'(A,E16.8)') 'Pstar: ',zp_pstar
      write(fu,'(A,E16.8)') 'gravity_star: ',zp_gstar
      write(fu,'(A,E16.8)') 'target_Re: ',zp_target_re
      write(fu,'(A,3E16.8)') 'particle_offset: ',zp_poff
      write(fu,'(A,3E16.8)') 'cage_offset: ',zp_coff
      write(fu,'(A,I8)') 'SEM_polynomial_order: ',lx1-1
      write(fu,'(A,I12)') 'global_elements: ',nelgt
      write(fu,'(A,E16.8)') 'rho_f: ',param(1)
      write(fu,'(A,E16.8)') 'mu_dynamic: ',abs(param(2))
      write(fu,'(A,E16.8)') 'nu_kinematic: ',
     $ abs(param(2))/max(abs(param(1)),1.0d-30)
      write(fu,'(A)')
     $ 'master_core: SPB common local-FDM V20'
      write(fu,'(A,I8)') 'short_test_id: ',short_test_id
      write(fu,'(A,E16.8)') 'r_sample_over_a: ',r_sample_over_a
      write(fu,'(A,E16.8)') 'coefficient_tolerance: ',
     $ phys_tol_coeff
      write(fu,'(A,E16.8)') 'particle_accel_tolerance: ',phys_tol_a
      write(fu,'(A,E16.8)') 'particle_velocity_tolerance: ',phys_tol_w
      write(fu,'(A,E16.8)') 'velocity_cage_gate_tolerance: ',5.0e-3
      close(fu)
      return
      end


      subroutine physalis_write_gate_summary(kused,accepted,ibc,iba,
     $ ibw,ibvel,ibp,ibdiv,rc,ra,rw,rv,rp,rd)
      include 'SIZE'
      include 'TOTAL'
      integer kused,accepted,ibc,iba,ibw,ibvel,ibp,ibdiv
      real rc,ra,rw,rv,rp,rd
      integer fu
      parameter(fu=79)
      logical first
      save first
      data first/.true./
      if (nid.eq.0) then
         if (first) then
            open(fu,file='physalis_gate_summary.dat',
     $           status='replace')
            write(fu,'(A)') '# step time k accepted block_coeff '//
     $       'block_a block_w block_vel block_p block_div '//
     $       'coeff a w cage p div'
            first=.false.
         else
            open(fu,file='physalis_gate_summary.dat',
     $           status='old',position='append')
         endif
         write(fu,*) istep,time,kused,accepted,ibc,iba,ibw,ibvel,
     $      ibp,ibdiv,rc,ra,rw,rv,rp,rd
         close(fu)
      endif
      return
      end

c=======================================================================
c  Restored from the known-working Nek_physalis_2d_moving set.usr
c  Required symbol: physalis_axisym_reset_cage_defect
c=======================================================================
      subroutine physalis_axisym_reset_cage_defect
c  Reset the 2D axisymmetric velocity-cage defect correction at the
c  beginning of each physical time step.  The correction is not a
c  Physalis parameter: it is a projection-defect compensation for the
c  Helmholtz Dirichlet value.  The desired final projected velocity is
c  still the unmodified Lamb+rigid velocity.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      real u_def(lx1,ly1,lz1,lelv)
      real v_def(lx1,ly1,lz1,lelv)
      real w_def(lx1,ly1,lz1,lelv)
      common /phys_axisym_cage_def/ u_def,v_def,w_def

      integer ntot1

      ntot1=lx1*ly1*lz1*nelv
      call rzero(u_def,ntot1)
      call rzero(v_def,ntot1)
      call rzero(w_def,ntot1)

      return
      end

c=======================================================================
c  Restored from the known-working Nek_physalis_2d_moving set.usr
c  Required symbol: physalis_projection_restore_audit
c=======================================================================
      subroutine physalis_projection_restore_audit(stage,inner_k)
c  Direct A/B measurement around post-projection mask release.
c
c  stage = 0 : immediately after constrained PLAN3 projection
c  stage = 1 : immediately after mask release; velocity is unchanged
c
c  Pressure-grid divergence is split into exterior fluid, cage, and
c  particle-interior regions.  Velocity maxima are split on the GLL grid.
c  hold_mismatch is the velocity change that a restore would apply on the
c  union of cage and inside nodes (zero, to roundoff, after the restore).
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      integer stage,inner_k
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      real divf(lx2,ly2,lz2,lelv)
      real audit_dsum(4),wsum(4),dmax(4),dl2(4)
      real audit_umax(4),audit_div2,audit_wt
      real audit_u2,audit_umag,audit_du2,audit_dumag
      real mis_sum,mis_w,mis_max,mis_l2,cfl_proxy,eps
      integer e,i,j,k,n,ireg,f,axis_elem
      integer fu
      parameter(fu=88)
      logical first_call
      save first_call
      data first_call /.true./

c     Node-level forensic dump (Step 1 of the R=0 pole-mismatch audit).
c     One file per rank, gated to every 500 steps to keep size sane.
c     For each cage/inside node: element+ijk id, physical (R,z),
c     particle-relative (r/a,theta_deg), region, BC target vs actual
c     velocity (M1) or local divergence (M2), GLL/axisym mass weight,
c     and whether the owning element has a true axis (R=0, BC='A')
c     face -- that distinguishes "near R=0" from "actually an axis
c     element", which matters for diagnosing a pole/axis conflict.
      logical node_dump_on
      integer fu2,fu3
      parameter(fu2=85,fu3=91)
      character*40 fname2,fname3
      logical first_dump
      save first_dump
      data first_dump /.true./
      real drx,dry,drz,rho_ax,rr,theta,pi_local

      pi_local=4.0*atan(1.0)
      node_dump_on = (mod(istep,500).eq.0)
      if (node_dump_on) then
         write(fname2,'(A,I5.5,A)') 'physalis_cage_node_vel_r',
     $      nid,'.dat'
         write(fname3,'(A,I5.5,A)') 'physalis_cage_node_p_r',
     $      nid,'.dat'
         if (first_dump) then
            open(fu2,file=fname2,status='replace')
            write(fu2,'(A)') '# step inner stage e i j k R z ' //
     $       'r_over_a theta_deg region axis_elem bm1 ' //
     $       'u_bc v_bc w_bc vx vy vz du dv dw'
            close(fu2)
            open(fu3,file=fname3,status='replace')
            write(fu3,'(A)') '# step inner stage e i j k R z ' //
     $       'r_over_a theta_deg region axis_elem bm2 divf'
            close(fu3)
            first_dump=.false.
         endif
         open(fu2,file=fname2,status='old',position='append')
         open(fu3,file=fname3,status='old',position='append')
      endif

      eps=1.0e-30
      do n=1,4
         audit_dsum(n)=0.0
         wsum(n)=0.0
         dmax(n)=0.0
         audit_umax(n)=0.0
      enddo
      mis_sum=0.0
      mis_w=0.0
      mis_max=0.0

c     Region indices: 1=all, 2=exterior fluid, 3=cage, 4=inside.
      call opdiv(divf,vx,vy,vz)
      do e=1,nelv
         axis_elem=0
         do f=1,2*ldim
            if (cbc(f,e,1)(1:1).eq.'A' .or.
     $          cbc(f,e,1)(1:1).eq.'a') axis_elem=1
         enddo
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         audit_div2=divf(i,j,k,e)*divf(i,j,k,e)
         audit_wt=bm2(i,j,k,e)
         audit_dsum(1)=audit_dsum(1)+audit_wt*audit_div2
         wsum(1)=wsum(1)+audit_wt
         dmax(1)=max(dmax(1),abs(divf(i,j,k,e)))
         ireg=2
         if (mask_inside_p(i,j,k,e).eq.1) then
            ireg=4
         elseif (mask_cage_p(i,j,k,e).eq.1) then
            ireg=3
         endif
         audit_dsum(ireg)=audit_dsum(ireg)+audit_wt*audit_div2
         wsum(ireg)=wsum(ireg)+audit_wt
         dmax(ireg)=max(dmax(ireg),abs(divf(i,j,k,e)))
         if (node_dump_on .and. (ireg.eq.3 .or. ireg.eq.4)) then
            if (ldim.eq.2) then
               drx=ym2(i,j,k,e)-phys_xp
               dry=0.0-phys_yp
               drz=xm2(i,j,k,e)-phys_zp
            else
               drx=xm2(i,j,k,e)-phys_xp
               dry=ym2(i,j,k,e)-phys_yp
               drz=zm2(i,j,k,e)-phys_zp
            endif
            rho_ax=sqrt(drx*drx+dry*dry)
            rr=sqrt(rho_ax*rho_ax+drz*drz)
            theta=atan2(rho_ax,drz)*180.0/pi_local
            write(fu3,'(I8,1X,I4,1X,I2,1X,4I6,1X,4E14.6,1X,I2,
     $         1X,I2,1X,2E16.8)')
     $         istep,inner_k,stage,e,i,j,k,ym2(i,j,k,e),
     $         xm2(i,j,k,e),rr/max(phys_a,1.0e-30),theta,
     $         ireg,axis_elem,bm2(i,j,k,e),divf(i,j,k,e)
         endif
      enddo
      enddo
      enddo
      enddo

      do e=1,nelv
         axis_elem=0
         do f=1,2*ldim
            if (cbc(f,e,1)(1:1).eq.'A' .or.
     $          cbc(f,e,1)(1:1).eq.'a') axis_elem=1
         enddo
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (ldim.eq.2) then
            audit_u2=vx(i,j,k,e)**2+vy(i,j,k,e)**2
            if (sp_cons_mode.eq.2)
     $         audit_u2=audit_u2+vz(i,j,k,e)**2
         else
            audit_u2=vx(i,j,k,e)**2+vy(i,j,k,e)**2+
     $         vz(i,j,k,e)**2
         endif
         audit_umag=sqrt(audit_u2)
         audit_umax(1)=max(audit_umax(1),audit_umag)
         ireg=2
         if (mask_inside_u(i,j,k,e).eq.1) then
            ireg=4
         elseif (mask_cage_u(i,j,k,e).eq.1) then
            ireg=3
         endif
         audit_umax(ireg)=max(audit_umax(ireg),audit_umag)
         if (ireg.eq.3 .or. ireg.eq.4) then
            if (ldim.eq.2) then
               audit_du2=
     $            (vx(i,j,k,e)-u_bc_cage(i,j,k,e))**2+
     $            (vy(i,j,k,e)-v_bc_cage(i,j,k,e))**2
               if (sp_cons_mode.eq.2) audit_du2=audit_du2+
     $            (vz(i,j,k,e)-w_bc_cage(i,j,k,e))**2
            else
               audit_du2=
     $            (vx(i,j,k,e)-u_bc_cage(i,j,k,e))**2+
     $            (vy(i,j,k,e)-v_bc_cage(i,j,k,e))**2+
     $            (vz(i,j,k,e)-w_bc_cage(i,j,k,e))**2
            endif
            audit_dumag=sqrt(audit_du2)
            mis_sum=mis_sum+bm1(i,j,k,e)*audit_du2
            mis_w=mis_w+bm1(i,j,k,e)
            mis_max=max(mis_max,audit_dumag)
            if (node_dump_on) then
               if (ldim.eq.2) then
                  drx=ym1(i,j,k,e)-phys_xp
                  dry=0.0-phys_yp
                  drz=xm1(i,j,k,e)-phys_zp
               else
                  drx=xm1(i,j,k,e)-phys_xp
                  dry=ym1(i,j,k,e)-phys_yp
                  drz=zm1(i,j,k,e)-phys_zp
               endif
               rho_ax=sqrt(drx*drx+dry*dry)
               rr=sqrt(rho_ax*rho_ax+drz*drz)
               theta=atan2(rho_ax,drz)*180.0/pi_local
               write(fu2,'(I8,1X,I4,1X,I2,1X,4I6,1X,4E14.6,1X,I2,
     $            1X,I2,1X,10E16.8)')
     $            istep,inner_k,stage,e,i,j,k,ym1(i,j,k,e),
     $            xm1(i,j,k,e),rr/max(phys_a,1.0e-30),theta,
     $            ireg,axis_elem,bm1(i,j,k,e),
     $            u_bc_cage(i,j,k,e),v_bc_cage(i,j,k,e),
     $            w_bc_cage(i,j,k,e),vx(i,j,k,e),vy(i,j,k,e),
     $            vz(i,j,k,e),
     $            vx(i,j,k,e)-u_bc_cage(i,j,k,e),
     $            vy(i,j,k,e)-v_bc_cage(i,j,k,e),
     $            vz(i,j,k,e)-w_bc_cage(i,j,k,e)
            endif
         endif
      enddo
      enddo
      enddo
      enddo

      if (node_dump_on) then
         close(fu2)
         close(fu3)
      endif

      do n=1,4
         audit_dsum(n)=glsum(audit_dsum(n),1)
         wsum(n)=glsum(wsum(n),1)
         dmax(n)=glmax(dmax(n),1)
         audit_umax(n)=glmax(audit_umax(n),1)
         dl2(n)=sqrt(audit_dsum(n)/max(wsum(n),eps))
      enddo
      mis_sum=glsum(mis_sum,1)
      mis_w=glsum(mis_w,1)
      mis_max=glmax(mis_max,1)
      mis_l2=sqrt(mis_sum/max(mis_w,eps))
      cfl_proxy=0.0
      if (h_gll_min.gt.eps) cfl_proxy=audit_umax(1)*dt/h_gll_min

      if (nid.eq.0) then
         if (first_call) then
            open(fu,file='physalis_projection_restore_audit.dat',
     $           status='replace')
            write(fu,'(A)')
     $       '# stage: 0=POST_CONSTRAINED_PLAN3 ' //
     $       '1=POST_MASK_RELEASE; inner=0 normal'
            write(fu,'(A)')
     $       '# step time dt inner stage divL2_all divInf_all ' //
     $       'divL2_fluid divInf_fluid divL2_cage divInf_cage ' //
     $       'divL2_inside divInf_inside umax_all umax_fluid ' //
     $       'umax_cage umax_inside hold_mismatch_L2 ' //
     $       'hold_mismatch_Linf cfl_proxy'
            first_call=.false.
         else
            open(fu,file='physalis_projection_restore_audit.dat',
     $           status='old',position='append')
         endif
         write(fu,*) istep,time,dt,inner_k,stage,
     $      dl2(1),dmax(1),dl2(2),dmax(2),dl2(3),dmax(3),
     $      dl2(4),dmax(4),audit_umax(1),audit_umax(2),
     $      audit_umax(3),audit_umax(4),
     $      mis_l2,mis_max,cfl_proxy
         close(fu)
      endif

      return
      end

c=======================================================================
c  Restored from the known-working Nek_physalis_2d_moving set.usr
c  Required symbol: physalis_axisym_update_cage_defect
c=======================================================================
      subroutine physalis_axisym_update_cage_defect
c  Defect-correct the next 2D axisymmetric Helmholtz Dirichlet target.
c
c  Nek imposes the cage velocity strongly in the Helmholtz solve, but the
c  subsequent pressure projection can move the final velocity away from
c  that target.  Let
c       base   = Lamb + rigid velocity,
c       defect = current pre-compensation,
c       target = base + defect,
c       slip   = final projected velocity - base.
c  The next replay uses defect <- defect - slip, so the Helmholtz solve
c  is pre-compensated for the projection displacement.
c
c  NORMAL-ONLY variant (ported unchanged from 2d_normal_defect_
c  correction / 2d_uniform_pcage_normal_defect): projects the measured
c  slip onto the LOCAL cage-outward-normal direction and corrects only
c  that scalar component.  Combined here with the TARGET-THETA
c  pressure cage (physalis_axisym_uniform_pcage_filter's target-angle
c  reconstruction, not the plain bin filter) to test whether the two
c  corrections stack better on top of the more principled pressure-
c  cage reconstruction than they did on the simpler bin-based one
c  (Case A: 1.36%->0.70%; target-theta alone: 0.86%).
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage

      real u_def(lx1,ly1,lz1,lelv)
      real v_def(lx1,ly1,lz1,lelv)
      real w_def(lx1,ly1,lz1,lelv)
      common /phys_axisym_cage_def/ u_def,v_def,w_def

      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      real phys_a
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      real baseu,basev,basew,slipu,slipv,slipw
      real axis_r_cut,alpha_def,def_cap,mag,fac
      real drx,dry,drz,rr,n_axial,n_radial,slip_n
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      integer e,i,j,k

      if (ldim.ne.2) return

      axis_r_cut=h_gll_mean
      alpha_def=0.1875
      def_cap=0.05*max(abs(sm_vt),1.0e-10)
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_cage_u(i,j,k,e).ne.1) cycle

         baseu = u_bc_cage(i,j,k,e) - u_def(i,j,k,e)
         basev = v_bc_cage(i,j,k,e) - v_def(i,j,k,e)
         slipu = vx(i,j,k,e) - baseu
         slipv = vy(i,j,k,e) - basev

c        Local cage-outward-normal direction from the particle center
c        to this node, in the SAME (drx=radial,dry,drz=axial)
c        convention physalis_reconstruct_velocity_cage itself uses.
         drx = ym1(i,j,k,e) - phys_xp
         dry = 0.0 - phys_yp
         drz = xm1(i,j,k,e) - phys_zp
         rr  = sqrt(drx*drx+dry*dry+drz*drz)
         n_axial  = drz/max(rr,1.0e-30)
         n_radial = drx/max(rr,1.0e-30)

c        Scalar slip along the normal only; tangential slip is left
c        uncorrected.
         slip_n = slipu*n_axial + slipv*n_radial

         u_def(i,j,k,e) = (1.0-alpha_def)*u_def(i,j,k,e)
     $      - alpha_def*slip_n*n_axial
         v_def(i,j,k,e) = (1.0-alpha_def)*v_def(i,j,k,e)
     $      - alpha_def*slip_n*n_radial

c        Keep the symmetry-axis regularity condition exact.
         if (ym1(i,j,k,e).lt.axis_r_cut)
     $      v_def(i,j,k,e) = 0.0

         if (sp_cons_mode.eq.2) then
            basew = w_bc_cage(i,j,k,e) - w_def(i,j,k,e)
            slipw = vz(i,j,k,e) - basew
            w_def(i,j,k,e) = (1.0-alpha_def)*w_def(i,j,k,e)
     $         - alpha_def*slipw
         else
            w_def(i,j,k,e) = 0.0
         endif

c        Bound the correction so it cannot become a second prescribed
c        velocity scale.  It may compensate projection loss, but it must
c        remain small compared with the terminal-speed scale.
         mag=sqrt(u_def(i,j,k,e)**2+v_def(i,j,k,e)**2+
     $            w_def(i,j,k,e)**2)
         if (mag.gt.def_cap) then
            fac=def_cap/max(mag,1.0e-30)
            u_def(i,j,k,e)=fac*u_def(i,j,k,e)
            v_def(i,j,k,e)=fac*v_def(i,j,k,e)
            w_def(i,j,k,e)=fac*w_def(i,j,k,e)
         endif
      enddo
      enddo
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_stage13_coeff_norms(pr,pi,fr,fi,vr,vi,
     $ cr,ci,gr,gi,wr,wi,luse,rnorm,cnorm)
      real pr(4,5),pi(4,5),fr(4,5),fi(4,5),vr(4,5),vi(4,5)
      real cr(4,5),ci(4,5),gr(4,5),gi(4,5),wr(4,5),wi(4,5)
      integer luse,n,m
      real rnorm,cnorm,rs,cs
      rs=0.0
      cs=0.0
      do n=1,luse
      do m=1,n+1
         rs=rs+pr(n,m)**2+pi(n,m)**2+
     $      fr(n,m)**2+fi(n,m)**2+
     $      vr(n,m)**2+vi(n,m)**2
         cs=cs+cr(n,m)**2+ci(n,m)**2+
     $      gr(n,m)**2+gi(n,m)**2+
     $      wr(n,m)**2+wi(n,m)**2
      enddo
      enddo
      rnorm=sqrt(max(rs,0.0))
      cnorm=sqrt(max(cs,0.0))
      return
      end
c-----------------------------------------------------------------------
      subroutine stage13_write_accept_diag
c  STAGE16 writer: use residuals copied at the actual convergence point.
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      real s16_acc_coeff,s16_acc_cage,s16_acc_p,s16_acc_div
      real s16_def_rms,s16_def_max
      integer s16_acc_inner
      common /stage16_accept_r/ s16_acc_coeff,s16_acc_cage,
     $ s16_acc_p,s16_acc_div,s16_def_rms,s16_def_max
      common /stage16_accept_i/ s16_acc_inner
      integer fu
      parameter(fu=76)
      logical first
      save first
      data first/.true./

      if (nid.ne.0) return
      if (first) then
         open(fu,file='stage16_accept_diag.dat',status='replace')
         write(fu,'(A)') '# step time inner coeff cage p div Fz '//
     $      'def_rms def_max s12_abs s12_target s12_rel s12_warn'
         first=.false.
      else
         open(fu,file='stage16_accept_diag.dat',
     $      status='old',position='append')
      endif
      write(fu,*) istep,time,s16_acc_inner,s16_acc_coeff,
     $ s16_acc_cage,s16_acc_p,s16_acc_div,F_phys(3),
     $ s16_def_rms,s16_def_max,
     $ stage12_constraint_abs,stage12_constraint_target,
     $ stage12_constraint_rel,stage12_constraint_warn_count
      close(fu)
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_stage16_defect_norms(def_rms,def_max)
      include 'SIZE'
      include 'TOTAL'
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      real u_def(lx1,ly1,lz1,lelv)
      real v_def(lx1,ly1,lz1,lelv)
      real w_def(lx1,ly1,lz1,lelv)
      common /phys_axisym_cage_def/ u_def,v_def,w_def
      real def_rms,def_max,sumd,cnt,mag
      integer e,i,j,k
      sumd=0.0
      cnt=0.0
      def_max=0.0
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_cage_u(i,j,k,e).eq.1) then
            mag=sqrt(u_def(i,j,k,e)**2+
     $               v_def(i,j,k,e)**2+
     $               w_def(i,j,k,e)**2)
            sumd=sumd+mag*mag
            def_max=max(def_max,mag)
            cnt=cnt+1.0
         endif
      enddo
      enddo
      enddo
      enddo
      sumd=glsum(sumd,1)
      cnt=glsum(cnt,1)
      def_max=glmax(def_max,1)
      def_rms=sqrt(sumd/max(cnt,1.0))
      return
      end
c-----------------------------------------------------------------------
c  STAGE22: pressure-cage constrained GMRES support
c
c  The Physalis pressure cage supplies an inhomogeneous Dirichlet value
c  for the pressure correction.  We use the affine decomposition
c
c       dp = lift + y,       y_D = 0
c
c  and solve the reduced system
c
c       P A P y = P (rhs - A lift)
c
c  where P zeros the pressure-cage DOFs.  The private Nek core calls
c  stage22_pressure_project() inside UZAWA_GMRES so every Krylov vector
c  remains in the homogeneous constrained space.
c-----------------------------------------------------------------------
      subroutine stage22_pressure_rhs_ortho(v)
      include 'SIZE'
      include 'TOTAL'
      real v(lx2,ly2,lz2,lelv)

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

c     A pressure cage removes the constant-pressure null vector from
c     the reduced problem.  Therefore do not apply Nek's free-pressure
c     ORTHO projection to this RHS.  If no cage exists, retain stock Nek.
      if (n_cage_p_g.gt.0) return
      call ortho(v)

      return
      end
c-----------------------------------------------------------------------
      subroutine stage22_pressure_rhs_lift(rhs,h1,h2,h2inv,intype)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      real rhs(lx2,ly2,lz2,lelv)
      real h1(lx1,ly1,lz1,lelv)
      real h2(lx1,ly1,lz1,lelv)
      real h2inv(lx1,ly1,lz1,lelv)
      integer intype

      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on
      integer phys_lift_restore_pending
      common /phys_cage_lift_state/ phys_lift_restore_pending

      real s22_lift(lx2,ly2,lz2,lelv)
      real s22_alift(lx2,ly2,lz2,lelv)
      common /stage22_pscr/ s22_lift,s22_alift

      integer ntot2
      logical first_call
      save first_call
      data first_call /.true./

      if (phys_uzawa_dirich_on.eq.0) return

      ntot2=lx2*ly2*lz2*nelv
      call copy(s22_lift,phi_cage_bc_scaled,ntot2)
      call cdabdtp(s22_alift,s22_lift,h1,h2,h2inv,intype)

c     Build homogeneous constrained RHS: P*(rhs-A*lift).
      call add2s2(rhs,s22_alift,-1.0,ntot2)
      call stage22_pressure_project(rhs)
      phys_lift_restore_pending=1

      if (first_call .and. nio.eq.0) then
         write(6,*) 'STAGE22 PRESSURE: P*A*P projected GMRES'
         write(6,*) 'STAGE22 PRESSURE: affine cage lift active'
         first_call=.false.
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine stage22_pressure_project(v)
      include 'SIZE'
      include 'TOTAL'
      include 'STAGE12'

      real v(lx2,ly2,lz2,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on

      integer e,i,j,k

      if (phys_uzawa_dirich_on.eq.0) return

      if (stage12_virtual_p_on.eq.1) then
         call stage12_project_m2(v)
         return
      endif

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) v(i,j,k,e)=0.0
      enddo
      enddo
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine stage22_pressure_gmres_finalize(v)
      include 'SIZE'
      include 'TOTAL'

      real v(lx2,ly2,lz2,lelv)
      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on

c     With cage Dirichlet constraints the pressure nullspace is removed.
c     Do not call ORTHO here because it adds a constant to cage DOFs.
      if (phys_uzawa_dirich_on.eq.1) then
         call stage22_pressure_project(v)
      else
         call ortho(v)
      endif

      return
      end
c-----------------------------------------------------------------------

c=======================================================================
c  STAGE23: SP-primary / Nek-specific pressure-interior mapping test.
c
c  The cage geometry is generated by Stage9 mode 2:
c    velocity: exterior endpoint of a GLL graph edge crossing r=a
c    pressure: interior endpoint of a PN-2 graph edge crossing r=a
c
c  Unlike Stage22, ALL pressure DOFs with r<a are removed from the
c  homogeneous GMRES unknown space.  Only the closed pressure-cage
c  layer receives the inhomogeneous Lamb pressure-correction lift.
c  This is a Nek-specific candidate for the SP pressure/interior role,
c  not a claim of a literal staggered-grid SP discretization.
c=======================================================================
      subroutine stage23_control_check
      include 'SIZE'
      include 'TOTAL'
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on
      logical st23_first
      save st23_first
      data st23_first /.true./

      if (stage23_active.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE24: Stage23 operator inactive'
         call exitt
      endif
      if (stage23_freeze.ne.0) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE24: Stage23 freeze must be zero'
         call exitt
      endif
      if (stage23_interior_on.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE24: interior treatment inactive'
         call exitt
      endif
      if (stage23_lift_on.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE24: pressure-cage lift inactive'
         call exitt
      endif

      if (st23_first .and. nid.eq.0) then
         write(6,'(A,4I4)')
     $    'STAGE24 BASE stage23 active/freeze/int/lift=',
     $    stage23_active,stage23_freeze,
     $    stage23_interior_on,stage23_lift_on
         st23_first=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage24_control_check
      include 'SIZE'
      include 'TOTAL'
      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved
      integer st24_eu,st24_ep
      parameter(st24_eu=1)
      parameter(st24_ep=1)
      logical st24_first
      save st24_first
      data st24_first /.true./

      if (stage24_active.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE24: active COMMON is not 1'
         call exitt
      endif
      if (stage24_udyn.ne.st24_eu) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE24: Udynamic COMMON mismatch'
         call exitt
      endif
      if (stage24_pdyn.ne.st24_ep) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE24: Pdynamic COMMON mismatch'
         call exitt
      endif
      if (st24_first .and. nid.eq.0) then
         write(6,'(A,3I4)')
     $    'STAGE24 CONTROL active/Udyn/Pdyn=',
     $    stage24_active,stage24_udyn,stage24_pdyn
         st24_first=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage24_save_reference_cages
      include 'SIZE'
      include 'TOTAL'
      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage
      real st24_uref(lx1,ly1,lz1,lelv)
      real st24_vref(lx1,ly1,lz1,lelv)
      real st24_wref(lx1,ly1,lz1,lelv)
      real st24_pref(lx2,ly2,lz2,lelv)
      common /stage24_ref_u/ st24_uref,st24_vref,st24_wref
      common /stage24_ref_p/ st24_pref
      integer st24_nt1,st24_nt2

      if (stage24_active.ne.1) return
      if (stage24_ref_saved.eq.1) return
      st24_nt1=lx1*ly1*lz1*nelv
      st24_nt2=lx2*ly2*lz2*nelv
      call copy(st24_uref,u_bc_cage,st24_nt1)
      call copy(st24_vref,v_bc_cage,st24_nt1)
      call copy(st24_wref,w_bc_cage,st24_nt1)
      call copy(st24_pref,p_bc_cage,st24_nt2)
      stage24_ref_saved=1
      if (nid.eq.0) write(6,*)
     $   'STAGE24 REFERENCE CAGES: SAVED'
      return
      end
c-----------------------------------------------------------------------
      subroutine stage24_apply_target_mode
      include 'SIZE'
      include 'TOTAL'
      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage
      real st24_uref(lx1,ly1,lz1,lelv)
      real st24_vref(lx1,ly1,lz1,lelv)
      real st24_wref(lx1,ly1,lz1,lelv)
      real st24_pref(lx2,ly2,lz2,lelv)
      common /stage24_ref_u/ st24_uref,st24_vref,st24_wref
      common /stage24_ref_p/ st24_pref
      integer st24_nt1,st24_nt2

      if (stage24_active.ne.1) return
      if (stage24_ref_saved.ne.1) then
         if (istep.gt.0) then
            if (nid.eq.0) write(6,*)
     $         'FATAL STAGE24: reference cages not saved'
            call exitt
         endif
         return
      endif
      st24_nt1=lx1*ly1*lz1*nelv
      st24_nt2=lx2*ly2*lz2*nelv
      if (stage24_udyn.eq.0) then
         call copy(u_bc_cage,st24_uref,st24_nt1)
         call copy(v_bc_cage,st24_vref,st24_nt1)
         call copy(w_bc_cage,st24_wref,st24_nt1)
      endif
      if (stage24_pdyn.eq.0)
     $   call copy(p_bc_cage,st24_pref,st24_nt2)
      return
      end
c-----------------------------------------------------------------------
      subroutine stage24_write_dynamic_diag
      include 'SIZE'
      include 'TOTAL'
      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage
      real st24_uref(lx1,ly1,lz1,lelv)
      real st24_vref(lx1,ly1,lz1,lelv)
      real st24_wref(lx1,ly1,lz1,lelv)
      real st24_pref(lx2,ly2,lz2,lelv)
      common /stage24_ref_u/ st24_uref,st24_vref,st24_wref
      common /stage24_ref_p/ st24_pref
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      integer e,i,j,k,st24_fu
      real st24_su,st24_sp,st24_cu,st24_cp
      real st24_du,st24_dv,st24_dw,st24_dp
      logical st24_first
      save st24_first
      data st24_first /.true./

      if (stage24_active.ne.1) return
      if (istep.gt.10 .and. mod(istep,100).ne.0) return
      if (stage24_ref_saved.ne.1) return
      st24_su=0.0
      st24_sp=0.0
      st24_cu=0.0
      st24_cp=0.0
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         if (mask_cage_u(i,j,k,e).eq.1) then
            st24_du=u_bc_cage(i,j,k,e)-st24_uref(i,j,k,e)
            st24_dv=v_bc_cage(i,j,k,e)-st24_vref(i,j,k,e)
            st24_dw=w_bc_cage(i,j,k,e)-st24_wref(i,j,k,e)
            st24_su=st24_su+st24_du*st24_du
     $         +st24_dv*st24_dv+st24_dw*st24_dw
            st24_cu=st24_cu+1.0
         endif
      enddo
      enddo
      enddo
      enddo
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st24_dp=p_bc_cage(i,j,k,e)-st24_pref(i,j,k,e)
            st24_sp=st24_sp+st24_dp*st24_dp
            st24_cp=st24_cp+1.0
         endif
      enddo
      enddo
      enddo
      enddo
      st24_su=glsum(st24_su,1)
      st24_sp=glsum(st24_sp,1)
      st24_cu=glsum(st24_cu,1)
      st24_cp=glsum(st24_cp,1)
      st24_su=sqrt(st24_su/max(st24_cu,1.0))
      st24_sp=sqrt(st24_sp/max(st24_cp,1.0))

      if (nid.eq.0) then
         st24_fu=92
         if (st24_first) then
            open(st24_fu,file='stage24_dynamic_diag.dat',
     $           status='replace')
            write(st24_fu,'(A)')
     $ '# step time Udyn Pdyn dUtarget dPtarget coeff cageU cageP div'
            st24_first=.false.
         else
            open(st24_fu,file='stage24_dynamic_diag.dat',
     $           status='old',position='append')
         endif
         write(st24_fu,'(I10,1X,1PE16.8,2I4,6E16.8)')
     $      istep,time,stage24_udyn,stage24_pdyn,
     $      st24_su,st24_sp,coeff_resid,cage_vel_res,
     $      pressure_cage_res,div_norm
         close(st24_fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage25_control_check
      include 'SIZE'
      include 'TOTAL'
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      integer st25_expect
      parameter(st25_expect=2)
      real stage6_p3_scale,stage6_phi3_scale
      real stage6_p4_scale,stage6_phi4_scale
      common /stage6_ctl_r/ stage6_p3_scale,stage6_phi3_scale,
     $ stage6_p4_scale,stage6_phi4_scale
      integer stage6_radial_clamp
      common /stage6_ctl_i/ stage6_radial_clamp
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      logical st25_first
      save st25_first
      data st25_first /.true./

      if (stage25_active.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: pressure-reference audit inactive'
         call exitt
      endif
      if (stage25_pref_mode.ne.st25_expect) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: pressure-reference mode mismatch'
         call exitt
      endif
      if (lmax.ne.3) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: expected lmax=3'
         call exitt
      endif
      if (stage6_radial_clamp.ne.0) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: radial clamp must be zero'
         call exitt
      endif
      if (abs(stage6_p3_scale-1.0).gt.1.0e-12 .or.
     $    abs(stage6_phi3_scale-1.0).gt.1.0e-12) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: n=3 pressure scaling changed'
         call exitt
      endif

      if (st25_first .and. nid.eq.0) then
         write(6,'(A,I4)')
     $      'STAGE25 CONTROL pressure-reference mode=',stage25_pref_mode
         write(6,*) 'STAGE25 U/P FEEDBACK: BOTH DYNAMIC'
         write(6,*) 'STAGE25 SP-NEK INTERIOR/LIFT: ON'
         st25_first=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage25_store_qmean(pmean)
      real pmean
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      real stage25_qmean,stage25_pref_q,stage25_pref_fit
      real stage25_pref_cur,stage25_shape_mean,stage25_shift_mean
      real stage25_pref_used
      common /stage25_ref_r/ stage25_qmean,stage25_pref_q,
     $ stage25_pref_fit,stage25_pref_cur,stage25_shape_mean,
     $ stage25_shift_mean,stage25_pref_used

      if (stage25_active.ne.1) return
      stage25_qmean=pmean
      stage25_qvalid=1
      return
      end
c-----------------------------------------------------------------------
      subroutine stage25_select_pressure_reference(pref)
      include 'SIZE'
      include 'TOTAL'
      real pref
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      real stage25_qmean,stage25_pref_q,stage25_pref_fit
      real stage25_pref_cur,stage25_shape_mean,stage25_shift_mean
      real stage25_pref_used
      common /stage25_ref_r/ stage25_qmean,stage25_pref_q,
     $ stage25_pref_fit,stage25_pref_cur,stage25_shape_mean,
     $ stage25_shift_mean,stage25_pref_used
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      integer e,i,j,k
      real st25_x,st25_y,st25_z,st25_r
      real st25_shape,st25_shift,st25_w
      real st25_sw,st25_spr,st25_ssh,st25_ssf,st25_sfit
      real st25_eps

      if (stage25_active.ne.1) return
      if (stage25_qvalid.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: Lebedev pressure mean unavailable'
         call exitt
      endif

      st25_eps=1.0e-30
      st25_sw=0.0
      st25_spr=0.0
      st25_ssh=0.0
      st25_ssf=0.0
      st25_sfit=0.0

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            if (ldim.eq.2) then
               st25_x=ym2(i,j,k,e)-phys_xp
               st25_y=0.0-phys_yp
               st25_z=xm2(i,j,k,e)-phys_zp
            else
               st25_x=xm2(i,j,k,e)-phys_xp
               st25_y=ym2(i,j,k,e)-phys_yp
               st25_z=zm2(i,j,k,e)-phys_zp
            endif
            st25_r=sqrt(st25_x*st25_x+st25_y*st25_y+
     $                   st25_z*st25_z)
            call physalis_lamb_pressure_at_point(
     $         st25_x,st25_y,st25_z,st25_r,phys_a,
     $         p_re,p_im,phi_re,phi_im,lmax,st25_shape)
            call physalis_sp_pressure_frame_shift(
     $         st25_x,st25_y,st25_z,st25_shift)
            st25_w=bm2(i,j,k,e)
            st25_sw=st25_sw+st25_w
            st25_spr=st25_spr+st25_w*pr(i,j,k,e)
            st25_ssh=st25_ssh+st25_w*st25_shape
            st25_ssf=st25_ssf+st25_w*st25_shift
            st25_sfit=st25_sfit+st25_w*
     $         (pr(i,j,k,e)-st25_shape-st25_shift)
         endif
      enddo
      enddo
      enddo
      enddo

      st25_sw=glsum(st25_sw,1)
      st25_spr=glsum(st25_spr,1)
      st25_ssh=glsum(st25_ssh,1)
      st25_ssf=glsum(st25_ssf,1)
      st25_sfit=glsum(st25_sfit,1)

      if (st25_sw.le.st25_eps) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: empty pressure cage'
         call exitt
      endif

      stage25_pref_q=stage25_qmean
      stage25_pref_cur=st25_spr/st25_sw
      stage25_pref_fit=st25_sfit/st25_sw
      stage25_shape_mean=st25_ssh/st25_sw
      stage25_shift_mean=st25_ssf/st25_sw

      if (stage25_pref_mode.eq.1) then
         pref=stage25_pref_q
      elseif (stage25_pref_mode.eq.2) then
         pref=stage25_pref_fit
      elseif (stage25_pref_mode.eq.3) then
         pref=stage25_pref_cur
      elseif (stage25_pref_mode.eq.4) then
         pref=0.0
      else
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE25: invalid pressure-reference mode'
         call exitt
      endif
      stage25_pref_used=pref

      call stage25_write_reference_diag
      return
      end
c-----------------------------------------------------------------------
      subroutine stage25_write_reference_diag
      include 'SIZE'
      include 'TOTAL'
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      real stage25_qmean,stage25_pref_q,stage25_pref_fit
      real stage25_pref_cur,stage25_shape_mean,stage25_shift_mean
      real stage25_pref_used
      common /stage25_ref_r/ stage25_qmean,stage25_pref_q,
     $ stage25_pref_fit,stage25_pref_cur,stage25_shape_mean,
     $ stage25_shift_mean,stage25_pref_used
      integer st25_last,st25_fu
      save st25_last
      data st25_last /-999999/

      if (stage25_active.ne.1) return
      if (istep.eq.st25_last) return
      if (istep.gt.10 .and. mod(istep,100).ne.0) return
      st25_last=istep

      if (nid.eq.0) then
         st25_fu=95
         if (istep.le.0) then
            open(st25_fu,file='stage25_pressure_ref_diag.dat',
     $           status='replace')
            write(st25_fu,'(A)')
     $ '# step time mode qmean cageMean cageFit shapeMean shift used'
         else
            open(st25_fu,file='stage25_pressure_ref_diag.dat',
     $           status='unknown',position='append')
         endif
         write(st25_fu,'(I10,1X,1PE16.8,I4,6E16.8)')
     $      istep,time,stage25_pref_mode,stage25_qmean,
     $      stage25_pref_cur,stage25_pref_fit,
     $      stage25_shape_mean,stage25_shift_mean,
     $      stage25_pref_used
         close(st25_fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage25_pressure_predictor_diag(up,pbc)
      include 'SIZE'
      include 'TOTAL'
      real up(lx2,ly2,lz2,lelv)
      real pbc(lx2,ly2,lz2,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      real stage25_qmean,stage25_pref_q,stage25_pref_fit
      real stage25_pref_cur,stage25_shape_mean,stage25_shift_mean
      real stage25_pref_used
      common /stage25_ref_r/ stage25_qmean,stage25_pref_q,
     $ stage25_pref_fit,stage25_pref_cur,stage25_shape_mean,
     $ stage25_shift_mean,stage25_pref_used
      integer e,i,j,k,st25_last,st25_fu
      real st25_sw,st25_su,st25_sb,st25_sd,st25_sd2
      real st25_w,st25_d
      save st25_last
      data st25_last /-999999/

      if (stage25_active.ne.1) return
      if (istep.eq.st25_last) return
      if (istep.gt.10 .and. mod(istep,100).ne.0) return
      st25_last=istep

      st25_sw=0.0
      st25_su=0.0
      st25_sb=0.0
      st25_sd=0.0
      st25_sd2=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st25_w=bm2(i,j,k,e)
            st25_d=pbc(i,j,k,e)-up(i,j,k,e)
            st25_sw=st25_sw+st25_w
            st25_su=st25_su+st25_w*up(i,j,k,e)
            st25_sb=st25_sb+st25_w*pbc(i,j,k,e)
            st25_sd=st25_sd+st25_w*st25_d
            st25_sd2=st25_sd2+st25_w*st25_d*st25_d
         endif
      enddo
      enddo
      enddo
      enddo
      st25_sw=glsum(st25_sw,1)
      st25_su=glsum(st25_su,1)
      st25_sb=glsum(st25_sb,1)
      st25_sd=glsum(st25_sd,1)
      st25_sd2=glsum(st25_sd2,1)

      if (st25_sw.le.1.0e-30) return
      if (nid.eq.0) then
         st25_fu=96
         if (istep.le.1) then
            open(st25_fu,file='stage25_predictor_diag.dat',
     $           status='replace')
            write(st25_fu,'(A)')
     $ '# step time mode meanPredict meanTarget meanDelta rmsDelta pref'
         else
            open(st25_fu,file='stage25_predictor_diag.dat',
     $           status='unknown',position='append')
         endif
         write(st25_fu,'(I10,1X,1PE16.8,I4,5E16.8)')
     $      istep,time,stage25_pref_mode,
     $      st25_su/st25_sw,st25_sb/st25_sw,
     $      st25_sd/st25_sw,sqrt(st25_sd2/st25_sw),
     $      stage25_pref_used
         close(st25_fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage26_control_check
      include 'SIZE'
      include 'TOTAL'
      integer stage26_active,stage26_meanfree
      common /stage26_ctl_i/ stage26_active,stage26_meanfree
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on
      integer stage24_active,stage24_udyn,stage24_pdyn
      integer stage24_ref_saved
      common /stage24_ctl_i/ stage24_active,stage24_udyn,
     $ stage24_pdyn,stage24_ref_saved
      logical st26_first
      save st26_first
      data st26_first /.true./

      if (stage26_active.ne.1 .or. stage26_meanfree.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE27: mean-free pressure correction inactive'
         call exitt
      endif
      if (stage23_active.ne.1 .or. stage23_freeze.ne.0 .or.
     $    stage23_interior_on.ne.1 .or.
     $    stage23_lift_on.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE27: Stage23 pressure base changed'
         call exitt
      endif
      if (stage24_active.ne.1 .or. stage24_udyn.ne.1 .or.
     $    stage24_pdyn.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE27: full dynamic U/P feedback required'
         call exitt
      endif

      if (st26_first .and. nid.eq.0) then
         write(6,*) 'STAGE27 MEAN-FREE PRESSURE CORE: ACTIVE'
         st26_first=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage26_write_meanfree_diag(rawmean,mfmean,
     $ rawrms,mfrms,pmean,upmean,phirms)
      include 'SIZE'
      include 'TOTAL'
      real rawmean,mfmean,rawrms,mfrms,pmean,upmean,phirms
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      integer st26_last,st26_fu
      save st26_last
      data st26_last /-999999/

      if (istep.eq.st26_last) return
      if (istep.gt.10 .and. mod(istep,100).ne.0) return
      st26_last=istep

      if (nid.eq.0) then
         st26_fu=94
         if (istep.le.1) then
            open(st26_fu,file='stage26_meanfree_diag.dat',
     $           status='replace')
            write(st26_fu,'(A)')
     $ '# step time ref rawMean mfMean rawRms mfRms pMean upMean phiRms'
         else
            open(st26_fu,file='stage26_meanfree_diag.dat',
     $           status='unknown',position='append')
         endif
         write(st26_fu,'(I10,1X,1PE16.8,I4,7E16.8)')
     $      istep,time,stage25_pref_mode,
     $      rawmean,mfmean,rawrms,mfrms,pmean,upmean,phirms
         close(st26_fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage26_write_postsolve_diag
      include 'SIZE'
      include 'TOTAL'
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_p/ p_bc_cage
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      integer stage26_active,stage26_meanfree
      common /stage26_ctl_i/ stage26_active,stage26_meanfree
      integer e,i,j,k,st26_fu
      real st26_w,st26_sw,st26_spr,st26_spb
      real st26_mpr,st26_mpb,st26_raw2,st26_gf2
      real st26_denraw,st26_dengf,st26_r,st26_g
      real st26_prf,st26_pbf,st26_rawres,st26_gfres
      real st26_eps

      if (stage26_active.ne.1) return
      if (istep.ne.1 .and. mod(istep,100).ne.0) return

      st26_eps=1.0e-30
      st26_sw=0.0
      st26_spr=0.0
      st26_spb=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st26_w=bm2(i,j,k,e)
            st26_sw=st26_sw+st26_w
            st26_spr=st26_spr+st26_w*pr(i,j,k,e)
            st26_spb=st26_spb+st26_w*p_bc_cage(i,j,k,e)
         endif
      enddo
      enddo
      enddo
      enddo
      st26_sw=glsum(st26_sw,1)
      st26_spr=glsum(st26_spr,1)
      st26_spb=glsum(st26_spb,1)
      if (st26_sw.le.st26_eps) return
      st26_mpr=st26_spr/st26_sw
      st26_mpb=st26_spb/st26_sw

      st26_raw2=0.0
      st26_gf2=0.0
      st26_denraw=0.0
      st26_dengf=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st26_w=bm2(i,j,k,e)
            st26_r=pr(i,j,k,e)-p_bc_cage(i,j,k,e)
            st26_prf=pr(i,j,k,e)-st26_mpr
            st26_pbf=p_bc_cage(i,j,k,e)-st26_mpb
            st26_g=st26_prf-st26_pbf
            st26_raw2=st26_raw2+st26_w*st26_r*st26_r
            st26_gf2=st26_gf2+st26_w*st26_g*st26_g
            st26_denraw=st26_denraw+st26_w*
     $         max(pr(i,j,k,e)**2,p_bc_cage(i,j,k,e)**2)
            st26_dengf=st26_dengf+st26_w*st26_pbf*st26_pbf
         endif
      enddo
      enddo
      enddo
      enddo
      st26_raw2=glsum(st26_raw2,1)
      st26_gf2=glsum(st26_gf2,1)
      st26_denraw=glsum(st26_denraw,1)
      st26_dengf=glsum(st26_dengf,1)
      st26_rawres=sqrt(st26_raw2/max(st26_denraw,st26_eps))
      st26_gfres=sqrt(st26_gf2/max(st26_dengf,st26_eps))

      if (nid.eq.0) then
         st26_fu=93
         if (istep.eq.1) then
            open(st26_fu,file='stage26_postsolve_diag.dat',
     $           status='replace')
            write(st26_fu,'(A)')
     $ '# step time ref meanPr meanPbc rawRes gaugeFreeRes'
         else
            open(st26_fu,file='stage26_postsolve_diag.dat',
     $           status='old',position='append')
         endif
         write(st26_fu,'(I10,1X,1PE16.8,I4,4E16.8)')
     $      istep,time,stage25_pref_mode,st26_mpr,st26_mpb,
     $      st26_rawres,st26_gfres
         close(st26_fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage27_control_check
      include 'SIZE'
      include 'TOTAL'
      integer stage27_active,stage27_pnmax
      common /stage27_ctl_i/ stage27_active,stage27_pnmax
      integer stage25_active,stage25_pref_mode,stage25_qvalid
      common /stage25_ctl_i/ stage25_active,stage25_pref_mode,
     $ stage25_qvalid
      integer st27_expect
      parameter(st27_expect=3)
      logical st27_first
      save st27_first
      data st27_first /.true./

      if (stage27_active.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE27: control inactive'
         call exitt
      endif
      if (stage27_pnmax.ne.st27_expect) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE27: pressure pnmax mismatch'
         call exitt
      endif
      if (stage27_pnmax.lt.0 .or. stage27_pnmax.gt.3) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE27: pressure pnmax outside 0:3'
         call exitt
      endif
      if (stage25_active.ne.0) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE27: Stage25 reference path still active'
         call exitt
      endif

      if (st27_first .and. nid.eq.0) then
         write(6,'(A,I4)')
     $      'STAGE27 CONTROL pressure-cage pnmax=',stage27_pnmax
         write(6,*) 'STAGE27 ABSOLUTE PRESSURE REFERENCE: REMOVED'
         write(6,*) 'STAGE27 VELOCITY/EXTRACTION LMAX: 3'
         st27_first=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage27_write_meanfree_diag(rawmean,mfmean,
     $ rawrms,mfrms,pmean,upmean,phirms)
      include 'SIZE'
      include 'TOTAL'
      real rawmean,mfmean,rawrms,mfrms,pmean,upmean,phirms
      integer stage27_active,stage27_pnmax
      common /stage27_ctl_i/ stage27_active,stage27_pnmax
