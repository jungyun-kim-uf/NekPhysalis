      save st27_last
      data st27_last /-999999/

      if (stage27_active.ne.1) return
      if (istep.eq.st27_last) return
      if (istep.gt.10 .and. mod(istep,100).ne.0) return
      st27_last=istep

      if (nid.eq.0) then
         st27_fu=94
         if (istep.le.1) then
            open(st27_fu,file='stage27_meanfree_diag.dat',
     $           status='replace')
            write(st27_fu,'(A)')
     $ '# step time pnmax rawMean mfMean rawRms mfRms pMean upMean phi'
         else
            open(st27_fu,file='stage27_meanfree_diag.dat',
     $           status='unknown',position='append')
         endif
         write(st27_fu,'(I10,1X,1PE16.8,I4,7E16.8)')
     $      istep,time,stage27_pnmax,
     $      rawmean,mfmean,rawrms,mfrms,pmean,upmean,phirms
         close(st27_fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage27_write_postsolve_diag
      include 'SIZE'
      include 'TOTAL'
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_p/ p_bc_cage
      integer stage27_active,stage27_pnmax
      common /stage27_ctl_i/ stage27_active,stage27_pnmax
      integer e,i,j,k,st27_fu
      real st27_w,st27_sw,st27_spr,st27_spb
      real st27_mpr,st27_mpb,st27_raw2,st27_gf2
      real st27_denraw,st27_dengf,st27_r,st27_g
      real st27_prf,st27_pbf,st27_rawres,st27_gfres
      real st27_eps

      if (stage27_active.ne.1) return
      if (istep.ne.1 .and. mod(istep,100).ne.0) return

      st27_eps=1.0e-30
      st27_sw=0.0
      st27_spr=0.0
      st27_spb=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st27_w=bm2(i,j,k,e)
            st27_sw=st27_sw+st27_w
            st27_spr=st27_spr+st27_w*pr(i,j,k,e)
            st27_spb=st27_spb+st27_w*p_bc_cage(i,j,k,e)
         endif
      enddo
      enddo
      enddo
      enddo
      st27_sw=glsum(st27_sw,1)
      st27_spr=glsum(st27_spr,1)
      st27_spb=glsum(st27_spb,1)
      if (st27_sw.le.st27_eps) return
      st27_mpr=st27_spr/st27_sw
      st27_mpb=st27_spb/st27_sw

      st27_raw2=0.0
      st27_gf2=0.0
      st27_denraw=0.0
      st27_dengf=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st27_w=bm2(i,j,k,e)
            st27_r=pr(i,j,k,e)-p_bc_cage(i,j,k,e)
            st27_prf=pr(i,j,k,e)-st27_mpr
            st27_pbf=p_bc_cage(i,j,k,e)-st27_mpb
            st27_g=st27_prf-st27_pbf
            st27_raw2=st27_raw2+st27_w*st27_r*st27_r
            st27_gf2=st27_gf2+st27_w*st27_g*st27_g
            st27_denraw=st27_denraw+st27_w*
     $         max(pr(i,j,k,e)**2,p_bc_cage(i,j,k,e)**2)
            st27_dengf=st27_dengf+st27_w*st27_pbf*st27_pbf
         endif
      enddo
      enddo
      enddo
      enddo
      st27_raw2=glsum(st27_raw2,1)
      st27_gf2=glsum(st27_gf2,1)
      st27_denraw=glsum(st27_denraw,1)
      st27_dengf=glsum(st27_dengf,1)
      st27_rawres=sqrt(st27_raw2/max(st27_denraw,st27_eps))
      st27_gfres=sqrt(st27_gf2/max(st27_dengf,st27_eps))

      if (nid.eq.0) then
         st27_fu=93
         if (istep.eq.1) then
            open(st27_fu,file='stage27_postsolve_diag.dat',
     $           status='replace')
            write(st27_fu,'(A)')
     $ '# step time pnmax meanPr meanPbc rawRes gaugeFreeRes'
         else
            open(st27_fu,file='stage27_postsolve_diag.dat',
     $           status='old',position='append')
         endif
         write(st27_fu,'(I10,1X,1PE16.8,I4,4E16.8)')
     $      istep,time,stage27_pnmax,st27_mpr,st27_mpb,
     $      st27_rawres,st27_gfres
         close(st27_fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage23_pressure_target(dp,up,scaledt)
      include 'SIZE'
      include 'TOTAL'
      real dp(lx2,ly2,lz2,lelv)
      real up(lx2,ly2,lz2,lelv)
      real scaledt
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      common /physalis_bc_p/ p_bc_cage
      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on
      integer phys_lift_restore_pending
      common /phys_cage_lift_state/ phys_lift_restore_pending
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on
      integer stage26_active,stage26_meanfree
      common /stage26_ctl_i/ stage26_active,stage26_meanfree
      integer e,i,j,k,ntot2,nc_l,nc_g
      real pbc,rawdel,delp,st23_s2,st23_d2
      real st23_cnt,st23_maxd
      real st27_sw,st27_sraw,st27_rawmean
      real st27_raw2,st27_mf2,st27_smf
      real st27_spbc,st27_sup,st27_ph2
      real st27_rawrms,st27_mfrms,st27_mfmean
      real st27_pmean,st27_upmean,st27_phirms
      real st27_w
      logical first_call
      save first_call
      data first_call /.true./

      phys_uzawa_dirich_on=0
      phys_lift_restore_pending=0
      if (stage23_active.ne.1) return
      if (stage23_interior_on.eq.0 .and.
     $    stage23_lift_on.eq.0) return

      phys_uzawa_dirich_on=1
      ntot2=lx2*ly2*lz2*nelv
      call rzero(phi_cage_bc_scaled,ntot2)

      if (stage23_lift_on.eq.0) then
         if (first_call .and. nid.eq.0) then
            write(6,*) 'STAGE27 PRESSURE: interior-only projection'
            first_call=.false.
         endif
         return
      endif

c     Direct gauge-neutral cage correction:
c        rawdel = p_bc - up
c        delp   = rawdel - <rawdel>_bm2
c     No absolute pressure reference enters the Nek pressure lift.
      st27_sw=0.0
      st27_sraw=0.0
      st27_raw2=0.0
      st27_spbc=0.0
      st27_sup=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st27_w=bm2(i,j,k,e)
            rawdel=p_bc_cage(i,j,k,e)-up(i,j,k,e)
            st27_sw=st27_sw+st27_w
            st27_sraw=st27_sraw+st27_w*rawdel
            st27_raw2=st27_raw2+st27_w*rawdel*rawdel
            st27_spbc=st27_spbc+st27_w*p_bc_cage(i,j,k,e)
            st27_sup=st27_sup+st27_w*up(i,j,k,e)
         endif
      enddo
      enddo
      enddo
      enddo
      st27_sw=glsum(st27_sw,1)
      st27_sraw=glsum(st27_sraw,1)
      st27_raw2=glsum(st27_raw2,1)
      st27_spbc=glsum(st27_spbc,1)
      st27_sup=glsum(st27_sup,1)

      if (st27_sw.le.1.0e-30) then
         if (nid.eq.0) write(6,*) 'FATAL STAGE27: empty pressure cage'
         call exitt
      endif

      st27_rawmean=st27_sraw/st27_sw
      st27_rawrms=sqrt(st27_raw2/st27_sw)
      st27_pmean=st27_spbc/st27_sw
      st27_upmean=st27_sup/st27_sw

      nc_l=0
      st23_s2=0.0
      st23_d2=0.0
      st23_cnt=0.0
      st23_maxd=0.0
      st27_mf2=0.0
      st27_smf=0.0
      st27_ph2=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_cage_p(i,j,k,e).eq.1) then
            st27_w=bm2(i,j,k,e)
            pbc=p_bc_cage(i,j,k,e)
            rawdel=pbc-up(i,j,k,e)
            delp=rawdel
            if (stage26_active.eq.1 .and.
     $          stage26_meanfree.eq.1)
     $         delp=rawdel-st27_rawmean
            phi_cage_bc_scaled(i,j,k,e)=delp*scaledt
            st23_s2=st23_s2+st27_w*pbc*pbc
            st23_d2=st23_d2+st27_w*delp*delp
            st23_cnt=st23_cnt+st27_w
            st23_maxd=max(st23_maxd,abs(delp))
            st27_mf2=st27_mf2+st27_w*delp*delp
            st27_smf=st27_smf+st27_w*delp
            st27_ph2=st27_ph2+st27_w*
     $         phi_cage_bc_scaled(i,j,k,e)**2
            nc_l=nc_l+1
         endif
      enddo
      enddo
      enddo
      enddo

      nc_g=iglsum(nc_l,1)
      if (nc_g.le.0) then
         if (nid.eq.0) write(6,*)
     $      'ERROR STAGE27: empty pressure cage'
         call exitt
      endif

      st23_s2=glsum(st23_s2,1)
      st23_d2=glsum(st23_d2,1)
      st23_cnt=glsum(st23_cnt,1)
      st23_maxd=glmax(st23_maxd,1)
      st27_mf2=glsum(st27_mf2,1)
      st27_smf=glsum(st27_smf,1)
      st27_ph2=glsum(st27_ph2,1)

      st27_mfmean=st27_smf/st27_sw
      st27_mfrms=sqrt(st27_mf2/st27_sw)
      st27_phirms=sqrt(st27_ph2/st27_sw)
      call stage27_write_meanfree_diag(st27_rawmean,st27_mfmean,
     $ st27_rawrms,st27_mfrms,st27_pmean,st27_upmean,
     $ st27_phirms)

      if (first_call .and. nid.eq.0) then
         write(6,*) 'STAGE27 PRESSURE: DIRECT MEAN-FREE SHAPE'
         write(6,'(A,4E16.8)')
     $      'STAGE27 first rawMean/mfMean/rawRms/mfRms=',
     $      st27_rawmean,st27_mfmean,st27_rawrms,st27_mfrms
         write(6,'(A,I8,3E16.8)')
     $      'STAGE27 P target n,rmsP,rmsD,maxD=',nc_g,
     $      sqrt(st23_s2/max(st23_cnt,1.0e-30)),
     $      sqrt(st23_d2/max(st23_cnt,1.0e-30)),st23_maxd
         first_call=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage23_pressure_project(v)
      include 'SIZE'
      include 'TOTAL'
      real v(lx2,ly2,lz2,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on
      integer e,i,j,k

      if (phys_uzawa_dirich_on.eq.0) return
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
c        STAGE33C independent pressure-space projection.
         if (stage23_interior_on.eq.1) then
            if (mask_inside_p(i,j,k,e).eq.1)
     $         v(i,j,k,e)=0.0
         endif
         if (stage23_lift_on.eq.1) then
            if (mask_cage_p(i,j,k,e).eq.1)
     $         v(i,j,k,e)=0.0
         endif
      enddo
      enddo
      enddo
      enddo
      return
      end
c-----------------------------------------------------------------------
      subroutine stage23_pressure_rhs_ortho(v)
      include 'SIZE'
      include 'TOTAL'
      real v(lx2,ly2,lz2,lelv)
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on

      if (stage23_active.eq.1 .and.
     $   (stage23_interior_on.eq.1 .or.
     $    stage23_lift_on.eq.1)) return
      call ortho(v)
      return
      end
c-----------------------------------------------------------------------
      subroutine stage23_pressure_rhs_lift(rhs,h1,h2,h2inv,intype)
      include 'SIZE'
      include 'TOTAL'
      real rhs(lx2,ly2,lz2,lelv)
      real h1(lx1,ly1,lz1,lelv)
      real h2(lx1,ly1,lz1,lelv)
      real h2inv(lx1,ly1,lz1,lelv)
      integer intype
      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on
      integer phys_lift_restore_pending
      common /phys_cage_lift_state/ phys_lift_restore_pending
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on
      real s23_lift(lx2,ly2,lz2,lelv)
      real s23_alift(lx2,ly2,lz2,lelv)
      common /stage23_pscr/ s23_lift,s23_alift
      integer ntot2
      logical first_call
      save first_call
      data first_call /.true./

      if (phys_uzawa_dirich_on.eq.0) return
      ntot2=lx2*ly2*lz2*nelv
      if (stage23_lift_on.eq.1) then
         call copy(s23_lift,phi_cage_bc_scaled,ntot2)
         call cdabdtp(s23_alift,s23_lift,h1,h2,h2inv,intype)
         call stage35bq_lift_pre(rhs,s23_lift,s23_alift)
         call add2s2(rhs,s23_alift,-1.0,ntot2)
      endif
      call stage23_pressure_project(rhs)
      call stage35bq_lift_post(rhs)
      phys_lift_restore_pending=1

      if (first_call .and. nid.eq.0) then
         write(6,'(A,2I4)')
     $    'STAGE23 PRESSURE int/lift=',stage23_interior_on,
     $    stage23_lift_on
         first_call=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage23_pressure_restore(v)
      include 'SIZE'
      include 'TOTAL'
      real v(lx2,ly2,lz2,lelv)
      real phi_cage_bc_scaled(lx2,ly2,lz2,lelv)
      integer phys_uzawa_dirich_on
      common /phys_cage_phi_bc/ phi_cage_bc_scaled,
     $ phys_uzawa_dirich_on
      integer phys_lift_restore_pending
      common /phys_cage_lift_state/ phys_lift_restore_pending
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on
      integer ntot2

      if (phys_uzawa_dirich_on.eq.0) return
      if (phys_lift_restore_pending.eq.0) return
      ntot2=lx2*ly2*lz2*nelv
      call stage23_pressure_project(v)
      if (stage23_lift_on.eq.1)
     $   call add2(v,phi_cage_bc_scaled,ntot2)
      phys_lift_restore_pending=0
      return
      end
c-----------------------------------------------------------------------
      subroutine stage23_pressure_gmres_finalize(v)
      include 'SIZE'
      include 'TOTAL'
      real v(lx2,ly2,lz2,lelv)
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on

      if (stage23_active.eq.1 .and.
     $   (stage23_interior_on.eq.1 .or.
     $    stage23_lift_on.eq.1)) then
         call stage23_pressure_project(v)
      else
         call ortho(v)
      endif
      return
      end
c-----------------------------------------------------------------------

      subroutine stage23_operator_audit(h1,h2,h2inv,intype)
      include 'SIZE'
      include 'TOTAL'

      real h1(lx1,ly1,lz1,lelv)
      real h2(lx1,ly1,lz1,lelv)
      real h2inv(lx1,ly1,lz1,lelv)
      integer intype

      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real pin(lx2,ly2,lz2,lelv)
      real ain(lx2,ly2,lz2,lelv)
      real ptmp(lx2,ly2,lz2,lelv)
      real atmp(lx2,ly2,lz2,lelv)
      common /stage23_audscr/ pin,ain,ptmp,atmp

      integer e,i,j,k,ntot2,ni_l,ne_l,nc_l,nu_l
      integer ni_g,ne_g,nc_g,nu_g,fu
      real nfull,next,nint,nred
      logical done
      save done
      data done /.false./

      if (done) return
      done=.true.

      ntot2=lx2*ly2*lz2*nelv
      call rzero(pin,ntot2)
      ni_l=0
      ne_l=0
      nc_l=0
      nu_l=0

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         if (mask_inside_p(i,j,k,e).eq.1) ni_l=ni_l+1
         if (mask_cage_p(i,j,k,e).eq.1) nc_l=nc_l+1
         if (mask_inside_p(i,j,k,e).eq.1 .or.
     $       mask_cage_p(i,j,k,e).eq.1) then
            pin(i,j,k,e)=1.0
            nu_l=nu_l+1
         else
            ne_l=ne_l+1
         endif
      enddo
      enddo
      enddo
      enddo

c     STAGE33C Schur action on the removed pressure-space union.
      call cdabdtp(ain,pin,h1,h2,h2inv,intype)
      nfull=0.0
      next=0.0
      nint=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         nfull=nfull+bm2(i,j,k,e)*ain(i,j,k,e)**2
         if (mask_inside_p(i,j,k,e).eq.1 .or.
     $       mask_cage_p(i,j,k,e).eq.1) then
            nint=nint+bm2(i,j,k,e)*ain(i,j,k,e)**2
         else
            next=next+bm2(i,j,k,e)*ain(i,j,k,e)**2
         endif
      enddo
      enddo
      enddo
      enddo

      nfull=sqrt(max(glsum(nfull,1),0.0))
      next=sqrt(max(glsum(next,1),0.0))
      nint=sqrt(max(glsum(nint,1),0.0))

c     Verify reduced space eliminates interior U pressure cage.
      call copy(ptmp,pin,ntot2)
      call stage23_pressure_project(ptmp)
      call cdabdtp(atmp,ptmp,h1,h2,h2inv,intype)
      call stage23_pressure_project(atmp)
      nred=glsc2(atmp,atmp,ntot2)
      nred=sqrt(max(nred,0.0))

      ni_g=iglsum(ni_l,1)
      ne_g=iglsum(ne_l,1)
      nc_g=iglsum(nc_l,1)
      nu_g=iglsum(nu_l,1)

      if (nid.eq.0) then
         fu=96
         open(fu,file='stage23_operator_audit.dat',
     $        status='replace')
         write(fu,'(A)')
     $    '# n_inside n_exterior n_pcage n_removed'
         write(fu,'(A)')
     $    '# full ext removed ext/full reduced'
         write(fu,*) ni_g,ne_g,nc_g,nu_g,nfull,next,nint,
     $      next/max(nfull,1.0e-30),nred
         close(fu)
         write(6,'(A,4I9)')
     $    'STAGE33C P inside/ext/cage/removed=',
     $    ni_g,ne_g,nc_g,nu_g
         write(6,'(A,4E16.8)')
     $    'STAGE33C A(Premoved) full/ext/extfrac/reduced=',
     $    nfull,next,next/max(nfull,1.0e-30),nred
      endif

      return
      end
c-----------------------------------------------------------------------

c-----------------------------------------------------------------------
      subroutine stage23_mapping_audit
      include 'SIZE'
      include 'TOTAL'

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      real delta_p_cage_local,delta_p_lift_local
      common /stage33c_pwidth_r/ delta_p_cage_local,
     $ delta_p_lift_local

      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer fu
      real ugap
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      if (stage23_active.ne.1) return
      ugap=(r_sample_over_a-max_ru_over_a)*phys_a/
     $ max(h_gll_mean,1.0e-30)

      if (nid.eq.0) then
         fu=95
         open(fu,file='stage23_mapping_audit.dat',
     $        status='replace')
         write(fu,'(A)')
     $ '# inside_u cage_u inside_p cage_p rumin rumax rpmin rpmax'
         write(fu,'(A)')
     $ '# humin humean hpmin hpmean q_over_a qgap_over_hmean'
         write(fu,*) n_inside_u_g,n_cage_u_g,
     $      n_inside_p_g,n_cage_p_g,
     $      min_ru_over_a,max_ru_over_a,
     $      min_rp_over_a,max_rp_over_a,
     $      h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $      r_sample_over_a,ugap
         close(fu)
         write(6,'(A,4I9)')
     $    'STAGE23 MAP Uin/Ucage/Pin/Pcage=',
     $    n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
         write(6,'(A,4E16.8)')
     $    'STAGE23 MAP Umin/Umax/Pmin/Pmax=',
     $    min_ru_over_a,max_ru_over_a,
     $    min_rp_over_a,max_rp_over_a
         write(6,'(A,2E16.8)')
     $    'STAGE23 MAP q/a,q-gap/hmean=',
     $    r_sample_over_a,ugap
         fu=94
         open(fu,file='stage33c_width_audit.dat',
     $        status='replace')
         write(fu,'(A)')
     $    '# delta_p_cage/a delta_p_lift/a hpmean/a'
         write(fu,*) delta_p_cage_local/max(phys_a,1.0e-30),
     $      delta_p_lift_local/max(phys_a,1.0e-30),
     $      h_p_mean/max(phys_a,1.0e-30)
         close(fu)
         write(6,'(A,2E16.8)')
     $    'STAGE33C P cage/lift widths over a=',
     $    delta_p_cage_local/max(phys_a,1.0e-30),
     $    delta_p_lift_local/max(phys_a,1.0e-30)
      endif

      return
      end
c-----------------------------------------------------------------------

c-----------------------------------------------------------------------
      subroutine stage34_local_diagnostics
c  STAGE34 read-only local-field dump for subsequent BF comparison.
c  Checkpoints: t=.2,.4,.6,.8 for dt=2e-6 (steps 100000 multiples).
c  No field, coefficient, mask, or boundary target is modified here.
      include 'SIZE'
      include 'TOTAL'

      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d
      real U_lab_l(nleb,3),p_lab_l(nleb)
      common /phys_leb_fields/ U_lab_l,p_lab_l
      real u_til_l(nleb,3),p_til_l(nleb)
      common /phys_tilde/ u_til_l,p_til_l

      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p

      real u_bc_cage(lx1,ly1,lz1,lelv)
      real v_bc_cage(lx1,ly1,lz1,lelv)
      real w_bc_cage(lx1,ly1,lz1,lelv)
      real p_bc_cage(lx2,ly2,lz2,lelv)
      common /physalis_bc_u/ u_bc_cage,v_bc_cage,w_bc_cage
      common /physalis_bc_p/ p_bc_cage

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      real z34rf,z34mu,z34nu,z34ep,z34rs,z34rx,z34ry,z34rz,z34rr
      real z34ux,z34uy,z34uz,z34pl,z34rq,z34ra,z34xa
      real z34nr,z34lr,z34na,z34la
      real z34sw,z34sp,z34sb,z34mp,z34mb,z34wt
      real z34xr,z34yr,z34r0,z34pg,z34bg
      integer z34i,z34j,z34k,z34e,z34n,z34m,z34fu
      logical z34ex
      character*80 z34fn

      if (istep.le.0) return
      if (mod(istep,100000).ne.0) return

      z34ep=1.0e-30
      z34rf=max(abs(param(1)),z34ep)
      z34mu=abs(param(2))
      z34nu=z34mu/z34rf
      z34rs=r_sample_over_a*phys_a

c     Refresh only the sampling buffers.  This does not alter the solution.
      call physalis_sample_sem_fields
      call physalis_transform_frame

c     Lebedev + Lamb values: one global file, rank zero.
      if (nid.eq.0) then
         z34fn='stage34_lebedev_local.dat'
         inquire(file=z34fn,exist=z34ex)
         z34fu=91
         if (z34ex) then
            open(z34fu,file=z34fn,status='old',position='append')
         else
            open(z34fu,file=z34fn,status='new')
            write(z34fu,'(A)')
     $ '# step time q k xhat yhat zhat w nek_x/a nek_r/a '//
     $ 'Nek_Uax Nek_Urad Nek_ptil Lamb_Uax Lamb_Urad Lamb_ptil'
         endif
         do z34k=1,nleb
            z34rx=z34rs*xleb_d(z34k)
            z34ry=z34rs*yleb_d(z34k)
            z34rz=z34rs*zleb_d(z34k)
            z34rr=sqrt(z34rx*z34rx+z34ry*z34ry+z34rz*z34rz)
            call physalis_lamb_vel_at_point(z34rx,z34ry,z34rz,
     $         z34rr,phys_a,z34nu,p_re,p_im,phi_re,phi_im,
     $         lmax,z34ux,z34uy,z34uz)
            call physalis_lamb_pressure_at_point(z34rx,z34ry,z34rz,
     $         z34rr,phys_a,p_re,p_im,phi_re,phi_im,lmax,z34pl)
            z34rq=sqrt(xleb_d(z34k)**2+yleb_d(z34k)**2)
            z34xa=r_sample_over_a*zleb_d(z34k)
            z34ra=r_sample_over_a*z34rq
            z34na=U_lab_l(z34k,3)
            z34la=z34uz
            z34nr=0.0
            z34lr=0.0
            if (z34rq.gt.z34ep) then
               z34nr=(U_lab_l(z34k,1)*xleb_d(z34k)+
     $                U_lab_l(z34k,2)*yleb_d(z34k))/z34rq
               z34lr=(z34ux*xleb_d(z34k)+
     $                z34uy*yleb_d(z34k))/z34rq
            endif
            write(z34fu,101) istep,time,r_sample_over_a,z34k,
     $         xleb_d(z34k),yleb_d(z34k),zleb_d(z34k),wleb_d(z34k),
     $         z34xa,z34ra,z34na,z34nr,p_til_l(z34k),
     $         z34la,z34lr,z34pl
         enddo
         close(z34fu)

c        Current committed Lamb coefficients.
         z34fn='stage34_lamb_coeff.dat'
         inquire(file=z34fn,exist=z34ex)
         z34fu=94
         if (z34ex) then
            open(z34fu,file=z34fn,status='old',position='append')
         else
            open(z34fu,file=z34fn,status='new')
            write(z34fu,'(A)')
     $ '# step time q n m p_re p_im phi_re phi_im v_re v_im'
         endif
         do z34n=1,lmax
         do z34m=0,z34n
            write(z34fu,102) istep,time,r_sample_over_a,z34n,z34m,
     $         p_re(z34n,z34m+1),p_im(z34n,z34m+1),
     $         phi_re(z34n,z34m+1),phi_im(z34n,z34m+1),
     $         v_re(z34n,z34m+1),v_im(z34n,z34m+1)
         enddo
         enddo
         close(z34fu)
      endif

c     Velocity cage: local-rank files.  Coordinates are Nek axial/radial.
      write(z34fn,'("stage34_ucage_r",I5.5,".dat")') nid
      inquire(file=z34fn,exist=z34ex)
      z34fu=92
      if (z34ex) then
         open(z34fu,file=z34fn,status='old',position='append')
      else
         open(z34fu,file=z34fn,status='new')
         write(z34fu,'(A)')
     $ '# step time e i j k x/a r/a R/a Nek_Uax Nek_Urad '//
     $ 'Lamb_Uax_target Lamb_Urad_target dUax dUrad'
      endif
      do z34e=1,nelv
      do z34k=1,lz1
      do z34j=1,ly1
      do z34i=1,lx1
         if (mask_cage_u(z34i,z34j,z34k,z34e).eq.1) then
            z34xr=(xm1(z34i,z34j,z34k,z34e)-phys_zp)/phys_a
            z34yr=(ym1(z34i,z34j,z34k,z34e)-phys_xp)/phys_a
            z34r0=sqrt(z34xr*z34xr+z34yr*z34yr)
            write(z34fu,103) istep,time,z34e,z34i,z34j,z34k,
     $         z34xr,z34yr,z34r0,
     $         vx(z34i,z34j,z34k,z34e),vy(z34i,z34j,z34k,z34e),
     $         u_bc_cage(z34i,z34j,z34k,z34e),
     $         v_bc_cage(z34i,z34j,z34k,z34e),
     $         vx(z34i,z34j,z34k,z34e)-u_bc_cage(z34i,z34j,z34k,z34e),
     $         vy(z34i,z34j,z34k,z34e)-v_bc_cage(z34i,z34j,z34k,z34e)
         endif
      enddo
      enddo
      enddo
      enddo
      close(z34fu)

c     Pressure-cage means for a gauge-free pointwise comparison.
      z34sw=0.0
      z34sp=0.0
      z34sb=0.0
      do z34e=1,nelv
      do z34k=1,lz2
      do z34j=1,ly2
      do z34i=1,lx2
         if (mask_cage_p(z34i,z34j,z34k,z34e).eq.1) then
            z34wt=bm2(z34i,z34j,z34k,z34e)
            z34sw=z34sw+z34wt
            z34sp=z34sp+z34wt*pr(z34i,z34j,z34k,z34e)
            z34sb=z34sb+z34wt*p_bc_cage(z34i,z34j,z34k,z34e)
         endif
      enddo
      enddo
      enddo
      enddo
      z34sw=glsum(z34sw,1)
      z34sp=glsum(z34sp,1)
      z34sb=glsum(z34sb,1)
      z34mp=z34sp/max(z34sw,z34ep)
      z34mb=z34sb/max(z34sw,z34ep)

      write(z34fn,'("stage34_pcage_r",I5.5,".dat")') nid
      inquire(file=z34fn,exist=z34ex)
      z34fu=93
      if (z34ex) then
         open(z34fu,file=z34fn,status='old',position='append')
      else
         open(z34fu,file=z34fn,status='new')
         write(z34fu,'(A)')
     $ '# step time e i j k x/a r/a R/a Nek_Praw Lamb_Praw '//
     $ 'Nek_Pgf Lamb_Pgf dPgf'
      endif
      do z34e=1,nelv
      do z34k=1,lz2
      do z34j=1,ly2
      do z34i=1,lx2
         if (mask_cage_p(z34i,z34j,z34k,z34e).eq.1) then
            z34xr=(xm2(z34i,z34j,z34k,z34e)-phys_zp)/phys_a
            z34yr=(ym2(z34i,z34j,z34k,z34e)-phys_xp)/phys_a
            z34r0=sqrt(z34xr*z34xr+z34yr*z34yr)
            z34pg=pr(z34i,z34j,z34k,z34e)-z34mp
            z34bg=p_bc_cage(z34i,z34j,z34k,z34e)-z34mb
            write(z34fu,104) istep,time,z34e,z34i,z34j,z34k,
     $         z34xr,z34yr,z34r0,
     $         pr(z34i,z34j,z34k,z34e),p_bc_cage(z34i,z34j,z34k,z34e),
     $         z34pg,z34bg,z34pg-z34bg
         endif
      enddo
      enddo
      enddo
      enddo
      close(z34fu)

  101 format(i9,1x,1p2e18.10,1x,i4,1x,12e18.10)
  102 format(i9,1x,1p2e18.10,1x,2i4,1x,6e18.10)
  103 format(i9,1x,1pe18.10,1x,4i6,1x,9e18.10)
  104 format(i9,1x,1pe18.10,1x,4i6,1x,8e18.10)
      return
      end
c-----------------------------------------------------------------------

