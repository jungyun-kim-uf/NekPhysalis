c=======================================================================
c M2 HISTORY SPLIT: velocity=UNION, pressure=RELEASE_ONLY
c This is an off-diagonal U/P history-refill combination.
c M2 pressure formulation and all other numerical settings unchanged.
c=======================================================================
c=======================================================================
c M2 ALL-PLAUSIBLE MATRIX group=00_CONTROL variant=CTRL
c Current selected M2 formulation; no new mechanism change.
c Common guardrails: betafb=.02, inner<=200, NMXP=4000.
c=======================================================================
c=======================================================================
c M2 ROOTCAUSE TRACK = T3_ROBUST_I200_P4000
c T2 + pressure iteration ceiling NMXP=4000; pressure tolerance remains 1e-6.
c Screening horizon ~1200 baseline-dt steps.
c=======================================================================
c=======================================================================
c  PCAGE_AB_METHOD = ACTUAL_SELECTED_M2
c  TARGET_RE_LABEL = 100
c  Same numerical/physical setup across Re; viscosity varies.
c=======================================================================
c=======================================================================
c LEAN V2 NONDIMENSIONAL RE-FAMILY -- BF-S4 Re100
c Historical algorithmic lineage:
c Nek_physalis_2d_moving -> Clean V1 -> Lean V2 C_tol5e-4_min1.
c Same algorithm in Re1/Re10/Re41/Re100; only Re-specific physical
c viscosity/reference metadata changes.
c L0=a_dim=2.5e-4 m, U0=0.0741 m/s, a*=1, rho*=1.
c dt*=0.011856, g*=-0.446655411496664.
c nu*=5.222722810651664E-01, target label Re=1.
c alpha_def / projection-defect / transfer-correction dead paths absent.
c POSTBC diagnostic branch is NOT used.
c=======================================================================
      subroutine physalis_check_findpts(iwk,npts,tag)
c  Treat findpts return code 2 as a fatal sampling error.  Return code 1
c  is an accepted boundary/tolerance match and is left available in iwk.
c-----------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'

      integer npts,iwk(npts,3)
      integer k,nfail,nfail_g
      character*(*) tag

      nfail = 0
      do k=1,npts
         if (iwk(k,1).ge.2) nfail=nfail+1
      enddo
      nfail_g=iglmax(nfail,1)

      if (nfail_g.gt.0) then
         if (nid.eq.0) write(6,'(A,A,A,I6)')
     $      'ERROR: findpts failed in ',tag,'; failed points=',nfail_g
         call exitt
      endif

      return
      end

c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'   ! this is not
      include 'NEKUSE'
      integer e,eg

      e = gllel(eg)

      udiff=0.0
      utrans=0.

      return
      end

c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg)
c  OP3 uses the Z&P constant pressure-gradient/body-force drive.
c  Nek USERF is acceleration, so ffz=P/rho.  All other problems have
c  no fluid body force; gravity is applied only in the particle ODE.
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer ix,iy,iz,eg,e
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      real a,rho_f,nu,mu,pgrad,pstar

      e=gllel(eg)
      call zp_validation_config
      ffx=0.0
      ffy=0.0
      ffz=0.0
      if (zp_problem.ge.31 .and. zp_problem.le.34) then
         call physalis_sp_validation_params(a,pstar)
         rho_f=max(param(1),1.0e-30)
         nu=abs(param(2))
         mu=rho_f*nu
         pgrad=pstar*mu*nu/max(a**3,1.0e-30)
         ffz=pgrad/rho_f
      endif
      return
      end
c-----------------------------------------------------------------------
c-----------------------------------------------------------------------

      subroutine physalis_sp_validation_params(sp_a,sp_pstar)
c  Shared radius and Z&P periodic-array pressure parameter.
      real sp_a,sp_pstar
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      call validation_config
      call zp_validation_config
      sp_a=cfg_radius
      sp_pstar=0.0
      if (zp_problem.ge.31 .and. zp_problem.le.34)
     $   sp_pstar=zp_pstar
      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e,eg

      qvol   = 0.0

      return
      end
c=======================================================================
c  2D AXISYMMETRIC IN-SOURCE CASE SELECTOR
c=======================================================================
      subroutine sp_conservation_config
c  EDIT THIS ONE VALUE ONLY:
c
c     case_id_param = 2 : fixed angular-momentum validation
c     case_id_param = 3 : freely moving S&P/Mordant settling validation
c     case_id_param = 4 : Wang2025 fixed sphere with moving free stream
c
c  This validation package selects 4; the original moving code path is
c  otherwise preserved.
      include 'SIZE'
      include 'TOTAL'
      integer case_id_param
c                    EDIT THIS ONE VALUE ONLY
      parameter (case_id_param=4)

      integer case_id
      common /physalis_2d_case_i/ case_id
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      real sp_cons_reomega
      common /sp_cons_r/ sp_cons_reomega
      logical initialized
      save initialized
      data initialized/.false./
      if (initialized) return

      case_id=case_id_param
      if (case_id.ne.2 .and. case_id.ne.3 .and.
     $    case_id.ne.4) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: 2D case_id must be 2, 3, or 4'
         call exitt
      endif

      sp_cons_mode=0
      if (case_id.eq.2) sp_cons_mode=2

c     G&P/SP rotating-sphere definition Re_Omega=a^2*Omega_z/nu.
      sp_cons_reomega=0.0
      if (sp_cons_mode.eq.2) sp_cons_reomega=20.0

      initialized=.true.
      if (nid.eq.0) write(6,'(A,I3,A,I3,A,E14.6)')
     $   '2D Physalis case_id=',case_id,
     $   ' SP mode=',sp_cons_mode,' Re_Omega=',sp_cons_reomega
      return
      end
c=======================================================================
c  USER-EDITABLE UNIFIED VALIDATION CONFIGURATION
c=======================================================================
      subroutine validation_config
c  Embedded B-case dimensional and Nek-deck audit parameters.
c  Change case by using set_S.usr, set_P.usr, or set_B.usr; do not edit
c  solver routines below this configuration block.
      include 'SIZE'
      include 'TOTAL'
      integer case_id
      common /physalis_2d_case_i/ case_id
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      real sp_cons_reomega
      common /sp_cons_r/ sp_cons_reomega

      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer extractor_mode
      common /validation_extractor_i/ extractor_mode
      integer cfg_expected_bc_mode
      common /validation_deck_i/ cfg_expected_bc_mode
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real cfg_min_clearance_a
      common /validation_deck_r/ cfg_min_clearance_a
      real cfg_expected_extent(6)
      common /validation_deck_extent_r/ cfg_expected_extent
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on

      logical initialized
      save initialized
      data initialized /.false./
      if (initialized) return
      call sp_conservation_config

c     Physical driver: 1=fixed/prescribed, 4=moving settling.
c     This deck is a 2D axisymmetric prototype of the 3D settling case.
c     Nek axisymmetric convention is x=axial and y=radius.  The Physalis
c     particle state still uses sm_z as the axial coordinate.
      validation_case=4
c     Coefficient extractor:
c        1=dualrot, 2=SHLS, 3=R2H diagnostic, 4=direct Lebedev.
c     This direct-Lebedev diagnostic uses extractor_mode=4.
      extractor_mode=4
c     This validation source supports exactly one particle.
      cfg_nparticles=1
c     Particle center: explicit center.  For the 2D axisymmetric case,
c     cfg_center=(r,azimuthal,z)=(0,0,z0) in Physalis coordinates.
      cfg_center_mode=0
c     Exact outer Stokes boundary: 0=off, 1=on.  B requires 0.
      cfg_fixed_exact_bc=0
c     Start on the symmetry axis, eight radii below the top outlet.
      cfg_center(1)=0.0
      cfg_center(2)=0.0
      cfg_center(3)=16
c     Particle radius nondimensionalized by L0=a_dim.
      cfg_radius=1.0
c     Particle-to-fluid density ratio for the settling experiment.
      cfg_rhop_ratio=2.5677031093279838
c     Nondimensional gravity: g*=g_dim*L0/U0**2.
      cfg_gz=-0.446655411496664
c     Reference speed Vt*=1 and tau95*=tau95_dim*U0/L0.
      cfg_vt_ref=1.0000000000000000E+00
      cfg_tau95_ref=1.6302000000000000E+01
c     Quiescent background flow [x,y,z].
      cfg_flow(1)=0.0
      cfg_flow(2)=0.0
      cfg_flow(3)=0.0
c     Prescribed oscillation amplitude [x,y,z]; disabled in B.
      cfg_osc_amp(1)=0.0
      cfg_osc_amp(2)=0.0
      cfg_osc_amp(3)=0.0
c     Oscillation frequency and phase; disabled in B.
      cfg_osc_omega=0.0
      cfg_osc_phase=0.0
c     Required top-boundary distance in particle radii.
      cfg_top_offset_over_a=8.0
c     Boundary audit: 1=all velocity, 2=wall/outflow deck.
      cfg_expected_bc_mode=2
c     Minimum particle-to-boundary clearance in radii.
      cfg_min_clearance_a=5.5
c     Time step and viscosity are controlled only by set.par.
c     Expected 2D axisymmetric deck extents.
c     Nek x is the radial coordinate and Nek y is the axial coordinate.
c     Physalis uses z as the axial coordinate, so the audit maps
c     Nek y -> Physalis z for this prototype.
      cfg_expected_extent(1)= 0.0
      cfg_expected_extent(2)= 10.0
      cfg_expected_extent(3)= 0.0
      cfg_expected_extent(4)= 0.0
      cfg_expected_extent(5)=-72.0
      cfg_expected_extent(6)= 24.0
c     Mesh element count and SEM polynomial order are controlled by
c     set.box/SIZE directly; no separate expected-value gate is kept
c     here (removed -- was pure friction across mesh/order sweeps).

c     Optional fixed angular-momentum validation branch.  The default
c     case_id=3 leaves all moving-case constants above unchanged.
c     When case_id=2, only the fixed-angular S&P/G&P deck constants are
c     selected; the moving-particle routines remain inactive.
      if (case_id.eq.2) then
         validation_case=1
         cfg_center(1)=0.0
         cfg_center(2)=0.0
         cfg_center(3)=0.0
         cfg_radius=1.0
         cfg_rhop_ratio=1.0
         cfg_gz=0.0
         cfg_vt_ref=1.0
         cfg_tau95_ref=1.0
         cfg_flow(1)=0.0
         cfg_flow(2)=0.0
         cfg_flow(3)=0.0
         cfg_osc_amp(1)=0.0
         cfg_osc_amp(2)=0.0
         cfg_osc_amp(3)=0.0
         cfg_osc_omega=0.0
         cfg_osc_phase=0.0
         cfg_top_offset_over_a=8.0
         cfg_expected_bc_mode=4
         cfg_min_clearance_a=0.75
c        2D axisymmetric angular deck: Nek x=axial, Nek y=radius.
c        Mapped Physalis extents are radius [0,2] and axial [-2,2].
         cfg_expected_extent(1)= 0.0
         cfg_expected_extent(2)= 2.0
         cfg_expected_extent(3)= 0.0
         cfg_expected_extent(4)= 0.0
         cfg_expected_extent(5)=-2.0
         cfg_expected_extent(6)= 2.0
      endif

c     BF_Re100_P15 S4-matched fixed-sphere / prescribed-flow case.
c     Physical constants and outer domain are matched to BF_Re*_P_15:
c       a=0.005 cm, D=0.01 cm, rho=1, mu=1.e-4
c       Nek x/a=[-72,88], Nek radius/a=[0,40]
c       outer BC labels v,O,A,v
c     The sphere is fixed.  Relative settling is represented by the
c     prescribed +Nek-x free stream, exactly as in the BF comparison.
c     Physalis internal z is the Nek axial x coordinate.
      if (case_id.eq.4) then
         validation_case=1
         extractor_mode=4
         cfg_nparticles=1
         cfg_center_mode=0
         cfg_fixed_exact_bc=0
         cfg_center(1)=0.0
         cfg_center(2)=0.0
         cfg_center(3)=0.0
         cfg_radius=5.0000000000000000e-03
         cfg_rhop_ratio=1.0
         cfg_gz=0.0
         cfg_vt_ref=0.0
         cfg_tau95_ref=0.0
c        cfg_flow(3) is the Physalis axial/free-stream velocity.
         cfg_flow(1)=0.0
         cfg_flow(2)=0.0
         cfg_flow(3)=1.0000000000000000e+00
         cfg_vt_ref=abs(cfg_flow(3))
         cfg_osc_amp(1)=0.0
         cfg_osc_amp(2)=0.0
         cfg_osc_amp(3)=0.0
         cfg_osc_omega=0.0
         cfg_osc_phase=0.0
         cfg_top_offset_over_a=88.0
c        Mode 3 = prescribed v at inlet/radial far field, O downstream,
c        and A on the symmetry axis.
         cfg_expected_bc_mode=3
c        Exact minimum surface clearance is 39a at the radial boundary.
c        Use a slightly smaller fatal-audit threshold for roundoff margin.
         cfg_min_clearance_a=38.5
c        Physalis coordinate audit after ldim=2 axisymmetric remap:
c        radial x=[0,0.20], suppressed y=0, axial z=[-0.36,0.44].
         cfg_expected_extent(1)= 0.0
         cfg_expected_extent(2)= 2.0000000000000000e-01
         cfg_expected_extent(3)= 0.0
         cfg_expected_extent(4)= 0.0
         cfg_expected_extent(5)=-3.6000000000000000e-01
         cfg_expected_extent(6)= 4.4000000000000000e-01
      endif

      initialized=.true.
      call validation_check_config
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_check_config
      include 'SIZE'
      include 'TOTAL'
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer extractor_mode
      common /validation_extractor_i/ extractor_mode
      integer EXTRACT_DUALROT,EXTRACT_SHLS,EXTRACT_R2H
      integer EXTRACT_DIRECT
      parameter(EXTRACT_DUALROT=1,EXTRACT_SHLS=2,EXTRACT_R2H=3,
     $          EXTRACT_DIRECT=4)
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      integer cfg_expected_bc_mode
      common /validation_deck_i/ cfg_expected_bc_mode
      real cfg_min_clearance_a
      common /validation_deck_r/ cfg_min_clearance_a
      real cfg_expected_extent(6)
      common /validation_deck_extent_r/ cfg_expected_extent

      if (validation_case.lt.1 .or. validation_case.gt.4) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: validation_case must be 1,2,3,or 4'
         call exitt
      endif
      if (extractor_mode.lt.EXTRACT_DUALROT .or.
     $    extractor_mode.gt.EXTRACT_DIRECT) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: extractor_mode must be 1,2,3,or 4'
         call exitt
      endif
      if (cfg_nparticles.ne.1) then
         if (nid.eq.0) then
            write(6,*) 'ERROR: cfg_nparticles=',cfg_nparticles
            write(6,*) 'This unified Cases 1-4 master is np=1 only.'
            write(6,*) 'Do not activate fake np>1 by changing one'
     $                ,' scalar.'
         endif
         call exitt
      endif
      if (cfg_radius.le.0.0) then
         if (nid.eq.0) write(6,*) 'ERROR: cfg_radius must be positive'
         call exitt
      endif
      if (cfg_center_mode.lt.0 .or. cfg_center_mode.gt.2) then
         if (nid.eq.0) write(6,*) 'ERROR: invalid cfg_center_mode'
         call exitt
      endif
      if (validation_case.eq.1 .and. cfg_center_mode.ne.0) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: Case 1 exact outer BC requires explicit center_mode=0'
         call exitt
      endif
      if (validation_case.eq.2) then
         if (abs(cfg_osc_amp(1))+abs(cfg_osc_amp(2)).gt.0.0) then
            if (nid.eq.0) write(6,*)
     $       'ERROR: current prescribed Anderson state supports z only'
            call exitt
         endif
         if (cfg_osc_omega.le.0.0) then
            if (nid.eq.0) write(6,*)
     $       'ERROR: Case 2 cfg_osc_omega must be positive'
            call exitt
         endif
      endif
      if (cfg_expected_bc_mode.lt.1 .or.
     $    cfg_expected_bc_mode.gt.4) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: expected_bc_mode must be 1..4'
         call exitt
      endif
      if (cfg_min_clearance_a.le.0.0) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: invalid deck audit tolerances in configuration'
         call exitt
      endif
      if (ldim.eq.3 .and.
     $   (cfg_expected_extent(2).le.cfg_expected_extent(1) .or.
     $    cfg_expected_extent(4).le.cfg_expected_extent(3) .or.
     $    cfg_expected_extent(6).le.cfg_expected_extent(5))) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: invalid expected domain extents in configuration'
         call exitt
      endif
      if (ldim.eq.2 .and.
     $   (cfg_expected_extent(2).le.cfg_expected_extent(1) .or.
     $    cfg_expected_extent(6).le.cfg_expected_extent(5))) then
         if (nid.eq.0) write(6,*)
     $   'ERROR: invalid expected 2D-axisym domain extents'
         call exitt
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_input_deck_audit
c  Fatal audit of mesh extent and boundary labels.
c  This prevents a valid reference from being compared with the wrong
c  physical boundary-value problem.
      include 'SIZE'
      include 'TOTAL'
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer cfg_expected_bc_mode
      common /validation_deck_i/ cfg_expected_bc_mode
      real cfg_min_clearance_a
      common /validation_deck_r/ cfg_min_clearance_a
      real cfg_expected_extent(6)
      common /validation_deck_extent_r/ cfg_expected_extent
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      integer e,f,nv,nw,no,nper,na,ni,nother,nwrong
      integer nv_g,nw_g,no_g,nper_g,na_g,nother_g,nwrong_g
      character*3 bc_tmp
      character*1 b1
      real clear_a,extent_err,extent_scale
      integer fu
      parameter(fu=97)
      logical done
      save done
      data done/.false./
      if (done) return

      nv=0
      nw=0
      no=0
      nper=0
      na=0
      ni=0
      nother=0
      nwrong=0
      do e=1,nelv
      do f=1,2*ldim
         bc_tmp=cbc(f,e,1)
         b1=bc_tmp(1:1)
         if (b1.eq.'E' .or. b1.eq.'e' .or. b1.eq.' ') then
            ni=ni+1
         elseif (b1.eq.'v' .or. b1.eq.'V') then
            nv=nv+1
            if (cfg_expected_bc_mode.ne.1 .and.
     $          cfg_expected_bc_mode.ne.3) nwrong=nwrong+1
         elseif (b1.eq.'W' .or. b1.eq.'w') then
            nw=nw+1
            if (cfg_expected_bc_mode.eq.1) nwrong=nwrong+1
            if (ldim.eq.3 .and. cfg_expected_bc_mode.eq.2
     $          .and. f.gt.4)
     $          nwrong=nwrong+1
         elseif (b1.eq.'O' .or. b1.eq.'o') then
            no=no+1
            if (cfg_expected_bc_mode.eq.1) nwrong=nwrong+1
            if (ldim.eq.3 .and. cfg_expected_bc_mode.eq.2
     $          .and. f.le.4)
     $          nwrong=nwrong+1
         elseif (b1.eq.'P' .or. b1.eq.'p') then
            nper=nper+1
            if (cfg_expected_bc_mode.ne.4) nwrong=nwrong+1
         elseif (b1.eq.'A' .or. b1.eq.'a') then
            na=na+1
         else
            nother=nother+1
            nwrong=nwrong+1
         endif
      enddo
      enddo
      nv_g=iglsum(nv,1)
      nw_g=iglsum(nw,1)
      no_g=iglsum(no,1)
      nper_g=iglsum(nper,1)
      na_g=iglsum(na,1)
      nother_g=iglsum(nother,1)
      nwrong_g=iglsum(nwrong,1)

      if (ldim.eq.2) then
         clear_a=min(sm_xmax-sm_x-sm_a,
     $      sm_z-sm_zmin-sm_a,sm_zmax-sm_z-sm_a)/sm_a
      else
         clear_a=min(sm_x-sm_xmin-sm_a,sm_xmax-sm_x-sm_a,
     $      sm_y-sm_ymin-sm_a,sm_ymax-sm_y-sm_a,
     $      sm_z-sm_zmin-sm_a,sm_zmax-sm_z-sm_a)/sm_a
      endif
      extent_scale=max(abs(cfg_expected_extent(1)),
     $ abs(cfg_expected_extent(2)),abs(cfg_expected_extent(3)),
     $ abs(cfg_expected_extent(4)),abs(cfg_expected_extent(5)),
     $ abs(cfg_expected_extent(6)),sm_a,1.0e-30)
      if (ldim.eq.2) then
         extent_err=max(abs(sm_xmin-cfg_expected_extent(1)),
     $      abs(sm_xmax-cfg_expected_extent(2)),
     $      abs(sm_zmin-cfg_expected_extent(5)),
     $      abs(sm_zmax-cfg_expected_extent(6)))/extent_scale
      else
         extent_err=max(abs(sm_xmin-cfg_expected_extent(1)),
     $      abs(sm_xmax-cfg_expected_extent(2)),
     $      abs(sm_ymin-cfg_expected_extent(3)),
     $      abs(sm_ymax-cfg_expected_extent(4)),
     $      abs(sm_zmin-cfg_expected_extent(5)),
     $      abs(sm_zmax-cfg_expected_extent(6)))/extent_scale
      endif

      if (nid.eq.0) then
         open(fu,file='validation_input_audit.dat',status='replace')
         write(fu,'(A,I6)') 'validation_case ',validation_case
         write(fu,'(A,6E22.12)') 'domain_extents ',sm_xmin,sm_xmax,
     $      sm_ymin,sm_ymax,sm_zmin,sm_zmax
         write(fu,'(A,E22.12)') 'initial_surface_clearance_over_a ',
     $      clear_a
         write(fu,'(A,6I12)') 'boundary_counts_v_W_O_P_A_other ',
     $      nv_g,nw_g,no_g,nper_g,na_g,nother_g
         write(fu,'(A,I12)') 'wrong_boundary_faces ',nwrong_g
         write(fu,'(A,E22.12)') 'dt_from_setpar ',dt
         write(fu,'(A,E22.12)') 'rho_from_setpar ',param(1)
         write(fu,'(A,E22.12)') 'mu_from_setpar ',abs(param(2))
         write(fu,'(A,E22.12)') 'nu_from_setpar ',
     $      abs(param(2))/max(abs(param(1)),1.0d-30)
         write(fu,'(A,E22.12)') 'domain_extent_relative_error ',
     $      extent_err
         write(fu,'(A,2I12)') 'nel_actual_order_actual ',
     $      nelgt,lx1-1
         close(fu)
      endif

      if (nwrong_g.gt.0) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: input-deck boundary labels do not match reference'
         call exitt
      endif
      if (cfg_expected_bc_mode.eq.1 .and. nv_g.le.0) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: all-Dirichlet validation deck has no v boundaries'
         call exitt
      endif
      if (cfg_expected_bc_mode.eq.2 .and.
     $   (nw_g.le.0 .or. no_g.le.0)) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: Case 4 deck requires W sidewalls and O z faces'
         call exitt
      endif
      if (cfg_expected_bc_mode.eq.3 .and.
     $   (nv_g.le.0 .or. no_g.le.0 .or. na_g.le.0 .or.
     $    nw_g.ne.0 .or. nper_g.ne.0)) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: BFmatch fixed-sphere deck requires v/O/A only'
         call exitt
      endif
      if (cfg_expected_bc_mode.eq.4 .and.
     $   (nper_g.le.0 .or. na_g.le.0 .or. nw_g.le.0 .or.
     $    no_g.ne.0 .or. nv_g.ne.0)) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: 2D angular deck requires P axial, A axis, W wall'
         call exitt
      endif
      if (clear_a.lt.cfg_min_clearance_a) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: initial particle clearance/a too small ',clear_a
         call exitt
      endif
      if (extent_err.gt.1.0e-5) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: mesh domain does not match case config ',extent_err
         call exitt
      endif
      done=.true.
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_dynamic_clearance_audit
c  Enforce the configured minimum surface clearance throughout the run.
      include 'SIZE'
      include 'TOTAL'
      real cfg_min_clearance_a
      common /validation_deck_r/ cfg_min_clearance_a
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real clear_a
      integer fu
      parameter(fu=96)
      logical first
      save first
      data first/.true./
      if (ldim.eq.2) then
c        Axisymmetric mesh: sm_x=radius, sm_z=axial.
c        sm_x=0 is the symmetry axis, not a wall.
c        sm_y is the suppressed azimuthal coordinate.
c        Check only outer radius and axial ends.
         clear_a=min(sm_xmax-sm_x-sm_a,
     $      sm_z-sm_zmin-sm_a,sm_zmax-sm_z-sm_a)/sm_a
      else
         clear_a=min(sm_x-sm_xmin-sm_a,sm_xmax-sm_x-sm_a,
     $      sm_y-sm_ymin-sm_a,sm_ymax-sm_y-sm_a,
     $      sm_z-sm_zmin-sm_a,sm_zmax-sm_z-sm_a)/sm_a
      endif
      if (nid.eq.0 .and. (istep.le.10 .or. mod(istep,100).eq.0)) then
         if (first) then
            open(fu,file='validation_clearance_history.dat',
     $           status='replace')
            write(fu,'(A)') '# step t surface_clearance_over_a limit'
            first=.false.
         else
            open(fu,file='validation_clearance_history.dat',
     $           status='old',position='append')
         endif
         write(fu,*) istep,time,clear_a,cfg_min_clearance_a
         close(fu)
      endif
      if (clear_a.lt.cfg_min_clearance_a) then
         if (nid.eq.0) write(6,*)
     $    'ERROR: particle surface clearance/a below limit ',
     $      clear_a,cfg_min_clearance_a
         call exitt
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_prescribed_kinematics(t,xp,yp,zp,
     $ up,vp,wp,ax,ay,az)
      real t,xp,yp,zp,up,vp,wp,ax,ay,az
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real val_origin(3)
      common /validation_origin_r/ val_origin
      real th,s,c

      if (validation_case.eq.1) then
         xp=val_origin(1)
         yp=val_origin(2)
         zp=val_origin(3)
         up=0.0
         vp=0.0
         wp=0.0
         ax=0.0
         ay=0.0
         az=0.0
         return
      endif
      th=cfg_osc_omega*t+cfg_osc_phase
      s=sin(th)
      c=cos(th)
      xp=val_origin(1)+cfg_osc_amp(1)*s
      yp=val_origin(2)+cfg_osc_amp(2)*s
      zp=val_origin(3)+cfg_osc_amp(3)*s
      up=cfg_osc_amp(1)*cfg_osc_omega*c
      vp=cfg_osc_amp(2)*cfg_osc_omega*c
      wp=cfg_osc_amp(3)*cfg_osc_omega*c
      ax=-cfg_osc_amp(1)*cfg_osc_omega**2*s
      ay=-cfg_osc_amp(2)*cfg_osc_omega**2*s
      az=-cfg_osc_amp(3)*cfg_osc_omega**2*s
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_set_prescribed_state(t)
      real t
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized
      call validation_prescribed_kinematics(t,sm_x,sm_y,sm_z,
     $ sm_u,sm_v,sm_w,sm_ax_prev,sm_ay_prev,sm_az_prev)
      sm_accel_initialized=1
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_prepare_prescribed_step
c  Move the prescribed sphere exactly once before the physical PLAN3 map.
c  The old masks are saved before changing the center; the accepted Lamb
c  state is shifted only after the replayed coefficient solve converges.
      include 'SIZE'
      include 'TOTAL'
      integer last_step
      save last_step
      data last_step/-999999/
      if (istep.le.0) return
      if (last_step.eq.istep) return
      call physalis_save_old_masks
      call validation_set_prescribed_state(time)
c     Slot 1 becomes the new exact kinematics with the previous accepted
c     Lamb coefficients as a predictor.  Commit replaces those coefficients
c     after the replay loop converges; it must not shift a second time.
      call physalis_shift_physical_history
      call physalis_sync_particle_bookkeeping
      last_step=istep
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_replace_history_slot1
c  Cases 1-2: replace the predictor coefficients in physical-history
c  slot 1 by the accepted coefficients without shifting the time levels.
      include 'SIZE'
      include 'TOTAL'
      integer phmax
      parameter(phmax=2*lorder-1)
      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax),ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized
      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer n,m
      ph_x(1,1)=sm_x
      ph_x(2,1)=sm_y
      ph_x(3,1)=sm_z
      ph_w(1,1)=sm_u
      ph_w(2,1)=sm_v
      ph_w(3,1)=sm_w
      ph_acc(1,1)=sm_ax_prev
      ph_acc(2,1)=sm_ay_prev
      ph_acc(3,1)=sm_az_prev
      ph_pref(1)=phys_pressure_ref
      do n=1,4
      do m=1,5
         ph_pr(n,m,1)=p_re(n,m)
         ph_pi(n,m,1)=p_im(n,m)
         ph_fr(n,m,1)=phi_re(n,m)
         ph_fi(n,m,1)=phi_im(n,m)
         ph_vr(n,m,1)=v_re(n,m)
         ph_vi(n,m,1)=v_im(n,m)
      enddo
      enddo
      return
      end
c-----------------------------------------------------------------------
      subroutine validation_fixed_stokes_velocity(xq,yq,zq,u,v,w)
c  Exact creeping-flow velocity outside a fixed sphere in uniform flow.
c  Vector form: u=A*U+B*(U.rhat)*rhat.
      real xq,yq,zq,u,v,w
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real dx,dy,dz,r,rinv,ar,a3r3,Acoef,Bcoef,udotr

      if (cfg_fixed_exact_bc.eq.0) then
         u=cfg_flow(1)
         v=cfg_flow(2)
         w=cfg_flow(3)
         return
      endif
      dx=xq-cfg_center(1)
      dy=yq-cfg_center(2)
      dz=zq-cfg_center(3)
      r=sqrt(dx*dx+dy*dy+dz*dz)
      if (r.le.cfg_radius) then
         u=0.0
         v=0.0
         w=0.0
         return
      endif
      rinv=1.0/r
      ar=cfg_radius*rinv
      a3r3=ar**3
      Acoef=1.0-0.75*ar-0.25*a3r3
      Bcoef=-0.75*ar+0.75*a3r3
      udotr=(cfg_flow(1)*dx+cfg_flow(2)*dy+
     $       cfg_flow(3)*dz)*rinv
      u=Acoef*cfg_flow(1)+Bcoef*udotr*dx*rinv
      v=Acoef*cfg_flow(2)+Bcoef*udotr*dy*rinv
      w=Acoef*cfg_flow(3)+Bcoef*udotr*dz*rinv
      return
      end
      subroutine stage31_control_check
      include 'SIZE'
      include 'TOTAL'
      logical st31_first
      save st31_first
      data st31_first /.true./

      if (abs(param(42)-1.0).gt.1.0e-12) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE31: expected PCG P042=1, got ',param(42)
         call exitt
      endif
      if (abs(param(21)-1.0e-6).gt.1.0e-12) then
         if (nid.eq.0) write(6,*)
     $      'FATAL STAGE31: pressure tolerance changed ',param(21)
         call exitt
      endif

      if (st31_first .and. nid.eq.0) then
         write(6,'(A,2E16.8)')
     $      'STAGE31 PCG production P042/tol=',param(42),param(21)
         write(6,*) 'STAGE35A LOCALCART PCG MAXIT=10000'
         write(6,*) 'STAGE31 SPATIAL RESUME: PHYSICS UNCHANGED'
         st31_first=.false.
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
c  Unified validation driver, including Wang2025 fixed-sphere mode.
c  two external configuration files and the physical mesh deck differ.
      include 'SIZE'
      include 'TOTAL'
      integer nn,s21_mode
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      integer sp_cons_mode
      common /sp_cons_i/ sp_cons_mode
      integer s35ad_rst_active
      common /s35ad_restart_i/ s35ad_rst_active

c     STAGE35AD full-restart field replay, if explicitly enabled.
      call s35ad_restart_field_hook
c     Stock Nek5000 Physalis port: no LPM .par reader is used.
      ifxyo=.true.
      if (istep.gt.1) ifxyo=.false.
      call validation_config
      call zp_validation_config
      call physalis_init
      call s35ad_init_once
      call s35ad_restart_state_hook
      call stage23_control_check
      call stage24_control_check
      call stage26_control_check
      call stage27_control_check
      call stage31_control_check
      call zp_reference_condition_audit
      call spmove_init_once
c     zp_problem=51 (moving S&P/Mordant sweep): the OP1-4 audit
c     dispatch collapses to the moving-case input-deck audit.
      call validation_input_deck_audit

c     Stock Nek5000 Physalis port: particle bookkeeping is kept
c     in Physalis/SP common blocks, not in LPM/IBM containers.
c     Moving MD uses dynamic-clearance audit.  Fixed angular validation
c     is stationary, so do not write/apply moving clearance history there.
      if (validation_case.gt.2) call validation_dynamic_clearance_audit

      if (istep.le.0) then
         call physalis_update_particle_state
         if (zp_problem.eq.71) then
            call wang_stokes_force_selftest
            if (s35ad_rst_active.eq.0)
     $         call physalis_init_lamb_arrays
            call physalis_update_particle_state
         endif
         call physalis_build_gll_cage
         call stage23_mapping_audit
         call stage21_startup_mode(s21_mode)
         if (zp_problem.eq.71 .and. s21_mode.eq.1 .and.
     $       s35ad_rst_active.eq.0)
     $      call stage21_initialize_stokes_pressure
c        phys_mode=7 (>=1/3/5 always true).
         call physalis_lock_pressure_reference
         call physalis_pressure_frame_audit
         if (zp_problem.eq.71 .and. s21_mode.eq.1 .and.
     $       s35ad_rst_active.eq.0) then
            call physalis_extract_selected
            call physalis_compute_lamb_force
         endif
         if (s35ad_rst_active.eq.0)
     $      call s35ad_axisym8_update
         call physalis_reconstruct_velocity_cage
         call physalis_reconstruct_pressure_cage
         call stage24_save_reference_cages
         call stage24_apply_target_mode
         call physalis_update_velocity_cage_residual
         if (zp_problem.eq.71)
     $      call stage21_write_startup_diag(s21_mode)
         call physalis_history_init_once
      endif

      if (istep.gt.0) then
         if (sp_cons_mode.eq.2) then
            call write_sp_angular_momentum_history
            call write_physalis_coeff_modes
         elseif (zp_problem.eq.71) then
            if (istep.eq.1 .or. mod(istep,1000).eq.0 .or.
     $          lastep.eq.1) call write_bfmatch_fixed_history
         else
            call write_sp_moving_history
         endif
      endif
      if (istep.gt.0) then
         if (istep.eq.1 .or. mod(istep,1000).eq.0 .or.
     $       lastep.eq.1) call s35ad_write_cv_force
c        Common CV-GL128 is diagnostic only; sparse cadence saves runtime.
      endif
      if (istep.eq.0 .or. istep.eq.1 .or.
     $    mod(istep,1000).eq.0 .or. lastep.eq.1)
     $    call s35ad_write_signature
      if (istep.eq.1) call zp_write_run_metadata
      if (istep.ge.5 .and. istep.le.8)
     $   call s35af_probe(4)
c     Stock Nek5000 Physalis port: no LPM particle solver is called.
      return
      end
c-----------------------------------------------------------------------

c-----------------------------------------------------------------------
      subroutine wang_stokes_force_selftest
c  Analytic creeping-flow sanity test for the Physalis extractor/force map.
c  This does NOT compare the numerical Re=1/10/100 solution with Stokes.
c  It feeds the exact fixed-sphere Stokes field directly on the current
c  38-point q=r_sample_over_a Lebedev sphere and requires the force to be
c  |Fz| = 6*pi*mu*a*U.  Failure isolates the local extractor/force map.
      include 'SIZE'
      include 'TOTAL'
      integer nleb
      parameter(nleb=38)
      real xleb_d(nleb),yleb_d(nleb),zleb_d(nleb),wleb_d(nleb)
      common /phys_leb/ xleb_d,yleb_d,zleb_d,wleb_d
      real u_til_l(nleb,3),p_til_l(nleb)
      common /phys_tilde/ u_til_l,p_til_l
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      integer phys_m0_project_on
      common /physalis_m0_ctl/ phys_m0_project_on
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real ft(3),tt(3)
      real pi0,rho,mu,nu,a,rs,uinf,ar,a3,a1,b1,udotr
      real fexact,relerr,eps
      integer k,fu
      parameter(fu=77)
      logical done
      save done
      data done/.false./
      if (done) return
      done=.true.
      eps=1.0d-30
      call validation_config
      rho=max(abs(param(1)),eps)
      mu=abs(param(2))
      nu=mu/rho
      a=cfg_radius
      uinf=abs(cfg_flow(3))
      if (a.le.0.0 .or. uinf.le.0.0) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: invalid BFmatch Stokes self-test scale'
         call exitt
      endif
      rs=r_sample_over_a*a
      ar=a/rs
      a3=ar**3
      a1=1.0d0-0.75d0*ar-0.25d0*a3
      b1=-0.75d0*ar+0.75d0*a3
      do k=1,nleb
         udotr=uinf*zleb_d(k)
         u_til_l(k,1)=b1*udotr*xleb_d(k)
         u_til_l(k,2)=b1*udotr*yleb_d(k)
         u_til_l(k,3)=a1*uinf+b1*udotr*zleb_d(k)
         p_til_l(k)=-1.5d0*mu*a*uinf*zleb_d(k)/(rs*rs)
      enddo
      call physalis_scalar_products
      call physalis_lamb_solve
      if (ldim.eq.2 .and. phys_m0_project_on.eq.1)
     $   call physalis_axisym_project_m0('bfmatch_stokes_selftest')
      call physalis_compute_lamb_force_arrays(
     $ p_re,p_im,phi_re,phi_im,v_re,v_im,ft,tt)
      pi0=4.0d0*atan(1.0d0)
      fexact=6.0d0*pi0*mu*a*uinf
      relerr=abs(abs(ft(3))-fexact)/max(fexact,eps)
      if (nid.eq.0) then
         open(fu,file='bfmatch_stokes_force_selftest.dat',
     $        status='replace')
         write(fu,'(A)') '# U a q rho mu nu F_phys_z F_Stokes relerr'
         write(fu,*) uinf,a,r_sample_over_a,rho,mu,nu,
     $      ft(3),fexact,relerr
         close(fu)
         write(6,'(A,E12.4,A,3E16.8)')
     $      'BFmatch Stokes self-test q=',r_sample_over_a,
     $      ' F,Fexact,err=',ft(3),fexact,relerr
      endif
      if (relerr.gt.1.0d-8) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: Physalis Stokes force self-test failed'
         call exitt
      endif
      return
      end
c-----------------------------------------------------------------------

      subroutine write_bfmatch_fixed_history
c     Direct Physalis drag for BF-Re100 comparison.
c     ldim=2 axisymmetric bridge maps Physalis z -> Nek axial x, so
c     F_phys(3) is the streamwise hydrodynamic force.
c     No empirical correction or BF feedback is used.
      include 'SIZE'
      include 'TOTAL'
      integer phys_replay_enabled,phys_replay_active
      integer phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      real F_raw_diag(3),T_raw_diag(3)
      common /phys_raw_force/ F_raw_diag,T_raw_diag
      real raw_p10_diag,raw_phi10_diag
      real raw_coeff_norm_diag,commit_coeff_norm_diag
      real raw_defect_diag
      common /phys_beta_diag/ raw_p10_diag,raw_phi10_diag,
     $ raw_coeff_norm_diag,commit_coeff_norm_diag,raw_defect_diag
      real s4_m0_norm,s4_mgt0_norm,s4_mgt0_ratio
      real s4_rt_u_pre,s4_rt_p_pre,s4_rt_u_post,s4_rt_p_post
      common /stage4_diag_r/ s4_m0_norm,s4_mgt0_norm,
     $ s4_mgt0_ratio,s4_rt_u_pre,s4_rt_p_pre,
     $ s4_rt_u_post,s4_rt_p_post
      real s5_raw_norm(4),s5_commit_norm(4),s5_ucage_rms(4)
      common /stage5_diag_r/ s5_raw_norm,s5_commit_norm,
     $ s5_ucage_rms
      real s6_pc_raw_rms(4),s6_pc_raw_max(4)
      real s6_pc_app_rms(4),s6_pc_app_max(4)
      common /stage6_diag_r/ s6_pc_raw_rms,s6_pc_raw_max,
     $ s6_pc_app_rms,s6_pc_app_max
      real phys_xp,phys_yp,phys_zp,phys_up,phys_vp,phys_wp
      real phys_ox,phys_oy,phys_oz,phys_a,phys_rhop
      common /physalis_particle/ phys_xp,phys_yp,phys_zp,
     $ phys_up,phys_vp,phys_wp,phys_ox,phys_oy,phys_oz,
     $ phys_a,phys_rhop
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real pi0,rho,mu,nu,area_p,fd,cd,cdsgn,recalc,eps,den
      real fd_raw,cd_raw,cdsgn_raw
      integer fu
      parameter(fu=78)
      logical first
      save first
      data first/.true./

c     DIAG: write drag/diagnostics every step.

      call zp_validation_config
      if (phys_replay_enabled.eq.0) then
         call physalis_update_velocity_cage_residual
         call physalis_update_divergence_norm
      endif

      eps=1.0d-30
      pi0=4.0d0*atan(1.0d0)
      rho=max(abs(param(1)),eps)
      mu=abs(param(2))
      nu=mu/rho
      area_p=pi0*phys_a**2
      fd=F_phys(3)
      recalc=rho*abs(zp_flow)*(2.0d0*phys_a)/max(mu,eps)
      den=max(0.5d0*rho*zp_flow**2*area_p,eps)
      cdsgn=fd/den
      cd=abs(cdsgn)
      fd_raw=F_raw_diag(3)
      cdsgn_raw=fd_raw/den
      cd_raw=abs(cdsgn_raw)

      if (nid.eq.0) then
         if (first) then
            open(fu,file='drag.dat',status='replace')
            write(fu,'(A)') '# NP_PHYSALIS_BF_S4_RE100_P6_V1'
            write(fu,'(A)') '# step time Re U rho mu F Cd_abs '//
     $       'Cd_signed coeff_resid cage_vel_res pressure_cage_res '//
     $       'div_norm p10 phi10 raw_p10 raw_phi10 raw_norm '//
     $       'commit_norm raw_defect F_raw Cd_raw_abs Cd_raw_signed '//
     $       'm0_norm mgt0_norm mgt0_ratio rt_u_pre rt_p_pre '//
     $       'rt_u_post rt_p_post raw_n1 raw_n2 raw_n3 raw_n4 '//
     $       'commit_n1 commit_n2 commit_n3 commit_n4 '//
     $       'ucage_n1_rms ucage_n2_rms ucage_n3_rms '//
     $       'ucage_n4_rms pc_raw_P3_rms pc_raw_Phi3_rms '//
     $       'pc_raw_P4_rms pc_raw_Phi4_rms '//
     $       'pc_raw_P3_max pc_raw_Phi3_max '//
     $       'pc_raw_P4_max pc_raw_Phi4_max '//
     $       'pc_app_P3_rms pc_app_Phi3_rms '//
     $       'pc_app_P4_rms pc_app_Phi4_rms '//
     $       'pc_app_P3_max pc_app_Phi3_max '//
     $       'pc_app_P4_max pc_app_Phi4_max'
            first=.false.
         else
            open(fu,file='drag.dat',
     $           status='old',position='append')
         endif
         write(fu,100) istep,time,recalc,zp_flow,rho,mu,fd,cd,
     $      cdsgn,coeff_resid,cage_vel_res,pressure_cage_res,
     $      div_norm,p_re(1,1),phi_re(1,1),raw_p10_diag,
     $      raw_phi10_diag,raw_coeff_norm_diag,
     $      commit_coeff_norm_diag,raw_defect_diag,
     $      fd_raw,cd_raw,cdsgn_raw,
     $      s4_m0_norm,s4_mgt0_norm,s4_mgt0_ratio,
     $      s4_rt_u_pre,s4_rt_p_pre,s4_rt_u_post,s4_rt_p_post,
     $      s5_raw_norm(1),s5_raw_norm(2),
     $      s5_raw_norm(3),s5_raw_norm(4),
     $      s5_commit_norm(1),s5_commit_norm(2),
     $      s5_commit_norm(3),s5_commit_norm(4),
     $      s5_ucage_rms(1),s5_ucage_rms(2),
     $      s5_ucage_rms(3),s5_ucage_rms(4),
     $      s6_pc_raw_rms(1),s6_pc_raw_rms(2),
     $      s6_pc_raw_rms(3),s6_pc_raw_rms(4),
     $      s6_pc_raw_max(1),s6_pc_raw_max(2),
     $      s6_pc_raw_max(3),s6_pc_raw_max(4),
     $      s6_pc_app_rms(1),s6_pc_app_rms(2),
     $      s6_pc_app_rms(3),s6_pc_app_rms(4),
     $      s6_pc_app_max(1),s6_pc_app_max(2),
     $      s6_pc_app_max(3),s6_pc_app_max(4)
         close(fu)
      endif
      call stage13_write_accept_diag
      call stage34_local_diagnostics

  100 format(i9,1x,1p57e18.10)
      return
      end
c-----------------------------------------------------------------------

      subroutine physalis_pressure_frame_audit
c  State which pressure variable is exchanged between Nek and Physalis.
c  In fixed periodic OP3, userf supplies the uniform pressure-gradient
c  acceleration, so Nek's periodic pressure is already S&P p_tilde.
c  Moving cases still require the particle-acceleration frame shift.
      include 'SIZE'
      include 'TOTAL'
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode

      if (nid.ne.0) return
      if (zp_problem.ge.31 .and. zp_problem.le.34 .and.
     $    zp_moving.eq.0) then
         write(6,*) 'PHYSALIS SEM PRESSURE FRAME: ' //
     $      'FIXED_BODY_FORCE_MODIFIED (shift=0)'
      elseif (zp_moving.eq.1) then
         write(6,*) 'PHYSALIS SEM PRESSURE FRAME: ' //
     $      'MOVING_ACCELERATION_SHIFT'
      else
         write(6,*) 'PHYSALIS SEM PRESSURE FRAME: DIRECT'
      endif
      return
      end

c-----------------------------------------------------------------------

c-----------------------------------------------------------------------
      subroutine zp_reference_condition_audit
c  Fail-fast audit of the published/reference-defining inputs. Candidate
c  B's SHLS extractor is exercised at explicit q=1.20 or q=1.25 values.
c  EXP1 is the established project validation, not an exact S&P-code
c  reproduction. OP4 gravity remains unreported by Z&P and is therefore
c  diagnosed as provisional rather than claimed as a published input.
      include 'SIZE'
      include 'TOTAL'
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real tol,expected_r_sample,expected_flow,expected_re
      real expected_pstar
      integer expected_lmax,expected_moving,expected_cage_mode
      logical done
      save done
      data done/.false./
      if (done) return
      tol=1.0e-6
      expected_r_sample=r_sample_over_a
      expected_lmax=zp_lmax
      expected_moving=zp_moving
      expected_cage_mode=zp_cage_mode
      expected_flow=zp_flow
      expected_re=zp_target_re
      expected_pstar=zp_pstar
c     Moving S&P/Mordant uses zp_moving=1.  The optional fixed angular
c     branch, zp_problem=62, must remain prescribed/fixed with
c     zp_moving=0.
      if (zp_problem.eq.62 .or. zp_problem.eq.71) then
         expected_moving=0
      else
         expected_moving=1
      endif
      if (r_sample_over_a.le.1.0) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: Physalis sampling sphere must have r/a > 1'
         call exitt
      endif
      if (lmax.ne.zp_lmax) then
         if (nid.eq.0) write(6,*) 'ERROR: lmax/config mismatch'
         call exitt
      endif
      if (zp_lmax.ne.expected_lmax) then
         if (nid.eq.0) write(6,*) 'ERROR: zp_lmax audit ',
     $      zp_lmax,expected_lmax
         call exitt
      endif
      if (zp_moving.ne.expected_moving) then
         if (nid.eq.0) write(6,*) 'ERROR: zp_moving audit ',
     $      zp_moving,expected_moving
         call exitt
      endif
      if (zp_cage_mode.ne.expected_cage_mode) then
         if (nid.eq.0) write(6,*) 'ERROR: zp_cage_mode audit ',
     $      zp_cage_mode,expected_cage_mode
         call exitt
      endif
      if (abs(zp_flow-expected_flow).gt.tol) then
         if (nid.eq.0) write(6,*) 'ERROR: zp_flow audit ',
     $      zp_flow,expected_flow
         call exitt
      endif
      if (abs(zp_target_re-expected_re).gt.tol) then
         if (nid.eq.0) write(6,*) 'ERROR: zp_target_re audit ',
     $      zp_target_re,expected_re
         call exitt
      endif
      if (abs(zp_pstar-expected_pstar).gt.tol) then
         if (nid.eq.0) write(6,*) 'ERROR: zp_pstar audit ',
     $      zp_pstar,expected_pstar
         call exitt
      endif
      done=.true.
      return
      end
c-----------------------------------------------------------------------
c-----------------------------------------------------------------------
      subroutine spmove_validation_params(a,rhop_ratio,gz,vt,tau95)
      real a,rhop_ratio,gz,vt,tau95
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      call validation_config
      a=cfg_radius
      rhop_ratio=cfg_rhop_ratio
      gz=cfg_gz
      vt=cfg_vt_ref
      tau95=cfg_tau95_ref
      return
      end
c-----------------------------------------------------------------------
      subroutine spmove_init_once
      include 'SIZE'
      include 'TOTAL'
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      logical initialized
      save initialized
      data initialized /.false./
      real xl,xu,yl,yu,zl,zu
      real xmin_l,xmax_l,ymin_l,ymax_l,zmin_l,zmax_l
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized
      integer i,j,k,e
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real val_origin(3),nu_safe,tau_stokes
      common /validation_origin_r/ val_origin

      if (initialized) return
      call validation_config
      call spmove_validation_params(sm_a,sm_rhop,sm_gz,
     $   sm_vt,sm_tau)

      xmin_l =  1.0e30
      ymin_l =  1.0e30
      zmin_l =  1.0e30
      xmax_l = -1.0e30
      ymax_l = -1.0e30
      zmax_l = -1.0e30
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         xmin_l = min(xmin_l,xm1(i,j,k,e))
         xmax_l = max(xmax_l,xm1(i,j,k,e))
         ymin_l = min(ymin_l,ym1(i,j,k,e))
         ymax_l = max(ymax_l,ym1(i,j,k,e))
         zmin_l = min(zmin_l,zm1(i,j,k,e))
         zmax_l = max(zmax_l,zm1(i,j,k,e))
      enddo
      enddo
      enddo
      enddo
      sm_xmin = glmin(xmin_l,1)
      sm_xmax = glmax(xmax_l,1)
      sm_ymin = glmin(ymin_l,1)
      sm_ymax = glmax(ymax_l,1)
      sm_zmin = glmin(zmin_l,1)
      sm_zmax = glmax(zmax_l,1)
      if (ldim.eq.2) then
c        Axisymmetric prototype map:
c        Nek x is axial, Nek y is radius, Physalis y is suppressed.
         sm_zmin = sm_xmin
         sm_zmax = sm_xmax
         sm_xmin = sm_ymin
         sm_xmax = sm_ymax
         sm_ymin = 0.0
         sm_ymax = 0.0
      endif

      if (cfg_center_mode.eq.0) then
         sm_x=cfg_center(1)
         sm_y=cfg_center(2)
         sm_z=cfg_center(3)
      elseif (cfg_center_mode.eq.1) then
         sm_x=0.5*(sm_xmin+sm_xmax)
         sm_y=0.5*(sm_ymin+sm_ymax)
         sm_z=0.5*(sm_zmin+sm_zmax)
      else
         sm_x=0.5*(sm_xmin+sm_xmax)
         sm_y=0.5*(sm_ymin+sm_ymax)
         sm_z=sm_zmax-cfg_top_offset_over_a*sm_a
      endif
      val_origin(1)=sm_x
      val_origin(2)=sm_y
      val_origin(3)=sm_z
      sm_u=0.0
      sm_v=0.0
      sm_w=0.0
      sm_ax_prev=0.0
      sm_ay_prev=0.0
      sm_az_prev=0.0
      sm_accel_initialized=0

c     Case 3 exact Stokes terminal scale and nominal exponential tau95.
      if (validation_case.eq.3) then
         nu_safe=max(abs(param(2)),1.0e-30)
         if (sm_vt.le.0.0) sm_vt=2.0*sm_a**2*
     $      (sm_rhop-1.0)*abs(sm_gz)/(9.0*nu_safe)
         if (sm_tau.le.0.0) then
            tau_stokes=2.0*sm_rhop*sm_a**2/(9.0*nu_safe)
            sm_tau=-log(0.05)*tau_stokes
         endif
      endif
      if (validation_case.eq.1 .and. sm_vt.le.0.0)
     $   sm_vt=sqrt(cfg_flow(1)**2+cfg_flow(2)**2+cfg_flow(3)**2)
      if (validation_case.le.2) call
     $   validation_set_prescribed_state(0.0)
      initialized = .true.

      if (nid.eq.0) then
         write(6,*) 'SPMOVE init: x/y/z=',sm_x,sm_y,sm_z
         write(6,*) 'SPMOVE domain x=',sm_xmin,sm_xmax
         write(6,*) 'SPMOVE domain y=',sm_ymin,sm_ymax
         write(6,*) 'SPMOVE domain z=',sm_zmin,sm_zmax
         write(6,*) 'SPMOVE a,rhop_ratio,gz=',sm_a,sm_rhop,sm_gz
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_sync_particle_bookkeeping
c  Stock Nek5000 Physalis port: no LPM/IBM particle container.
c  Particle state lives in /spmove_state_r/ and /physalis_particle/.
      return
      end
c-----------------------------------------------------------------------
      subroutine spmove_startup_gain(gain)
c     S&P 2016 sedimentation validation: apply full gravity from the
c     first physical time step.  No numerical startup ramp is used.
      real gain
      gain = 1.0
      return
      end
c-----------------------------------------------------------------------

c-----------------------------------------------------------------------
      subroutine physalis_begin_particle_step
c  Freeze the committed physical time-n state.  Kappa candidates are
c  always recomputed from this baseline and never time-accumulated.
      include 'SIZE'
      include 'TOTAL'
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized
      real pk_xn,pk_yn,pk_zn,pk_un,pk_vn,pk_wn
      real pk_anx,pk_any,pk_anz,pk_uk,pk_vk,pk_wk
      real pk_akx,pk_aky,pk_akz,pk_uc,pk_vc,pk_wc
      real pk_acx,pk_acy,pk_acz
      real coeff_resid_raw,coeff_resid_relaxed
      real particle_resid_a,particle_resid_w,closure_resid
      common /physalis_kappa_r/ pk_xn,pk_yn,pk_zn,
     $ pk_un,pk_vn,pk_wn,pk_anx,pk_any,pk_anz,
     $ pk_uk,pk_vk,pk_wk,pk_akx,pk_aky,pk_akz,
     $ pk_uc,pk_vc,pk_wc,pk_acx,pk_acy,pk_acz,
     $ coeff_resid_raw,coeff_resid_relaxed,
     $ particle_resid_a,particle_resid_w,closure_resid
      integer phys_kappa_active,phys_accept_ready,phys_inner_used
      integer phys_last_begin_step,phys_last_commit_step
      common /physalis_kappa_i/ phys_kappa_active,
     $ phys_accept_ready,phys_inner_used,
     $ phys_last_begin_step,phys_last_commit_step

      if (phys_last_begin_step.eq.istep) return
      pk_xn=sm_x
      pk_yn=sm_y
      pk_zn=sm_z
      pk_un=sm_u
      pk_vn=sm_v
      pk_wn=sm_w
      if (sm_accel_initialized.eq.0) then
         pk_anx=0.0
         pk_any=0.0
         pk_anz=0.0
      else
         pk_anx=sm_ax_prev
         pk_any=sm_ay_prev
         pk_anz=sm_az_prev
      endif
      pk_uk=pk_un
      pk_vk=pk_vn
      pk_wk=pk_wn
      pk_akx=pk_anx
      pk_aky=pk_any
      pk_akz=pk_anz
      pk_uc=pk_uk
      pk_vc=pk_vk
      pk_wc=pk_wk
      pk_acx=pk_akx
      pk_acy=pk_aky
      pk_acz=pk_akz
      coeff_resid_raw=1.0e30
      coeff_resid_relaxed=1.0e30
      particle_resid_a=1.0e30
      particle_resid_w=1.0e30
      closure_resid=1.0e30
      phys_inner_used=0
      phys_accept_ready=0
      phys_kappa_active=1
      phys_last_begin_step=istep
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_particle_map(ainx,ainy,ainz,
     $ aoutx,aouty,aoutz,uout,vout,wout)
c  Production wrapper using the force stored in /phys_frc/.
      real ainx,ainy,ainz,aoutx,aouty,aoutz,uout,vout,wout
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      call physalis_particle_map_force(ainx,ainy,ainz,F_phys(3),
     $ aoutx,aouty,aoutz,uout,vout,wout)
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_particle_map_force(ainx,ainy,ainz,Fzin,
     $ aoutx,aouty,aoutz,uout,vout,wout)
c  S&P A.28-A.29 and A.26 with an explicit reduced-force input.
c  This read-only map is used to form a particle raw candidate from the
c  same coefficient raw map that enters the coupled Anderson residual.
      include 'SIZE'
      include 'TOTAL'
      real ainx,ainy,ainz,Fzin
      real aoutx,aouty,aoutz,uout,vout,wout
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real pk_xn,pk_yn,pk_zn,pk_un,pk_vn,pk_wn
      real pk_anx,pk_any,pk_anz,pk_uk,pk_vk,pk_wk
      real pk_akx,pk_aky,pk_akz,pk_uc,pk_vc,pk_wc
      real pk_acx,pk_acy,pk_acz
      real coeff_resid_raw,coeff_resid_relaxed
      real particle_resid_a,particle_resid_w,closure_resid
      common /physalis_kappa_r/ pk_xn,pk_yn,pk_zn,
     $ pk_un,pk_vn,pk_wn,pk_anx,pk_any,pk_anz,
     $ pk_uk,pk_vk,pk_wk,pk_akx,pk_aky,pk_akz,
     $ pk_uc,pk_vc,pk_wc,pk_acx,pk_acy,pk_acz,
     $ coeff_resid_raw,coeff_resid_relaxed,
     $ particle_resid_a,particle_resid_w,closure_resid
      real pi_loc,Vp,rho_f,rho_p,gstart
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer phys_kappa_active,phys_accept_ready,phys_inner_used
      integer phys_last_begin_step,phys_last_commit_step
      common /physalis_kappa_i/ phys_kappa_active,
     $ phys_accept_ready,phys_inner_used,
     $ phys_last_begin_step,phys_last_commit_step
      real xt,yt,zt
      call validation_config
      if (validation_case.le.2 .and. phys_kappa_active.eq.1) then
         call validation_prescribed_kinematics(time,xt,yt,zt,
     $      uout,vout,wout,aoutx,aouty,aoutz)
         return
      endif

      pi_loc=4.0*atan(1.0)
      Vp=4.0*pi_loc*sm_a**3/3.0
      rho_f=param(1)
      rho_p=sm_rhop*rho_f
      call spmove_startup_gain(gstart)
      aoutx=0.0
      aouty=0.0
      aoutz=(rho_f/rho_p)*ainz+Fzin/(rho_p*Vp)
     $       +(1.0-rho_f/rho_p)*gstart*sm_gz
      uout=0.0
      vout=0.0
      wout=pk_wn+0.5*dt*(aoutz+pk_anz)
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_coeff_residual_pair(pr1,pi1,fr1,fi1,
     $ vr1,vi1,pr0,pi0,fr0,fi0,vr0,vi0,luse,res)
c  Global relative L2 fixed-point defect over all retained complex
c  Lamb coefficients.  This is the same norm used by the established
c  physalis_iteration production path.  A per-mode maximum relative
c  defect is not a valid global convergence gate: a coefficient only
c  1e-4 of the leading mode would be forced to an absolute defect of
c  1e-6 of the leading mode at a 1e-2 tolerance, and can therefore stop
c  an otherwise converged physical state because of interpolation noise.
      real pr1(4,5),pi1(4,5),fr1(4,5),fi1(4,5)
      real vr1(4,5),vi1(4,5),pr0(4,5),pi0(4,5)
      real fr0(4,5),fi0(4,5),vr0(4,5),vi0(4,5)
      integer luse,n,m
      real res,num,den,eps
      eps=1.0e-30
      num=0.0
      den=0.0
      do n=1,luse
      do m=0,n
         num=num+
     $      (pr1(n,m+1)-pr0(n,m+1))**2+
     $      (pi1(n,m+1)-pi0(n,m+1))**2+
     $      (fr1(n,m+1)-fr0(n,m+1))**2+
     $      (fi1(n,m+1)-fi0(n,m+1))**2+
     $      (vr1(n,m+1)-vr0(n,m+1))**2+
     $      (vi1(n,m+1)-vi0(n,m+1))**2
         den=den+
     $      pr1(n,m+1)**2+pi1(n,m+1)**2+
     $      fr1(n,m+1)**2+fi1(n,m+1)**2+
     $      vr1(n,m+1)**2+vi1(n,m+1)**2
      enddo
      enddo
      res=sqrt(num/max(den,eps))
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_save_old_masks
      include 'SIZE'
      include 'TOTAL'
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      integer old_inside_u(lx1,ly1,lz1,lelv)
      integer old_cage_u(lx1,ly1,lz1,lelv)
      integer old_inside_p(lx2,ly2,lz2,lelv)
      integer old_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_old_masks_u/ old_inside_u,old_cage_u
      common /physalis_old_masks_p/ old_inside_p,old_cage_p
      integer e,i,j,k
      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         old_inside_u(i,j,k,e)=mask_inside_u(i,j,k,e)
         old_cage_u(i,j,k,e)=mask_cage_u(i,j,k,e)
      enddo
      enddo
      enddo
      enddo
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         old_inside_p(i,j,k,e)=mask_inside_p(i,j,k,e)
         old_cage_p(i,j,k,e)=mask_cage_p(i,j,k,e)
      enddo
      enddo
      enddo
      enddo
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_history_init_once
      include 'SIZE'
      include 'TOTAL'
      integer phmax
      parameter(phmax=2*lorder-1)
      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax),ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      integer ph_initialized,ph_count
      common /physalis_history_i/ ph_initialized,ph_count
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized
      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer ih,n,m
      if (ph_initialized.eq.1) return
      do ih=1,phmax
         ph_x(1,ih)=sm_x
         ph_x(2,ih)=sm_y
         ph_x(3,ih)=sm_z
         ph_w(1,ih)=sm_u
         ph_w(2,ih)=sm_v
         ph_w(3,ih)=sm_w
         ph_acc(1,ih)=sm_ax_prev
         ph_acc(2,ih)=sm_ay_prev
         ph_acc(3,ih)=sm_az_prev
         ph_pref(ih)=phys_pressure_ref
         do n=1,4
         do m=1,5
            ph_pr(n,m,ih)=p_re(n,m)
            ph_pi(n,m,ih)=p_im(n,m)
            ph_fr(n,m,ih)=phi_re(n,m)
            ph_fi(n,m,ih)=phi_im(n,m)
            ph_vr(n,m,ih)=v_re(n,m)
            ph_vi(n,m,ih)=v_im(n,m)
         enddo
         enddo
      enddo
      ph_initialized=1
      ph_count=phmax
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_shift_physical_history
      include 'SIZE'
      include 'TOTAL'
      integer phmax
      parameter(phmax=2*lorder-1)
      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax),ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      integer ph_initialized,ph_count
      common /physalis_history_i/ ph_initialized,ph_count
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized
      real phys_pressure_ref
      common /physalis_pressure_reference/ phys_pressure_ref
      integer ih,n,m,last_shift_step
      save last_shift_step
      data last_shift_step/-999999/
      if (last_shift_step.eq.istep) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: physical history shifted twice at step ',istep
         call exitt
      endif
      last_shift_step=istep
      if (ph_initialized.ne.1) call physalis_history_init_once
      do ih=phmax,2,-1
         ph_x(1,ih)=ph_x(1,ih-1)
         ph_x(2,ih)=ph_x(2,ih-1)
         ph_x(3,ih)=ph_x(3,ih-1)
         ph_w(1,ih)=ph_w(1,ih-1)
         ph_w(2,ih)=ph_w(2,ih-1)
         ph_w(3,ih)=ph_w(3,ih-1)
         ph_acc(1,ih)=ph_acc(1,ih-1)
         ph_acc(2,ih)=ph_acc(2,ih-1)
         ph_acc(3,ih)=ph_acc(3,ih-1)
         ph_pref(ih)=ph_pref(ih-1)
         do n=1,4
         do m=1,5
            ph_pr(n,m,ih)=ph_pr(n,m,ih-1)
            ph_pi(n,m,ih)=ph_pi(n,m,ih-1)
            ph_fr(n,m,ih)=ph_fr(n,m,ih-1)
            ph_fi(n,m,ih)=ph_fi(n,m,ih-1)
            ph_vr(n,m,ih)=ph_vr(n,m,ih-1)
            ph_vi(n,m,ih)=ph_vi(n,m,ih-1)
         enddo
         enddo
      enddo
      ph_x(1,1)=sm_x
      ph_x(2,1)=sm_y
      ph_x(3,1)=sm_z
      ph_w(1,1)=sm_u
      ph_w(2,1)=sm_v
      ph_w(3,1)=sm_w
      ph_acc(1,1)=sm_ax_prev
      ph_acc(2,1)=sm_ay_prev
      ph_acc(3,1)=sm_az_prev
      ph_pref(1)=phys_pressure_ref
      do n=1,4
      do m=1,5
         ph_pr(n,m,1)=p_re(n,m)
         ph_pi(n,m,1)=p_im(n,m)
         ph_fr(n,m,1)=phi_re(n,m)
         ph_fi(n,m,1)=phi_im(n,m)
         ph_vr(n,m,1)=v_re(n,m)
         ph_vi(n,m,1)=v_im(n,m)
      enddo
      enddo
      ph_count=min(ph_count+1,phmax)
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_eval_history_velocity(ih,x,y,z,u,v,w)
      include 'SIZE'
      include 'TOTAL'
      integer ih,phmax
      parameter(phmax=2*lorder-1)
      real x,y,z,u,v,w
      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax),ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real hx,hy,hz,hr,ulx,uly,ulz,nu
      hx=x-ph_x(1,ih)
      hy=y-ph_x(2,ih)
      hz=z-ph_x(3,ih)
      hr=sqrt(hx*hx+hy*hy+hz*hz)
      u=ph_w(1,ih)
      v=ph_w(2,ih)
      w=ph_w(3,ih)
      if (hr.gt.sm_a) then
         nu=abs(param(2))
         call physalis_lamb_vel_at_point(hx,hy,hz,hr,sm_a,nu,
     $      ph_pr(1,1,ih),ph_pi(1,1,ih),
     $      ph_fr(1,1,ih),ph_fi(1,1,ih),lmax,ulx,uly,ulz)
         u=u+ulx
         v=v+uly
         w=w+ulz
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_eval_history_pressure(ih,x,y,z,p)
      include 'SIZE'
      include 'TOTAL'
      integer ih,phmax
      parameter(phmax=2*lorder-1)
      real x,y,z,p
      real ph_x(3,phmax),ph_w(3,phmax),ph_acc(3,phmax)
      real ph_pr(4,5,phmax),ph_pi(4,5,phmax)
      real ph_fr(4,5,phmax),ph_fi(4,5,phmax)
      real ph_vr(4,5,phmax),ph_vi(4,5,phmax),ph_pref(phmax)
      common /physalis_history_r/ ph_x,ph_w,ph_acc,
     $ ph_pr,ph_pi,ph_fr,ph_fi,ph_vr,ph_vi,ph_pref
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      real hx,hy,hz,hr,ptil,pshift,rho_f
      hx=x-ph_x(1,ih)
      hy=y-ph_x(2,ih)
      hz=z-ph_x(3,ih)
      hr=sqrt(hx*hx+hy*hy+hz*hz)
      ptil=0.0
      if (hr.gt.sm_a) then
         call physalis_lamb_pressure_at_point(hx,hy,hz,hr,sm_a,
     $      ph_pr(1,1,ih),ph_pi(1,1,ih),
     $      ph_fr(1,1,ih),ph_fi(1,1,ih),lmax,ptil)
      endif
      rho_f=param(1)
      pshift=-rho_f*(ph_acc(1,ih)*hx+ph_acc(2,ih)*hy+
     $                ph_acc(3,ih)*hz)
      p=ptil+ph_pref(ih)+pshift
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_refill_transition_history
c  Synchronize the complete multistep history whenever the moving internal
c  Dirichlet set changes.  The former implementation initialized only nodes
c  RELEASED from the old particle/cage.  A newly constrained GLL node kept
c  its old free-fluid vxlag/vylag/vzlag (and prlag) values while BCDIRVC
c  imposed an analytic current value.  That mixed-time state creates an
c  O(1) BDF impulse when the cage topology changes.  Refresh all nodes in
c  the union of the old and new constrained sets: currently constrained
c  nodes receive consistent analytic histories, and newly released nodes
c  receive the same analytic continuation used by the established refill.
      include 'SIZE'
      include 'TOTAL'
      integer mask_inside_u(lx1,ly1,lz1,lelv)
      integer mask_cage_u(lx1,ly1,lz1,lelv)
      integer mask_inside_p(lx2,ly2,lz2,lelv)
      integer mask_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_masks_u/ mask_inside_u,mask_cage_u
      common /physalis_masks_p/ mask_inside_p,mask_cage_p
      integer old_inside_u(lx1,ly1,lz1,lelv)
      integer old_cage_u(lx1,ly1,lz1,lelv)
      integer old_inside_p(lx2,ly2,lz2,lelv)
      integer old_cage_p(lx2,ly2,lz2,lelv)
      common /physalis_old_masks_u/ old_inside_u,old_cage_u
      common /physalis_old_masks_p/ old_inside_p,old_cage_p
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      integer e,i,j,k,il,ih
      integer new_u_l,rel_u_l,new_p_l,rel_p_l
      integer new_u_g,rel_u_g,new_p_g,rel_p_g
      integer fu
      parameter(fu=73)
      real uu,vv,ww,pp,du,dv,dw,hx,hy,hz
      real dnew_u_l,dnew_u_g,eps
      logical oldcu,newcu,oldcp,newcp
      logical first
      save first
      data first /.true./

      new_u_l=0
      rel_u_l=0
      new_p_l=0
      rel_p_l=0
      dnew_u_l=0.0
      eps=1.0e-30

      do e=1,nelv
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         oldcu=(old_inside_u(i,j,k,e).eq.1 .or.
     $          old_cage_u(i,j,k,e).eq.1)
         newcu=(mask_inside_u(i,j,k,e).eq.1 .or.
     $          mask_cage_u(i,j,k,e).eq.1)
         if (newcu .and. .not.oldcu) then
            new_u_l=new_u_l+1
            hx=xm1(i,j,k,e)
            hy=ym1(i,j,k,e)
            hz=zm1(i,j,k,e)
            if (ldim.eq.2) then
               hx=ym1(i,j,k,e)
               hy=0.0
               hz=xm1(i,j,k,e)
            endif
            call physalis_eval_history_velocity(1,hx,hy,hz,uu,vv,ww)
            du=vx(i,j,k,e)-uu
            if (ldim.eq.2) then
               du=vx(i,j,k,e)-ww
               dv=vy(i,j,k,e)-uu
               dw=0.0
            else
               dv=vy(i,j,k,e)-vv
               dw=vz(i,j,k,e)-ww
            endif
            dnew_u_l=dnew_u_l+du*du+dv*dv+dw*dw
         elseif (oldcu .and. .not.newcu) then
            rel_u_l=rel_u_l+1
         endif

c        The union refresh is intentional.  Nodes that remain constrained
c        also need BDF histories at the actual physical-time particle/Lamb
c        states, not histories inherited from an earlier topology.
         if (newcu .or. oldcu) then
            hx=xm1(i,j,k,e)
            hy=ym1(i,j,k,e)
            hz=zm1(i,j,k,e)
            if (ldim.eq.2) then
               hx=ym1(i,j,k,e)
               hy=0.0
               hz=xm1(i,j,k,e)
            endif
            call physalis_eval_history_velocity(1,hx,hy,hz,uu,vv,ww)
            if (ldim.eq.2) then
               vx(i,j,k,e)=ww
               vy(i,j,k,e)=uu
               vz(i,j,k,e)=0.0
            else
               vx(i,j,k,e)=uu
               vy(i,j,k,e)=vv
               vz(i,j,k,e)=ww
            endif
            do il=1,lorder-1
               ih=il+1
               call physalis_eval_history_velocity(ih,hx,hy,hz,
     $            uu,vv,ww)
               if (ldim.eq.2) then
                  vxlag(i,j,k,e,il)=ww
                  vylag(i,j,k,e,il)=uu
                  vzlag(i,j,k,e,il)=0.0
               else
                  vxlag(i,j,k,e,il)=uu
                  vylag(i,j,k,e,il)=vv
                  vzlag(i,j,k,e,il)=ww
               endif
            enddo
         endif
      enddo
      enddo
      enddo
      enddo

      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         oldcp=(old_inside_p(i,j,k,e).eq.1 .or.
     $          old_cage_p(i,j,k,e).eq.1)
         newcp=(mask_inside_p(i,j,k,e).eq.1 .or.
     $          mask_cage_p(i,j,k,e).eq.1)
         if (newcp .and. .not.oldcp) then
            new_p_l=new_p_l+1
         elseif (oldcp .and. .not.newcp) then
            rel_p_l=rel_p_l+1
         endif
         if (oldcp .and. .not.newcp) then
            hx=xm2(i,j,k,e)
            hy=ym2(i,j,k,e)
            hz=zm2(i,j,k,e)
            if (ldim.eq.2) then
               hx=ym2(i,j,k,e)
               hy=0.0
               hz=xm2(i,j,k,e)
            endif
            call physalis_eval_history_pressure(1,hx,hy,hz,pp)
            pr(i,j,k,e)=pp
            do il=1,lorder-2
               ih=il+1
               call physalis_eval_history_pressure(ih,hx,hy,hz,pp)
               prlag(i,j,k,e,il)=pp
            enddo
         endif
      enddo
      enddo
      enddo
      enddo

      new_u_g=iglsum(new_u_l,1)
      rel_u_g=iglsum(rel_u_l,1)
      new_p_g=iglsum(new_p_l,1)
      rel_p_g=iglsum(rel_p_l,1)
      dnew_u_g=glsum(dnew_u_l,1)
      dnew_u_g=sqrt(dnew_u_g/max(3.0*float(new_u_g),eps))
     $        /max(abs(sm_vt),eps)

      if (nid.eq.0) then
         if (first) then
            open(fu,file='physalis_cage_transition.dat',
     $           status='replace')
            write(fu,'(A)')
     $       '# step t new_u released_u new_p released_p ' //
     $       'new_u_pre_refresh_rms_over_Vt'
            first=.false.
         else
            open(fu,file='physalis_cage_transition.dat',
     $           status='old',position='append')
         endif
         write(fu,'(I9,1X,E16.8,4I10,E16.8)')
     $      istep,time,new_u_g,rel_u_g,new_p_g,rel_p_g,dnew_u_g
         close(fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine spmove_commit_particle
c  Commit the accepted coupled state exactly once.  No force or acceleration
c  is recomputed here; this prevents the legacy double update.
      include 'SIZE'
      include 'TOTAL'
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real sm_ax_prev,sm_ay_prev,sm_az_prev
      integer sm_accel_initialized
      common /spmove_accel_r/ sm_ax_prev,sm_ay_prev,sm_az_prev
      common /spmove_accel_i/ sm_accel_initialized
      real pk_xn,pk_yn,pk_zn,pk_un,pk_vn,pk_wn
      real pk_anx,pk_any,pk_anz,pk_uk,pk_vk,pk_wk
      real pk_akx,pk_aky,pk_akz,pk_uc,pk_vc,pk_wc
      real pk_acx,pk_acy,pk_acz
      real coeff_resid_raw,coeff_resid_relaxed
      real particle_resid_a,particle_resid_w,closure_resid
      common /physalis_kappa_r/ pk_xn,pk_yn,pk_zn,
     $ pk_un,pk_vn,pk_wn,pk_anx,pk_any,pk_anz,
     $ pk_uk,pk_vk,pk_wk,pk_akx,pk_aky,pk_akz,
     $ pk_uc,pk_vc,pk_wc,pk_acx,pk_acy,pk_acz,
     $ coeff_resid_raw,coeff_resid_relaxed,
     $ particle_resid_a,particle_resid_w,closure_resid
      integer phys_kappa_active,phys_accept_ready,phys_inner_used
      integer phys_last_begin_step,phys_last_commit_step
      common /physalis_kappa_i/ phys_kappa_active,
     $ phys_accept_ready,phys_inner_used,
     $ phys_last_begin_step,phys_last_commit_step
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      if (phys_accept_ready.ne.1) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: particle commit requested without accepted state'
         call exitt
      endif
      if (phys_last_commit_step.eq.istep) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: duplicate particle commit at step ',istep
         call exitt
      endif

      call validation_config
      call zp_validation_config
      if (validation_case.le.2) then
c        Old masks were saved before the prescribed state was imposed.
         call validation_set_prescribed_state(time)
         pk_uk=sm_u
         pk_vk=sm_v
         pk_wk=sm_w
         pk_akx=sm_ax_prev
         pk_aky=sm_ay_prev
         pk_akz=sm_az_prev
      else
         call physalis_save_old_masks
         sm_u=pk_uk
         sm_v=pk_vk
         sm_w=pk_wk
         sm_x=pk_xn+0.5*dt*(pk_un+pk_uk)
         sm_y=pk_yn+0.5*dt*(pk_vn+pk_vk)
         sm_z=pk_zn+0.5*dt*(pk_wn+pk_wk)
         sm_ax_prev=pk_akx
         sm_ay_prev=pk_aky
         sm_az_prev=pk_akz
         if (zp_problem.eq.41) call zp_wrap_op4_particle
      endif
      sm_accel_initialized=1
      pk_uc=pk_uk
      pk_vc=pk_vk
      pk_wc=pk_wk
      pk_acx=pk_akx
      pk_acy=pk_aky
      pk_acz=pk_akz

      if (zp_moving.eq.1) then
         if (ldim.eq.2) then
c           Axisym: sm_x=0 is the axis; sm_y is suppressed.
c           Stop only near outer radius and axial ends.
            if (sm_x.ge.sm_xmax-2.0*sm_a .or.
     $         (zp_problem.ne.41 .and.
     $         (sm_z.le.sm_zmin+2.0*sm_a .or.
     $          sm_z.ge.sm_zmax-2.0*sm_a))) then
               if (nid.eq.0) write(6,*)
     $            'VALIDATION stop: particle approached outer boundary'
               call exitt
            endif
         else
            if (sm_x.le.sm_xmin+2.0*sm_a .or.
     $          sm_x.ge.sm_xmax-2.0*sm_a .or.
     $          sm_y.le.sm_ymin+2.0*sm_a .or.
     $          sm_y.ge.sm_ymax-2.0*sm_a .or.
     $         (zp_problem.ne.41 .and.
     $         (sm_z.le.sm_zmin+2.0*sm_a .or.
     $          sm_z.ge.sm_zmax-2.0*sm_a))) then
               if (nid.eq.0) write(6,*)
     $            'VALIDATION stop: particle approached outer boundary'
               call exitt
            endif
         endif
      endif

      phys_kappa_active=0
      phys_last_commit_step=istep
      phys_accept_ready=0
      if (validation_case.le.2) then
         call validation_replace_history_slot1
      else
         call physalis_shift_physical_history
      endif
      call physalis_sync_particle_bookkeeping
      call physalis_update_particle_state
      call physalis_build_gll_cage
      call physalis_refill_transition_history
      if (phys_mode.ge.3) call physalis_reconstruct_velocity_cage
      if (phys_mode.ge.5) call physalis_reconstruct_pressure_cage
      return
      end
c-----------------------------------------------------------------------
      subroutine write_sp_moving_history
c  Cases 3/4 free-particle history.  Case 3 includes the exact Stokes
c  terminal scale and a simple no-history exponential diagnostic.  The
c  exact BBO transient is evaluated by post_case3_free_lowre_bbo.py.
      include 'SIZE'
      include 'TOTAL'
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      integer extractor_mode
      common /validation_extractor_i/ extractor_mode
      real sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,sm_a,sm_rhop
      real sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,sm_ymin,sm_ymax
      real sm_zmin,sm_zmax
      common /spmove_state_r/ sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,
     $ sm_a,sm_rhop,sm_gz,sm_vt,sm_tau,sm_xmin,sm_xmax,
     $ sm_ymin,sm_ymax,sm_zmin,sm_zmax
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid

      real pk_xn,pk_yn,pk_zn,pk_un,pk_vn,pk_wn
      real pk_anx,pk_any,pk_anz,pk_uk,pk_vk,pk_wk
      real pk_akx,pk_aky,pk_akz,pk_uc,pk_vc,pk_wc
      real pk_acx,pk_acy,pk_acz
      real coeff_resid_raw,coeff_resid_relaxed
      real particle_resid_a,particle_resid_w,closure_resid
      common /physalis_kappa_r/ pk_xn,pk_yn,pk_zn,
     $ pk_un,pk_vn,pk_wn,pk_anx,pk_any,pk_anz,
     $ pk_uk,pk_vk,pk_wk,pk_akx,pk_aky,pk_akz,
     $ pk_uc,pk_vc,pk_wc,pk_acx,pk_acy,pk_acz,
     $ coeff_resid_raw,coeff_resid_relaxed,
     $ particle_resid_a,particle_resid_w,closure_resid
      integer phys_kappa_active,phys_accept_ready,phys_inner_used
      integer phys_last_begin_step,phys_last_commit_step
      common /physalis_kappa_i/ phys_kappa_active,
     $ phys_accept_ready,phys_inner_used,
     $ phys_last_begin_step,phys_last_commit_step

      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      integer fu
      parameter(fu=77)
      logical first_call
      save first_call
      data first_call /.true./
      real pi_loc,Vp,rho_f,rho_p,mu,Fbody,Fh_total,Fnet
      real Re,Vmag,Vover,nu_safe,vt_safe,tau_safe,gstart
      real bottom_gap_over_a,top_gap_over_a,settling_speed
      real Re_ref,tau_stokes,Vsimple,Vsimple_ratio,Vsimple_err
      real Fstokes_z,Fstokes_err,Fscale

      if (istep.gt.10 .and. mod(istep,10).ne.0) return

      pi_loc=4.0*atan(1.0)
      Vp=4.0*pi_loc*sm_a**3/3.0
      rho_f=param(1)
      rho_p=sm_rhop*rho_f
      nu_safe=max(abs(param(2)),1.0e-30)
      mu=rho_f*nu_safe
      call spmove_startup_gain(gstart)
      Fbody=(rho_p-rho_f)*Vp*gstart*sm_gz
      Fh_total=rho_f*Vp*pk_acz+F_phys(3)
      Fnet=Fh_total+Fbody

      Vmag=sqrt(sm_u**2+sm_v**2+sm_w**2)
      settling_speed=-sm_w
      vt_safe=max(abs(sm_vt),1.0e-30)
      tau_safe=max(sm_tau,1.0e-30)
      Re=2.0*sm_a*Vmag/nu_safe
      Re_ref=2.0*sm_a*abs(sm_vt)/nu_safe
      Vover=settling_speed/vt_safe
      bottom_gap_over_a=(sm_z-sm_zmin)/sm_a-1.0
      top_gap_over_a=(sm_zmax-sm_z)/sm_a-1.0

      Vsimple=-1.0
      Vsimple_ratio=-1.0
      Vsimple_err=-1.0
      Fstokes_z=-1.0
      Fstokes_err=-1.0
      if (validation_case.eq.3) then
c        This exponential omits added mass/history and is diagnostic only.
         tau_stokes=sm_tau/max(-log(0.05),1.0e-30)
         Vsimple=abs(sm_vt)*(1.0-exp(-time/
     $             max(tau_stokes,1.0e-30)))
         Vsimple_ratio=Vsimple/vt_safe
         Vsimple_err=abs(settling_speed-Vsimple)/vt_safe
         Fstokes_z=-6.0*pi_loc*mu*sm_a*sm_w
         Fscale=6.0*pi_loc*mu*sm_a*vt_safe
         Fstokes_err=abs(Fh_total-Fstokes_z)/max(Fscale,1.0e-30)
      endif

      if (nid.eq.0) then
         if (first_call) then
            open(fu,file='sp_moving_validation_history.dat',
     $           status='replace')
            write(fu,'(A)') '# step t dt case extractor x y z u v w ' //
     $      'settling_speed Re Re_ref V_over_Vt t_over_tau95 ' //
     $      'bottom_gap_over_a top_gap_over_a Fhat_x Fhat_y Fhat_z ' //
     $      'Fh_total_z Fbody_z Fnet_z ax ay az coeff_resid_raw ' //
     $      'coeff_resid_relaxed particle_resid_a particle_resid_w ' //
     $      'closure_resid cage_vel_apply_res ' //
     $      'pressure_cage_apply_res ' //
     $      'div_norm inner_used lmax r_sample_over_a a rho_f rho_p ' //
     $      'gz nu Vt_ref tau95_ref V_stokes_exp ' //
     $      'V_stokes_exp_over_Vt V_stokes_exp_error ' //
     $      'F_stokes_z F_stokes_error'
            first_call=.false.
         else
            open(fu,file='sp_moving_validation_history.dat',
     $           status='old',position='append')
         endif
         write(fu,*) istep,time,dt,validation_case,extractor_mode,
     $      sm_x,sm_y,sm_z,sm_u,sm_v,sm_w,settling_speed,
     $      Re,Re_ref,Vover,time/tau_safe,
     $      bottom_gap_over_a,top_gap_over_a,
     $      F_phys(1),F_phys(2),F_phys(3),Fh_total,Fbody,Fnet,
     $      pk_acx,pk_acy,pk_acz,coeff_resid_raw,
     $      coeff_resid_relaxed,particle_resid_a,
     $      particle_resid_w,closure_resid,cage_vel_res,
     $      pressure_cage_res,div_norm,phys_inner_used,
     $      lmax,r_sample_over_a,sm_a,rho_f,rho_p,sm_gz,
     $      nu_safe,sm_vt,sm_tau,Vsimple,Vsimple_ratio,
     $      Vsimple_err,Fstokes_z,Fstokes_err
         close(fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_pre_plan3_hook(igeom)
c     Re100 fixed-sphere cold-start matrix.
c     replay=0: retain the uploaded N00 single-pass predictor.
c     replay=1: moving-master same-time replay setup, but with prescribed
c     fixed-sphere kinematics (validation_case=1 for case_id=4).
      include 'SIZE'
      include 'TOTAL'
      integer igeom
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      integer n_phys_inner
      common /physalis_inner/ n_phys_inner
      integer phys_replay_enabled,phys_replay_active,phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc

      if (igeom.lt.2) return
      call physalis_init
      if (phys_replay_active.eq.1) return
      if (phys_mode.lt.3) return

      if (phys_replay_enabled.eq.1 .and.
     $    phys_mode.ge.7 .and. n_phys_inner.gt.0) then
c        case_id=4 maps to validation_case=1: prescribed fixed sphere.
         if (validation_case.le.2)
     $      call validation_prepare_prescribed_step
         call physalis_begin_particle_step
         call physalis_update_particle_state
         call physalis_axisym_reset_cage_defect
         call physalis_build_gll_cage
         if (validation_case.le.2)
     $      call physalis_refill_transition_history
         if (phys_mode.ge.5)
     $      call physalis_lock_pressure_reference
         if (phys_mode.ge.3)
     $      call physalis_reconstruct_velocity_cage
         if (phys_mode.ge.5)
     $      call physalis_reconstruct_pressure_cage
         call stage24_apply_target_mode
         call physalis_history_init_once
         call physalis_save_timestep_state
      else
c        Exact uploaded N00 single-pass ordering.
         call validation_set_prescribed_state(time)
         call physalis_update_particle_state
         call physalis_build_gll_cage
         if (phys_mode.ge.3)
     $      call physalis_reconstruct_velocity_cage
         if (phys_mode.ge.5)
     $      call physalis_reconstruct_pressure_cage
         call stage24_apply_target_mode
         call physalis_history_init_once
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_post_plan3_hook(igeom)
c     replay=0: uploaded N00 one-pass coefficient update.
c     replay=1: solve the Physalis fixed point at the SAME physical time
c     by restoring the saved t^n state and replaying PLAN3 until accepted.
      include 'SIZE'
      include 'TOTAL'
      integer igeom
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p
      integer n_phys_inner
      common /physalis_inner/ n_phys_inner
      integer phys_replay_enabled,phys_replay_active,phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved
      integer stage23_active,stage23_freeze
      integer stage23_interior_on,stage23_lift_on
      common /stage23_ctl_i/ stage23_active,stage23_freeze,
     $ stage23_interior_on,stage23_lift_on

      if (igeom.lt.2) return
      call physalis_init
      if (phys_replay_active.eq.1) return
      if (phys_mode.lt.3) return

c     Stage23 freezes the Stokes-compatible Lamb state.  The purpose
c     is pressure/interior operator validation, not Cd convergence.
      if (stage23_active.eq.1 .and. stage23_freeze.eq.1) then
         if (istep.eq.1 .and. nid.eq.0)
     $      write(6,*) 'STAGE23 POST-PLAN3: FROZEN RETURN'
         call physalis_update_divergence_norm
         if (istep.eq.1 .or. mod(istep,100).eq.0)
     $      call stage19_write_operator_diag
         return
      endif

      if (phys_replay_enabled.eq.1 .and.
     $    phys_mode.ge.7 .and. n_phys_inner.gt.0) then
         call physalis_projection_restore_audit(0,0)
         call physalis_axisym_update_cage_defect
         call physalis_true_inner_loop(igeom)
      else
         call physalis_update_particle_state
         call physalis_build_gll_cage
         call physalis_iteration
         call physalis_update_divergence_norm
         call stage24_write_dynamic_diag
         if (istep.eq.1 .or. mod(istep,100).eq.0)
     $      call stage19_write_operator_diag
         if (istep.eq.1 .or. mod(istep,100).eq.0)
     $      call stage27_write_postsolve_diag
      endif
      return
      end
      subroutine physalis_save_timestep_state
c     Case-local state snapshot.  Keeping this in set.usr makes the true
c     inner replay portable without requiring another shared-core symbol.
      include 'SIZE'
      include 'TOTAL'

c     Inlined replay storage: no custom include file is required.
      real phys_rp_vx(lx1,ly1,lz1,lelv)
      real phys_rp_vy(lx1,ly1,lz1,lelv)
      real phys_rp_vz(lx1,ly1,lz1,lelv)
      real phys_rp_vxlag(lx1,ly1,lz1,lelv,lorder-1)
      real phys_rp_vylag(lx1,ly1,lz1,lelv,lorder-1)
      real phys_rp_vzlag(lx1,ly1,lz1,lelv,lorder-1)
      real phys_rp_pr(lx2,ly2,lz2,lelv)
      real phys_rp_prlag(lx2,ly2,lz2,lelv,lorder2)
      common /physalis_replay_buf/ phys_rp_vx,phys_rp_vy,
     $ phys_rp_vz,phys_rp_vxlag,phys_rp_vylag,phys_rp_vzlag,
     $ phys_rp_pr,phys_rp_prlag
      real phys_rp_abx1(lx1,ly1,lz1,lelv)
      real phys_rp_aby1(lx1,ly1,lz1,lelv)
      real phys_rp_abz1(lx1,ly1,lz1,lelv)
      real phys_rp_abx2(lx1,ly1,lz1,lelv)
      real phys_rp_aby2(lx1,ly1,lz1,lelv)
      real phys_rp_abz2(lx1,ly1,lz1,lelv)
      real phys_rp_bm1lag(lx1,ly1,lz1,lelv,lorder-1)
      common /physalis_replay_rhs/ phys_rp_abx1,phys_rp_aby1,
     $ phys_rp_abz1,phys_rp_abx2,phys_rp_aby2,
     $ phys_rp_abz2,phys_rp_bm1lag
      real phys_rp_v1mask(lx1,ly1,lz1,lelv)
      real phys_rp_v2mask(lx1,ly1,lz1,lelv)
      real phys_rp_v3mask(lx1,ly1,lz1,lelv)
      common /physalis_replay_masks/ phys_rp_v1mask,
     $ phys_rp_v2mask,phys_rp_v3mask

      integer phys_replay_enabled,phys_replay_active,phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved

      logical first_full_replay
      save first_full_replay
      data first_full_replay /.true./

      if (phys_replay_enabled.ne.1) return

      if (nio.eq.0 .and. first_full_replay) then
         write(6,*) 'PHYSALIS FULL REPLAY STATE ACTIVE'
         write(6,*) '  restored: V/P, lag, AB1/AB2, BM1LAG, masks'
         first_full_replay=.false.
      endif

      ntot1 = lx1*ly1*lz1*nelv
      ntot2 = lx2*ly2*lz2*nelv
      call opcopy(phys_rp_vx,phys_rp_vy,phys_rp_vz,vx,vy,vz)
      call copy(phys_rp_vxlag,vxlag,ntot1*(lorder-1))
      call copy(phys_rp_vylag,vylag,ntot1*(lorder-1))
      call copy(phys_rp_vzlag,vzlag,ntot1*(lorder-1))
      call copy(phys_rp_pr,pr,ntot2)
      call copy(phys_rp_prlag,prlag,ntot2*(lorder-2))
      call copy(phys_rp_abx1,abx1,ntot1)
      call copy(phys_rp_aby1,aby1,ntot1)
      call copy(phys_rp_abz1,abz1,ntot1)
      call copy(phys_rp_abx2,abx2,ntot1)
      call copy(phys_rp_aby2,aby2,ntot1)
      call copy(phys_rp_abz2,abz2,ntot1)
      call copy(phys_rp_bm1lag,bm1lag,
     $          ntot1*(lorder-1))
      call copy(phys_rp_v1mask,v1mask,ntot1)
      call copy(phys_rp_v2mask,v2mask,ntot1)
      call copy(phys_rp_v3mask,v3mask,ntot1)
      phys_state_saved = 1

      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_restore_timestep_state
      include 'SIZE'
      include 'TOTAL'

c     Inlined replay storage: no custom include file is required.
      real phys_rp_vx(lx1,ly1,lz1,lelv)
      real phys_rp_vy(lx1,ly1,lz1,lelv)
      real phys_rp_vz(lx1,ly1,lz1,lelv)
      real phys_rp_vxlag(lx1,ly1,lz1,lelv,lorder-1)
      real phys_rp_vylag(lx1,ly1,lz1,lelv,lorder-1)
      real phys_rp_vzlag(lx1,ly1,lz1,lelv,lorder-1)
      real phys_rp_pr(lx2,ly2,lz2,lelv)
      real phys_rp_prlag(lx2,ly2,lz2,lelv,lorder2)
      common /physalis_replay_buf/ phys_rp_vx,phys_rp_vy,
     $ phys_rp_vz,phys_rp_vxlag,phys_rp_vylag,phys_rp_vzlag,
     $ phys_rp_pr,phys_rp_prlag
      real phys_rp_abx1(lx1,ly1,lz1,lelv)
      real phys_rp_aby1(lx1,ly1,lz1,lelv)
      real phys_rp_abz1(lx1,ly1,lz1,lelv)
      real phys_rp_abx2(lx1,ly1,lz1,lelv)
      real phys_rp_aby2(lx1,ly1,lz1,lelv)
      real phys_rp_abz2(lx1,ly1,lz1,lelv)
      real phys_rp_bm1lag(lx1,ly1,lz1,lelv,lorder-1)
      common /physalis_replay_rhs/ phys_rp_abx1,phys_rp_aby1,
     $ phys_rp_abz1,phys_rp_abx2,phys_rp_aby2,
     $ phys_rp_abz2,phys_rp_bm1lag
      real phys_rp_v1mask(lx1,ly1,lz1,lelv)
      real phys_rp_v2mask(lx1,ly1,lz1,lelv)
      real phys_rp_v3mask(lx1,ly1,lz1,lelv)
      common /physalis_replay_masks/ phys_rp_v1mask,
     $ phys_rp_v2mask,phys_rp_v3mask

      integer phys_replay_enabled,phys_replay_active,phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved

      if (phys_state_saved.ne.1) then
         if (nio.eq.0) write(6,*)
     $      'ERROR: Physalis timestep replay state was not saved'
         call exitt
      endif

      ntot1 = lx1*ly1*lz1*nelv
      ntot2 = lx2*ly2*lz2*nelv
      call opcopy(vx,vy,vz,phys_rp_vx,phys_rp_vy,phys_rp_vz)
      call copy(vxlag,phys_rp_vxlag,ntot1*(lorder-1))
      call copy(vylag,phys_rp_vylag,ntot1*(lorder-1))
      call copy(vzlag,phys_rp_vzlag,ntot1*(lorder-1))
      call copy(pr,phys_rp_pr,ntot2)
      call copy(prlag,phys_rp_prlag,ntot2*(lorder-2))
      call copy(abx1,phys_rp_abx1,ntot1)
      call copy(aby1,phys_rp_aby1,ntot1)
      call copy(abz1,phys_rp_abz1,ntot1)
      call copy(abx2,phys_rp_abx2,ntot1)
      call copy(aby2,phys_rp_aby2,ntot1)
      call copy(abz2,phys_rp_abz2,ntot1)
      call copy(bm1lag,phys_rp_bm1lag,
     $          ntot1*(lorder-1))
      call copy(v1mask,phys_rp_v1mask,ntot1)
      call copy(v2mask,phys_rp_v2mask,ntot1)
      call copy(v3mask,phys_rp_v3mask,ntot1)

      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_replay_timestep(igeom,inner_k)
      include 'SIZE'
      include 'TOTAL'

      integer igeom,inner_k
      real pk_xn,pk_yn,pk_zn,pk_un,pk_vn,pk_wn
      real pk_anx,pk_any,pk_anz,pk_uk,pk_vk,pk_wk
      real pk_akx,pk_aky,pk_akz,pk_uc,pk_vc,pk_wc
      real pk_acx,pk_acy,pk_acz
      real coeff_resid_raw,coeff_resid_relaxed
      real particle_resid_a,particle_resid_w,closure_resid
      common /physalis_kappa_r/ pk_xn,pk_yn,pk_zn,
     $ pk_un,pk_vn,pk_wn,pk_anx,pk_any,pk_anz,
     $ pk_uk,pk_vk,pk_wk,pk_akx,pk_aky,pk_akz,
     $ pk_uc,pk_vc,pk_wc,pk_acx,pk_acy,pk_acz,
     $ coeff_resid_raw,coeff_resid_relaxed,
     $ particle_resid_a,particle_resid_w,closure_resid
      real wk0,ak0,uk0,vk0,ax0,ay0
      integer phys_replay_enabled,phys_replay_active,phys_state_saved
      common /physalis_replay_ctl/ phys_replay_enabled,
     $ phys_replay_active,phys_state_saved
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real param21_saved
      logical first_nested_pressure
      save first_nested_pressure
      data first_nested_pressure /.true./
      integer phys_surface_inner_current
      common /phys_surface_audit_i/ phys_surface_inner_current

      if (phys_replay_enabled.ne.1) return
      if (igeom.lt.2) return

      uk0=pk_uk
      vk0=pk_vk
      wk0=pk_wk
      ax0=pk_akx
      ay0=pk_aky
      ak0=pk_akz
      call physalis_restore_timestep_state
      phys_replay_active = 1
      param21_saved=param(21)
      if (zp_problem.eq.12) then
         param(21)=-1.0e-5
         if (nio.eq.0 .and. first_nested_pressure) write(6,*)
     $      'PHYSALIS S NESTED PRESSURE RTOL: 1.0E-5'
         first_nested_pressure=.false.
      endif
      phys_surface_inner_current = inner_k
      call plan3(igeom)
      param(21)=param21_saved

c     STAGE16 replay projection-defect feedback.
c     This restores the two calls present in the known-working moving
c     branch after every nested PLAN3.  The updated u_def/v_def are
c     applied by physalis_reconstruct_velocity_cage on the next replay.
      call physalis_projection_restore_audit(0,inner_k)
      call physalis_axisym_update_cage_defect

      phys_replay_active = 0
      if (pk_uk.ne.uk0 .or. pk_vk.ne.vk0 .or. pk_wk.ne.wk0 .or.
     $    pk_akx.ne.ax0 .or. pk_aky.ne.ay0 .or. pk_akz.ne.ak0) then
         if (nid.eq.0) write(6,*)
     $      'ERROR: replay modified particle kappa work state'
         call exitt
      endif

      return
      end

      subroutine physalis_post_fluid_update_hook(igeom)
c     Disabled in Re100 single-pass stage1.
c     physalis_post_plan3_hook is the only coefficient-update path.
      integer igeom
      return
      end

c-----------------------------------------------------------------------
      subroutine stage19_write_operator_diag
c     Stage19: diagnostics only.  No PLAN3 call and no state mutation
c     except evaluation of already-defined cage residual norms.
      include 'SIZE'
      include 'TOTAL'

      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old

      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid

      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g

      integer fu
      call physalis_update_velocity_cage_residual
      call physalis_enforce_pressure_cage(pr)

      if (nid.eq.0) then
         fu=97
         if (istep.eq.1) then
            open(unit=fu,file='stage19_operator_diag.dat',
     $           status='replace')
            write(fu,'(A)')
     $ '# step time Fz coeff cage pcage div p10 phi10'
         else
            open(unit=fu,file='stage19_operator_diag.dat',
     $           status='old',position='append')
         endif
         write(fu,'(I10,8(1X,E18.9))')
     $      istep,time,F_phys(3),coeff_resid,cage_vel_res,
     $      pressure_cage_res,div_norm,p_re(1,1),phi_re(1,1)
         close(fu)
      endif

      return
      end
c-----------------------------------------------------------------------
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg)
      include 'SIZE'
      include 'TSTEP'
      include 'NEKUSE'
      include 'INPUT'
      include 'GEOM'
      integer ix,iy,iz,iside,eg
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      real ue,ve,we

      call zp_validation_config
      ux=0.0
      uy=0.0
      uz=0.0
      if (zp_problem.eq.11) then
         call zp_op1_exact_velocity(x,y,z,ue,ve,we)
         ux=ue
         uy=ve
         uz=we
      elseif (zp_problem.eq.12) then
         call validation_fixed_stokes_velocity(x,y,z,ue,ve,we)
         ux=ue
         uy=ve
         uz=we
      elseif (zp_problem.eq.21 .or. zp_problem.eq.22) then
c        USERBC is called only on the lower-z inlet marked 'v'.
         uz=zp_flow
      elseif (zp_problem.eq.71) then
c        BF-S4 axisym validation: Nek x is the axial/flow coordinate.
c        Both inlet and outer-radial far field are labeled lowercase v.
         ux=zp_flow
         uy=0.0
         uz=0.0
      endif
      return
      end
c-----------------------------------------------------------------------


c-----------------------------------------------------------------------
      subroutine stage21_startup_mode(mode)
      integer mode
      integer s21_start_mode
      parameter(s21_start_mode=1)
      mode=s21_start_mode
      return
      end
c-----------------------------------------------------------------------
      subroutine stage21_stokes_velocity_axisym(xq,rq,uq,vq)
c     Nek x=axial, Nek y=radius; Physalis z=Nek x.
      include 'SIZE'
      include 'TOTAL'
      real xq,rq,uq,vq
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real xa,rrad,r2,r,rinv,ar,a3,aa,bb,udotr,uinf
      xa=xq-cfg_center(3)
      rrad=rq-cfg_center(1)
      r2=xa*xa+rrad*rrad
      r=sqrt(max(r2,1.0e-30))
      if (r.le.cfg_radius) then
         uq=0.0
         vq=0.0
         return
      endif
      rinv=1.0/r
      ar=cfg_radius*rinv
      a3=ar**3
      aa=1.0-0.75*ar-0.25*a3
      bb=-0.75*ar+0.75*a3
      uinf=cfg_flow(3)
      udotr=uinf*xa*rinv
      uq=aa*uinf+bb*udotr*xa*rinv
      vq=bb*udotr*rrad*rinv
      return
      end
c-----------------------------------------------------------------------
      subroutine stage21_stokes_pressure_axisym(xq,rq,pq)
      include 'SIZE'
      include 'TOTAL'
      real xq,rq,pq
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real xa,rrad,r2,r,mu,uinf
      xa=xq-cfg_center(3)
      rrad=rq-cfg_center(1)
      r2=xa*xa+rrad*rrad
      r=sqrt(max(r2,1.0e-30))
      if (r.le.cfg_radius) then
         pq=0.0
      else
         mu=abs(param(2))
         uinf=cfg_flow(3)
         pq=-1.5*mu*cfg_radius*uinf*xa/(r2*r)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine stage21_stokes_pressure_cont_axisym(xq,rq,pq)
      include 'SIZE'
      include 'TOTAL'
      real xq,rq,pq
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      real xa,rrad,r2,r,mu,uinf
      xa=xq-cfg_center(3)
      rrad=rq-cfg_center(1)
      r2=xa*xa+rrad*rrad
      r=sqrt(max(r2,1.0e-30))
      mu=abs(param(2))
      uinf=cfg_flow(3)
      pq=-1.5*mu*cfg_radius*uinf*xa/(r2*r)
      return
      end
c-----------------------------------------------------------------------
      subroutine stage21_initialize_stokes_pressure
      include 'SIZE'
      include 'TOTAL'
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      integer n_inside_u_g,n_cage_u_g,n_inside_p_g,n_cage_p_g
      real h_gll_min,h_gll_mean,h_p_min,h_p_mean
      real delta_u_local,delta_p_local
      real min_ru_over_a,max_ru_over_a,min_rp_over_a,max_rp_over_a
      real cage_vel_res,pressure_cage_res,div_norm
      common /physalis_diag/ h_gll_min,h_gll_mean,h_p_min,h_p_mean,
     $ delta_u_local,delta_p_local,min_ru_over_a,max_ru_over_a,
     $ min_rp_over_a,max_rp_over_a,cage_vel_res,
     $ pressure_cage_res,div_norm,n_inside_u_g,n_cage_u_g,
     $ n_inside_p_g,n_cage_p_g
      real delta_p_cage_local,delta_p_lift_local
      common /stage33c_pwidth_r/ delta_p_cage_local,
     $ delta_p_lift_local
      integer e,i,j,k,il,ntot2
      real pq,xa,rrad,rr,inner_support
      inner_support=max(0.25,1.0-2.0*delta_p_lift_local/
     $ max(cfg_radius,1.0e-30))
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         xa=xm2(i,j,k,e)-cfg_center(3)
         rrad=ym2(i,j,k,e)-cfg_center(1)
         rr=sqrt(xa*xa+rrad*rrad)
         pq=0.0
         if (rr.ge.inner_support*cfg_radius .and.
     $       rr.le.2.0*cfg_radius)
     $      call stage21_stokes_pressure_cont_axisym(
     $       xm2(i,j,k,e),ym2(i,j,k,e),pq)
         if (rr.gt.2.0*cfg_radius)
     $      call stage21_stokes_pressure_axisym(
     $       xm2(i,j,k,e),ym2(i,j,k,e),pq)
         pr(i,j,k,e)=pq
      enddo
      enddo
      enddo
      enddo
      ntot2=lx2*ly2*lz2*nelv
      do il=1,lorder2
         call copy(prlag(1,1,1,1,il),pr,ntot2)
      enddo
      return
      end
c-----------------------------------------------------------------------
      subroutine stage21_write_startup_diag(mode)
      include 'SIZE'
      include 'TOTAL'
      integer mode
      real p_re(4,5),p_im(4,5),phi_re(4,5),phi_im(4,5)
      real v_re(4,5),v_im(4,5)
      real p_re_old(4,5),p_im_old(4,5)
      real phi_re_old(4,5),phi_im_old(4,5)
      real v_re_old(4,5),v_im_old(4,5)
      common /phys_lamb/ p_re,p_im,phi_re,phi_im,v_re,v_im,
     $ p_re_old,p_im_old,phi_re_old,phi_im_old,v_re_old,v_im_old
      real F_phys(3),T_phys(3),coeff_resid
      common /phys_frc/ F_phys,T_phys,coeff_resid
      real prms2,wsum,pmax,w
      integer e,i,j,k,fu
      prms2=0.0
      wsum=0.0
      pmax=0.0
      do e=1,nelv
      do k=1,lz2
      do j=1,ly2
      do i=1,lx2
         w=bm2(i,j,k,e)
         prms2=prms2+w*pr(i,j,k,e)*pr(i,j,k,e)
         wsum=wsum+w
         pmax=max(pmax,abs(pr(i,j,k,e)))
      enddo
      enddo
      enddo
      enddo
      prms2=glsum(prms2,1)
      wsum=glsum(wsum,1)
      pmax=glmax(pmax,1)
      if (nid.eq.0) then
         fu=96
         open(fu,file='stage21_startup_diag.dat',
     $        status='replace')
         write(fu,'(A)')
     $ '# mode dt prms pmax p10 phi10 Fz cage'
         write(fu,'(I3,7(1X,E18.9))') mode,dt,
     $      sqrt(prms2/max(wsum,1.0e-30)),pmax,
     $      p_re(1,1),phi_re(1,1),F_phys(3),cage_vel_res
         close(fu)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer ix,iy,iz,eg
      integer zp_problem,zp_lmax,zp_moving,zp_stride,zp_cage_mode
      common /zp_validation_i/ zp_problem,zp_lmax,zp_moving,
     $ zp_stride,zp_cage_mode
      real zp_flow,zp_pstar,zp_gstar,zp_target_re
      real zp_poff(3),zp_coff(3)
      common /zp_validation_r/ zp_flow,zp_pstar,zp_gstar,
     $ zp_target_re,zp_poff,zp_coff
      real ue,ve,we
      integer s21_mode

      call zp_validation_config
      ux=0.0
      uy=0.0
      uz=0.0
      if (zp_problem.eq.11) then
         call zp_op1_exact_velocity(x,y,z,ue,ve,we)
         ux=ue
         uy=ve
         uz=we
      elseif (zp_problem.eq.12) then
         call validation_fixed_stokes_velocity(x,y,z,ue,ve,we)
         ux=ue
         uy=ve
         uz=we
      elseif (zp_problem.eq.21 .or. zp_problem.eq.22) then
         uz=zp_flow
      elseif (zp_problem.eq.71) then
         call stage21_startup_mode(s21_mode)
         if (s21_mode.eq.1) then
            call stage21_stokes_velocity_axisym(x,y,ue,ve)
            ux=ue
            uy=ve
            uz=0.0
         else
            ux=zp_flow
            uy=0.0
            uz=0.0
         endif
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine physalis_fixed_test_flow(u0x,u0y,u0z,idir,u0)
      real u0x,u0y,u0z,u0
      integer idir
      integer validation_case,cfg_nparticles,cfg_center_mode
      integer cfg_fixed_exact_bc
      common /validation_case_i/ validation_case,cfg_nparticles,
     $ cfg_center_mode,cfg_fixed_exact_bc
      real cfg_center(3),cfg_radius,cfg_rhop_ratio,cfg_gz
      real cfg_vt_ref,cfg_tau95_ref,cfg_flow(3),cfg_osc_amp(3)
      real cfg_osc_omega,cfg_osc_phase,cfg_top_offset_over_a
      common /validation_case_r/ cfg_center,cfg_radius,
     $ cfg_rhop_ratio,cfg_gz,cfg_vt_ref,cfg_tau95_ref,
     $ cfg_flow,cfg_osc_amp,cfg_osc_omega,cfg_osc_phase,
     $ cfg_top_offset_over_a
      call validation_config
      u0x=cfg_flow(1)
      u0y=cfg_flow(2)
      u0z=cfg_flow(3)
      u0=sqrt(u0x*u0x+u0y*u0y+u0z*u0z)
      idir=3
      if (abs(u0x).ge.abs(u0y) .and. abs(u0x).ge.abs(u0z)) idir=1
      if (abs(u0y).gt.abs(u0x) .and. abs(u0y).ge.abs(u0z)) idir=2
      return
      end
c-----------------------------------------------------------------------
c-----------------------------------------------------------------------
      subroutine usrdat
      include 'SIZE'
      include 'TOTAL'
      integer phys_mode,n_phys_iter,lmax,pressure_mode
      real beta_coeff,phys_tol_coeff,phys_tol_cage
      real r_sample_over_a,cage_thickness_u,cage_thickness_p
      common /physalis_params/ phys_mode,n_phys_iter,lmax,
     $ pressure_mode,beta_coeff,phys_tol_coeff,phys_tol_cage,
     $ r_sample_over_a,cage_thickness_u,cage_thickness_p

      call physalis_init

c     Stock Nek5000 Physalis port: no LPM/IBM marker switch is used.

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'
      integer i,j,k,e

c     set.re2 is generated in the same particle-radius units as the BF
c     reference set.box: x/a=[-72,88], r/a=[0,40].
c     Convert to the identical physical domain with a=0.005 cm.
      do e=1,nelt
      do k=1,lz1
      do j=1,ly1
      do i=1,lx1
         xm1(i,j,k,e)=0.005d0*xm1(i,j,k,e)
         ym1(i,j,k,e)=0.005d0*ym1(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

c     GLL coordinates were modified; request geometry regeneration.
      param(59)=1.0d0

c     STAGE23 uses documented GMRES from set.par.
c     The private core restricts pressure correction to exterior DOFs.
      if (nid.eq.0) then
         write(6,*) 'STAGE23 pressure solver=GMRES'
         write(6,*) 'STAGE23 P042/P095=',param(42),param(95)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
